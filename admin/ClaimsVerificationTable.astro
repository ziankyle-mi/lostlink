                <path d="M12 2v2"></path>
              </svg>
            )}
            {item.iconType === "calculator" && (
              <svg class="size-6 text-forest-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="16" height="20" x="4" y="2" rx="2"></rect>
                <line x1="8" x2="16" y1="6" y2="6"></line>
                <line x1="16" x2="16" y1="14" y2="18"></line>
                <path d="M16 10h.01"></path>
                <path d="M12 10h.01"></path>
                <path d="M8 10h.01"></path>
                <path d="M12 14h.01"></path>
                <path d="M8 14h.01"></path>
                <path d="M12 18h.01"></path>
                <path d="M8 18h.01"></path>
              </svg>
            )}
          </div>
          <div class="min-w-0">
            <p class="truncate text-sm font-bold text-stone-900 leading-tight">
              {item.name}
            </p>
            <p class="truncate text-xs text-stone-500 mt-0.5">
              {item.location}
            </p>
          </div>
        </div>

        <!-- CLAIMANT Column -->
        <div class="sm:col-span-3 lg:col-span-3 min-w-0 pl-14 sm:pl-0">
          <p class="truncate text-sm font-bold text-stone-900 leading-tight">
            {item.claimant}
          </p>
          <p class="truncate text-xs text-stone-500 mt-0.5 font-mono">
            {item.studentId}
          </p>
        </div>

        <!-- STATUS Column -->
        <div class="sm:col-span-3 lg:col-span-2 pl-14 sm:pl-0">
          <span class={`inline-block rounded-full px-3 py-1 text-xs font-bold leading-none ${item.statusStyle}`}>
            {item.statusText}
          </span>
          <span class="block text-xs text-stone-500 mt-1">
            {item.time}
          </span>
        </div>

        <!-- ACTION Column -->
        <div class="sm:col-span-2 lg:col-span-2 sm:text-right pl-14 sm:pl-0">
          <button
            type="button"
            data-claim-id={item.id}
            data-claim-item={item.name}
            data-claim-claimant={item.claimant}
            data-claim-details={item.privateDetails}
            class="claim-review-btn inline-flex items-center gap-1 text-sm font-bold text-forest-900 hover:text-forest-700 transition-colors cursor-pointer"
          >
            {isAdmin ? "Review \u2192" : "View ticket \u2192"}
          </button>
        </div>
      </div>
    )))}
  </div>
</section>
