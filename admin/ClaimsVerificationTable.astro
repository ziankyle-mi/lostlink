function formatClaimDate(dateStr?: string): string {
  if (!dateStr) return "Recently";
  const d = new Date(dateStr);
  const now = new Date();
  const isToday = d.toDateString() === now.toDateString();
  const timeStr = d.toLocaleTimeString("en-US", { hour: "numeric", minute: "2-digit" });
  return isToday ? `Today, ${timeStr}` : d.toLocaleDateString("en-US", { month: "short", day: "numeric" });
}

interface RawLiveClaim {
  id: string;
  proof_description?: string;
  status?: string;
  created_at?: string;
  items?: { name?: string; location?: string; category?: string };
  profiles?: { full_name?: string; email?: string };
}

const mappedLiveClaims = liveClaims && liveClaims.length > 0
  ? liveClaims.map((c: RawLiveClaim) => ({
      id: c.id,
      name: c.items?.name ?? "Reported Item",
      location: c.items?.location ? `Found at ${c.items.location}` : "Campus grounds",
      iconBg: "bg-[#e5ecdc]",
      iconType: c.items?.category === "IDs, Cards & Wallets" ? "wallet" : "id-card",
      claimant: c.profiles?.full_name ?? "Student Claimant",
      studentId: c.profiles?.email ? c.profiles.email.split("@")[0] : "Verified Student",
      statusText: c.status === "verified" ? "Verified" : (c.status === "denied" ? "Denied" : "Awaiting visit"),
      statusStyle: c.status === "verified" ? "bg-[#d8ef8c] text-[#164f38]" : (c.status === "denied" ? "bg-red-100 text-red-800" : "bg-stone-200 text-stone-700"),
      time: formatClaimDate(c.created_at),
      privateDetails: c.proof_description ?? "Proof details provided during claim verification.",
    }))
  : [];

const items = liveClaims !== undefined
  ? mappedLiveClaims
  : (isAdmin ? adminClaims : studentClaims);
---

<section class="rounded-[2rem] bg-white p-6 sm:p-8 border border-stone-200/60 shadow-xs" id="claims">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 pb-5 border-b border-stone-100">
    <div>
      <h2 class="font-serif text-2xl sm:text-[1.75rem] font-black text-forest-900 tracking-tight">
        {isAdmin ? "Claims to verify" : "My active claims & reports"}
      </h2>
      <p class="mt-1 text-sm text-stone-500">
        {isAdmin
          ? "Check each claim against the private details before release."
          : "Track verification status and office pickup tickets."}
      </p>
    </div>

    <a
      href={isAdmin ? "/admin#all-claims" : "/profile#all-claims"}
      class="text-sm font-bold text-forest-900 hover:text-forest-700 underline underline-offset-4 transition-colors shrink-0"
    >
      {isAdmin ? "View all claims \u2192" : "View all reports \u2192"}
    </a>
  </div>

  <!-- Table Header (Desktop) -->
  <div class="hidden sm:grid sm:grid-cols-12 gap-4 py-3 border-b border-stone-100 text-[11px] font-black tracking-wider text-stone-400 uppercase">
    <div class="col-span-4 lg:col-span-5">ITEM</div>
    <div class="col-span-3 lg:col-span-3">CLAIMANT</div>
    <div class="col-span-3 lg:col-span-2">STATUS</div>
    <div class="col-span-2 lg:col-span-2 text-right">ACTION</div>
  </div>

  <!-- Rows List -->
  <div class="divide-y divide-stone-100">
    {items.length === 0 ? (
      <div class="py-12 text-center text-stone-500">
        <div class="mx-auto flex size-12 items-center justify-center rounded-full bg-stone-100 text-stone-400">
          <svg class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <p class="mt-3 text-sm font-bold text-forest-900">No claims to verify</p>
        <p class="mt-1 text-xs text-stone-400">When students submit claims for found items, they will appear here for verification.</p>
      </div>
    ) : (
      items.map((item) => (
      <div class="grid grid-cols-1 sm:grid-cols-12 gap-3 sm:gap-4 py-4.5 sm:items-center hover:bg-stone-50/60 rounded-xl px-2 transition-colors">
        <!-- ITEM Column -->
        <div class="sm:col-span-4 lg:col-span-5 flex items-center gap-3.5 min-w-0">
          <div class={`size-11 sm:size-12 shrink-0 rounded-2xl flex items-center justify-center ${item.iconBg}`}>
            {item.iconType === "wallet" && (
