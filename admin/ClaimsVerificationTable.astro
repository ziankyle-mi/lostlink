                <path d="M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4"></path>
              </svg>
            )}
            {item.iconType === "id-card" && (
              <svg class="size-6 text-forest-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="18" height="14" x="3" y="5" rx="2"></rect>
                <circle cx="8" cy="11" r="2"></circle>
                <path d="M14 9h3"></path>
                <path d="M14 13h3"></path>
              </svg>
            )}
            {item.iconType === "keys" && (
              <svg class="size-6 text-forest-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="7.5" cy="15.5" r="4.5"></circle>
                <path d="m21 3-9.5 9.5"></path>
                <path d="m15.5 7.5 3 3"></path>
              </svg>
            )}
            {item.iconType === "earbuds" && (
              <svg class="size-6 text-forest-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="16" height="12" x="4" y="6" rx="4"></rect>
                <path d="M4 12h16"></path>
                <circle cx="12" cy="12" r="1.5" fill="currentColor"></circle>
              </svg>
            )}
            {item.iconType === "umbrella" && (
