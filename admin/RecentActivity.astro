---
interface Props {
  role?: "admin" | "student";
  liveLogs?: any[];
}

const { role = "admin", liveLogs } = Astro.props;
const isAdmin = role === "admin";

const adminLogs = [
  { text: "Umbrella logged into custody", time: "2:45 PM" },
  { text: "Earbuds case flagged: two claimants", time: "1:30 PM" },
  { text: "Backpack released to owner", time: "11:20 AM" },
  { text: "Daily custody sweep completed", time: "8:00 AM" },
];

const studentLogs = [
  { text: "Claim submitted for Scientific calculator", time: "2:10 PM" },
  { text: "Lost report filed for Green Lanyard", time: "Yesterday, 4:05 PM" },
  { text: "Match alert: Keys found at Engg Bldg", time: "Oct 9, 11:20 AM" },
  { text: "Account linked to DLSAU Portal", time: "Oct 8, 8:00 AM" },
];

function formatLogTime(dateStr?: string): string {
  if (!dateStr) return "Just now";
  const d = new Date(dateStr);
  const now = new Date();
  const isToday = d.toDateString() === now.toDateString();
  const timeStr = d.toLocaleTimeString("en-US", { hour: "numeric", minute: "2-digit" });
  return isToday ? timeStr : d.toLocaleDateString("en-US", { month: "short", day: "numeric" });
}

function formatLogAction(action: string, itemName?: string): string {
  const name = itemName ? `"${itemName}"` : "item";
  if (action === "intake_confirmed" || action === "approved") return `${name} intake confirmed into DO custody`;
  if (action === "claim_verified") return `Claim verified for ${name}`;
  if (action === "claim_denied") return `Claim denied for ${name}`;
  if (action === "rejected") return `${name} report flagged/rejected`;
  if (action === "marked_claimed") return `${name} released to owner`;
  return `${name} status updated: ${action}`;
}

const mappedLiveLogs = liveLogs && liveLogs.length > 0
  ? liveLogs.map((l: any) => ({
      text: formatLogAction(l.action, l.items?.name),
      time: formatLogTime(l.created_at),
    }))
  : [];

const logs = liveLogs !== undefined
  ? mappedLiveLogs
  : (isAdmin ? adminLogs : studentLogs);
---

<section class="rounded-[2rem] bg-white p-6 sm:p-8 border border-stone-200/60 shadow-xs flex flex-col justify-between" id="activity">
  <div>
    <!-- Header -->
    <div class="flex items-center justify-between pb-4 border-b border-stone-100">
      <h2 class="font-serif text-2xl font-black text-forest-900 tracking-tight">
        {isAdmin ? "Recent activity" : "My recent activity"}
      </h2>
      <span class="text-xs font-bold text-stone-400 uppercase tracking-wider">
        Today
      </span>
    </div>

    <!-- Feed List -->
    <div class="mt-4 divide-y divide-stone-100">
      {logs.length === 0 ? (
        <div class="py-8 text-center text-stone-500">
          <p class="text-sm font-semibold text-stone-600">No activity recorded today</p>
          <p class="mt-1 text-xs text-stone-400">Actions taken by staff and students will appear here in real time.</p>
        </div>
      ) : (
        logs.map((log) => (
        <div class="flex items-center justify-between gap-4 py-4 first:pt-2 last:pb-0 hover:bg-stone-50/50 rounded-lg px-1 transition-colors">
          <div class="flex items-center gap-3 min-w-0">
            <span class="size-2 rounded-full bg-[#164f38] shrink-0"></span>
            <p class="truncate text-sm font-medium text-stone-800">
              {log.text}
            </p>
          </div>
          <span class="shrink-0 text-xs font-mono font-medium text-stone-500">
            {log.time}
          </span>
        </div>
      )))}
    </div>
  </div>

  <div class="mt-6 pt-4 border-t border-stone-100">
    {isAdmin ? (
      <button
        type="button"
        id="open-audit-log-btn"
        class="inline-flex items-center gap-1.5 text-xs font-bold text-forest-900 underline underline-offset-4 hover:text-forest-700 transition-colors cursor-pointer"
      >
        <span>View full audit log &rarr;</span>
      </button>
    ) : (
      <a
        href="/profile#history"
        class="inline-flex items-center gap-1.5 text-xs font-bold text-forest-900 underline underline-offset-4 hover:text-forest-700 transition-colors"
      >
        <span>View complete activity history &rarr;</span>
      </a>
    )}
  </div>
</section>
