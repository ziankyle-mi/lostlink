---
interface Props {
  role?: "admin" | "student";
  liveIntake?: any[];
}

const { role = "admin", liveIntake } = Astro.props;
const isAdmin = role === "admin";

const intakeItems = [
  {
    id: "intake-1",
    name: "Grey drawstring bag",
    meta: "Posted by Kevin L. \u00b7 20 min ago",
    iconBg: "bg-[#e6eae2]",
    iconType: "bag",
  },
  {
    id: "intake-2",
    name: "Black tumbler",
    meta: "Posted by Liza M. \u00b7 1 hr ago",
    iconBg: "bg-[#e5eed6]",
    iconType: "bottle",
  },
  {
    id: "intake-3",
    name: "Calculator, scientific",
    meta: "Posted by Ben T. \u00b7 3 hrs ago",
    iconBg: "bg-[#dde6de]",
    iconType: "calculator",
  },
];

interface RawIntake {
  id: string;
  name: string;
  category?: string;
  location?: string;
  reference_code?: string;
  created_at?: string;
  profiles?: { full_name?: string; email?: string };
}

const mappedLiveIntake = liveIntake && liveIntake.length > 0
  ? liveIntake.map((item: RawIntake) => ({
      id: item.id,
      name: item.name,
      meta: `Posted by ${item.profiles?.full_name ?? "Student"} \u00b7 ${item.reference_code ?? "Ref LL-Item"}`,
      iconBg: "bg-[#dde6de]",
      iconType: item.category === "Water Bottles & Tumblers" ? "bottle" : (item.category === "Bags & Backpacks" ? "bag" : "calculator"),
    }))
  : [];

const queueItems = liveIntake !== undefined
  ? mappedLiveIntake
  : intakeItems;
---

<section
  class="scroll-mt-8 rounded-[2rem] bg-white p-6 sm:p-8 border border-stone-200/60 shadow-xs flex flex-col justify-between"
  id="inventory"
>
  <div>
    <!-- Header -->
    <div>
      <h2 class="font-serif text-2xl font-black text-forest-900 tracking-tight">
        {isAdmin ? "Waiting for intake" : "Campus Claiming Checklist"}
      </h2>
      <p class="mt-1 text-sm text-stone-500">
        {isAdmin
          ? "Posted online. Confirm once the item reaches the office."
          : "Essential steps before heading to the Disciplinary Office."}
      </p>
    </div>

    <!-- Items List -->
    {isAdmin ? (
      <div class="mt-6 divide-y divide-stone-100">
        {queueItems.length === 0 ? (
          <div class="py-10 text-center text-stone-500">
            <div class="mx-auto flex size-12 items-center justify-center rounded-full bg-stone-100 text-stone-400">
              <svg class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <p class="mt-3 text-sm font-bold text-forest-900">Intake queue is clear</p>
            <p class="mt-1 text-xs text-stone-400">All submitted found items have been confirmed into custody.</p>
          </div>
        ) : (
          queueItems.map((item) => (
          <div class="flex items-center justify-between gap-3 py-4 first:pt-2 last:pb-0">
            <div class="flex items-center gap-3.5 min-w-0">
              <div class={`size-11 shrink-0 rounded-2xl flex items-center justify-center ${item.iconBg}`}>
                {item.iconType === "bag" && (
                  <svg class="size-6 text-forest-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 20h12a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-3V5a3 3 0 0 0-6 0v1H6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2Z"></path>
                    <path d="M9 6h6"></path>
                  </svg>
                )}
                {item.iconType === "bottle" && (
                  <svg class="size-6 text-forest-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 3h6v3H9z"></path>
                    <path d="M9 6l-2 4v11a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V10l-2-4"></path>
                    <line x1="7" x2="17" y1="14" y2="14"></line>
                  </svg>
                )}
                {item.iconType === "calculator" && (
                  <svg class="size-6 text-forest-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect width="16" height="20" x="4" y="2" rx="2"></rect>
                    <line x1="8" x2="16" y1="6" y2="6"></line>
                    <line x1="16" x2="16" y1="14" y2="18"></line>
                    <path d="M16 10h.01"></path>
                    <path d="M12 10h.01"></path>
                    <path d="M8 10h.01"></path>
                  </svg>
                )}
              </div>
              <div class="min-w-0">
                <p class="truncate text-sm font-bold text-stone-900 leading-tight">
                  {item.name}
                </p>
                <p class="truncate text-xs text-stone-500 mt-0.5">
                  {item.meta}
                </p>
              </div>
            </div>

            <div class="flex items-center gap-2 shrink-0">
              <button
                type="button"
                data-intake-id={item.id}
                data-intake-name={item.name}
                class="remove-intake-btn rounded-full border border-rose-200/90 bg-rose-50 hover:bg-rose-100 active:scale-95 px-3 py-1.5 text-xs font-bold text-rose-700 transition-all shadow-2xs cursor-pointer"
                title="Remove post"
              >
                Remove
              </button>
              <button
                type="button"
                data-intake-id={item.id}
                data-intake-name={item.name}
                class="confirm-intake-btn rounded-full bg-[#d8ef8c] hover:bg-[#cde97b] active:scale-95 px-4 py-1.5 text-xs font-bold text-[#164f38] transition-all shadow-xs cursor-pointer"
              >
                Confirm received
              </button>
            </div>
          </div>
        )))}
      </div>
    ) : (
      <div class="mt-6 space-y-3.5">
        <div class="flex items-start gap-3 rounded-2xl bg-[#f5f1e6]/80 p-3.5 border border-stone-200/50">
          <span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-[#164f38] text-xs font-black text-white">
            1
          </span>
          <div class="text-xs sm:text-sm text-stone-700">
            <p class="font-bold text-forest-900">Valid Identification</p>
            <p class="mt-0.5 text-stone-600">Present your physical DLSAU ID card or currently validated Certificate of Registration (COR).</p>
          </div>
        </div>

        <div class="flex items-start gap-3 rounded-2xl bg-[#f5f1e6]/80 p-3.5 border border-stone-200/50">
          <span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-[#164f38] text-xs font-black text-white">
            2
          </span>
          <div class="text-xs sm:text-sm text-stone-700">
            <p class="font-bold text-forest-900">Proof of Ownership</p>
            <p class="mt-0.5 text-stone-600">Be ready to describe hidden marks, phone unlock passwords, or unique contents to the office officer.</p>
          </div>
        </div>

        <div class="flex items-start gap-3 rounded-2xl bg-[#f5f1e6]/80 p-3.5 border border-stone-200/50">
          <span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-[#164f38] text-xs font-black text-white">
            3
          </span>
          <div class="text-xs sm:text-sm text-stone-700">
            <p class="font-bold text-forest-900">Office Hours & Location</p>
            <p class="mt-0.5 text-stone-600">Disciplinary Office, Admin Building Room 102. Open Monday to Friday, 8:00 AM &ndash; 5:00 PM.</p>
          </div>
        </div>
      </div>
    )}
  </div>

  <div class="mt-6 pt-4 border-t border-stone-100">
    {isAdmin ? (
      <button
        type="button"
        id="open-intake-guidelines-btn"
        class="inline-flex items-center gap-1.5 text-xs font-bold text-forest-900 underline underline-offset-4 hover:text-forest-700 transition-colors cursor-pointer"
      >
        <span>Campus intake guidelines &rarr;</span>
      </button>
    ) : (
      <a
        href="/help#claiming"
        class="inline-flex items-center gap-1.5 text-xs font-bold text-forest-900 underline underline-offset-4 hover:text-forest-700 transition-colors"
      >
        <span>View complete release policies &rarr;</span>
      </a>
    )}
  </div>
</section>
