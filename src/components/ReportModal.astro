---
import { CATEGORIES } from "~/data/mockItems";
import { CAMPUS_LOCATIONS } from "~/data/campusBuildings";
import BrandMark from "~/components/BrandMark.astro";

// Location presets come from the single shared campus location list, so the
// report form always matches the /help campus map exactly.
const presets = CAMPUS_LOCATIONS;
---

<div
  id="report-modal-backdrop"
  class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/50 backdrop-blur-sm p-3 sm:p-5 transition-all"
  role="dialog"
  aria-modal="true"
  aria-labelledby="report-modal-title"
>
  <div class="relative w-full max-w-xl max-h-[90dvh] overflow-y-auto custom-scrollbar rounded-card border border-line bg-white p-6 sm:p-8 shadow-card transition-all">
    <!-- Header with Brand Accent & Close Button -->
    <div class="flex items-start justify-between gap-4 border-b border-line/80 pb-5">
      <div class="flex items-center gap-3.5">
        <BrandMark class="size-11 rounded-2xl shadow-xs shrink-0" size={44} />
        <div>
          <h3 id="report-modal-title" class="font-serif text-2xl sm:text-[1.75rem] font-black text-forest-900 tracking-tight leading-tight">
            Post an Item to <span class="italic font-bold text-forest-700">Campus Feed</span>
          </h3>
          <p class="mt-1 text-xs sm:text-sm text-stone-500 leading-normal">
            Submit an item to be verified and published across De La Salle Araneta University.
          </p>
        </div>
      </div>

      <!-- Close button -->
      <button
        type="button"
        id="close-report-modal"
        class="flex size-10 shrink-0 items-center justify-center rounded-full border border-line bg-stone-50 text-stone-500 hover:bg-forest-700 hover:text-white hover:border-forest-700 transition-all cursor-pointer shadow-2xs active:scale-95"
        aria-label="Close dialog"
      >
        <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Step 1: Type Selection Choice (Found vs Lost) -->
    <div class="mt-5">
      <span class="block text-xs font-bold uppercase tracking-wider text-forest-900/80 mb-2.5">
        Report Classification
      </span>
      <div class="grid grid-cols-2 gap-3 sm:gap-4">
        <button
          type="button"
          id="report-choice-found"
          class="group relative flex flex-col items-start rounded-2xl border-2 border-forest-700 bg-forest-700/[0.04] p-4 text-left transition-all hover:bg-forest-700/[0.07] cursor-pointer shadow-2xs active:scale-[0.98]"
        >
          <div class="flex w-full items-center justify-between">
            <span class="inline-flex items-center gap-1.5 rounded-full bg-forest-700 px-3 py-1 text-xs font-bold uppercase tracking-wider text-white shadow-2xs">
              <svg class="size-3 text-[#d8ef8c]" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
              Found
            </span>
            <span class="choice-check flex size-5.5 items-center justify-center rounded-full bg-forest-700 text-white shadow-2xs">
              <svg class="size-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            </span>
          </div>
          <span class="mt-3 text-sm sm:text-[0.9375rem] font-bold text-forest-900">I Found Something</span>
          <span class="mt-0.5 text-xs text-stone-500 leading-snug">
            Turned in or held at Security Office
          </span>
        </button>

        <button
          type="button"
          id="report-choice-lost"
          class="group relative flex flex-col items-start rounded-2xl border-2 border-line bg-white p-4 text-left transition-all hover:border-forest-700/60 hover:bg-[#f5f1e6]/40 cursor-pointer shadow-2xs active:scale-[0.98]"
        >
          <div class="flex w-full items-center justify-between">
            <span class="inline-flex items-center gap-1.5 rounded-full bg-[#d8ef8c] border border-lime-600/30 px-3 py-1 text-xs font-bold uppercase tracking-wider text-forest-900 shadow-2xs">
              <svg class="size-3 text-forest-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35m1.85-5.15a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
              Lost
            </span>
            <span class="choice-check hidden size-5.5 items-center justify-center rounded-full bg-forest-700 text-white shadow-2xs">
              <svg class="size-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            </span>
          </div>
          <span class="mt-3 text-sm sm:text-[0.9375rem] font-bold text-forest-900">I Lost Something</span>
          <span class="mt-0.5 text-xs text-stone-500 leading-snug">
            Broadcast request to campus
          </span>
        </button>
      </div>
    </div>

    <!-- Form Inputs -->
    <form
      id="quick-report-form"
      class="mt-5 space-y-4"
      onsubmit="event.preventDefault(); window.handleReportSubmit();"
    >
      <input type="hidden" id="report-type-val" value="found" />

      <!-- Item Name Field -->
      <div>
        <div class="flex items-center justify-between mb-1.5">
          <label for="report-name" class="text-xs font-bold uppercase tracking-wider text-forest-900">
            Item Name <span class="text-danger">*</span>
          </label>
          <span class="text-xs text-stone-400 font-medium">e.g. Wallet, Hydroflask, ID</span>
        </div>
        <div class="relative flex items-center">
          <input
            type="text"
            id="report-name"
            required
            placeholder="e.g. Green DLSAU ID Lace, Black Hydroflask..."
            class="w-full min-h-[3.25rem] rounded-control border border-line bg-white px-4 py-2.5 text-sm sm:text-[0.9375rem] font-medium text-forest-900 placeholder:text-stone-400 focus:border-forest-700 focus:ring-2 focus:ring-forest-700/20 transition-all shadow-2xs outline-none"
          />
        </div>
      </div>

      <!-- Category & Location Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
        <div>
          <label for="report-category" class="block text-xs font-bold uppercase tracking-wider text-forest-900 mb-1.5">
            Category <span class="text-danger">*</span>
          </label>
          <div class="relative flex items-center">
            <select
              id="report-category"
              required
              class="w-full min-h-[3.25rem] appearance-none rounded-control border border-line bg-white pl-4 pr-10 py-2.5 text-sm sm:text-[0.9375rem] font-medium text-forest-900 focus:border-forest-700 focus:ring-2 focus:ring-forest-700/20 transition-all shadow-2xs outline-none cursor-pointer"
            >
              <option value="" selected disabled>Select category</option>
              {CATEGORIES.filter((c) => c !== "All Categories").map((c) => (
                <option value={c}>{c}</option>
              ))}
            </select>
            <div class="pointer-events-none absolute right-3.5 text-stone-500">
              <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </div>
          </div>
        </div>

        <div>
          <label for="report-location" class="block text-xs font-bold uppercase tracking-wider text-forest-900 mb-1.5">
            Location <span class="text-danger">*</span>
          </label>
          <div class="relative flex items-center">
            <select
              id="report-location"
              required
              class="w-full min-h-[3.25rem] appearance-none rounded-control border border-line bg-white pl-4 pr-10 py-2.5 text-sm sm:text-[0.9375rem] font-medium text-forest-900 focus:border-forest-700 focus:ring-2 focus:ring-forest-700/20 transition-all shadow-2xs outline-none cursor-pointer"
            >
              <option value="" selected disabled>Select location</option>
              {presets.map((l) => (
                <option value={l}>{l}</option>
              ))}
              <option value="__other__">Other (type below)</option>
            </select>
            <div class="pointer-events-none absolute right-3.5 text-stone-500">
              <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </div>
          </div>
        </div>
      </div>

      <!-- Custom Location (Optional) -->
      <div id="report-location-other-wrap" class="hidden">
        <label for="report-location-other" class="block text-xs font-bold uppercase tracking-wider text-forest-900 mb-1.5">
          Custom Campus Location <span class="text-danger">*</span>
        </label>
        <input
          type="text"
          id="report-location-other"
          placeholder="e.g. Science Building Rm 302, Cafeteria Corner..."
          class="w-full min-h-[3.25rem] rounded-control border border-line bg-white px-4 py-2.5 text-sm font-medium text-forest-900 placeholder:text-stone-400 focus:border-forest-700 focus:ring-2 focus:ring-forest-700/20 transition-all shadow-2xs outline-none"
        />
      </div>

      <!-- Step 2: Photo Upload (1-3 images, required for Found, optional for Lost) -->
      <div class="rounded-2xl border border-line/80 bg-[#faf8f4] p-4 sm:p-5 space-y-3.5">
        <div class="flex items-center justify-between flex-wrap gap-2">
          <div class="flex items-center gap-2">
            <span class="flex size-7 items-center justify-center rounded-lg bg-forest-700/10 text-forest-700">
              <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </span>
            <label class="text-xs font-bold uppercase tracking-wider text-forest-900 mb-0" id="report-photos-label">
              Item Photos <span id="photo-req-star" class="text-danger">*</span>
            </label>
          </div>
          <span
            id="photo-req-badge"
            class="rounded-full bg-forest-700/10 px-3 py-1 text-xs font-bold text-forest-700"
          >
            1 required (max 3)
          </span>
        </div>
        
        <p id="photo-req-hint" class="text-xs text-stone-500 leading-relaxed">
          Upload clear photos so the owner can identify it. Compressed automatically for crisp, fast display.
        </p>

        <!-- Hidden Native File Input -->
        <input
          type="file"
          id="report-photos-input"
          accept="image/png, image/jpeg, image/jpg, image/webp"
          multiple
          class="hidden"
        />

        <!-- Clickable & Drag-and-Drop Dropzone -->
        <div
          id="photo-dropzone"
          role="button"
          tabindex="0"
          aria-label="Upload item photos"
          class="group relative flex flex-col items-center justify-center rounded-2xl border-2 border-dashed border-stone-300 bg-white p-6 text-center transition-all hover:border-forest-700 hover:bg-forest-700/[0.02] cursor-pointer focus:outline-none focus:ring-2 focus:ring-forest-700/20 shadow-2xs"
        >
          <div class="flex size-12 items-center justify-center rounded-full bg-forest-700/10 text-forest-700 group-hover:scale-110 group-hover:bg-forest-700 group-hover:text-white transition-all shadow-2xs">
            <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <p class="mt-3 text-sm font-bold text-forest-900 group-hover:text-forest-700 transition-colors">
            Click to upload or drag &amp; drop photos
          </p>
          <p class="mt-1 text-xs text-stone-500">
            PNG, JPG, WebP up to 5MB (1 to 3 images)
          </p>
        </div>

        <!-- Thumbnails Preview Grid -->
        <div id="photos-preview-grid" class="hidden grid grid-cols-3 gap-2.5 pt-1">
          <!-- Dynamically populated thumbnails with remove buttons -->
        </div>

        <!-- Status & Compression Info -->
        <div id="photos-status-bar" class="hidden flex items-center justify-between text-xs text-stone-500 font-medium">
          <span id="photos-count-indicator">0 of 3 photos attached</span>
          <span id="photos-compression-tag" class="text-forest-700 font-bold flex items-center gap-1">
            <svg class="size-3.5 inline text-forest-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            <span>Auto-compressed &bull; Cloud Storage</span>
          </span>
        </div>

        <!-- Validation Error Alert -->
        <div
          id="photo-validation-error"
          class="hidden rounded-xl border border-danger/30 bg-danger/10 p-3 text-xs font-bold text-danger flex items-center gap-2"
          role="alert"
        >
          <svg class="size-4 shrink-0 text-danger" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
          <span>Please add at least 1 photo for found items (up to 3 photos allowed).</span>
        </div>
      </div>

      <!-- Description Field -->
      <div>
        <div class="flex items-center justify-between mb-1.5">
          <label for="report-desc" class="text-xs font-bold uppercase tracking-wider text-forest-900">
            Description <span class="text-danger">*</span>
          </label>
          <span class="text-xs text-stone-400 font-medium">Min 10 characters</span>
        </div>
        <textarea
          id="report-desc"
          required
          rows="3"
          minlength="10"
          placeholder="Provide identifiable details, colors, or condition (e.g. keychains, brand, unique stickers)..."
          class="w-full rounded-control border border-line bg-white p-3.5 text-sm sm:text-[0.9375rem] font-medium text-forest-900 placeholder:text-stone-400 focus:border-forest-700 focus:ring-2 focus:ring-forest-700/20 transition-all shadow-2xs outline-none resize-none"
        ></textarea>
      </div>

      <!-- Modal Footer -->
      <div class="flex items-center justify-between gap-3 pt-4 border-t border-line/80">
        <p class="text-xs text-stone-500 font-medium hidden sm:block">
          All reports are verified by the Security Office
        </p>

        <div class="flex items-center justify-end gap-2.5 w-full sm:w-auto">
          <button
            type="button"
            id="cancel-report-btn"
            class="min-h-11 rounded-full px-5 py-2 text-sm font-bold text-stone-600 hover:text-forest-900 hover:bg-stone-100 cursor-pointer transition-all active:scale-95"
          >
            Cancel
          </button>
          <button
            type="submit"
            id="report-submit-btn"
            class="min-h-11 rounded-full bg-forest-700 hover:bg-forest-900 active:scale-95 text-white font-bold px-7 py-2.5 text-sm shadow-2xs transition-all flex items-center justify-center gap-2 cursor-pointer"
          >
            <span id="report-submit-btn-spinner" class="hidden size-4 animate-spin rounded-full border-2 border-white border-t-transparent"></span>
            <span id="report-submit-btn-text">Submit report</span>
            <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </button>
        </div>
      </div>
    </form>

    <div
      id="report-success-msg"
      class="hidden mt-4 rounded-2xl border border-emerald-600/30 bg-emerald-50/80 p-4 text-center text-sm font-semibold text-[#082e1a] shadow-xs"
    >
      <div class="flex items-center justify-center gap-2">
        <svg class="size-5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
        </svg>
        <span id="report-success-msg-text">
          Report submitted successfully! The Security Office will review your post.
        </span>
      </div>

      <!-- Reference code + copy button (revealed for Found items after a successful post) -->
      <div id="report-success-ref" class="hidden mt-3 pt-3 border-t border-emerald-600/25">
        <div class="flex items-center justify-center gap-1.5">
          <span class="text-[11px] font-bold uppercase tracking-wider text-emerald-800">Tag code</span>
          <span id="report-success-ref-code" class="font-mono text-lg font-black text-forest-900 tracking-wider">LL-0000</span>
          <button
            type="button"
            id="report-copy-ref-btn"
            data-ref=""
            class="copy-ref-btn"
            aria-label="Copy reference tag code"
            title="Copy code"
          >
            <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
            </svg>
            <span class="copy-label">Copy</span>
            <span class="copy-ref-tooltip">Copied!</span>
          </button>
        </div>
        <p class="mt-1.5 text-[11px] text-emerald-800 font-medium">Write this code on the item tag before turning it in.</p>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    // Custom location dropdown
    const locSelect = document.getElementById("report-location");
    const otherWrap = document.getElementById("report-location-other-wrap");
    const otherInput = document.getElementById("report-location-other");
    if (locSelect && otherWrap && otherInput) {
      locSelect.addEventListener("change", function () {
        const isOther = locSelect.value === "__other__";
        otherWrap.classList.toggle("hidden", !isOther);
        otherInput.required = isOther;
        if (!isOther) otherInput.value = "";
        if (isOther) otherInput.focus();
      });
    }

    // Photo Upload, Client Compression, Previews, and Limit (1-3 images)
    window.reportUploadedPhotos = [];

    const fileInput = document.getElementById("report-photos-input");
    const dropzone = document.getElementById("photo-dropzone");
    const previewGrid = document.getElementById("photos-preview-grid");
    const statusBar = document.getElementById("photos-status-bar");
    const countIndicator = document.getElementById("photos-count-indicator");
    const validationError = document.getElementById("photo-validation-error");

    if (!fileInput || !dropzone) return;

    dropzone.addEventListener("click", () => fileInput.click());
    dropzone.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        fileInput.click();
      }
    });

    // Drag and Drop
    ["dragenter", "dragover"].forEach((eventName) => {
      dropzone.addEventListener(eventName, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropzone.classList.add("border-forest-700", "bg-forest-700/10");
      });
    });

    ["dragleave", "drop"].forEach((eventName) => {
      dropzone.addEventListener(eventName, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropzone.classList.remove("border-forest-700", "bg-forest-700/10");
      });
    });

    dropzone.addEventListener("drop", (e) => {
      const files = e.dataTransfer?.files;
      if (files && files.length) handleSelectedFiles(Array.from(files));
    });

    fileInput.addEventListener("change", (e) => {
      const files = e.target.files;
      if (files && files.length) handleSelectedFiles(Array.from(files));
      fileInput.value = "";
    });

    // Compress image via HTML5 Canvas (max 1200px, JPEG 0.85)
    async function compressImage(file) {
      return new Promise((resolve, reject) => {
        if (!file.type.startsWith("image/")) {
          return reject(new Error("File is not an image"));
        }
        const reader = new FileReader();
        reader.onload = (readerEvent) => {
          const img = new Image();
          img.onload = () => {
            const maxDimension = 1200;
            let width = img.width;
            let height = img.height;

            if (width > maxDimension || height > maxDimension) {
              if (width > height) {
                height = Math.round((height * maxDimension) / width);
                width = maxDimension;
              } else {
                width = Math.round((width * maxDimension) / height);
                height = maxDimension;
              }
            }

            const canvas = document.createElement("canvas");
            canvas.width = width;
            canvas.height = height;
            const ctx = canvas.getContext("2d");
            if (!ctx) return resolve(readerEvent.target.result);

            ctx.drawImage(img, 0, 0, width, height);
            const compressedDataUrl = canvas.toDataURL("image/jpeg", 0.85);
            resolve(compressedDataUrl);
          };
          img.onerror = reject;
          img.src = readerEvent.target.result;
        };
        reader.onerror = reject;
        reader.readAsDataURL(file);
      });
    }

    async function handleSelectedFiles(files) {
      if (validationError) validationError.classList.add("hidden");

      const availableSlots = 3 - window.reportUploadedPhotos.length;
      if (availableSlots <= 0) {
        alert("You have already added the maximum of 3 photos.");
        return;
      }

      if (files.length > availableSlots) {
        alert(`You can only add up to 3 photos in total. Adding ${availableSlots} of your selected photos.`);
      }

      const filesToProcess = files.slice(0, availableSlots);

      for (const file of filesToProcess) {
        try {
          const compressedDataUrl = await compressImage(file);
          window.reportUploadedPhotos.push(compressedDataUrl);
        } catch (err) {
          console.error("Compression error:", err);
        }
      }

      renderPhotoPreviews();
    }

    function renderPhotoPreviews() {
      if (!previewGrid || !statusBar || !countIndicator) return;

      previewGrid.replaceChildren();
      const count = window.reportUploadedPhotos.length;

      if (count > 0) {
        previewGrid.classList.remove("hidden");
        statusBar.classList.remove("hidden");
        countIndicator.textContent = `${count} of 3 photos attached`;

        window.reportUploadedPhotos.forEach((dataUrl, index) => {
          const card = document.createElement("div");
          card.className = "relative aspect-square overflow-hidden rounded-2xl border border-stone-200/90 bg-[#f5f1e6] shadow-xs group";

          const img = document.createElement("img");
          img.src = dataUrl;
          img.alt = `Uploaded item photo ${index + 1}`;
          img.className = "h-full w-full object-cover";

          const removeBtn = document.createElement("button");
          removeBtn.type = "button";
          removeBtn.setAttribute("aria-label", `Remove photo ${index + 1}`);
          removeBtn.className = "absolute right-2 top-2 flex size-6.5 items-center justify-center rounded-full bg-[#9b2c1f] text-white shadow-md hover:scale-110 cursor-pointer text-xs font-bold transition-all active:scale-90";
          removeBtn.innerHTML = '<svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>';
          removeBtn.onclick = (e) => {
            e.stopPropagation();
            window.reportUploadedPhotos.splice(index, 1);
            renderPhotoPreviews();
          };

          const badge = document.createElement("span");
          badge.className = "absolute bottom-2 left-2 rounded-full bg-[#082e1a]/80 px-2 py-0.5 text-[10px] font-bold text-white backdrop-blur-xs";
          badge.textContent = `Photo ${index + 1}`;

          card.appendChild(img);
          card.appendChild(removeBtn);
          card.appendChild(badge);
          previewGrid.appendChild(card);
        });

        // Toggle dropzone if 3 photos reached
        if (count >= 3) {
          dropzone.classList.add("hidden");
        } else {
          dropzone.classList.remove("hidden");
        }
      } else {
        previewGrid.classList.add("hidden");
        statusBar.classList.add("hidden");
        dropzone.classList.remove("hidden");
      }
    }

    window.resetReportPhotos = function () {
      window.reportUploadedPhotos = [];
      renderPhotoPreviews();
      if (validationError) validationError.classList.add("hidden");
    };
  })();
</script>
