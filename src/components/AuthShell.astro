---
import Background from "./Background.astro";
import BrandHeader from "./BrandHeader.astro";
import TrustBadges from "./TrustBadges.astro";
import Base from "~/layouts/Base.astro";

/** Shared page frame for every auth screen: header, quote, card. */
interface Props {
  title: string;
  heading: string;
  description?: string;
}

const { title, heading, description } = Astro.props;
---

<Base title={title} description={description}>
  <main class="relative flex min-h-dvh flex-col">
    <Background />

    <div
      class="relative mx-auto flex w-full max-w-[1240px] flex-1 flex-col px-5 py-6 sm:px-8 sm:py-8"
    >
      <BrandHeader />

      <div
        class="flex flex-1 flex-col items-center justify-center gap-10 py-8 lg:grid lg:grid-cols-12 lg:items-center lg:gap-6 lg:py-6"
      >
        <div class="hidden lg:col-span-5 lg:block lg:self-center">
          <p class="font-serif text-[3.8rem] leading-[1.12] tracking-[-0.02em] text-forest-900 xl:text-[4.4rem]">
            <span class="text-forest-700">&ldquo;</span><span class="font-bold">Lost <span
              class="text-forest-600 font-normal italic">things</span></span><br />
            their way<br />
            <span class="font-bold">back</span> <span class="text-forest-700">&rdquo;</span>
          </p>
          <p class="mt-8 flex items-center gap-3.5 text-sage-700">
            <span class="h-0.5 w-16 bg-sage-400"></span>
            <span class="text-lg font-semibold tracking-wide text-forest-900/90">LostLink &middot; DLSAU</span>
          </p>
        </div>

        <section
          class="w-full max-w-[34rem] rounded-[2rem] bg-card-tint px-8 py-10 shadow-card sm:px-12 sm:py-12 lg:col-span-7 lg:justify-self-start xl:col-span-6 xl:max-w-[36rem]"
          aria-labelledby="auth-title"
        >
          <h1
            id="auth-title"
            class="text-center text-[1.85rem] font-bold tracking-[0.08em] text-forest-900"
          >
            {heading}
          </h1>
          <slot />
        </section>
      </div>

      <TrustBadges />
    </div>
  </main>
</Base>