---
import BrandHeader from "./BrandHeader.astro";
import SiteFooter from "./SiteFooter.astro";
import Base from "~/layouts/Base.astro";

/** Shared page frame for every auth screen: header, green panel, white card, footer. */
interface Props {
  title: string;
  heading: string;
  subheading?: string;
  description?: string;
}

const { title, heading, subheading, description } = Astro.props;

/** Rotating stories in the lime callout. First entry is the brand tagline;
    the rest are short campus stories that give it a human payoff. */
const stories = [
  { text: "A little thing,<br>can mean a lot.", name: null },
  {
    text: "Got my ID back in 20 minutes.",
    name: "Andrew Cruz, 3rd year Computer Science",
  },
  {
    text: "Returned a laptop I found at the canteen.",
    name: "Justin Miguel Encarnado, 3rd year Computer Science",
  },
];
---

<Base title={title} description={description}>
  <div class="flex min-h-dvh flex-col bg-canvas px-4 sm:px-10 lg:px-14">
    <header class="flex items-center justify-between gap-4 border-b border-line py-5 sm:py-6">
      <BrandHeader />
      <div class="flex items-center gap-5">
        <p class="hidden text-sm font-medium tracking-wide text-forest-700 uppercase md:block">
          DLSAU Campus Community
        </p>
        <a href="/help" class="help-pill">Need help?</a>
      </div>
    </header>

    <main class="grid flex-1 gap-5 py-6 lg:grid-cols-2 lg:gap-8 lg:py-8">
      <aside
        class="relative hidden flex-col justify-between overflow-hidden rounded-card p-9 text-white lg:flex xl:p-10 border border-white/10 shadow-card bg-forest-700"
      >
        <!-- Subtle animated organic wave layers -->
        <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 bottom-0 h-44 overflow-hidden select-none opacity-20">
          <svg class="animate-wave-slow absolute -bottom-1 left-0 w-[200%] h-36 text-lime" viewBox="0 0 1200 120" preserveAspectRatio="none" fill="currentColor">
            <path d="M0,40 C150,95 350,10 500,60 C650,110 900,20 1200,50 L1200,120 L0,120 Z"></path>
          </svg>
          <svg class="animate-wave-reverse absolute -bottom-1 left-0 w-[200%] h-32 text-white opacity-40" viewBox="0 0 1200 120" preserveAspectRatio="none" fill="currentColor">
            <path d="M0,20 C200,80 400,-10 600,45 C800,100 1000,15 1200,35 L1200,120 L0,120 Z"></path>
          </svg>
        </div>

        <div class="relative flex items-start justify-between">
          <span class="rounded-full border border-white/25 bg-white/[0.04] px-4 py-1.5 text-sm font-medium tracking-wide text-white/90">
            DLSAU &middot; Lost &amp; Found
          </span>
        </div>

        <p
          class="relative font-serif text-[clamp(2.5rem,4.2vw,4rem)] leading-[1.12] font-normal tracking-tight text-white"
        >
          Find what<br />
          <span class="font-bold text-lime">you Lost.</span><br />
          Return what<br />
          <span class="font-bold text-lime">you Found.</span>
        </p>

        <div
          class="relative overflow-hidden rounded-2xl bg-lime px-7 py-6 sm:px-8 sm:py-7 border border-lime-600/20 shadow-xs"
          data-story-carousel
        >
          <!-- Subtle animated wave inside callout card -->
          <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 bottom-0 h-16 overflow-hidden select-none opacity-15">
            <svg class="animate-wave-slow absolute -bottom-1 left-0 w-[200%] h-14 text-forest-900" viewBox="0 0 1200 120" preserveAspectRatio="none" fill="currentColor">
              <path d="M0,40 C150,95 350,10 500,60 C650,110 900,20 1200,50 L1200,120 L0,120 Z"></path>
            </svg>
          </div>
          <div class="grid">
            {
              stories.map((story, i) => (
                <div
                  class:list={["story-slide", i === 0 && "is-active"]}
                  data-story-slide
                  aria-hidden={i === 0 ? "false" : "true"}
                >
                  <p class="text-xl sm:text-2xl leading-snug font-bold text-forest-900 xl:text-[1.625rem]">
                    <span set:html={story.text} />
                  </p>
                  {story.name && (
                    <p class="mt-2 text-sm font-semibold leading-snug text-forest-900/70">
                      &mdash; {story.name}
                    </p>
                  )}
                </div>
              ))
            }
          </div>
          <div class="mt-4 flex items-center gap-2" aria-label="Campus stories">
            {
              stories.map((_, i) => (
                <button
                  type="button"
                  class="story-dot"
                  data-story-dot={i}
                  aria-current={i === 0 ? "true" : "false"}
                  aria-label={`Show story ${i + 1}`}
                />
              ))
            }
          </div>
        </div>
      </aside>

      <section
        class="flex flex-col justify-center rounded-card border border-line/70 bg-white px-6 py-8 shadow-card sm:px-10 sm:py-10 xl:px-11"
        aria-labelledby="auth-title"
      >
        <h1
          id="auth-title"
          class="font-serif text-[clamp(2rem,3.2vw,2.75rem)] leading-[1.1] font-black text-ink"
        >
          {heading}
        </h1>
        {subheading && <p class="mt-3 text-[1.0625rem] text-sage-600">{subheading}</p>}
        <slot />
      </section>
    </main>

    <SiteFooter />
  </div>

  <script>
    // @ts-nocheck -- legacy DOM script, migrated out of is:inline for CSP.
    (function () {
      var root = document.querySelector("[data-story-carousel]");
      if (!root) return;
      var slides = Array.prototype.slice.call(root.querySelectorAll("[data-story-slide]"));
      var dots = Array.prototype.slice.call(root.querySelectorAll("[data-story-dot]"));
      if (slides.length < 2) return;

      var index = 0;
      var timer = null;
      var paused = false;
      var INTERVAL = 4500;

      var reduceMotion = false;
      try {
        reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      } catch (e) {}

      function show(i) {
        index = (i + slides.length) % slides.length;
        slides.forEach(function (slide, n) {
          var active = n === index;
          slide.classList.toggle("is-active", active);
          slide.setAttribute("aria-hidden", active ? "false" : "true");
        });
        dots.forEach(function (dot, n) {
          dot.setAttribute("aria-current", n === index ? "true" : "false");
        });
      }

      function tick() {
        if (!paused) show(index + 1);
      }

      function start() {
        if (reduceMotion || timer) return;
        timer = setInterval(tick, INTERVAL);
      }
      function stop() {
        if (timer) { clearInterval(timer); timer = null; }
      }

      dots.forEach(function (dot, n) {
        dot.addEventListener("click", function () {
          show(n);
          // Nudge the interval so a click doesn't immediately get overridden.
          stop();
          start();
        });
      });

      // Pause while the user is hovering / focused, so they can read a story.
      root.addEventListener("mouseenter", function () { paused = true; });
      root.addEventListener("mouseleave", function () { paused = false; });
      root.addEventListener("focusin", function () { paused = true; });
      root.addEventListener("focusout", function () { paused = false; });

      // Only auto-rotate for users who haven't asked for reduced motion.
      if (!reduceMotion) start();
    })();
  </script>

</Base>
