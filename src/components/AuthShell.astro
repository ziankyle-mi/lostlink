---
import BrandHeader from "./BrandHeader.astro";
import SiteFooter from "./SiteFooter.astro";
import Base from "~/layouts/Base.astro";

/** Shared page frame for every auth screen: header, green panel, white card, footer. */
interface Props {
  title: string;
  heading: string;
  subheading?: string;
  description?: string;
}

const { title, heading, subheading, description } = Astro.props;
---

<Base title={title} description={description}>
  <div class="flex min-h-dvh flex-col bg-canvas px-4 sm:px-10 lg:px-14">
    <header class="flex items-center justify-between gap-4 border-b border-line py-5 sm:py-6">
      <BrandHeader />
      <div class="flex items-center gap-5">
        <p class="hidden text-[0.8125rem] font-medium tracking-wide text-forest-700 uppercase md:block">
          DLSAU Campus Community
        </p>
        <a href="/help" class="help-pill">Need Help?</a>
      </div>
    </header>

    <main class="grid flex-1 gap-5 py-6 lg:grid-cols-2 lg:gap-8 lg:py-8">
      <aside
        class="relative hidden flex-col justify-between overflow-hidden rounded-[2.25rem] p-9 text-white lg:flex xl:p-10 border border-white/10 shadow-[inset_0_1px_1px_rgba(255,255,255,0.12),0_20px_45px_-15px_rgba(8,46,26,0.35)]"
        style="background: radial-gradient(130% 120% at 85% 25%, #246a48 0%, #164f38 42%, #0d3222 100%);"
      >
        <!-- Subtle organic ambient glow (really soft and diffused) -->
        <div aria-hidden="true" class="pointer-events-none absolute inset-0 overflow-hidden">
          <div
            class="absolute -right-16 -top-16 size-[28rem] rounded-full opacity-35 blur-3xl"
            style="background: radial-gradient(circle, rgba(216, 239, 140, 0.3) 0%, rgba(38, 106, 72, 0.4) 45%, transparent 70%);"
          >
          </div>
          <div
            class="absolute -right-10 top-1/2 size-[22rem] -translate-y-1/2 rounded-full opacity-20 blur-2xl"
            style="background: radial-gradient(circle, rgba(163, 219, 142, 0.25) 0%, transparent 70%);"
          >
          </div>
          <!-- Dotted trail: same lime as the glows, arcs from above the badge into the light behind the headline -->
          <svg class="absolute inset-0 h-full w-full" viewBox="0 0 1000 800" preserveAspectRatio="none" fill="none">
            <path
              d="M 400 -40 C 520 120 760 90 860 240 C 900 300 880 350 800 380"
              stroke="#d8ef8c"
              stroke-opacity="0.5"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-dasharray="0.01 16"
              vector-effect="non-scaling-stroke"
            >
            </path>
          </svg>
          <!-- Terminal marker where the trail lands in the glow -->
          <span class="absolute left-[80%] top-[47.5%] -translate-x-1/2 -translate-y-1/2">
            <span
              class="block size-2 rounded-full bg-[#d8ef8c] shadow-[0_0_14px_4px_rgba(216,239,140,0.35)]"
            >
            </span>
          </span>
        </div>

        <div class="relative flex items-start justify-between">
          <span class="rounded-full border border-white/25 bg-white/[0.04] px-4 py-1.5 text-xs sm:text-[0.875rem] font-medium tracking-wide text-white/90">
            DLSAU &middot; Lost &amp; Found
          </span>
        </div>

        <p
          class="relative font-serif text-[clamp(2.5rem,4.2vw,4rem)] leading-[1.12] font-normal tracking-tight text-white"
        >
          Find what<br />
          <span class="font-bold text-[#d8ef8c]">you Lost.</span><br />
          Return what<br />
          <span class="font-bold text-[#d8ef8c]">you Found.</span>
        </p>

        <div class="relative rounded-2xl bg-[#d8ef8c] px-7 py-6 sm:px-8 sm:py-7 border border-lime-500/20 shadow-xs">
          <p class="text-xl sm:text-2xl leading-snug font-bold text-forest-900 xl:text-[1.625rem]">
            A little thing,<br />can mean a lot.
          </p>
        </div>
      </aside>

      <section
        class="flex flex-col justify-center rounded-card border border-line/70 bg-white px-6 py-8 shadow-card sm:px-10 sm:py-10 xl:px-11"
        aria-labelledby="auth-title"
      >
        <h1
          id="auth-title"
          class="font-serif text-[clamp(2rem,3.2vw,2.75rem)] leading-[1.1] font-black text-ink"
        >
          {heading}
        </h1>
        {subheading && <p class="mt-3 text-[1.0625rem] text-sage-600">{subheading}</p>}
        <slot />
      </section>
    </main>

    <SiteFooter />
  </div>
</Base>
