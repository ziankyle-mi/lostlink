---
import BrandHeader from "./BrandHeader.astro";
import SiteFooter from "./SiteFooter.astro";
import Base from "~/layouts/Base.astro";

/** Shared page frame for every auth screen: header, green panel, white card, footer. */
interface Props {
  title: string;
  heading: string;
  subheading?: string;
  description?: string;
}

const { title, heading, subheading, description } = Astro.props;

/** Rotating stories in the lime callout. First entry is the brand tagline;
    the rest are short campus stories that give it a human payoff. */
const stories = [
  { text: "A little thing,<br>can mean a lot.", name: null },
  {
    text: "Got my ID back in 20 minutes.",
    name: "Andrew Cruz, 3rd year Computer Science",
  },
  {
    text: "Returned a laptop I found at the canteen.",
    name: "Justin Miguel Encarnado, 3rd year Computer Science",
  },
];
---

<Base title={title} description={description}>
  <div class="flex min-h-dvh flex-col bg-canvas px-4 sm:px-10 lg:px-14">
    <header class="flex items-center justify-between gap-4 border-b border-line py-5 sm:py-6">
      <BrandHeader />
      <div class="flex items-center gap-5">
        <p class="hidden text-[0.8125rem] font-medium tracking-wide text-forest-700 uppercase md:block">
          DLSAU Campus Community
        </p>
        <a href="/help" class="help-pill">Need Help?</a>
      </div>
    </header>

    <main class="grid flex-1 gap-5 py-6 lg:grid-cols-2 lg:gap-8 lg:py-8">
      <aside
        class="relative hidden flex-col justify-between overflow-hidden rounded-[2.25rem] p-9 text-white lg:flex xl:p-10 border border-white/10 shadow-[inset_0_1px_1px_rgba(255,255,255,0.12),0_20px_45px_-15px_rgba(8,46,26,0.35)]"
        style="background: radial-gradient(130% 120% at 85% 25%, #246a48 0%, #164f38 42%, #0d3222 100%);"
      >
        <!-- Subtle organic ambient glow (really soft and diffused) -->
        <div aria-hidden="true" class="pointer-events-none absolute inset-0 overflow-hidden">
          <div
            class="absolute -right-16 -top-16 size-[28rem] rounded-full opacity-35 blur-3xl"
            style="background: radial-gradient(circle, rgba(216, 239, 140, 0.3) 0%, rgba(38, 106, 72, 0.4) 45%, transparent 70%);"
          >
          </div>
          <div
            class="absolute -right-10 top-1/2 size-[22rem] -translate-y-1/2 rounded-full opacity-20 blur-2xl"
            style="background: radial-gradient(circle, rgba(163, 219, 142, 0.25) 0%, transparent 70%);"
          >
          </div>
          <!-- Dotted trail: same lime as the glows, arcs from above the badge into the light behind the headline -->
          <svg class="absolute inset-0 h-full w-full" viewBox="0 0 1000 800" preserveAspectRatio="none" fill="none">
            <path
              d="M 400 -40 C 520 120 760 90 860 240 C 900 300 880 350 800 380"
              stroke="#d8ef8c"
              stroke-opacity="0.5"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-dasharray="0.01 16"
              vector-effect="non-scaling-stroke"
            >
            </path>
          </svg>
          <!-- Terminal marker where the trail lands in the glow -->
          <span class="absolute left-[80%] top-[47.5%] -translate-x-1/2 -translate-y-1/2">
            <span
              class="block size-2 rounded-full bg-[#d8ef8c] shadow-[0_0_14px_4px_rgba(216,239,140,0.35)]"
            >
            </span>
          </span>
        </div>

        <!-- Flowing Organic SVG Waves (Multi-layered, floating translucent background animation) -->
        <div class="card-wave-container pointer-events-none absolute inset-0 overflow-hidden z-0" aria-hidden="true">
          <!-- Back Wave Layer: Deep Forest Ambient Drift -->
          <div class="card-wave card-wave-back">
            <svg viewBox="0 0 1600 450" fill="none" preserveAspectRatio="none" class="h-full w-full">
              <defs>
                <linearGradient id="wave-grad-back" x1="0%" y1="0%" x2="100%" y2="80%">
                  <stop offset="0%" stop-color="#2a7a53" stop-opacity="0.32" />
                  <stop offset="40%" stop-color="#164f38" stop-opacity="0.22" />
                  <stop offset="85%" stop-color="#0d3222" stop-opacity="0.12" />
                  <stop offset="100%" stop-color="#082216" stop-opacity="0.04" />
                </linearGradient>
              </defs>
              <path
                d="M 0,170 C 240,90 480,240 720,160 C 960,80 1200,230 1440,150 C 1540,110 1600,130 1600,130 L 1600,450 L 0,450 Z"
                fill="url(#wave-grad-back)"
              />
            </svg>
          </div>

          <!-- Mid Wave Layer: Luminous Emerald & Lime Float -->
          <div class="card-wave card-wave-mid">
            <svg viewBox="0 0 1600 450" fill="none" preserveAspectRatio="none" class="h-full w-full">
              <defs>
                <linearGradient id="wave-grad-mid" x1="0%" y1="0%" x2="100%" y2="60%">
                  <stop offset="0%" stop-color="#d8ef8c" stop-opacity="0.18" />
                  <stop offset="35%" stop-color="#3fa76e" stop-opacity="0.16" />
                  <stop offset="75%" stop-color="#164f38" stop-opacity="0.08" />
                  <stop offset="100%" stop-color="#d8ef8c" stop-opacity="0.04" />
                </linearGradient>
              </defs>
              <path
                d="M 0,220 C 220,300 460,150 700,230 C 940,310 1180,170 1420,240 C 1520,270 1600,225 1600,225 L 1600,450 L 0,450 Z"
                fill="url(#wave-grad-mid)"
              />
            </svg>
          </div>

          <!-- Front Wave Layer: Radiant Lime Crest Ribbon with Subtle Edge Glow -->
          <div class="card-wave card-wave-front">
            <svg viewBox="0 0 1600 450" fill="none" preserveAspectRatio="none" class="h-full w-full">
              <defs>
                <linearGradient id="wave-crest-stroke" x1="0%" y1="0%" x2="100%" y2="0%">
                  <stop offset="0%" stop-color="#d8ef8c" stop-opacity="0.06" />
                  <stop offset="25%" stop-color="#d8ef8c" stop-opacity="0.45" />
                  <stop offset="55%" stop-color="#bfe880" stop-opacity="0.6" />
                  <stop offset="85%" stop-color="#d8ef8c" stop-opacity="0.3" />
                  <stop offset="100%" stop-color="#d8ef8c" stop-opacity="0.05" />
                </linearGradient>
                <linearGradient id="wave-grad-front" x1="0%" y1="0%" x2="0%" y2="100%">
                  <stop offset="0%" stop-color="#d8ef8c" stop-opacity="0.12" />
                  <stop offset="30%" stop-color="#246a48" stop-opacity="0.06" />
                  <stop offset="100%" stop-color="#0d3222" stop-opacity="0" />
                </linearGradient>
              </defs>
              <path
                d="M 0,270 C 260,200 520,330 780,250 C 1040,170 1300,310 1560,230 C 1600,220 1600,220 1600,220 L 1600,450 L 0,450 Z"
                fill="url(#wave-grad-front)"
              />
              <path
                d="M 0,270 C 260,200 520,330 780,250 C 1040,170 1300,310 1560,230 C 1600,220 1600,220 1600,220"
                stroke="url(#wave-crest-stroke)"
                stroke-width="2.5"
                stroke-linecap="round"
              />
            </svg>
          </div>
        </div>

        <div class="relative z-10 flex items-start justify-between">
          <span class="rounded-full border border-white/25 bg-white/[0.04] px-4 py-1.5 text-xs sm:text-[0.875rem] font-medium tracking-wide text-white/90">
            DLSAU &middot; Lost &amp; Found
          </span>
        </div>

        <p
          class="relative z-10 font-serif text-[clamp(2.5rem,4.2vw,4rem)] leading-[1.12] font-normal tracking-tight text-white"
        >
          Find what<br />
          <span class="font-bold text-[#d8ef8c]">you Lost.</span><br />
          Return what<br />
          <span class="font-bold text-[#d8ef8c]">you Found.</span>
        </p>

        <div
          class="relative z-10 rounded-2xl bg-[#d8ef8c] px-7 py-6 sm:px-8 sm:py-7 border border-lime-500/20 shadow-xs"
          data-story-carousel
        >
          <div class="grid">
            {
              stories.map((story, i) => (
                <div
                  class:list={["story-slide", i === 0 && "is-active"]}
                  data-story-slide
                  aria-hidden={i === 0 ? "false" : "true"}
                >
                  <p class="text-xl sm:text-2xl leading-snug font-bold text-forest-900 xl:text-[1.625rem]">
                    <span set:html={story.text} />
                  </p>
                  {story.name && (
                    <p class="mt-2 text-[0.8125rem] font-semibold leading-snug text-forest-900/70">
                      &mdash; {story.name}
                    </p>
                  )}
                </div>
              ))
            }
          </div>
          <div class="mt-4 flex items-center gap-2" aria-label="Campus stories">
            {
              stories.map((_, i) => (
                <button
                  type="button"
                  class="story-dot"
                  data-story-dot={i}
                  aria-current={i === 0 ? "true" : "false"}
                  aria-label={`Show story ${i + 1}`}
                />
              ))
            }
          </div>
        </div>
      </aside>

      <section
        class="flex flex-col justify-center rounded-card border border-line/70 bg-white px-6 py-8 shadow-card sm:px-10 sm:py-10 xl:px-11"
        aria-labelledby="auth-title"
      >
        <h1
          id="auth-title"
          class="font-serif text-[clamp(2rem,3.2vw,2.75rem)] leading-[1.1] font-black text-ink"
        >
          {heading}
        </h1>
        {subheading && <p class="mt-3 text-[1.0625rem] text-sage-600">{subheading}</p>}
        <slot />
      </section>
    </main>

    <SiteFooter />
  </div>

  <script is:inline>
    (function () {
      var root = document.querySelector("[data-story-carousel]");
      if (!root) return;
      var slides = Array.prototype.slice.call(root.querySelectorAll("[data-story-slide]"));
      var dots = Array.prototype.slice.call(root.querySelectorAll("[data-story-dot]"));
      if (slides.length < 2) return;

      var index = 0;
      var timer = null;
      var paused = false;
      var INTERVAL = 4500;

      var reduceMotion = false;
      try {
        reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      } catch (e) {}

      function show(i) {
        index = (i + slides.length) % slides.length;
        slides.forEach(function (slide, n) {
          var active = n === index;
          slide.classList.toggle("is-active", active);
          slide.setAttribute("aria-hidden", active ? "false" : "true");
        });
        dots.forEach(function (dot, n) {
          dot.setAttribute("aria-current", n === index ? "true" : "false");
        });
      }

      function tick() {
        if (!paused) show(index + 1);
      }

      function start() {
        if (reduceMotion || timer) return;
        timer = setInterval(tick, INTERVAL);
      }
      function stop() {
        if (timer) { clearInterval(timer); timer = null; }
      }

      dots.forEach(function (dot, n) {
        dot.addEventListener("click", function () {
          show(n);
          // Nudge the interval so a click doesn't immediately get overridden.
          stop();
          start();
        });
      });

      // Pause while the user is hovering / focused, so they can read a story.
      root.addEventListener("mouseenter", function () { paused = true; });
      root.addEventListener("mouseleave", function () { paused = false; });
      root.addEventListener("focusin", function () { paused = true; });
      root.addEventListener("focusout", function () { paused = false; });

      // Only auto-rotate for users who haven't asked for reduced motion.
      if (!reduceMotion) start();
    })();
  </script>

  <style>
    .card-wave-container {
      position: absolute;
      inset: 0;
      overflow: hidden;
      pointer-events: none;
      border-radius: inherit;
    }

    .card-wave {
      position: absolute;
      bottom: -10%;
      left: -20%;
      width: 140%;
      height: 72%;
      will-change: transform;
      mix-blend-mode: screen;
      pointer-events: none;
    }

    .card-wave-back {
      animation: waveDriftBack 20s cubic-bezier(0.45, 0.05, 0.55, 0.95) infinite alternate;
    }

    .card-wave-mid {
      animation: waveDriftMid 15s cubic-bezier(0.42, 0, 0.58, 1) infinite alternate;
      opacity: 0.9;
    }

    .card-wave-front {
      animation: waveDriftFront 11s cubic-bezier(0.4, 0, 0.2, 1) infinite alternate;
      opacity: 0.95;
      filter: drop-shadow(0 0 10px rgba(216, 239, 140, 0.25));
    }

    @keyframes waveDriftBack {
      0% {
        transform: translate3d(0, 0, 0) scale(1, 1) rotate(0deg);
      }
      50% {
        transform: translate3d(-6%, -16px, 0) scale(1.04, 1.08) rotate(1deg);
      }
      100% {
        transform: translate3d(4%, -6px, 0) scale(0.97, 0.96) rotate(-0.8deg);
      }
    }

    @keyframes waveDriftMid {
      0% {
        transform: translate3d(4%, 0, 0) scale(1.02, 0.96) rotate(-1deg);
      }
      50% {
        transform: translate3d(-5%, -12px, 0) scale(0.97, 1.05) rotate(0.8deg);
      }
      100% {
        transform: translate3d(-7%, 8px, 0) scale(1.03, 1.01) rotate(-0.4deg);
      }
    }

    @keyframes waveDriftFront {
      0% {
        transform: translate3d(-3%, 4px, 0) scale(1, 1);
      }
      50% {
        transform: translate3d(5%, -14px, 0) scale(1.03, 1.06);
      }
      100% {
        transform: translate3d(-5%, -4px, 0) scale(0.98, 0.97);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .card-wave-back,
      .card-wave-mid,
      .card-wave-front {
        animation: none !important;
      }
    }
  </style>
</Base>
