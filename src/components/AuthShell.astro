---
import Background from "./Background.astro";
import BrandHeader from "./BrandHeader.astro";
import TrustBadges from "./TrustBadges.astro";
import Base from "~/layouts/Base.astro";

/** Shared page frame for every auth screen: header, quote, card. */
interface Props {
  title: string;
  heading: string;
  description?: string;
}

const { title, heading, description } = Astro.props;
---

<Base title={title} description={description}>
  <main class="relative flex min-h-dvh flex-col">
    <Background />

    <div
      class="relative flex w-full flex-1 flex-col px-6 py-6 sm:px-12 sm:py-8 lg:px-16"
    >
      <div class="w-full">
        <BrandHeader />
      </div>

      <div
        class="flex flex-1 flex-col items-center justify-center gap-12 py-10 md:grid md:grid-cols-2 md:items-center md:gap-8 md:py-6"
      >
        <div class="hidden max-w-xl md:block md:self-end md:pb-20">
          <p class="font-serif text-[3.4rem] leading-[1.15] tracking-[-0.015em] text-forest-900 sm:text-[3.8rem]">
            <span class="text-forest-700">&ldquo;</span><span class="font-bold">Lost <span
              class="text-forest-600 font-normal italic">things</span></span><br />
            their way<br />
            <span class="font-bold">back</span> <span class="text-forest-700">&rdquo;</span>
          </p>
          <p class="mt-7 flex items-center gap-3.5 text-sage-700">
            <span class="h-px w-14 bg-sage-400"></span>
            <span class="text-base font-medium tracking-wide text-forest-900/90">LostLink &middot; DLSAU</span>
          </p>
        </div>

        <section
          class="w-full max-w-[40rem] justify-self-center rounded-[1.75rem] bg-card-tint px-7 py-11 shadow-card sm:px-14 sm:py-14"
          aria-labelledby="auth-title"
        >
          <h1
            id="auth-title"
            class="text-center text-[1.85rem] font-bold tracking-[0.08em] text-forest-900"
          >
            {heading}
          </h1>
          <slot />
        </section>
      </div>

      <TrustBadges />
    </div>
  </main>
</Base>