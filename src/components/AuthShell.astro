---
import Background from "./Background.astro";
import BrandHeader from "./BrandHeader.astro";
import TrustBadges from "./TrustBadges.astro";
import Base from "~/layouts/Base.astro";

/** Shared page frame for every auth screen: header, quote, card. */
interface Props {
  title: string;
  heading: string;
  description?: string;
}

const { title, heading, description } = Astro.props;
---

<Base title={title} description={description}>
  <main class="relative flex min-h-dvh flex-col">
    <Background />

    <div
      class="relative mx-auto flex w-full max-w-[1440px] flex-1 flex-col px-5 py-7 sm:px-10 sm:py-10"
    >
      <BrandHeader />

      <div
        class="flex flex-1 flex-col items-center justify-center gap-14 py-12 md:grid md:grid-cols-2 md:items-center md:gap-10 md:py-8"
      >
        <div class="hidden max-w-xl md:block md:self-end md:pb-20">
          <p class="font-serif text-[3.1rem] leading-[1.18] tracking-[-0.015em] text-forest-900 sm:text-[3.5rem]">
            <span class="text-forest-700">&ldquo;</span><span class="font-bold">Lost <span
              class="text-forest-600 font-normal italic">things</span></span><br />
            their way<br />
            <span class="font-bold">back</span> <span class="text-forest-700">&rdquo;</span>
          </p>
          <p class="mt-7 flex items-center gap-3 text-sage-700">
            <span class="h-px w-14 bg-sage-400"></span>
            <span class="text-base font-medium tracking-wide">LostLink &middot; DLSAU</span>
          </p>
        </div>

        <section
          class="w-full max-w-[40rem] justify-self-center rounded-[1.75rem] bg-card-tint px-7 py-11 shadow-card sm:px-14 sm:py-14"
          aria-labelledby="auth-title"
        >
          <h1
            id="auth-title"
            class="text-center text-[1.75rem] font-medium tracking-[0.06em] text-ink"
          >
            {heading}
          </h1>
          <slot />
        </section>
      </div>

      <TrustBadges />
    </div>
  </main>
</Base>