---
interface Props {
  isAdmin?: boolean;
}

const { isAdmin = false } = Astro.props;
---

<div
  id="claim-modal-backdrop"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/45 backdrop-blur-xs p-4 sm:p-6"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-item-title"
  data-is-admin={isAdmin ? "true" : "false"}
>
  <div class="relative w-full max-w-xl max-h-[90dvh] overflow-y-auto rounded-card border border-line bg-white p-6 shadow-2xl sm:p-8">
    <!-- Close button -->
    <button
      type="button"
      id="close-claim-modal"
      class="absolute right-6 top-6 flex size-10 items-center justify-center rounded-full text-stone-400 hover:bg-stone-100 hover:text-stone-700 cursor-pointer"
      aria-label="Close dialog"
    >
      <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <!-- Modal Content -->
    <div class="flex items-center gap-3">
      <span
        id="modal-type-badge"
        class="rounded-full px-3 py-1 text-xs font-bold uppercase tracking-wider bg-forest-700 text-white"
      >
        FOUND
      </span>
      <span id="modal-category" class="text-sm font-bold text-stone-500 uppercase tracking-wide">
        Category
      </span>
    </div>

    <h3 id="modal-item-title" class="mt-3 font-serif text-2xl sm:text-3xl font-black text-forest-900 leading-tight">
      Item Name
    </h3>

    <!-- Item Photos Gallery (if available) -->
    <div id="modal-images-container" class="mt-4 hidden">
      <div id="modal-images-gallery" class="flex gap-2.5 overflow-x-auto pb-1 no-scrollbar">
        <!-- Dynamically populated thumbnails -->
      </div>
      <p class="mt-1 text-xs text-stone-400">Click a photo to zoom in.</p>
    </div>

    <div class="mt-4 grid grid-cols-2 gap-3.5 rounded-2xl bg-[#f5f1e6]/80 p-4 text-sm">
      <div>
        <span class="block text-xs text-stone-400 font-medium">Location</span>
        <span id="modal-location" class="font-bold text-forest-900 mt-0.5 block">Library, 2F</span>
      </div>
      <div>
        <span class="block text-xs text-stone-400 font-medium">Date Reported</span>
        <span id="modal-date" class="font-bold text-forest-900 mt-0.5 block">Oct 9</span>
      </div>
      <div id="modal-ref-container">
        <span class="block text-xs text-stone-400 font-medium">Reference Code</span>
        <div class="flex items-center gap-1.5 mt-0.5">
          <span id="modal-ref-code" class="font-mono font-bold text-forest-700 block">LL-4821</span>
          <button
            type="button"
            id="modal-copy-ref-btn"
            class="copy-ref-btn"
            title="Copy reference code"
            aria-label="Copy reference code"
          >
            <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
            </svg>
            <span class="copy-ref-tooltip">Copied!</span>
          </button>
        </div>
      </div>
      <div>
        <span class="block text-xs text-stone-400 font-medium">Custody</span>
        <span class="font-bold text-forest-900 mt-0.5 block">DLSAU Security Office</span>
      </div>
    </div>

    <div class="mt-5">
      <h4 class="text-xs font-bold uppercase tracking-wider text-forest-900">Item Description</h4>
      <p id="modal-description" class="mt-1.5 text-sm sm:text-base text-stone-700 leading-relaxed">
        Description here...
      </p>
    </div>

    <!-- Admin Post Controls (Only for Admins) -->
    {isAdmin && (
      <div class="mt-5 rounded-2xl bg-rose-50/80 border border-rose-200/70 p-4">
        <div class="flex items-center justify-between gap-3 flex-wrap sm:flex-nowrap">
          <div class="flex items-center gap-2.5">
            <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-rose-100 text-rose-700">
              <svg class="size-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </span>
            <div>
              <p class="text-xs font-bold uppercase tracking-wider text-rose-900">
                Disciplinary Office Controls
              </p>
              <p class="text-xs text-rose-700">
                Authorized administrators can remove this listing from campus feed.
              </p>
            </div>
          </div>
          <button
            type="button"
            id="modal-admin-remove-btn"
            class="inline-flex shrink-0 items-center gap-1.5 rounded-full bg-rose-600 px-4 py-2 text-xs font-bold text-white shadow-xs hover:bg-rose-700 active:scale-95 transition-all cursor-pointer"
          >
            <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
            </svg>
            <span>Remove Post</span>
          </button>
        </div>
      </div>
    )}

    <!-- Claim / Response Section -->
    <div class="mt-6 border-t border-line/70 pt-5">
      <form id="claim-submit-form" onsubmit="event.preventDefault(); window.handleClaimSubmit();">
        <label for="proof-description-input" id="modal-proof-label" class="block text-sm font-bold text-forest-900">
          Describe Proof of Ownership
        </label>
        <p class="mt-0.5 text-xs text-stone-500">
          State unique marks, identifying features, or contents so security staff can verify.
        </p>
        <textarea
          id="proof-description-input"
          required
          rows="3"
          minlength="20"
          placeholder="e.g. There is a sticker on the back, and the initials engraved are..."
          class="mt-2 w-full rounded-xl border border-line bg-[#fbf9f4] p-3.5 text-sm text-forest-900 placeholder:text-stone-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-forest-700/20"
        ></textarea>

        <div class="mt-5 flex items-center justify-end gap-3.5">
          <button
            type="button"
            id="cancel-claim-btn"
            class="min-h-11 rounded-full px-5 py-2.5 text-sm font-semibold text-stone-600 hover:bg-stone-100 cursor-pointer"
          >
            Cancel
          </button>
          <button
            type="submit"
            id="submit-claim-btn"
            class="min-h-11 rounded-full bg-forest-700 px-6 py-2.5 text-sm font-bold text-white shadow-sm hover:bg-forest-900 active:scale-95 cursor-pointer"
          >
            Submit Claim Verification
          </button>
        </div>
      </form>

      <div id="claim-success-msg" class="hidden rounded-xl bg-forest-700/10 p-4 text-center text-sm text-forest-900 font-semibold">
        Your claim request has been sent to the Security Office. Check your notifications for status updates.
      </div>
    </div>
  </div>
</div>

<!-- Photo Zoom Lightbox (opened from the item photo gallery) -->
<div
  id="photo-lightbox"
  class="fixed inset-0 z-[60] hidden items-center justify-center bg-black/80 p-4"
  role="dialog"
  aria-modal="true"
  aria-label="Zoomed item photo"
>
  <button
    type="button"
    id="close-photo-lightbox"
    class="absolute right-4 top-4 flex size-10 items-center justify-center rounded-full bg-white/15 text-white hover:bg-white/30 cursor-pointer"
    aria-label="Close photo"
  >
    <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>
  <img
    id="photo-lightbox-img"
    src=""
    alt=""
    class="max-h-[85dvh] max-w-[92vw] rounded-2xl object-contain shadow-2xl"
  />
</div>
