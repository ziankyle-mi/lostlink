---
// Dashboard Footer matching AuthShell login page standards
interface Props {
  /** Match the wide admin content frame instead of the student dashboard width. */
  wide?: boolean;
}
const { wide = false } = Astro.props;
---

<footer class="mt-16 w-full border-t border-line py-7 sm:py-8">
  <div class={`mx-auto flex ${wide ? "max-w-[1660px]" : "max-w-7xl"} flex-col items-center justify-between gap-4 px-4 sm:px-10 lg:px-14 sm:flex-row`}>
    <p class="text-sm font-medium text-forest-700">
      &copy; 2026 LostLink &middot; DLSAU Lost &amp; Found System
    </p>

    <div class="flex items-center gap-7 sm:gap-8 text-sm font-medium text-forest-700">
      <a href="/privacy" class="transition-colors hover:text-forest-900">Privacy</a>
      <a href="/terms" class="transition-colors hover:text-forest-900">Terms</a>
      <a href="/help" class="transition-colors hover:text-forest-900">Help</a>
    </div>
  </div>
</footer>
