---
import { actions } from "astro:actions";

interface Props {
  userEmail?: string;
}

const { userEmail = "student@dlsau.edu.ph" } = Astro.props;

// Compute initials from email (e.g. maria.reyes -> MR, or default "MR")
function getInitials(email: string): string {
  const namePart = email.split("@")[0];
  const segments = namePart.split(/[._-]/).filter(Boolean);
  if (segments.length >= 2) {
    return (segments[0][0] + segments[1][0]).toUpperCase();
  }
  if (segments.length === 1 && segments[0].length >= 2) {
    return segments[0].slice(0, 2).toUpperCase();
  }
  return "MR";
}

const initials = getInitials(userEmail);
---

<header class="w-full bg-canvas border-b border-line/80">
  <!-- Top Ticker Announcement Bar (generously sized and spaced) -->
  <div class="relative w-full overflow-hidden bg-[#164f38] py-2 sm:py-2.5 text-white">
    <div class="animate-ticker flex items-center whitespace-nowrap text-xs sm:text-[0.8125rem] font-medium tracking-wide text-[#dcecd2]">
      <!-- Ticker Sequence 1 -->
      <span class="inline-flex items-center gap-4 sm:gap-5 px-6">
        <span>A little thing can mean a lot</span>
        <span class="text-[9px] text-[#d8ef8c]" aria-hidden="true">▼</span>
        <span>Found something? Post it in under a minute</span>
        <span class="text-[9px] text-[#d8ef8c]" aria-hidden="true">▼</span>
        <span>Lost something? Tell the community</span>
        <span class="text-[9px] text-[#d8ef8c]" aria-hidden="true">▼</span>
        <span>Found something? Post it in under a minute</span>
        <span class="text-[9px] text-[#d8ef8c]" aria-hidden="true">▼</span>
        <span>Lost something? Tell the community</span>
        <span class="text-[9px] text-[#d8ef8c]" aria-hidden="true">▼</span>
      </span>
      <!-- Ticker Sequence 2 (for smooth infinite marquee) -->
      <span class="inline-flex items-center gap-4 sm:gap-5 px-6" aria-hidden="true">
        <span>A little thing can mean a lot</span>
        <span class="text-[9px] text-[#d8ef8c]">▼</span>
        <span>Found something? Post it in under a minute</span>
        <span class="text-[9px] text-[#d8ef8c]">▼</span>
        <span>Lost something? Tell the community</span>
        <span class="text-[9px] text-[#d8ef8c]">▼</span>
        <span>Found something? Post it in under a minute</span>
        <span class="text-[9px] text-[#d8ef8c]">▼</span>
        <span>Lost something? Tell the community</span>
        <span class="text-[9px] text-[#d8ef8c]">▼</span>
      </span>
    </div>
  </div>

  <!-- Main Navigation Row (Scaled to match AuthShell benchmark) -->
  <div class="mx-auto max-w-7xl px-4 py-3.5 sm:px-10 sm:py-5 lg:px-14">
    <div class="flex items-center justify-between gap-3 sm:gap-4">
      <!-- Left: Brand Logo & Links -->
      <div class="flex items-center gap-4 sm:gap-7 lg:gap-9 shrink-0">
        <a href="/" class="flex items-center gap-2.5 sm:gap-3 transition-opacity hover:opacity-90">
          <img
            src="/lostlink-badge.png"
            alt="LostLink"
            width="44"
            height="44"
            class="size-9 sm:size-11 rounded-xl object-contain shadow-2xs"
          />
          <span class="font-serif text-xl sm:text-[1.75rem] lg:text-[2.1rem] leading-none font-bold tracking-tight text-forest-900">
            Lost<span class="italic font-black">Link</span>
          </span>
        </a>

        <nav class="hidden items-center gap-6 lg:flex" aria-label="Main Navigation">
          <a
            href="#feed"
            data-nav-filter="found"
            class="nav-tab text-[0.9375rem] font-semibold text-forest-900/80 transition-colors hover:text-forest-900"
          >
            Found Items
          </a>
          <a
            href="#feed"
            data-nav-filter="lost"
            class="nav-tab text-[0.9375rem] font-semibold text-forest-900/80 transition-colors hover:text-forest-900"
          >
            Lost Items
          </a>
          <a
            href="/profile"
            class="text-[0.9375rem] font-semibold text-forest-900/80 transition-colors hover:text-forest-900"
          >
            Profile
          </a>
        </nav>
      </div>

      <!-- Center: Search Pill Input (Desktop/Tablet) -->
      <div class="hidden md:flex flex-1 max-w-xs lg:max-w-md mx-2">
        <div class="relative w-full flex items-center">
          <input
            type="search"
            id="global-search-input"
            placeholder="Search Wallets, Keys, IDs, bags..."
            class="w-full min-h-[3rem] sm:min-h-[3.25rem] rounded-full bg-[#ece5d6] py-2.5 pl-5 pr-11 text-sm sm:text-base text-forest-900 placeholder:text-stone-500 placeholder:font-normal focus:bg-white focus:outline-none focus:ring-2 focus:ring-forest-700/25 transition-all shadow-2xs"
          />
          <svg
            class="pointer-events-none absolute right-4 size-5 text-stone-500"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35m1.85-5.15a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
      </div>

      <!-- Right: Bell, Post Button, Avatar -->
      <div class="flex items-center gap-2.5 sm:gap-4 shrink-0">
        <!-- Notification Bell (44px touch target) -->
        <div class="relative">
          <button
            type="button"
            id="notif-bell-btn"
            aria-label="View notifications"
            class="flex size-10 sm:size-11 items-center justify-center rounded-full border border-line bg-white text-forest-900 shadow-2xs transition-all hover:bg-stone-50 active:scale-95 cursor-pointer"
          >
            <svg
              class="size-5"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
            </svg>
            <span class="absolute top-2 right-2 size-2.5 rounded-full bg-[#9b2c1f]"></span>
          </button>

          <!-- Notification Popover -->
          <div
            id="notif-popover"
            class="absolute right-0 top-14 z-50 hidden w-72 sm:w-80 rounded-2xl border border-line bg-white p-4 shadow-xl"
          >
            <div class="flex items-center justify-between border-b border-line pb-2.5">
              <span class="text-sm font-bold text-forest-900">Notifications</span>
              <span class="rounded-full bg-forest-700/10 px-2.5 py-0.5 text-xs font-semibold text-forest-900">1 new</span>
            </div>
            <div class="mt-3 space-y-2.5">
              <div class="rounded-xl bg-[#f5f1e6]/80 p-3 text-xs sm:text-sm border border-line/60">
                <p class="font-bold text-forest-900">Account Security</p>
                <p class="mt-0.5 text-stone-600">Your DLSAU account is active. If your password was recently reset, your new credentials are active!</p>
                <span class="mt-1.5 block text-[10px] text-stone-400">Campus Security Office</span>
              </div>
              <div class="rounded-xl p-3 text-xs sm:text-sm hover:bg-stone-50">
                <p class="font-bold text-forest-900">Report Approved</p>
                <p class="mt-0.5 text-stone-600">Your report for "Student ID card" is live on the campus feed.</p>
                <span class="mt-1.5 block text-[10px] text-stone-400">10m ago</span>
              </div>
              <div class="rounded-xl p-3 text-xs sm:text-sm hover:bg-stone-50">
                <p class="font-bold text-forest-900">Item Matched</p>
                <p class="mt-0.5 text-stone-600">A found item matching "Keys" was dropped at the security office.</p>
                <span class="mt-1.5 block text-[10px] text-stone-400">2h ago</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Post an item Button -->
        <button
          type="button"
          id="top-post-item-btn"
          class="flex min-h-10 sm:min-h-11 items-center gap-1.5 sm:gap-2 rounded-full bg-forest-700 px-3.5 sm:px-6 py-2 sm:py-2.5 text-xs sm:text-[0.9375rem] font-bold text-white shadow-2xs transition-all hover:bg-forest-900 hover:shadow-sm active:scale-95 cursor-pointer"
        >
          <span class="hidden sm:inline">Post an item</span>
          <span class="sm:hidden">Post</span>
          <span class="text-base leading-none font-bold">+</span>
        </button>

        <!-- Avatar Pill with User Menu Dropdown -->
        <div class="relative">
          <button
            type="button"
            id="user-avatar-btn"
            aria-label="User account menu"
            class="flex size-10 sm:size-11 items-center justify-center rounded-full border border-lime-600/30 bg-[#d8ef8c] text-sm sm:text-base font-black text-forest-900 shadow-2xs transition-all hover:opacity-90 active:scale-95 cursor-pointer"
          >
            {initials}
          </button>

          <!-- Dropdown Menu -->
          <div
            id="user-menu-dropdown"
            class="absolute right-0 top-14 z-50 hidden w-64 rounded-2xl border border-line bg-white p-4 shadow-xl"
          >
            <div class="border-b border-line pb-3">
              <p class="text-xs font-semibold text-stone-500">Signed in as</p>
              <p class="truncate text-sm font-bold text-forest-900" title={userEmail}>
                {userEmail}
              </p>
              <span class="mt-1.5 inline-block rounded-full bg-forest-700/10 px-2.5 py-0.5 text-xs font-semibold text-forest-900">
                DLSAU Student
              </span>
            </div>

            <div class="mt-3 space-y-1.5">
              <a
                href="#feed"
                class="block rounded-xl px-3 py-2 text-sm font-medium text-forest-900 hover:bg-[#f5f1e6]"
              >
                Browse Campus Feed
              </a>
            <a
              href="/profile"
              class="block rounded-xl px-3 py-2 text-sm font-medium text-forest-900 hover:bg-[#f5f1e6]"
            >
              Profile
            </a>
            </div>

            <div class="mt-3 border-t border-line pt-3">
              <form method="POST" action={actions.logout}>
                <button
                  type="submit"
                  class="w-full rounded-xl bg-[#9b2c1f]/10 px-3 py-2.5 text-left text-sm font-bold text-[#9b2c1f] transition-colors hover:bg-[#9b2c1f]/20 cursor-pointer"
                >
                  Sign out
                </button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Mobile Search Bar (Phone screens) -->
    <div class="mt-3 md:hidden">
      <div class="relative w-full flex items-center">
        <input
          type="search"
          id="mobile-search-input"
          placeholder="Search Wallets, Keys, IDs, bags..."
          class="w-full min-h-[2.85rem] rounded-full bg-[#ece5d6] py-2 pl-4 pr-10 text-sm text-forest-900 placeholder:text-stone-500 placeholder:font-normal focus:bg-white focus:outline-none focus:ring-2 focus:ring-forest-700/25 transition-all shadow-2xs"
        />
        <svg
          class="pointer-events-none absolute right-3.5 size-4 text-stone-500"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35m1.85-5.15a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>
    </div>
  </div>
</header>
