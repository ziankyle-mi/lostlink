---
import { actions } from "astro:actions";

import { createClient } from "@supabase/supabase-js";
import { readEnv } from "~/lib/env";

interface Props {
  userEmail?: string;
  userRole?: string;
}

const { userEmail = "student@dlsau.edu.ph", userRole } = Astro.props;
let isAdmin = userRole === "admin" || Astro.locals.user?.role === "admin";

const env = Astro.locals.env || readEnv();
interface LiveNotif {
  id: string;
  message: string;
  read: boolean;
  link?: string;
  created_at: string;
}

let liveNotifications: LiveNotif[] = [];
let unreadNotifCount = 0;

if (env.PUBLIC_SUPABASE_URL && (env.SUPABASE_SERVICE_ROLE_KEY || env.PUBLIC_SUPABASE_ANON_KEY)) {
  try {
    const supabase = createClient(env.PUBLIC_SUPABASE_URL, env.SUPABASE_SERVICE_ROLE_KEY || env.PUBLIC_SUPABASE_ANON_KEY, {
      auth: { persistSession: false },
    });
    const { data: prof } = await supabase
      .from("profiles")
      .select("id, role")
      .eq("email", userEmail.toLowerCase().trim())
      .maybeSingle();

    if (prof?.role === "admin") {
      isAdmin = true;
    }

    if (prof?.id) {
      const { data: nList } = await supabase
        .from("notifications")
        .select("*")
        .eq("user_id", prof.id)
        .order("created_at", { ascending: false })
        .limit(8);

      if (nList) {
        liveNotifications = nList;
        unreadNotifCount = nList.filter((n) => !n.read).length;
      }
    }
  } catch (err) {
    console.warn("[navbar] Notifs fetch notice:", err);
  }
}

function formatNotifTime(dateStr?: string): string {
  if (!dateStr) return "Recently";
  const diff = Date.now() - new Date(dateStr).getTime();
  const mins = Math.floor(diff / 60000);
  if (mins < 1) return "Just now";
  if (mins < 60) return `${mins}m ago`;
  const hours = Math.floor(mins / 60);
  if (hours < 24) return `${hours}h ago`;
  const days = Math.floor(hours / 24);
  return `${days}d ago`;
}

// Compute initials from email (e.g. maria.reyes -> MR, or default "MR")
function getInitials(email: string): string {
  if (isAdmin) return "DO";
  const namePart = email.split("@")[0];
  const segments = namePart.split(/[._-]/).filter(Boolean);
  if (segments.length >= 2) {
    return (segments[0][0] + segments[1][0]).toUpperCase();
  }
  if (segments.length === 1 && segments[0].length >= 2) {
    return segments[0].slice(0, 2).toUpperCase();
  }
  return "MR";
}

const initials = getInitials(userEmail);
---

<header class="w-full bg-canvas border-b border-line/80">
  <!-- Top Ticker Announcement Bar (generously sized and spaced) -->
  <div class="relative w-full overflow-hidden bg-forest-700 py-2 sm:py-2.5 text-white">
    <div class="animate-ticker flex items-center whitespace-nowrap text-xs sm:text-[0.8125rem] font-medium tracking-wide text-[#dcecd2]">
      <!-- Ticker Sequence 1 -->
      <span class="inline-flex items-center gap-4 sm:gap-5 px-6">
        <span>A little thing can mean a lot</span>
        <span class="text-[9px] text-lime" aria-hidden="true">▼</span>
        <span>Found something? Post it in under a minute</span>
        <span class="text-[9px] text-lime" aria-hidden="true">▼</span>
        <span>Lost something? Tell the community</span>
        <span class="text-[9px] text-lime" aria-hidden="true">▼</span>
        <span>Found something? Post it in under a minute</span>
        <span class="text-[9px] text-lime" aria-hidden="true">▼</span>
        <span>Lost something? Tell the community</span>
        <span class="text-[9px] text-lime" aria-hidden="true">▼</span>
      </span>
      <!-- Ticker Sequence 2 (for smooth infinite marquee) -->
      <span class="inline-flex items-center gap-4 sm:gap-5 px-6" aria-hidden="true">
        <span>A little thing can mean a lot</span>
        <span class="text-[9px] text-lime">▼</span>
        <span>Found something? Post it in under a minute</span>
        <span class="text-[9px] text-lime">▼</span>
        <span>Lost something? Tell the community</span>
        <span class="text-[9px] text-lime">▼</span>
        <span>Found something? Post it in under a minute</span>
        <span class="text-[9px] text-lime">▼</span>
        <span>Lost something? Tell the community</span>
        <span class="text-[9px] text-lime">▼</span>
      </span>
    </div>
  </div>

  <!-- Main Navigation Row (Responsive layout for Mobile, Tablet, PC) -->
  <div class="mx-auto max-w-7xl px-4 py-3.5 sm:px-6 md:px-8 lg:px-10 xl:px-14 sm:py-5">
    <div class="flex items-center justify-between gap-2.5 sm:gap-4 min-w-0">
      <!-- Left: Brand Logo & Links -->
      <div class="flex items-center gap-3 sm:gap-6 lg:gap-8 shrink-0">
        <a href="/" class="flex items-center gap-2 sm:gap-3 transition-opacity hover:opacity-90">
          <img
            src="/lostlink-badge.png"
            alt="LostLink"
            width="44"
            height="44"
            class="size-9 sm:size-11 rounded-xl object-contain shadow-2xs"
          />
          <span class="font-serif text-xl sm:text-[1.75rem] lg:text-[2.1rem] leading-none font-bold tracking-tight text-forest-900">
            Lost<span class="italic font-black">Link</span>
          </span>
        </a>

        <nav class="hidden md:flex items-center gap-5 lg:gap-6 shrink-0" aria-label="Main Navigation">
          <a
            href="/#feed"
            data-nav-filter="found"
            class="nav-tab text-[0.9375rem] font-semibold text-forest-900/80 transition-colors hover:text-forest-900"
          >
            Found Items
          </a>
          <a
            href="/#feed"
            data-nav-filter="lost"
            class="nav-tab text-[0.9375rem] font-semibold text-forest-900/80 transition-colors hover:text-forest-900"
          >
            Lost Items
          </a>
          {isAdmin && (
            <a
              href="/admin"
              class="inline-flex items-center gap-1.5 text-[0.9375rem] font-semibold text-forest-900/80 hover:text-forest-900 transition-colors"
            >
              <svg class="size-3.5 text-forest-700/60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
              </svg>
              <span>Admin Console</span>
            </a>
          )}
        </nav>
      </div>

      <!-- Right: Post Button, Notification Bell, User Avatar (Natural utility grouping) -->
      <div class="flex items-center gap-2 sm:gap-3 lg:gap-3.5 shrink-0">
        <!-- Post an item Button (Primary Action) -->
        <button
          type="button"
          id="top-post-item-btn"
          class="flex min-h-10 sm:min-h-11 items-center gap-1.5 sm:gap-2 rounded-full bg-forest-700 px-3.5 sm:px-5 lg:px-6 py-2 sm:py-2.5 text-xs sm:text-[0.9375rem] font-bold text-white shadow-2xs transition-all hover:bg-forest-900 hover:shadow-sm active:scale-95 cursor-pointer shrink-0"
        >
          <span class="hidden sm:inline">Post an item</span>
          <span class="sm:hidden">Post</span>
          <span class="text-base leading-none font-bold">+</span>
        </button>

        <!-- Notification Bell (44px touch target) -->
        <div class="relative">
          <button
            type="button"
            id="notif-bell-btn"
            aria-label="View notifications"
            aria-haspopup="true"
            aria-expanded="false"
            class="flex size-10 sm:size-11 items-center justify-center rounded-full border border-line bg-white text-forest-900 shadow-2xs transition-all hover:bg-stone-50 active:scale-95 cursor-pointer shrink-0"
          >
            <svg
              class="size-5"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
            </svg>
            <span
              id="notif-unread-dot"
              class={`absolute top-2 right-2 size-2.5 rounded-full bg-danger ${unreadNotifCount > 0 ? "" : "hidden"}`}
            ></span>
          </button>

          <!-- Notification Popover (Responsive on mobile, tablet & PC) -->
          <div
            id="notif-popover"
            class="fixed inset-x-3 top-16 sm:absolute sm:inset-auto sm:right-0 sm:top-14 z-50 hidden w-auto sm:w-80 max-w-[calc(100vw-1.5rem)] rounded-2xl border border-line bg-white p-4 shadow-xl"
          >
            <div class="flex items-center justify-between border-b border-line pb-2.5">
              <span class="text-sm font-bold text-forest-900">Notifications</span>
              <div class="flex items-center gap-2">
                <span id="notif-unread-badge" class="rounded-full bg-forest-700/10 px-2.5 py-0.5 text-xs font-semibold text-forest-900">
                  {unreadNotifCount > 0 ? `${unreadNotifCount} new` : "All caught up"}
                </span>
                {unreadNotifCount > 0 && (
                  <button
                    type="button"
                    id="mark-all-notifs-read-btn"
                    class="text-xs font-bold text-forest-700 hover:underline cursor-pointer"
                  >
                    Mark read
                  </button>
                )}
              </div>
            </div>

            <div id="notif-list-container" class="mt-3 space-y-2.5 max-h-72 sm:max-h-80 overflow-y-auto overscroll-contain pr-1 custom-scrollbar">
              {liveNotifications.length > 0 ? (
                liveNotifications.map((notif) => (
                  <div
                    data-notif-id={notif.id}
                    data-notif-read={notif.read ? "true" : "false"}
                    class={`notif-card group relative block rounded-xl p-3 text-xs sm:text-sm border transition-all ${
                      !notif.read
                        ? "bg-canvas/90 border-line/70 font-medium"
                        : "bg-white border-transparent hover:bg-stone-50"
                    }`}
                  >
                    <div class="flex items-start justify-between gap-2">
                      <a href={notif.link || "#"} class="font-bold text-forest-900 leading-tight hover:underline flex-1">
                        {notif.message.includes("submitted")
                          ? "Report Submitted"
                          : notif.message.includes("approved")
                          ? "Report Approved"
                          : notif.message.includes("verified")
                          ? "Claim Verified"
                          : notif.message.includes("denied")
                          ? "Claim Update"
                          : "Campus Notification"}
                      </a>
                      <div class="flex items-center gap-1.5 shrink-0">
                        {!notif.read && (
                          <span class="size-1.5 shrink-0 rounded-full bg-forest-700"></span>
                        )}
                        <button
                          type="button"
                          class="delete-notif-btn p-1 -mr-1 rounded-md text-stone-400 hover:text-rose-600 hover:bg-stone-200/60 transition-colors cursor-pointer"
                          data-notif-id={notif.id}
                          title="Delete notification"
                          aria-label="Delete notification"
                        >
                          <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="3 6 5 6 21 6" />
                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                          </svg>
                        </button>
                      </div>
                    </div>
                    <a href={notif.link || "#"} class="block mt-1">
                      <p class="text-stone-600 leading-relaxed text-xs">
                        {notif.message}
                      </p>
                      <span class="mt-1.5 block text-xs text-stone-400">
                        {formatNotifTime(notif.created_at)}
                      </span>
                    </a>
                  </div>
                ))
              ) : (
                <div class="py-6 text-center text-xs text-stone-500">
                  <p class="font-semibold text-forest-900">No notifications yet</p>
                  <p class="mt-1">When reports or claims update, they will appear here.</p>
                </div>
              )}
            </div>
          </div>
        </div>

        <!-- Avatar Pill with User Menu Dropdown -->
        <div class="relative">
          <button
            type="button"
            id="user-avatar-btn"
            aria-label="User account menu"
            aria-haspopup="true"
            aria-expanded="false"
            class="flex size-10 sm:size-11 items-center justify-center rounded-full border border-lime-600/30 bg-lime text-sm sm:text-base font-black text-forest-900 shadow-2xs transition-all hover:opacity-90 active:scale-95 cursor-pointer shrink-0"
          >
            {initials}
          </button>

          <!-- Dropdown Menu -->
          <div
            id="user-menu-dropdown"
            class="absolute right-0 top-14 z-50 hidden w-64 max-w-[calc(100vw-1.5rem)] rounded-2xl border border-line bg-white p-4 shadow-xl"
          >
            <div class="border-b border-line pb-3">
              <p class="text-xs font-semibold text-stone-500">Signed in as</p>
              <p class="truncate text-sm font-bold text-forest-900" title={userEmail}>
                {userEmail}
              </p>
              <span class="mt-1.5 inline-block rounded-full bg-forest-700/10 px-2.5 py-0.5 text-xs font-semibold text-forest-900">
                {isAdmin ? "DLSAU Disciplinary Admin" : "DLSAU Student"}
              </span>
            </div>

            <div class="mt-3 space-y-1.5">
              {isAdmin && (
                <a
                  href="/admin"
                  class="flex items-center justify-between rounded-xl px-3 py-2 text-sm font-medium text-forest-900 hover:bg-canvas transition-colors"
                >
                  <div class="flex items-center gap-2">
                    <svg class="size-4 text-forest-700/70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                    </svg>
                    <span>Admin Console</span>
                  </div>
                  <span class="rounded-full border border-forest-900/15 bg-forest-900/5 px-2 py-0.5 text-[10px] font-semibold text-forest-900">DO</span>
                </a>
              )}
              <a
                href="/#feed"
                class="block rounded-xl px-3 py-2 text-sm font-medium text-forest-900 hover:bg-canvas"
              >
                Browse Campus Feed
              </a>
              <a
                href="/profile"
                class="block rounded-xl px-3 py-2 text-sm font-medium text-forest-900 hover:bg-canvas"
              >
                Profile &amp; Overview
              </a>
            </div>

            <div class="mt-3 border-t border-line pt-3">
              <form method="POST" action={actions.logout}>
                <button
                  type="submit"
                  class="w-full rounded-xl bg-danger/10 px-3 py-2.5 text-left text-sm font-bold text-danger transition-colors hover:bg-danger/20 cursor-pointer"
                >
                  Sign out
                </button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    // @ts-nocheck -- legacy DOM script, migrated out of is:inline for CSP.
    (function () {
      const avatarBtn = document.getElementById("user-avatar-btn");
      const userMenu = document.getElementById("user-menu-dropdown");
      const notifBtn = document.getElementById("notif-bell-btn");
      const notifPopover = document.getElementById("notif-popover");
      const markReadBtn = document.getElementById("mark-all-notifs-read-btn");
      const postBtn = document.getElementById("top-post-item-btn");

      function closeUserMenu() {
        if (userMenu && !userMenu.classList.contains("hidden")) {
          userMenu.classList.add("hidden");
          avatarBtn?.setAttribute("aria-expanded", "false");
        }
      }

      function openUserMenu() {
        if (userMenu) {
          closeNotifPopover();
          userMenu.classList.remove("hidden");
          avatarBtn?.setAttribute("aria-expanded", "true");
        }
      }

      function toggleUserMenu() {
        if (!userMenu) return;
        if (userMenu.classList.contains("hidden")) {
          openUserMenu();
        } else {
          closeUserMenu();
        }
      }

      function closeNotifPopover() {
        if (notifPopover && !notifPopover.classList.contains("hidden")) {
          notifPopover.classList.add("hidden");
          notifBtn?.setAttribute("aria-expanded", "false");
        }
      }

      function openNotifPopover() {
        if (notifPopover) {
          closeUserMenu();
          notifPopover.classList.remove("hidden");
          notifBtn?.setAttribute("aria-expanded", "true");
        }
      }

      function toggleNotifPopover() {
        if (!notifPopover) return;
        if (notifPopover.classList.contains("hidden")) {
          openNotifPopover();
        } else {
          closeNotifPopover();
        }
      }

      if (avatarBtn && userMenu) {
        avatarBtn.addEventListener("click", (e) => {
          e.stopPropagation();
          toggleUserMenu();
        });
      }

      if (notifBtn && notifPopover) {
        notifBtn.addEventListener("click", (e) => {
          e.stopPropagation();
          toggleNotifPopover();
        });
      }

      if (markReadBtn) {
        markReadBtn.addEventListener("click", async (e) => {
          e.stopPropagation();
          const dot = document.getElementById("notif-unread-dot");
          const badge = document.getElementById("notif-unread-badge");
          if (dot) dot.classList.add("hidden");
          if (badge) badge.textContent = "All caught up";
          markReadBtn.classList.add("hidden");
          try {
            await fetch("/api/notifications", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ markAllRead: true }),
            });
          } catch (err) {
            console.warn("[notifs] Mark read notice:", err);
          }
        });
      }

      // Delete individual notification handler
      const notifContainer = document.getElementById("notif-list-container");
      if (notifContainer) {
        notifContainer.addEventListener("click", async (e) => {
          const deleteBtn = e.target.closest(".delete-notif-btn");
          if (!deleteBtn) return;
          e.stopPropagation();
          e.preventDefault();

          const notifCard = deleteBtn.closest(".notif-card");
          if (!notifCard) return;

          const notifId = deleteBtn.dataset.notifId;

          // Smooth slide-fade out
          notifCard.style.transition = "opacity 180ms ease, transform 180ms ease";
          notifCard.style.opacity = "0";
          notifCard.style.transform = "translateX(16px)";
          setTimeout(() => {
            notifCard.remove();
            const remaining = notifContainer.querySelectorAll(".notif-card");
            if (remaining.length === 0) {
              notifContainer.innerHTML = `
                <div class="py-6 text-center text-xs text-stone-500">
                  <p class="font-semibold text-forest-900">No notifications yet</p>
                  <p class="mt-1">When reports or claims update, they will appear here.</p>
                </div>
              `;
            }
            // Recount unread
            const remainingUnread = notifContainer.querySelectorAll('.notif-card[data-notif-read="false"]').length;
            const dot = document.getElementById("notif-unread-dot");
            const badge = document.getElementById("notif-unread-badge");
            const markAllBtn = document.getElementById("mark-all-notifs-read-btn");
            if (remainingUnread > 0) {
              if (dot) dot.classList.remove("hidden");
              if (badge) badge.textContent = `${remainingUnread} new`;
            } else {
              if (dot) dot.classList.add("hidden");
              if (badge) badge.textContent = "All caught up";
              if (markAllBtn) markAllBtn.classList.add("hidden");
            }
          }, 180);

          if (notifId) {
            try {
              await fetch("/api/notifications", {
                method: "DELETE",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ notificationId: notifId }),
              });
            } catch (err) {
              console.warn("[notifs] Delete notification notice:", err);
            }
          }
        });
      }

      if (postBtn) {
        postBtn.addEventListener("click", () => {
          if (typeof window.openReport === "function") {
            window.openReport("found");
          } else {
            window.location.href = "/?report=found";
          }
        });
      }

      // Close dropdowns on outside click
      document.addEventListener("click", (e) => {
        if (userMenu && !userMenu.contains(e.target) && !avatarBtn?.contains(e.target)) {
          closeUserMenu();
        }
        if (notifPopover && !notifPopover.contains(e.target) && !notifBtn?.contains(e.target)) {
          closeNotifPopover();
        }
      });

      // Close dropdowns on Escape key
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          closeUserMenu();
          closeNotifPopover();
        }
      });

    })();
  </script>
</header>
