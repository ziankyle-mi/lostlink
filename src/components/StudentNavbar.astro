---
import { actions } from "astro:actions";
import { roleForEmail } from "~/lib/session";

import { createClient } from "@supabase/supabase-js";
import { readEnv } from "~/lib/env";

interface Props {
  userEmail?: string;
}

const { userEmail = "student@dlsau.edu.ph" } = Astro.props;
const isAdmin = roleForEmail(userEmail) === "admin";

const env = Astro.locals.env || readEnv();
interface LiveNotif {
  id: string;
  message: string;
  read: boolean;
  link?: string;
  created_at: string;
}

let liveNotifications: LiveNotif[] = [];
let unreadNotifCount = 0;

if (env.PUBLIC_SUPABASE_URL && (env.SUPABASE_SERVICE_ROLE_KEY || env.PUBLIC_SUPABASE_ANON_KEY)) {
  try {
    const supabase = createClient(env.PUBLIC_SUPABASE_URL, env.SUPABASE_SERVICE_ROLE_KEY || env.PUBLIC_SUPABASE_ANON_KEY, {
      auth: { persistSession: false },
    });
    const { data: prof } = await supabase
      .from("profiles")
      .select("id")
      .eq("email", userEmail.toLowerCase().trim())
      .maybeSingle();

    if (prof?.id) {
      const { data: nList } = await supabase
        .from("notifications")
        .select("*")
        .eq("user_id", prof.id)
        .order("created_at", { ascending: false })
        .limit(8);

      if (nList) {
        liveNotifications = nList;
        unreadNotifCount = nList.filter((n) => !n.read).length;
      }
    }
  } catch (err) {
    console.warn("[navbar] Notifs fetch notice:", err);
  }
}

function formatNotifTime(dateStr?: string): string {
  if (!dateStr) return "Recently";
  const diff = Date.now() - new Date(dateStr).getTime();
  const mins = Math.floor(diff / 60000);
  if (mins < 1) return "Just now";
  if (mins < 60) return `${mins}m ago`;
  const hours = Math.floor(mins / 60);
  if (hours < 24) return `${hours}h ago`;
  const days = Math.floor(hours / 24);
  return `${days}d ago`;
}

// Compute initials from email (e.g. maria.reyes -> MR, or default "MR")
function getInitials(email: string): string {
  if (isAdmin) return "DO";
  const namePart = email.split("@")[0];
  const segments = namePart.split(/[._-]/).filter(Boolean);
  if (segments.length >= 2) {
    return (segments[0][0] + segments[1][0]).toUpperCase();
  }
  if (segments.length === 1 && segments[0].length >= 2) {
    return segments[0].slice(0, 2).toUpperCase();
  }
  return "MR";
}

const initials = getInitials(userEmail);
---

<header class="w-full bg-canvas border-b border-line/80">
  <!-- Top Ticker Announcement Bar (generously sized and spaced) -->
  <div class="relative w-full overflow-hidden bg-[#164f38] py-2 sm:py-2.5 text-white">
    <div class="animate-ticker flex items-center whitespace-nowrap text-xs sm:text-[0.8125rem] font-medium tracking-wide text-[#dcecd2]">
      <!-- Ticker Sequence 1 -->
      <span class="inline-flex items-center gap-4 sm:gap-5 px-6">
        <span>A little thing can mean a lot</span>
        <span class="text-[9px] text-[#d8ef8c]" aria-hidden="true">▼</span>
        <span>Found something? Post it in under a minute</span>
        <span class="text-[9px] text-[#d8ef8c]" aria-hidden="true">▼</span>
        <span>Lost something? Tell the community</span>
        <span class="text-[9px] text-[#d8ef8c]" aria-hidden="true">▼</span>
        <span>Found something? Post it in under a minute</span>
        <span class="text-[9px] text-[#d8ef8c]" aria-hidden="true">▼</span>
        <span>Lost something? Tell the community</span>
        <span class="text-[9px] text-[#d8ef8c]" aria-hidden="true">▼</span>
      </span>
      <!-- Ticker Sequence 2 (for smooth infinite marquee) -->
      <span class="inline-flex items-center gap-4 sm:gap-5 px-6" aria-hidden="true">
        <span>A little thing can mean a lot</span>
        <span class="text-[9px] text-[#d8ef8c]">▼</span>
        <span>Found something? Post it in under a minute</span>
        <span class="text-[9px] text-[#d8ef8c]">▼</span>
        <span>Lost something? Tell the community</span>
        <span class="text-[9px] text-[#d8ef8c]">▼</span>
        <span>Found something? Post it in under a minute</span>
        <span class="text-[9px] text-[#d8ef8c]">▼</span>
        <span>Lost something? Tell the community</span>
        <span class="text-[9px] text-[#d8ef8c]">▼</span>
      </span>
    </div>
  </div>

  <!-- Main Navigation Row (Scaled to match AuthShell benchmark) -->
  <div class="mx-auto max-w-7xl px-4 py-3.5 sm:px-10 sm:py-5 lg:px-14">
    <div class="flex items-center justify-between gap-3 sm:gap-4">
      <!-- Left: Brand Logo & Links -->
      <div class="flex items-center gap-4 sm:gap-7 lg:gap-9 shrink-0">
        <a href="/" class="flex items-center gap-2.5 sm:gap-3 transition-opacity hover:opacity-90">
          <img
            src="/lostlink-badge.png"
            alt="LostLink"
            width="44"
            height="44"
            class="size-9 sm:size-11 rounded-xl object-contain shadow-2xs"
          />
          <span class="font-serif text-xl sm:text-[1.75rem] lg:text-[2.1rem] leading-none font-bold tracking-tight text-forest-900">
            Lost<span class="italic font-black">Link</span>
          </span>
        </a>

        <nav class="hidden items-center gap-6 lg:flex" aria-label="Main Navigation">
          <a
            href="/#feed"
            data-nav-filter="found"
            class="nav-tab text-[0.9375rem] font-semibold text-forest-900/80 transition-colors hover:text-forest-900"
          >
            Found Items
          </a>
          <a
            href="/#feed"
            data-nav-filter="lost"
            class="nav-tab text-[0.9375rem] font-semibold text-forest-900/80 transition-colors hover:text-forest-900"
          >
            Lost Items
          </a>
          <a
            href="/profile"
            class="text-[0.9375rem] font-semibold text-forest-900/80 transition-colors hover:text-forest-900"
          >
            Profile
          </a>
          {isAdmin && (
            <a
              href="/admin"
              class="flex items-center gap-1.5 rounded-full bg-[#164f38] px-3.5 py-1 text-xs font-bold text-[#d8ef8c] hover:bg-[#123e2c] transition-colors shadow-2xs"
            >
              <span class="size-2 rounded-full bg-[#d8ef8c]"></span>
              Admin Console
            </a>
          )}
        </nav>
      </div>

      <!-- Center: Search Pill Input (Desktop/Tablet) -->
      <div class="hidden md:flex flex-1 max-w-xs lg:max-w-md mx-2">
        <div class="relative w-full flex items-center">
          <input
            type="search"
            id="global-search-input"
            placeholder="Search Wallets, Keys, IDs, bags..."
            class="w-full min-h-[3rem] sm:min-h-[3.25rem] rounded-full bg-[#ece5d6] py-2.5 pl-5 pr-11 text-sm sm:text-base text-forest-900 placeholder:text-stone-500 placeholder:font-normal focus:bg-white focus:outline-none focus:ring-2 focus:ring-forest-700/25 transition-all shadow-2xs"
          />
          <svg
            class="pointer-events-none absolute right-4 size-5 text-stone-500"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35m1.85-5.15a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
      </div>

      <!-- Right: Bell, Post Button, Avatar -->
      <div class="flex items-center gap-2.5 sm:gap-4 shrink-0">
        <!-- Notification Bell (44px touch target) -->
        <div class="relative">
          <button
            type="button"
            id="notif-bell-btn"
            aria-label="View notifications"
            class="flex size-10 sm:size-11 items-center justify-center rounded-full border border-line bg-white text-forest-900 shadow-2xs transition-all hover:bg-stone-50 active:scale-95 cursor-pointer"
          >
            <svg
              class="size-5"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
            </svg>
            <span
              id="notif-unread-dot"
              class={`absolute top-2 right-2 size-2.5 rounded-full bg-[#9b2c1f] ${unreadNotifCount > 0 ? "" : "hidden"}`}
            ></span>
          </button>

          <!-- Notification Popover -->
          <div
            id="notif-popover"
            class="absolute right-0 top-14 z-50 hidden w-72 sm:w-80 rounded-2xl border border-line bg-white p-4 shadow-xl"
          >
            <div class="flex items-center justify-between border-b border-line pb-2.5">
              <span class="text-sm font-bold text-forest-900">Notifications</span>
              <div class="flex items-center gap-2">
                <span id="notif-unread-badge" class="rounded-full bg-forest-700/10 px-2.5 py-0.5 text-xs font-semibold text-forest-900">
                  {unreadNotifCount > 0 ? `${unreadNotifCount} new` : "All caught up"}
                </span>
                {unreadNotifCount > 0 && (
                  <button
                    type="button"
                    id="mark-all-notifs-read-btn"
                    class="text-[11px] font-bold text-forest-700 hover:underline cursor-pointer"
                  >
                    Mark read
                  </button>
                )}
              </div>
            </div>

            <div id="notif-list-container" class="mt-3 space-y-2.5 max-h-72 overflow-y-auto pr-1">
              {liveNotifications.length > 0 ? (
                liveNotifications.map((notif) => (
                  <a
                    href={notif.link || "#"}
                    class={`block rounded-xl p-3 text-xs sm:text-sm border transition-all ${
                      !notif.read
                        ? "bg-[#f5f1e6]/90 border-line/70 font-medium"
                        : "bg-white border-transparent hover:bg-stone-50"
                    }`}
                  >
                    <div class="flex items-start justify-between gap-2">
                      <p class="font-bold text-forest-900 leading-tight">
                        {notif.message.includes("submitted")
                          ? "Report Submitted"
                          : notif.message.includes("approved")
                          ? "Report Approved"
                          : notif.message.includes("verified")
                          ? "Claim Verified"
                          : notif.message.includes("denied")
                          ? "Claim Update"
                          : "Campus Notification"}
                      </p>
                      {!notif.read && (
                        <span class="size-1.5 shrink-0 rounded-full bg-[#164f38] mt-1"></span>
                      )}
                    </div>
                    <p class="mt-1 text-stone-600 leading-relaxed text-xs">
                      {notif.message}
                    </p>
                    <span class="mt-1.5 block text-[10px] text-stone-400">
                      {formatNotifTime(notif.created_at)}
                    </span>
                  </a>
                ))
              ) : (
                <div class="py-6 text-center text-xs text-stone-500">
                  <p class="font-semibold text-forest-900">No notifications yet</p>
                  <p class="mt-1">When reports or claims update, they will appear here.</p>
                </div>
              )}
            </div>
          </div>
        </div>

        <!-- Post an item Button -->
        <button
          type="button"
          id="top-post-item-btn"
          class="flex min-h-10 sm:min-h-11 items-center gap-1.5 sm:gap-2 rounded-full bg-forest-700 px-3.5 sm:px-6 py-2 sm:py-2.5 text-xs sm:text-[0.9375rem] font-bold text-white shadow-2xs transition-all hover:bg-forest-900 hover:shadow-sm active:scale-95 cursor-pointer"
        >
          <span class="hidden sm:inline">Post an item</span>
          <span class="sm:hidden">Post</span>
          <span class="text-base leading-none font-bold">+</span>
        </button>

        <!-- Avatar Pill with User Menu Dropdown -->
        <div class="relative">
          <button
            type="button"
            id="user-avatar-btn"
            aria-label="User account menu"
            class="flex size-10 sm:size-11 items-center justify-center rounded-full border border-lime-600/30 bg-[#d8ef8c] text-sm sm:text-base font-black text-forest-900 shadow-2xs transition-all hover:opacity-90 active:scale-95 cursor-pointer"
          >
            {initials}
          </button>

          <!-- Dropdown Menu -->
          <div
            id="user-menu-dropdown"
            class="absolute right-0 top-14 z-50 hidden w-64 rounded-2xl border border-line bg-white p-4 shadow-xl"
          >
            <div class="border-b border-line pb-3">
              <p class="text-xs font-semibold text-stone-500">Signed in as</p>
              <p class="truncate text-sm font-bold text-forest-900" title={userEmail}>
                {userEmail}
              </p>
              <span class="mt-1.5 inline-block rounded-full bg-forest-700/10 px-2.5 py-0.5 text-xs font-semibold text-forest-900">
                {isAdmin ? "DLSAU Disciplinary Admin" : "DLSAU Student"}
              </span>
            </div>

            <div class="mt-3 space-y-1.5">
              {isAdmin && (
                <a
                  href="/admin"
                  class="flex items-center justify-between rounded-xl bg-[#164f38]/10 px-3 py-2 text-sm font-bold text-[#164f38] hover:bg-[#164f38]/20 transition-colors"
                >
                  <span>Admin Console</span>
                  <span class="rounded-full bg-[#d8ef8c] px-2 py-0.5 text-[10px] font-black text-[#164f38]">DO</span>
                </a>
              )}
              <a
                href="#feed"
                class="block rounded-xl px-3 py-2 text-sm font-medium text-forest-900 hover:bg-[#f5f1e6]"
              >
                Browse Campus Feed
              </a>
              <a
                href="/profile"
                class="block rounded-xl px-3 py-2 text-sm font-medium text-forest-900 hover:bg-[#f5f1e6]"
              >
                Profile &amp; Overview
              </a>
            </div>

            <div class="mt-3 border-t border-line pt-3">
              <form method="POST" action={actions.logout}>
                <button
                  type="submit"
                  class="w-full rounded-xl bg-[#9b2c1f]/10 px-3 py-2.5 text-left text-sm font-bold text-[#9b2c1f] transition-colors hover:bg-[#9b2c1f]/20 cursor-pointer"
                >
                  Sign out
                </button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Mobile Search Bar (Phone screens) -->
    <div class="mt-3 md:hidden">
      <div class="relative w-full flex items-center">
        <input
          type="search"
          id="mobile-search-input"
          placeholder="Search Wallets, Keys, IDs, bags..."
          class="w-full min-h-[2.85rem] rounded-full bg-[#ece5d6] py-2 pl-4 pr-10 text-sm text-forest-900 placeholder:text-stone-500 placeholder:font-normal focus:bg-white focus:outline-none focus:ring-2 focus:ring-forest-700/25 transition-all shadow-2xs"
        />
        <svg
          class="pointer-events-none absolute right-3.5 size-4 text-stone-500"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35m1.85-5.15a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>
    </div>
  </div>

  <script is:inline>
    (function () {
      const avatarBtn = document.getElementById("user-avatar-btn");
      const userMenu = document.getElementById("user-menu-dropdown");
      const notifBtn = document.getElementById("notif-bell-btn");
      const notifPopover = document.getElementById("notif-popover");
      const markReadBtn = document.getElementById("mark-all-notifs-read-btn");
      const postBtn = document.getElementById("top-post-item-btn");

      if (avatarBtn && userMenu) {
        avatarBtn.addEventListener("click", (e) => {
          e.stopPropagation();
          if (notifPopover) notifPopover.classList.add("hidden");
          userMenu.classList.toggle("hidden");
        });
      }

      if (notifBtn && notifPopover) {
        notifBtn.addEventListener("click", (e) => {
          e.stopPropagation();
          if (userMenu) userMenu.classList.add("hidden");
          notifPopover.classList.toggle("hidden");
        });
      }

      if (markReadBtn) {
        markReadBtn.addEventListener("click", async (e) => {
          e.stopPropagation();
          const dot = document.getElementById("notif-unread-dot");
          const badge = document.getElementById("notif-unread-badge");
          if (dot) dot.classList.add("hidden");
          if (badge) badge.textContent = "All caught up";
          markReadBtn.classList.add("hidden");
          try {
            await fetch("/api/notifications", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ markAllRead: true }),
            });
          } catch (err) {
            console.warn("[notifs] Mark read notice:", err);
          }
        });
      }

      if (postBtn) {
        postBtn.addEventListener("click", () => {
          if (typeof window.openReport === "function") {
            window.openReport("found");
          } else {
            window.location.href = "/?report=found";
          }
        });
      }

      // Close dropdowns on outside click
      document.addEventListener("click", (e) => {
        if (userMenu && !userMenu.contains(e.target) && !avatarBtn?.contains(e.target)) {
          userMenu.classList.add("hidden");
        }
        if (notifPopover && !notifPopover.contains(e.target) && !notifBtn?.contains(e.target)) {
          notifPopover.classList.add("hidden");
        }
      });

      // Handle search on non-index pages
      function handleSearchEnter(input) {
        if (!input) return;
        input.addEventListener("keydown", (e) => {
          if (e.key === "Enter") {
            e.preventDefault();
            const val = input.value.trim();
            if (window.location.pathname === "/") {
              const mainSearch = document.getElementById("global-search-input");
              if (mainSearch && mainSearch !== input) {
                mainSearch.value = val;
                mainSearch.dispatchEvent(new Event("input"));
              }
            } else {
              window.location.href = `/?search=${encodeURIComponent(val)}`;
            }
          }
        });
      }

      handleSearchEnter(document.getElementById("global-search-input"));
      handleSearchEnter(document.getElementById("mobile-search-input"));
    })();
  </script>
</header>
