---
import { INITIAL_ITEMS, EXTRA_ITEMS, type DashboardItem } from "~/data/mockItems";
import ItemCard from "./ItemCard.astro";

interface Props {
  items?: DashboardItem[];
  isAdmin?: boolean;
}

const { items, isAdmin = false } = Astro.props;
const displayItems = items !== undefined ? items : [...INITIAL_ITEMS, ...EXTRA_ITEMS];
const initialDisplay = displayItems.slice(0, 8);
const extraDisplay = displayItems.slice(8);
const totalCount = displayItems.length;
const showingCount = Math.min(8, totalCount);
---

<section id="feed" class="mx-auto w-full max-w-7xl px-4 sm:px-10 lg:px-14 py-6 sm:py-10" aria-labelledby="latest-heading">
  <!-- Section Header (Scaled up) -->
  <div class="flex flex-wrap items-end justify-between gap-3 sm:gap-4 pb-5 sm:pb-8">
    <div>
      <h2 id="latest-heading" class="font-serif text-[clamp(1.75rem,4vw,2.65rem)] font-black text-forest-900 leading-tight">
        Latest on campus
      </h2>
      <p id="feed-subtitle" class="mt-1 text-sm sm:text-base text-forest-900/75">
        Showing {showingCount} of {totalCount} items, newest first.
      </p>
    </div>

    <button
      type="button"
      id="view-all-items-btn"
      class="inline-flex min-h-11 items-center gap-1.5 text-sm sm:text-base font-bold text-forest-900 underline underline-offset-4 hover:text-forest-700 cursor-pointer"
    >
      <span>View all items</span>
      <span aria-hidden="true"><svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></span>
    </button>
  </div>

  <!-- Filter Controls Toolbar embedded inside Latest Items -->
  <div class="mb-5 sm:mb-8 relative z-30">
    <slot name="filters" />
  </div>

  <!-- Skeleton Loading Cards Grid (Displays during filtering/search transitions) -->
  <div
    id="skeleton-grid"
    class="hidden relative z-10 grid grid-cols-1 gap-5 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 sm:gap-6 lg:gap-7"
    aria-hidden="true"
  >
    {[1, 2, 3, 4, 5, 6, 7, 8].map(() => (
      <div class="skeleton-card flex flex-col justify-between overflow-hidden shadow-2xs">
        <div class="skeleton-pulse h-48 sm:h-52 lg:h-56 w-full rounded-none"></div>
        <div class="flex flex-1 flex-col justify-between bg-white p-5 sm:p-6 space-y-4">
          <div class="space-y-2">
            <div class="skeleton-pulse h-3 w-20"></div>
            <div class="skeleton-pulse h-5 w-4/5"></div>
          </div>
          <div class="pt-4 flex items-end justify-between gap-3">
            <div class="space-y-1.5 flex-1">
              <div class="skeleton-pulse h-2.5 w-16"></div>
              <div class="skeleton-pulse h-4 w-28"></div>
            </div>
            <div class="skeleton-pulse h-6 w-14"></div>
          </div>
          <div class="pt-4 border-t border-line/60 flex items-center justify-between">
            <div class="skeleton-pulse h-3.5 w-24"></div>
            <div class="skeleton-pulse size-3.5 rounded-full"></div>
          </div>
        </div>
      </div>
    ))}
  </div>

  <!-- Cards Grid (Fluid 1 -> 2 -> 3 -> 4 columns) -->
  <div
    id="items-grid"
    class="relative z-10 grid grid-cols-1 gap-5 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 sm:gap-6 lg:gap-7"
  >
    <!-- Initial Cards -->
    {initialDisplay.map((item) => (
      <ItemCard item={item} isAdmin={isAdmin} />
    ))}

    <!-- Additional items loaded on click -->
    {extraDisplay.map((item) => (
      <div class="extra-item hidden">
        <ItemCard item={item} isAdmin={isAdmin} />
      </div>
    ))}
  </div>

  <!-- Empty State when filters yield 0 results -->
  <div
    id="empty-state"
    class="hidden my-14 rounded-card border border-line bg-white/80 p-10 text-center sm:p-14"
  >
    <div class="mx-auto flex size-14 items-center justify-center rounded-full bg-[#ece5d6] text-forest-900">
      <svg class="size-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35m1.85-5.15a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
    </div>
    <h3 class="mt-5 font-serif text-xl sm:text-2xl font-bold text-forest-900">No matching items found</h3>
    <p class="mt-2 text-sm text-stone-600 max-w-md mx-auto leading-relaxed">
      Try adjusting your search terms or clearing current filters to browse all campus lost and found reports.
    </p>
    <button
      type="button"
      id="empty-clear-filters-btn"
      class="mt-6 inline-flex min-h-11 items-center rounded-full bg-forest-700 px-6 py-2.5 text-sm font-bold text-white shadow-2xs hover:bg-forest-900 active:scale-95 transition-all cursor-pointer"
    >
      Clear all filters
    </button>
  </div>

  <!-- Load More Button (Scaled up) -->
  <div class="mt-10 text-center sm:mt-12">
    <button
      type="button"
      id="load-more-btn"
      class="inline-flex min-h-[3.25rem] items-center gap-2 rounded-full border border-forest-900/40 bg-white/90 px-8 sm:px-10 py-3 text-sm sm:text-base font-bold text-forest-900 shadow-2xs transition-all hover:bg-white active:scale-95 cursor-pointer"
    >
      <span>Load more items</span>
    </button>
  </div>
</section>
