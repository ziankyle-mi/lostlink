---
interface Props {
  icon: "wallet" | "bottle" | "id-card" | "keys" | "laptop" | "earbuds" | "backpack" | "umbrella";
  class?: string;
}

const { icon, class: className = "w-16 h-12" } = Astro.props;
---

{icon === "wallet" && (
  <svg viewBox="0 0 72 50" class={className} fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <rect x="6" y="6" width="60" height="38" rx="8" stroke="#17503a" stroke-width="2.6" />
    <line x1="6" y1="16" x2="66" y2="16" stroke="#17503a" stroke-width="2.4" />
    <circle cx="50" cy="27" r="3.5" fill="#d8ef8c" stroke="#17503a" stroke-width="2.2" />
  </svg>
)}

{icon === "bottle" && (
  <svg viewBox="0 0 50 72" class={className} fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <rect x="15" y="8" width="20" height="9" rx="2" fill="#d8ef8c" stroke="#17503a" stroke-width="2.6" stroke-linejoin="round" />
    <path d="M18 17V23L12 30V62C12 64.2 13.8 66 16 66H34C36.2 66 38 64.2 38 62V30L32 23V17" stroke="#17503a" stroke-width="2.6" stroke-linejoin="round" />
    <line x1="12" y1="44" x2="38" y2="44" stroke="#17503a" stroke-width="2.4" />
  </svg>
)}

{icon === "id-card" && (
  <svg viewBox="0 0 72 50" class={className} fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <rect x="6" y="6" width="60" height="38" rx="7" stroke="#17503a" stroke-width="2.6" />
    <circle cx="23" cy="20" r="4.5" fill="#d8ef8c" stroke="#17503a" stroke-width="2.2" />
    <path d="M15 33C15 28.5 18.5 27 23 27C27.5 27 31 28.5 31 33" stroke="#17503a" stroke-width="2.2" stroke-linecap="round" />
    <line x1="39" y1="19" x2="55" y2="19" stroke="#17503a" stroke-width="2.4" stroke-linecap="round" />
    <line x1="39" y1="26" x2="51" y2="26" stroke="#17503a" stroke-width="2.4" stroke-linecap="round" />
  </svg>
)}

{icon === "keys" && (
  <svg viewBox="0 0 72 50" class={className} fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <circle cx="20" cy="25" r="9" stroke="#17503a" stroke-width="2.6" />
    <circle cx="20" cy="25" r="2.5" fill="#d8ef8c" stroke="#17503a" stroke-width="2" />
    <line x1="29" y1="25" x2="58" y2="25" stroke="#17503a" stroke-width="2.6" stroke-linecap="round" />
    <line x1="51" y1="25" x2="51" y2="33" stroke="#17503a" stroke-width="2.6" stroke-linecap="round" />
    <line x1="57" y1="25" x2="57" y2="32" stroke="#17503a" stroke-width="2.6" stroke-linecap="round" />
  </svg>
)}

{icon === "laptop" && (
  <svg viewBox="0 0 72 50" class={className} fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <rect x="16" y="8" width="40" height="26" rx="4" stroke="#17503a" stroke-width="2.6" />
    <rect x="22" y="13" width="28" height="16" rx="1.5" fill="#d8ef8c" stroke="#17503a" stroke-width="2" />
    <line x1="10" y1="38" x2="62" y2="38" stroke="#17503a" stroke-width="2.8" stroke-linecap="round" />
  </svg>
)}

{icon === "earbuds" && (
  <svg viewBox="0 0 72 50" class={className} fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <rect x="16" y="11" width="40" height="28" rx="14" stroke="#17503a" stroke-width="2.6" />
    <line x1="16" y1="25" x2="56" y2="25" stroke="#17503a" stroke-width="2.2" />
    <circle cx="36" cy="25" r="3" fill="#d8ef8c" stroke="#17503a" stroke-width="2" />
  </svg>
)}

{icon === "backpack" && (
  <svg viewBox="0 0 50 72" class={className} fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <path d="M20 12C20 9 22 7 25 7C28 7 30 9 30 12" stroke="#17503a" stroke-width="2.6" stroke-linecap="round" />
    <rect x="10" y="12" width="30" height="48" rx="10" stroke="#17503a" stroke-width="2.6" />
    <line x1="16" y1="24" x2="34" y2="24" stroke="#17503a" stroke-width="2.4" stroke-linecap="round" />
    <rect x="15" y="32" width="20" height="18" rx="5" fill="#d8ef8c" stroke="#17503a" stroke-width="2.2" />
  </svg>
)}

{icon === "umbrella" && (
  <svg viewBox="0 0 72 50" class={className} fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <path d="M12 24C12 14 22 8 36 8C50 8 60 14 60 24C56 22 52 23 48 25C44 23 40 23 36 25C32 23 28 23 24 25C20 23 16 22 12 24Z" fill="#d8ef8c" stroke="#17503a" stroke-width="2.4" stroke-linejoin="round" />
    <line x1="36" y1="5" x2="36" y2="8" stroke="#17503a" stroke-width="2.6" stroke-linecap="round" />
    <path d="M36 24V37C36 41 33 43 30 43C27 43 25 41 25 38" stroke="#17503a" stroke-width="2.6" stroke-linecap="round" />
  </svg>
)}
