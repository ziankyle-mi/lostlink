---
import Icon from "./Icon.astro";

const badges = [
  {
    icon: "shield",
    title: "Secure Access",
    text: "For DLSAU students and staff",
  },
  {
    icon: "key",
    title: "Easy Recovery",
    text: "Reset your password in a few steps",
  },
  {
    icon: "pin",
    title: "Always Here",
    text: "Find what's lost. Return what's found.",
  },
] as const;
---

<ul class="mx-auto grid w-full max-w-4xl gap-7 px-4 sm:grid-cols-3 sm:gap-6">
  {
    badges.map((badge) => (
      <li class="flex items-start gap-4">
        <span class="grid size-12 shrink-0 place-items-center rounded-full border border-line/60 bg-forest-700/[0.04] text-forest-700">
          <Icon name={badge.icon} class="size-5" />
        </span>
        <span class="min-w-0">
          <span class="block text-[1rem] font-bold text-forest-900">{badge.title}</span>
          <span class="mt-1 block text-[0.875rem] font-medium leading-normal text-forest-900/80">{badge.text}</span>
        </span>
      </li>
    ))
  }
</ul>