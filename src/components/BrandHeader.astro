---
/** Brand lockup from the Figma frames: seal | divider | green tile | wordmark. */
---

<header class="flex items-center gap-3 sm:gap-4">
  <a
    href="https://www.dlsau.edu.ph/#gsc.tab=0"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="De La Salle Araneta University website (opens in a new tab)"
    class="shrink-0 rounded-sm"
  >
    <img
      src="/dlsau-logo.png"
      alt="De La Salle Araneta University"
      width="56"
      height="56"
      class="size-11 object-contain sm:size-14"
    />
  </a>
  <span class="h-10 w-px bg-line sm:h-12" aria-hidden="true"></span>
  <img
    src="/lostlink-badge.png"
    alt=""
    width="44"
    height="44"
    class="size-10 shrink-0 object-contain sm:size-11"
  />
  <p class="font-serif text-[1.75rem] leading-none font-bold tracking-tight text-forest-900 sm:text-[2.1rem]">
    Lost<span class="italic font-black">Link</span>
  </p>
</header>
