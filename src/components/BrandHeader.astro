---
/** Brand lockup copied from context/dashboard.jpg: seal | divider | mark | wordmark. */
---

<header class="flex items-center gap-3">
  <img
    src="/dlsau-logo.svg"
    alt="De La Salle Araneta University seal"
    width="44"
    height="44"
    class="size-11 shrink-0"
  />
  <span class="h-9 w-px bg-sage-400/70" aria-hidden="true"></span>
  <img
    src="/lostlink-logo.jpg"
    alt=""
    width="44"
    height="44"
    class="size-11 shrink-0 rounded-xl"
  />
  <div class="min-w-0">
    <p class="text-[1.15rem] font-semibold leading-none text-forest-700">LostLink</p>
    <p class="mt-1.5 text-[0.6875rem] leading-none text-sage-600">
      DLSAU Web-based Lost and Found System
    </p>
  </div>
</header>