---
/** Brand lockup from the mockup: seal | divider | green tile | wordmark.
    The minimal logo is white artwork, so it sits on the dark tile. */
---

<header class="flex items-center gap-3 sm:gap-3.5">
  <a
    href="https://www.dlsau.edu.ph/#gsc.tab=0"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="De La Salle Araneta University website (opens in a new tab)"
    class="shrink-0 rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-forest-700"
  >
    <img
      src="/dlsau-logo.png"
      alt="De La Salle Araneta University"
      width="56"
      height="56"
      class="size-12 sm:size-14 object-contain"
    />
  </a>
  <span class="h-10 sm:h-11 w-px bg-sage-400/70" aria-hidden="true"></span>
  <img
    src="/lostlink-badge.png"
    alt="LostLink"
    width="44"
    height="44"
    class="size-10 sm:size-11 shrink-0 object-contain"
  />
  <div class="min-w-0 pl-0.5">
    <p class="text-2xl font-bold tracking-tight leading-none text-forest-900 sm:text-[1.7rem]">
      LostLink
    </p>
    <p class="mt-2 text-[0.8rem] font-medium leading-none text-sage-600">
      DLSAU Lost and Found System
    </p>
  </div>
</header>