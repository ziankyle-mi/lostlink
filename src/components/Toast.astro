---
// Global toast notification system.
// Include once in any layout. Call `window.llToast(message, type?)` from JS.
// Types: 'success' (default), 'error', 'info'
---

<!-- Toast container injected once per page -->
<div id="ll-toast-container" class="ll-toast-container" aria-live="polite" aria-atomic="false"></div>

<script>
    // @ts-nocheck -- legacy DOM script, migrated out of is:inline for CSP.
  (function () {
    if (window.llToast) return; // Already initialised

    const DISMISS_MS = 3500;

    /**
     * Show a toast notification.
     * @param {string} message - Text to display
     * @param {'success'|'error'|'info'} [type='success'] - Icon style
     */
    window.llToast = function llToast(message, type) {
      type = type || "success";
      var container = document.getElementById("ll-toast-container");
      if (!container) return;

      var toast = document.createElement("div");
      toast.className = "ll-toast";
      toast.setAttribute("role", "status");

      var icon = document.createElement("span");
      icon.className = "ll-toast-icon " + type;
      icon.textContent = type === "success" ? "OK" : type === "error" ? "!" : "i";

      var text = document.createElement("span");
      text.textContent = message;

      toast.appendChild(icon);
      toast.appendChild(text);
      container.appendChild(toast);

      // Auto-dismiss
      setTimeout(function () {
        toast.classList.add("toast-out");
        setTimeout(function () {
          if (toast.parentNode) toast.parentNode.removeChild(toast);
        }, 300);
      }, DISMISS_MS);
    };
  })();
</script>
