---
import { actions } from "astro:actions";
import BrandMark from "~/components/BrandMark.astro";
import { DEMO_STATS, FOUND_COUNT, LOST_COUNT } from "~/data/mockItems";
import { adminClaims, studentClaims } from "~/components/admin/ClaimsVerificationTable.astro";

interface Props {
  role?: "admin" | "student";
  activeTab?: string;
  userEmail?: string;
}

const {
  role = "admin",
  activeTab = "overview",
  userEmail = "dlsau.lostlink@dlsau.edu.ph",
} = Astro.props;

const isAdmin = role === "admin";

function initialsOf(email: string): string {
  if (isAdmin) return "DO";
  const segments = email.split("@")[0].split(/[._-]/).filter(Boolean);
  if (segments.length >= 2) return (segments[0][0] + segments[1][0]).toUpperCase();
  if (segments.length === 1 && segments[0].length >= 2) return segments[0].slice(0, 2).toUpperCase();
  return "ST";
}

const initials = initialsOf(userEmail);
const userName = isAdmin
  ? "Disciplinary Office"
  : userEmail.split("@")[0].replace(/[._-]/g, " ").replace(/\b\w/g, (c) => c.toUpperCase());
---

<aside
  class="w-full lg:w-[20.5rem] shrink-0 rounded-[2rem] bg-[#164f38] p-6 sm:p-7 text-white shadow-xl flex flex-col justify-between"
  aria-label="Console Navigation"
>
  <div>
    <!-- Brand Header -->
    <div class="border-b border-[#24694b] pb-6">
      <div class="flex items-center gap-3">
        <BrandMark class="size-10" />
        <span class="font-serif text-2xl font-black tracking-tight text-white">
          Lost<span class="italic font-bold text-[#d8ef8c]">Link</span>
        </span>
      </div>

      <div class="mt-3">
        <span
          class="inline-block rounded-full border border-[#2d6e4f] bg-[#134631] px-3.5 py-1 text-[10px] font-black tracking-[0.2em] text-[#d8ef8c] uppercase shadow-inner"
        >
          {isAdmin ? "ADMIN CONSOLE" : "STUDENT CONSOLE"}
        </span>
      </div>
    </div>

    <!-- Navigation Menu -->
    <nav class="mt-6 space-y-1.5" aria-label="Console Sections">
      <!-- Overview -->
      <a
        href={isAdmin ? "/admin" : "/profile"}
        class={`flex items-center justify-between rounded-2xl px-4 py-3 text-sm font-bold transition-all ${
          activeTab === "overview"
            ? "bg-[#d8ef8c] text-[#164f38] shadow-xs"
            : "text-white/85 hover:bg-white/10 hover:text-white"
        }`}
      >
        <span class="flex items-center gap-3.5">
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="7" height="7" x="3" y="3" rx="1.5"></rect>
            <rect width="7" height="7" x="14" y="3" rx="1.5"></rect>
            <rect width="7" height="7" x="14" y="14" rx="1.5"></rect>
            <rect width="7" height="7" x="3" y="14" rx="1.5"></rect>
          </svg>
          Overview
        </span>
      </a>

      {isAdmin ? (
        <>
          <!-- Claims (Admin) -->
          <a
            href="/admin#claims"
            class={`flex items-center justify-between rounded-2xl px-4 py-3 text-sm font-semibold transition-all ${
              activeTab === "claims"
                ? "bg-[#d8ef8c] text-[#164f38]"
                : "text-white/85 hover:bg-white/10 hover:text-white"
            }`}
          >
            <span class="flex items-center gap-3.5">
              <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 11l3 3L22 4"></path>
                <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
              </svg>
              Claims
            </span>
            <span class="flex size-6 items-center justify-center rounded-full bg-[#d8ef8c] text-xs font-black text-[#164f38]">
              {adminClaims.length}
            </span>
          </a>

          <!-- Found inventory (Admin) -->
          <a
            href="/admin#inventory"
            class="flex items-center justify-between rounded-2xl px-4 py-3 text-sm font-semibold text-white/85 hover:bg-white/10 hover:text-white transition-all"
          >
            <span class="flex items-center gap-3.5">
              <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m7.5 4.27 9 5.15"></path>
                <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"></path>
                <path d="m3.3 7 8.7 5 8.7-5"></path>
                <path d="M12 22V12"></path>
              </svg>
              Found inventory
            </span>
            <span class="text-xs font-semibold text-stone-300">{FOUND_COUNT}</span>
          </a>

          <!-- Lost reports (Admin) -->
          <a
            href="/admin#lost-reports"
            class="flex items-center justify-between rounded-2xl px-4 py-3 text-sm font-semibold text-white/85 hover:bg-white/10 hover:text-white transition-all"
          >
            <span class="flex items-center gap-3.5">
              <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <path d="m21 21-4.3-4.3"></path>
              </svg>
              Lost reports
            </span>
            <span class="text-xs font-semibold text-stone-300">{LOST_COUNT}</span>
          </a>

          <!-- Users (Admin) -->
          <a
            href="/admin#users"
            class="flex items-center justify-between rounded-2xl px-4 py-3 text-sm font-semibold text-white/85 hover:bg-white/10 hover:text-white transition-all"
          >
            <span class="flex items-center gap-3.5">
              <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
                <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
              </svg>
              Users
            </span>
          </a>

          <!-- Activity log (Admin) -->
          <a
            href="/admin#activity"
            class="flex items-center justify-between rounded-2xl px-4 py-3 text-sm font-semibold text-white/85 hover:bg-white/10 hover:text-white transition-all"
          >
            <span class="flex items-center gap-3.5">
              <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
              Activity log
            </span>
          </a>

          <!-- Settings (Admin) -->
          <a
            href="/admin#settings"
            class="flex items-center justify-between rounded-2xl px-4 py-3 text-sm font-semibold text-white/85 hover:bg-white/10 hover:text-white transition-all"
          >
            <span class="flex items-center gap-3.5">
              <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
              Settings
            </span>
          </a>
        </>
      ) : (
        <>
          <!-- My Reports (Student) -->
          <a
            href="/profile#reports"
            class="flex items-center justify-between rounded-2xl px-4 py-3 text-sm font-semibold text-white/85 hover:bg-white/10 hover:text-white transition-all"
          >
            <span class="flex items-center gap-3.5">
              <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <path d="m21 21-4.3-4.3"></path>
              </svg>
              My reports
            </span>
            <span class="flex size-6 items-center justify-center rounded-full bg-[#d8ef8c] text-xs font-black text-[#164f38]">
              {DEMO_STATS.myActiveReports}
            </span>
          </a>

          <!-- My Claims (Student) -->
          <a
            href="/profile#claims"
            class="flex items-center justify-between rounded-2xl px-4 py-3 text-sm font-semibold text-white/85 hover:bg-white/10 hover:text-white transition-all"
          >
            <span class="flex items-center gap-3.5">
              <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 11l3 3L22 4"></path>
                <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
              </svg>
              My claims
            </span>
            <span class="text-xs font-semibold text-stone-300">{studentClaims.length}</span>
          </a>

          <!-- Campus feed (Student) -->
          <a
            href="/"
            class="flex items-center justify-between rounded-2xl px-4 py-3 text-sm font-semibold text-white/85 hover:bg-white/10 hover:text-white transition-all"
          >
            <span class="flex items-center gap-3.5">
              <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                <polyline points="9 22 9 12 15 12 15 22"></polyline>
              </svg>
              Campus feed
            </span>
          </a>

          <!-- Help & FAQ (Student) -->
          <a
            href="/help"
            class="flex items-center justify-between rounded-2xl px-4 py-3 text-sm font-semibold text-white/85 hover:bg-white/10 hover:text-white transition-all"
          >
            <span class="flex items-center gap-3.5">
              <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
                <path d="M12 17h.01"></path>
              </svg>
              Help & Guidelines
            </span>
          </a>

          <!-- Settings (Student) -->
          <a
            href="/profile#settings"
            class="flex items-center justify-between rounded-2xl px-4 py-3 text-sm font-semibold text-white/85 hover:bg-white/10 hover:text-white transition-all"
          >
            <span class="flex items-center gap-3.5">
              <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
              Settings
            </span>
          </a>
        </>
      )}
    </nav>
  </div>

  <div class="mt-8">
    <!-- Callout Card -->
    <div class="rounded-2xl bg-[#d8ef8c] p-4.5 text-[#164f38] shadow-sm">
      {isAdmin ? (
        <>
          <p class="text-sm font-bold leading-snug">
            {DEMO_STATS.unclaimed30Days} items unclaimed for 30+ days.
          </p>
          <a
            href="/admin#unclaimed"
            class="mt-2.5 inline-flex items-center gap-1 text-xs font-black underline underline-offset-2 hover:opacity-80 transition-opacity"
          >
            Review them &rarr;
          </a>
        </>
      ) : (
        <>
          <p class="text-sm font-bold leading-snug">
            Have an item to drop off?
          </p>
          <p class="mt-1 text-xs text-[#164f38]/90">
            Disciplinary Office (Admin 1F) is open Mon–Fri, 8AM–5PM.
          </p>
          <a
            href="/help#turn-in"
            class="mt-2.5 inline-flex items-center gap-1 text-xs font-black underline underline-offset-2 hover:opacity-80 transition-opacity"
          >
            Turn-in guide &rarr;
          </a>
        </>
      )}
    </div>

    <!-- User Profile Footer -->
    <div class="mt-4 flex items-center justify-between rounded-2xl bg-[#1c5c42] p-3 text-white">
      <div class="flex items-center gap-3 min-w-0">
        <span
          class="flex size-10 shrink-0 items-center justify-center rounded-full bg-[#d8ef8c] text-sm font-black text-[#164f38]"
        >
          {initials}
        </span>
        <div class="min-w-0">
          <p class="truncate text-sm font-bold text-white leading-tight" title={userName}>
            {userName}
          </p>
          <form method="POST" action={actions.logout} class="mt-0.5">
            <button
              type="submit"
              class="text-xs text-stone-300 hover:text-white transition-colors cursor-pointer"
            >
              Sign out
            </button>
          </form>
        </div>
      </div>

      <a
        href={isAdmin ? "/profile" : "/admin"}
        title={isAdmin ? "Switch to Student View" : "Switch to Admin Console"}
        class="shrink-0 rounded-xl bg-white/10 p-2 text-stone-200 hover:bg-white/20 hover:text-white transition-colors text-xs font-semibold"
      >
        {isAdmin ? "Student" : "Admin"}
      </a>
    </div>
  </div>
</aside>
