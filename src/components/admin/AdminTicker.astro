---
interface Props {
  announcements?: Array<{
    id: string;
    title: string;
    message?: string;
    content?: string;
    priority?: string;
    urgency?: string;
  }>;
}

const { announcements = [] } = Astro.props;
const hasAnnouncements = announcements.length > 0;
---

<div class="relative w-full overflow-hidden bg-forest-700 py-2 sm:py-2.5 text-white" aria-label="Campus Announcement Ticker">
  <div class="animate-ticker flex items-center whitespace-nowrap text-xs sm:text-[0.8125rem] font-medium tracking-wide text-[#dcecd2]">
    <!-- Sequence 1 -->
    <span class="inline-flex items-center gap-5 sm:gap-6 px-6">
      {hasAnnouncements ? (
        announcements.map((ann) => (
          <span class="inline-flex items-center gap-2">
            <span class="size-1.5 rotate-45 bg-lime" aria-hidden="true"></span>
            <span class="font-black text-lime uppercase text-[10px]">[{ann.priority || ann.urgency || "notice"}]:</span>
            <strong class="text-white">{ann.title}</strong>
            <span class="text-lime/90 font-normal">{ann.message || ann.content}</span>
          </span>
        ))
      ) : (
        <>
          <span>A little thing, can mean a lot</span>
          <span class="size-1.5 rotate-45 bg-lime" aria-hidden="true"></span>
          <span>Found something? Post it in under a minute</span>
          <span class="size-1.5 rotate-45 bg-lime" aria-hidden="true"></span>
          <span>Lost something? Tell the community</span>
          <span class="size-1.5 rotate-45 bg-lime" aria-hidden="true"></span>
          <span>Disciplinary Office Room 102 &bull; 8:00 AM &ndash; 5:00 PM</span>
        </>
      )}
    </span>
    <!-- Sequence 2 (for smooth infinite marquee) -->
    <span class="inline-flex items-center gap-5 sm:gap-6 px-6" aria-hidden="true">
      {hasAnnouncements ? (
        announcements.map((ann) => (
          <span class="inline-flex items-center gap-2">
            <span class="size-1.5 rotate-45 bg-lime"></span>
            <span class="font-black text-lime uppercase text-[10px]">[{ann.priority || ann.urgency || "notice"}]:</span>
            <strong class="text-white">{ann.title}</strong>
            <span class="text-lime/90 font-normal">{ann.message || ann.content}</span>
          </span>
        ))
      ) : (
        <>
          <span>A little thing, can mean a lot</span>
          <span class="size-1.5 rotate-45 bg-lime"></span>
          <span>Found something? Post it in under a minute</span>
          <span class="size-1.5 rotate-45 bg-lime"></span>
          <span>Lost something? Tell the community</span>
          <span class="size-1.5 rotate-45 bg-lime"></span>
          <span>Disciplinary Office Room 102 &bull; 8:00 AM &ndash; 5:00 PM</span>
        </>
      )}
    </span>
  </div>
</div>
