---
import { FOUND_COUNT, LOST_COUNT } from "~/data/mockItems";

interface Props {
  role?: "admin" | "student";
  metrics?: {
    itemsInCustody?: number;
    activeLostReports?: number;
    claimsToVerify?: number;
    returnedThisMonth?: number;
  };
}

const { role = "admin", metrics } = Astro.props;
const isAdmin = role === "admin";

const custodyCount = metrics?.itemsInCustody !== undefined
  ? metrics.itemsInCustody
  : (isAdmin ? FOUND_COUNT : 0);

const lostCount = metrics?.activeLostReports !== undefined
  ? metrics.activeLostReports
  : (isAdmin ? LOST_COUNT : 0);

const claimsCount = metrics?.claimsToVerify !== undefined
  ? metrics.claimsToVerify
  : 0;

const returnedCount = metrics?.returnedThisMonth !== undefined
  ? metrics.returnedThisMonth
  : 0;
---

<section class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5" aria-label="Key Performance Metrics">
  <!-- Card 1 -->
  <div class="rounded-3xl bg-white p-6 sm:p-7 border border-stone-200/60 shadow-xs flex flex-col justify-between">
    <p class="text-sm font-medium text-stone-600">
      {isAdmin ? "Items in custody" : "My active reports"}
    </p>
    <div class="mt-4">
      <p class="font-serif text-4xl sm:text-5xl font-black text-forest-900 tracking-tight leading-none">
        {custodyCount}
      </p>
      <p class="mt-3 text-xs text-stone-500 font-medium">
        {isAdmin ? `${custodyCount} held in custody` : "Active submissions"}
      </p>
    </div>
  </div>

  <!-- Card 2 -->
  <div
    id="lost-reports"
    class="scroll-mt-8 rounded-3xl bg-white p-6 sm:p-7 border border-stone-200/60 shadow-xs flex flex-col justify-between"
  >
    <p class="text-sm font-medium text-stone-600">
      {isAdmin ? "Active lost reports" : "My pending claims"}
    </p>
    <div class="mt-4">
      <p class="font-serif text-4xl sm:text-5xl font-black text-forest-900 tracking-tight leading-none">
        {lostCount}
      </p>
      <p class="mt-3 text-xs text-stone-500 font-medium">
        {isAdmin ? `${lostCount} active reports` : "Under office verification"}
      </p>
    </div>
  </div>

  <!-- Card 3 (Lime Pill Card) -->
  <div class="rounded-3xl bg-lime p-6 sm:p-7 text-forest-900 shadow-xs flex flex-col justify-between">
    <p class="text-sm font-bold text-forest-900">
      {isAdmin ? "Claims to verify" : "Ready for pickup"}
    </p>
    <div class="mt-4">
      <p class="font-serif text-4xl sm:text-5xl font-black text-forest-900 tracking-tight leading-none">
        {claimsCount}
      </p>
      <p class="mt-3 text-xs font-semibold text-forest-900">
        {isAdmin ? (claimsCount > 0 ? `${claimsCount} pending verification` : "No pending claims") : "Visit Disciplinary Office"}
      </p>
    </div>
  </div>

  <!-- Card 4 (Dark Forest Green Card) -->
  <div class="rounded-3xl bg-forest-700 p-6 sm:p-7 text-white shadow-xs flex flex-col justify-between">
    <p class="text-sm font-medium text-stone-200">
      {isAdmin ? "Returned this month" : "Campus recovered"}
    </p>
    <div class="mt-4">
      <p class="font-serif text-4xl sm:text-5xl font-black text-white tracking-tight leading-none">
        {returnedCount}
      </p>
      <p class="mt-3 text-xs font-semibold text-lime">
        {isAdmin ? `${returnedCount} items returned` : "Campus reunited this term"}
      </p>
    </div>
  </div>
</section>
