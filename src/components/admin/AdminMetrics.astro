---
import { DEMO_STATS, FOUND_COUNT, LOST_COUNT } from "~/data/mockItems";
import { adminClaims, studentClaims } from "~/components/admin/ClaimsVerificationTable.astro";

interface Props {
  role?: "admin" | "student";
  metrics?: {
    itemsInCustody?: number;
    activeLostReports?: number;
    claimsToVerify?: number;
    returnedThisMonth?: number;
  };
}

const { role = "admin", metrics } = Astro.props;
const isAdmin = role === "admin";

const officeNowCount = adminClaims.filter((claim) => claim.statusText === "At the office now").length;
const readyForPickupCount = studentClaims.filter(
  (claim) => claim.statusText === "At the office now" || claim.statusText === "In DO custody",
).length;

const custodyCount = metrics?.itemsInCustody !== undefined && metrics.itemsInCustody > 0
  ? metrics.itemsInCustody
  : (isAdmin ? FOUND_COUNT : DEMO_STATS.myActiveReports);

const lostCount = metrics?.activeLostReports !== undefined && metrics.activeLostReports > 0
  ? metrics.activeLostReports
  : (isAdmin ? LOST_COUNT : studentClaims.length);

const claimsCount = metrics?.claimsToVerify !== undefined && metrics.claimsToVerify > 0
  ? metrics.claimsToVerify
  : (isAdmin ? adminClaims.length : readyForPickupCount);

const returnedCount = metrics?.returnedThisMonth !== undefined && metrics.returnedThisMonth > 0
  ? metrics.returnedThisMonth
  : (isAdmin ? DEMO_STATS.returnedThisMonth : DEMO_STATS.campusRecovered);
---

<section class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5" aria-label="Key Performance Metrics">
  <!-- Card 1 -->
  <div class="rounded-3xl bg-white p-6 sm:p-7 border border-stone-200/60 shadow-xs flex flex-col justify-between">
    <p class="text-sm font-medium text-stone-600">
      {isAdmin ? "Items in custody" : "My active reports"}
    </p>
    <div class="mt-4">
      <p class="font-serif text-4xl sm:text-5xl font-black text-forest-900 tracking-tight leading-none">
        {custodyCount}
      </p>
      <p class="mt-3 text-xs text-stone-500 font-medium">
        {isAdmin ? `+${DEMO_STATS.itemsInCustodyDelta} this week` : DEMO_STATS.myActiveReportsNote}
      </p>
    </div>
  </div>

  <!-- Card 2 -->
  <div class="rounded-3xl bg-white p-6 sm:p-7 border border-stone-200/60 shadow-xs flex flex-col justify-between">
    <p class="text-sm font-medium text-stone-600">
      {isAdmin ? "Active lost reports" : "My pending claims"}
    </p>
    <div class="mt-4">
      <p class="font-serif text-4xl sm:text-5xl font-black text-forest-900 tracking-tight leading-none">
        {lostCount}
      </p>
      <p class="mt-3 text-xs text-stone-500 font-medium">
        {isAdmin ? `+${DEMO_STATS.lostDelta} this week` : "Under office verification"}
      </p>
    </div>
  </div>

  <!-- Card 3 (Lime Pill Card) -->
  <div class="rounded-3xl bg-[#d8ef8c] p-6 sm:p-7 text-forest-900 shadow-xs flex flex-col justify-between">
    <p class="text-sm font-bold text-forest-900">
      {isAdmin ? "Claims to verify" : "Ready for pickup"}
    </p>
    <div class="mt-4">
      <p class="font-serif text-4xl sm:text-5xl font-black text-forest-900 tracking-tight leading-none">
        {claimsCount}
      </p>
      <p class="mt-3 text-xs font-semibold text-forest-800">
        {isAdmin ? `${officeNowCount} student at the office now` : "Visit Disciplinary Office"}
      </p>
    </div>
  </div>

  <!-- Card 4 (Dark Forest Green Card) -->
  <div class="rounded-3xl bg-[#164f38] p-6 sm:p-7 text-white shadow-xs flex flex-col justify-between">
    <p class="text-sm font-medium text-stone-200">
      {isAdmin ? "Returned this month" : "Campus recovered"}
    </p>
    <div class="mt-4">
      <p class="font-serif text-4xl sm:text-5xl font-black text-white tracking-tight leading-none">
        {returnedCount}
      </p>
      <p class="mt-3 text-xs font-semibold text-[#d8ef8c]">
        {isAdmin ? `+${DEMO_STATS.returnedDelta} vs last month` : "Campus reunited this term"}
      </p>
    </div>
  </div>
</section>
