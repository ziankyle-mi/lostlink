        </button>
        <button
          type="button"
          id="confirm-role-change-btn"
          class="rounded-full bg-forest-700 hover:bg-forest-900 active:scale-95 px-6 py-2.5 text-xs font-bold text-[#d8ef8c] transition-all shadow-xs cursor-pointer"
        >
          Confirm role change
        </button>
      </div>
    </div>
  </div>

  <!-- Status Toggle Confirmation Modal -->
  <div
    id="user-status-modal"
    class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/50 p-4 backdrop-blur-sm"
    role="dialog"
    aria-modal="true"
  >
    <div class="relative w-full max-w-md rounded-card border border-line bg-white p-6 sm:p-8 shadow-card max-h-[90dvh] overflow-y-auto">
      <div class="flex items-center justify-between border-b border-stone-100 pb-4">
        <div>
          <span id="status-modal-badge" class="rounded-full bg-rose-100 px-3 py-1 text-xs font-bold text-rose-800">
            Account moderation
          </span>
          <h3 id="status-modal-title" class="font-serif text-2xl font-black text-forest-900 mt-2">
            Suspend account
          </h3>
        </div>
        <button
          type="button"
          class="close-status-modal size-9 rounded-full bg-stone-100 hover:bg-stone-200 active:scale-95 flex items-center justify-center text-stone-600 transition-colors cursor-pointer text-lg"
          aria-label="Close dialog"
        >
          &times;
        </button>
      </div>

      <div class="mt-4 text-sm text-stone-600 space-y-3">
        <p id="status-modal-description">
          Are you sure you want to suspend this account?
        </p>
        <div class="rounded-xl border border-stone-200 bg-stone-50 p-3 text-xs text-stone-600">
          Suspended students will not be able to report items or submit ownership claims until reactivated by the Disciplinary Office.
        </div>
