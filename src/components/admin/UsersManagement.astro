              <!-- Reset Link Button -->
              <button
                type="button"
                id="dossier-reset-pwd-btn"
                class="rounded-full bg-[#ece5d6] hover:bg-stone-200 px-4 py-2 text-xs font-bold text-forest-900 transition-all active:scale-95 cursor-pointer"
                data-user-email={defaultSelectedUser?.email}
                data-user-name={defaultSelectedUser?.full_name}
                title="Send secure password reset link to user's campus email"
