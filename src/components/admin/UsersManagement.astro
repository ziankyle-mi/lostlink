        <button
          type="button"
          id="confirm-status-toggle-btn"
          class="rounded-full bg-[#9b2c1f] hover:bg-[#7e2419] active:scale-95 px-6 py-2.5 text-xs font-bold text-white transition-all shadow-xs cursor-pointer"
        >
