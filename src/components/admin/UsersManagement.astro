        <button
          type="button"
          id="confirm-send-pwd-btn"
          class="rounded-full bg-forest-700 hover:bg-forest-900 active:scale-95 px-6 py-2.5 text-xs font-bold text-white transition-all shadow-xs cursor-pointer"
