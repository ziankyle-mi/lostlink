                  defaultSelectedUser?.active
                    ? "bg-stone-100 hover:bg-stone-200 text-stone-700"
                    : "bg-[#d8ef8c] hover:bg-[#c9e376] text-forest-900 border border-lime-600/40"
                }`}
                data-user-id={defaultSelectedUser?.id}
                data-user-email={defaultSelectedUser?.email}
                data-user-name={defaultSelectedUser?.full_name}
                data-target-active={defaultSelectedUser?.active ? "false" : "true"}
              >
                {defaultSelectedUser?.active ? "Suspend account" : "Reactivate account"}
