      <div class="mt-6 flex items-center justify-end gap-3 pt-4 border-t border-stone-100">
        <button
          type="button"
          class="close-status-modal rounded-full bg-stone-100 hover:bg-stone-200 active:scale-95 px-5 py-2.5 text-xs font-bold text-stone-700 transition-colors cursor-pointer"
