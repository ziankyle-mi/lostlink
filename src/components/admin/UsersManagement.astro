  </div>

  <!-- Password Reset Link Confirmation Modal -->
  <div
    id="user-pwd-modal"
    class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/50 p-4 backdrop-blur-sm"
    role="dialog"
    aria-modal="true"
  >
    <div class="relative w-full max-w-md rounded-card border border-line bg-white p-6 sm:p-8 shadow-card max-h-[90dvh] overflow-y-auto">
      <div class="flex items-center justify-between border-b border-stone-100 pb-4">
        <div>
          <span class="rounded-full bg-forest-700/10 px-3 py-1 text-xs font-bold text-forest-700">
            Security reset
          </span>
          <h3 class="font-serif text-2xl font-black text-forest-900 mt-2">
            Send reset instructions
          </h3>
        </div>
        <button
          type="button"
          class="close-pwd-modal size-9 rounded-full bg-stone-100 hover:bg-stone-200 active:scale-95 flex items-center justify-center text-stone-600 transition-colors cursor-pointer text-lg"
          aria-label="Close dialog"
        >
          &times;
        </button>
      </div>

      <div class="mt-4 text-sm text-stone-600 space-y-3">
        <p id="pwd-modal-description">
          A secure password recovery link will be dispatched to the user's verified DLSAU email.
        </p>
        <div class="rounded-xl border border-emerald-200 bg-emerald-50/70 p-3 text-xs text-emerald-900">
          Passwords are encrypted using cryptographic hashes and can never be viewed directly. The student will receive a link to securely configure their new credentials.
        </div>
      </div>

      <div class="mt-6 flex items-center justify-end gap-3 pt-4 border-t border-stone-100">
        <button
          type="button"
          class="close-pwd-modal rounded-full bg-stone-100 hover:bg-stone-200 active:scale-95 px-5 py-2.5 text-xs font-bold text-stone-700 transition-colors cursor-pointer"
