        </button>
        <button
          type="button"
          id="confirm-status-toggle-btn"
          class="inline-flex min-h-11 items-center justify-center rounded-full bg-danger hover:bg-danger/90 active:scale-95 px-6 py-2.5 text-sm font-bold text-white transition-all shadow-2xs cursor-pointer"
        >
          Confirm suspend / hide
        </button>
      </div>
    </div>
  </div>

  <!-- Password Reset Link Confirmation Modal (Two-step flow with copyable temporary password) -->
  <div
    id="user-pwd-modal"
    class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/50 p-4 backdrop-blur-sm"
    role="dialog"
    aria-modal="true"
  >
    <div class="relative w-full max-w-md rounded-card border border-line bg-white p-6 sm:p-8 shadow-card max-h-[90dvh] overflow-y-auto">
      <div class="flex items-center justify-between border-b border-stone-100 pb-4">
        <div>
          <span class="rounded-full bg-forest-700/10 px-3 py-1 text-xs font-bold text-forest-700" id="pwd-modal-badge">
            Security reset
          </span>
          <h3 class="font-serif text-2xl font-black text-forest-900 mt-2" id="pwd-modal-title">
            Issue temporary password
          </h3>
        </div>
        <button
          type="button"
          class="close-pwd-modal size-11 rounded-full bg-stone-100 hover:bg-stone-200 active:scale-95 flex items-center justify-center text-stone-600 transition-colors cursor-pointer"
          aria-label="Close dialog"
        >
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- STEP 1: Confirmation Step -->
      <div id="pwd-modal-confirm-step" class="mt-4 space-y-4">
        <div class="text-sm text-stone-600 space-y-3">
          <p id="pwd-modal-description">
            Issue a temporary password for this student. They must change it after signing in.
          </p>
          <div class="rounded-xl border border-line bg-canvas p-3.5 text-xs text-forest-900 flex items-start gap-2.5">
            <svg class="size-4 text-forest-700 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10" />
              <line x1="12" y1="16" x2="12" y2="12" />
              <line x1="12" y1="8" x2="12.01" y2="8" />
            </svg>
            <span>Read the temporary password to the student at the counter after checking their DLSAU ID. It is also sent to their in-app notifications.</span>
          </div>
        </div>

        <div class="mt-6 flex items-center justify-end gap-3 pt-4 border-t border-stone-100">
          <button
            type="button"
            class="inline-flex min-h-11 items-center justify-center rounded-full bg-stone-100 hover:bg-stone-200 active:scale-95 px-5 py-2.5 text-sm font-bold text-stone-700 transition-colors cursor-pointer"
          >
            Cancel
          </button>
          <button
            type="button"
            id="confirm-send-pwd-btn"
            class="inline-flex min-h-11 items-center justify-center gap-2 rounded-full bg-forest-700 hover:bg-forest-900 active:scale-95 px-6 py-2.5 text-sm font-bold text-white transition-all shadow-2xs cursor-pointer"
          >
            <span>Issue temp password</span>
          </button>
        </div>
      </div>

      <!-- STEP 2: Password Reveal Step (Shown on success) -->
      <div id="pwd-modal-result-step" class="mt-4 hidden space-y-4">
        <div class="rounded-2xl border border-forest-700/20 bg-stone-50 p-5 text-center">
          <span class="text-xs font-bold uppercase tracking-widest text-stone-500">Official temporary credentials</span>
          <div class="mt-3 flex items-center justify-center gap-2 flex-wrap">
            <span
              id="pwd-generated-value"
              class="tabular-nums text-2xl font-black tracking-wider text-forest-900 select-all bg-white px-4 py-2 rounded-xl border border-stone-200 shadow-2xs"
            >
              Reset-XXXX-YYYY
            </span>
            <button
              type="button"
              id="copy-generated-pwd-btn"
              class="inline-flex min-h-11 items-center justify-center gap-1.5 rounded-xl bg-forest-700 hover:bg-forest-900 active:scale-95 text-white px-4 py-2.5 text-sm font-bold transition-all shadow-2xs cursor-pointer"
              title="Copy password to clipboard"
            >
              <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
              </svg>
              <span id="copy-pwd-btn-label">Copy</span>
            </button>
          </div>
          <p class="text-xs text-stone-600 mt-3">
            Read this code to <strong id="pwd-result-user-name" class="text-forest-900">the student</strong> at the counter.
          </p>
        </div>

        <div class="space-y-2 text-xs text-stone-600">
          <div class="flex items-start gap-2.5 rounded-xl bg-forest-700/5 p-3 text-forest-900 border border-forest-700/15">
            <svg class="size-4 text-forest-700 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
              <polyline points="22 4 12 14.01 9 11.01" />
            </svg>
            <div>
              <p class="font-bold">Temporary password active</p>
              <p class="text-xs text-stone-500 mt-0.5">The student will be prompted to choose a permanent password immediately upon logging in.</p>
            </div>
          </div>

          <div class="flex items-start gap-2.5 rounded-xl bg-canvas p-3 text-forest-900 border border-line">
            <svg class="size-4 text-forest-700 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
              <path d="M13.73 21a2 2 0 0 1-3.46 0" />
            </svg>
            <div>
              <p class="font-bold">Notification delivered</p>
              <p class="text-xs text-stone-500 mt-0.5">Credentials were dispatched to the student's in-app notification inbox.</p>
            </div>
          </div>
        </div>

        <div class="mt-6 flex items-center justify-end gap-3 pt-4 border-t border-stone-100">
          <button
            type="button"
            class="close-pwd-modal inline-flex min-h-11 items-center justify-center rounded-full bg-forest-700 hover:bg-forest-900 active:scale-95 px-7 py-2.5 text-sm font-bold text-white transition-all shadow-2xs cursor-pointer"
          >
            Done and close
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .custom-scroll::-webkit-scrollbar {
    width: 6px;
  }
  .custom-scroll::-webkit-scrollbar-track {
    background: transparent;
  }
  .custom-scroll::-webkit-scrollbar-thumb {
    background: var(--color-sage-400);
    border-radius: 9999px;
  }
  .custom-scroll::-webkit-scrollbar-thumb:hover {
    background: var(--color-sage-600);
  }
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<script is:inline>
  (function () {
    const searchInput = document.getElementById("user-search-input");
    const degreeSelect = document.getElementById("user-degree-select");
    const collegePills = document.querySelectorAll(".college-filter-pill");
    const studentCards = document.querySelectorAll(".student-select-card");
    const noCardsMessage = document.getElementById("no-cards-message");
    const resetFiltersBtn = document.getElementById("reset-filters-btn");
    const visibleCountLabel = document.getElementById("visible-count-label");
    const totalCountLabel = document.getElementById("total-count-label");
    const leftListCounter = document.getElementById("left-list-counter");

    // Metrics elements
    const metricTotalUsers = document.getElementById("metric-total-users");
    const metricStudents = document.getElementById("metric-students");
    const metricAdmins = document.getElementById("metric-admins");
    const metricSuspended = document.getElementById("metric-suspended");

    // Dossier DOM elements
    const dossierAvatar = document.getElementById("dossier-avatar");
    const dossierName = document.getElementById("dossier-name");
    const dossierEmail = document.getElementById("dossier-email");
    const dossierStatusContainer = document.getElementById("dossier-status-container");
    const dossierRoleContainer = document.getElementById("dossier-role-container");
    const dossierCollegeBanner = document.getElementById("dossier-college-banner");
    const dossierAffiliationText = document.getElementById("dossier-affiliation-text");
    const dossierProgramCode = document.getElementById("dossier-program-code");
    const dossierProgramName = document.getElementById("dossier-program-name");
    const dossierStudentId = document.getElementById("dossier-student-id");
    const dossierUnitsLevel = document.getElementById("dossier-units-level");
    const dossierCampus = document.getElementById("dossier-campus");
    const dossierCampusSubtext = document.getElementById("dossier-campus-subtext");
    const dossierPortalLevel = document.getElementById("dossier-portal-level");
    const dossierPortalSubtext = document.getElementById("dossier-portal-subtext");
    const dossierJoinedDate = document.getElementById("dossier-joined-date");
    const dossierAccountIdLabel = document.getElementById("dossier-account-id-label");

    // Dossier action buttons
    const dossierToggleRoleBtn = document.getElementById("dossier-toggle-role-btn");
    const dossierToggleStatusBtn = document.getElementById("dossier-toggle-status-btn");
    const dossierResetPwdBtn = document.getElementById("dossier-reset-pwd-btn");
    const dossierDeleteUserBtn = document.getElementById("dossier-delete-user-btn");

    // Modals
    const roleModal = document.getElementById("user-role-modal");
    const roleModalTitle = document.getElementById("role-modal-title");
    const roleModalDesc = document.getElementById("role-modal-description");
    const confirmRoleBtn = document.getElementById("confirm-role-change-btn");

    const statusModal = document.getElementById("user-status-modal");
    const statusModalBadge = document.getElementById("status-modal-badge");
    const statusModalTitle = document.getElementById("status-modal-title");
    const statusModalDesc = document.getElementById("status-modal-description");
    const confirmStatusBtn = document.getElementById("confirm-status-toggle-btn");

    const pwdModal = document.getElementById("user-pwd-modal");
    const pwdModalDesc = document.getElementById("pwd-modal-description");
    const confirmPwdBtn = document.getElementById("confirm-send-pwd-btn");
    const pwdModalConfirmStep = document.getElementById("pwd-modal-confirm-step");
    const pwdModalResultStep = document.getElementById("pwd-modal-result-step");
    const pwdGeneratedValue = document.getElementById("pwd-generated-value");
    const pwdResultUserName = document.getElementById("pwd-result-user-name");
    const copyGeneratedPwdBtn = document.getElementById("copy-generated-pwd-btn");
    const copyPwdBtnLabel = document.getElementById("copy-pwd-btn-label");
    const dossierResetWarning = document.getElementById("dossier-reset-warning");

    const deleteModal = document.getElementById("user-delete-modal");
    const deleteModalDesc = document.getElementById("delete-modal-description");
    const confirmDeleteBtn = document.getElementById("confirm-delete-user-btn");

    const toggleHideInactiveBtn = document.getElementById("toggle-hide-inactive-btn");
    const hideInactiveLabel = document.getElementById("hide-inactive-label");
    let hideInactive = false;

    let currentCollege = "all";
    let currentDegree = "all";
    let pendingTarget = null;
    let currentSelectedCard = document.querySelector(".student-select-card.selected-user") || studentCards[0] || null;

    function showToast(msg) {
      const toast = document.getElementById("toast-notification");
      const toastMsg = document.getElementById("toast-message");
      if (!toast || !toastMsg) return;
      toastMsg.textContent = msg;
      toast.classList.remove("hidden");
      setTimeout(() => toast.classList.add("hidden"), 3500);
    }

    function initialsOf(name, email) {
      if (name && name.trim().length > 0) {
        const parts = name.trim().split(/\s+/).filter(Boolean);
        if (parts.length >= 2) return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
        if (parts.length === 1 && parts[0].length >= 2) return parts[0].slice(0, 2).toUpperCase();
      }
      const emailPart = (email || "").split("@")[0].split(/[._-]/).filter(Boolean);
      if (emailPart.length >= 2) return (emailPart[0][0] + emailPart[1][0]).toUpperCase();
      return "ST";
    }

    function formatDate(isoStr) {
      if (!isoStr) return "Recently";
      const d = new Date(isoStr);
      return d.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
    }

    function updateDossier(card) {
      if (!card) return;
      currentSelectedCard = card;

      // Update active selection classes on all cards
      studentCards.forEach((c) => {
        c.classList.remove("border-2", "border-forest-700", "bg-forest-700/5", "shadow-xs", "selected-user");
        c.classList.add("border-stone-200/80", "bg-white");
        c.setAttribute("aria-pressed", "false");
      });
      card.classList.remove("border-stone-200/80", "bg-white");
      card.classList.add("border-2", "border-forest-700", "bg-forest-700/5", "shadow-xs", "selected-user");
      card.setAttribute("aria-pressed", "true");

      // Extract attributes
      const id = card.getAttribute("data-user-id");
      const name = card.getAttribute("data-user-name") || "Student";
      const email = card.getAttribute("data-user-email") || "";
      const role = card.getAttribute("data-user-role") || "user";
      const active = card.getAttribute("data-user-active") === "true";
      const collegeCode = card.getAttribute("data-college-code") || "CAST";
      const collegeName = card.getAttribute("data-college-name") || "";
      const programCode = card.getAttribute("data-program-code") || "BSCS";
      const programName = card.getAttribute("data-program-name") || "";
      const studentId = card.getAttribute("data-student-id") || "";
      const units = card.getAttribute("data-units") || "21";
      const yearLevel = card.getAttribute("data-year-level") || "3rd Year";
      const isFaculty = card.getAttribute("data-is-faculty") === "true";
      const campus = card.getAttribute("data-campus") || "Victoneta Park (Main)";
      const campusSubtext = card.getAttribute("data-campus-subtext") || "";
      const affiliationText = card.getAttribute("data-affiliation-text") || "";
      const portalLevel = card.getAttribute("data-portal-level") || "Student";
      const isSelf = card.getAttribute("data-is-self") === "true";
      const createdAt = card.getAttribute("data-created-at");

      // Populate Dossier fields
      if (dossierAvatar) dossierAvatar.textContent = initialsOf(name, email);
      if (dossierName) dossierName.textContent = name;
      if (dossierEmail) dossierEmail.textContent = email;

      if (dossierStatusContainer) {
        if (active) {
          dossierStatusContainer.innerHTML = "";
        } else {
          dossierStatusContainer.innerHTML = `
            <span class="inline-flex items-center gap-1.5 rounded-full bg-danger/10 border border-danger/20 px-3.5 py-1 text-xs font-bold text-danger uppercase tracking-wider">
              <span class="size-2 rounded-full bg-danger"></span>
              Suspended
            </span>
          `;
        }
      }

      if (dossierRoleContainer) {
        if (role === "admin") {
          dossierRoleContainer.innerHTML = `
            <span class="inline-flex items-center gap-1 rounded-full bg-forest-700 text-lime px-3.5 py-1 text-xs font-bold uppercase tracking-wider shadow-2xs">
              DO Admin
            </span>
          `;
        } else if (isFaculty) {
          dossierRoleContainer.innerHTML = `
            <span class="inline-flex items-center gap-1 rounded-full bg-lime text-forest-900 border border-lime-600/30 px-3.5 py-1 text-xs font-bold uppercase tracking-wider">
              Faculty
            </span>
          `;
        } else {
          dossierRoleContainer.innerHTML = `
            <span class="inline-flex items-center gap-1 rounded-full bg-[#ece5d6] text-forest-900 border border-stone-200/80 px-3.5 py-1 text-xs font-bold uppercase tracking-wider">
              Student
            </span>
          `;
        }
      }

      if (dossierCollegeBanner) dossierCollegeBanner.textContent = `${collegeName} (${collegeCode}) • ${campus}`;
      if (dossierAffiliationText) dossierAffiliationText.textContent = affiliationText;
      if (dossierProgramCode) dossierProgramCode.textContent = programCode;
      if (dossierProgramName) dossierProgramName.textContent = programName;
      if (dossierStudentId) dossierStudentId.textContent = studentId;
      if (dossierUnitsLevel) {
        dossierUnitsLevel.textContent = isFaculty ? "Faculty Member • Active Load" : `${units} Units • ${yearLevel}`;
      }
      if (dossierCampus) dossierCampus.textContent = campus;
      if (dossierCampusSubtext) dossierCampusSubtext.textContent = campusSubtext;
      if (dossierPortalLevel) {
        dossierPortalLevel.textContent = role === "admin"
          ? "Disciplinary Office Administrator"
          : (portalLevel || (isFaculty ? "Faculty Member (Standard Privileges)" : "Student"));
      }
      if (dossierPortalSubtext) {
        dossierPortalSubtext.textContent = role === "admin"
          ? "Full Disciplinary Office privileges: review claims, approve custody intake, and moderate reports."
          : (isFaculty
            ? "Academic teaching and campus reporting privileges."
            : "Standard LostLink reporting and claim submission privileges.");
      }
      if (dossierJoinedDate) dossierJoinedDate.textContent = formatDate(createdAt);
      if (dossierAccountIdLabel) dossierAccountIdLabel.textContent = `Account ID: ${studentId}`;

      // Update Dossier Action Buttons
      if (dossierToggleRoleBtn) {
        dossierToggleRoleBtn.setAttribute("data-user-id", id);
        dossierToggleRoleBtn.setAttribute("data-user-email", email);
        dossierToggleRoleBtn.setAttribute("data-user-name", name);
        if (isSelf) {
          dossierToggleRoleBtn.disabled = true;
          dossierToggleRoleBtn.textContent = "Admin lock";
          dossierToggleRoleBtn.className = "rounded-full bg-stone-100 px-4 py-2 text-xs font-bold text-stone-400 cursor-not-allowed";
        } else {
          dossierToggleRoleBtn.disabled = false;
          if (role === "admin") {
            dossierToggleRoleBtn.textContent = "Demote to student";
            dossierToggleRoleBtn.setAttribute("data-target-role", "user");
            dossierToggleRoleBtn.className = "rounded-full bg-stone-100 hover:bg-stone-200 px-4 py-2 text-xs font-bold text-stone-700 transition-all active:scale-95 cursor-pointer";
          } else {
            dossierToggleRoleBtn.textContent = "Make admin";
            dossierToggleRoleBtn.setAttribute("data-target-role", "admin");
            dossierToggleRoleBtn.className = "rounded-full bg-forest-700/10 hover:bg-forest-700 hover:text-lime px-4 py-2 text-xs font-bold text-forest-700 transition-all active:scale-95 cursor-pointer";
          }
        }
      }

      if (dossierToggleStatusBtn) {
        dossierToggleStatusBtn.setAttribute("data-user-id", id);
        dossierToggleStatusBtn.setAttribute("data-user-email", email);
        dossierToggleStatusBtn.setAttribute("data-user-name", name);
        if (isSelf) {
          dossierToggleStatusBtn.disabled = true;
          dossierToggleStatusBtn.textContent = "Active (Self)";
          dossierToggleStatusBtn.className = "inline-flex min-h-11 items-center justify-center rounded-full bg-stone-100 px-4 py-2 text-xs font-bold text-stone-400 cursor-not-allowed";
        } else {
          dossierToggleStatusBtn.disabled = false;
          if (active) {
            dossierToggleStatusBtn.textContent = "Suspend / Hide user";
            dossierToggleStatusBtn.setAttribute("data-target-active", "false");
            dossierToggleStatusBtn.className = "inline-flex min-h-11 items-center justify-center rounded-full bg-stone-100 hover:bg-stone-200 px-4 py-2 text-xs font-bold text-stone-700 transition-all active:scale-95 cursor-pointer";
          } else {
            dossierToggleStatusBtn.textContent = "Reactivate / Unhide user";
            dossierToggleStatusBtn.setAttribute("data-target-active", "true");
            dossierToggleStatusBtn.className = "inline-flex min-h-11 items-center justify-center rounded-full bg-lime hover:bg-[#c9e376] px-4 py-2 text-xs font-bold text-forest-900 border border-lime-600/40 transition-all active:scale-95 cursor-pointer";
          }
        }
      }

      const hasResetRequest = card.getAttribute("data-has-reset-request") === "true";
      if (dossierResetWarning) {
        if (hasResetRequest) {
          dossierResetWarning.classList.remove("hidden");
        } else {
          dossierResetWarning.classList.add("hidden");
        }
      }

      if (dossierResetPwdBtn) {
        dossierResetPwdBtn.setAttribute("data-user-email", email);
        dossierResetPwdBtn.setAttribute("data-user-name", name);
        if (hasResetRequest) {
          dossierResetPwdBtn.className = "inline-flex min-h-11 items-center justify-center rounded-full bg-forest-700 hover:bg-forest-900 text-lime px-4 py-2 text-xs font-black transition-all active:scale-95 cursor-pointer shadow-2xs";
          dossierResetPwdBtn.textContent = "Issue requested password";
        } else {
          dossierResetPwdBtn.className = "inline-flex min-h-11 items-center justify-center rounded-full bg-canvas hover:bg-stone-200 px-4 py-2 text-xs font-bold text-forest-900 transition-all active:scale-95 cursor-pointer";
          dossierResetPwdBtn.textContent = "Reset password";
        }
      }

      if (dossierDeleteUserBtn) {
        dossierDeleteUserBtn.setAttribute("data-user-id", id);
        dossierDeleteUserBtn.setAttribute("data-user-email", email);
        dossierDeleteUserBtn.setAttribute("data-user-name", name);
        if (isSelf) {
          dossierDeleteUserBtn.disabled = true;
          dossierDeleteUserBtn.className = "inline-flex min-h-11 items-center justify-center rounded-full bg-stone-100 px-4 py-2 text-xs font-bold text-stone-400 cursor-not-allowed gap-1.5";
          dossierDeleteUserBtn.title = "Administrators cannot deactivate their own active account.";
        } else {
          dossierDeleteUserBtn.disabled = false;
          dossierDeleteUserBtn.className = "inline-flex min-h-11 items-center justify-center rounded-full bg-danger/10 hover:bg-danger hover:text-white border border-danger/20 px-4 py-2 text-xs font-bold text-danger transition-all active:scale-95 cursor-pointer gap-1.5";
          dossierDeleteUserBtn.title = "Deactivate account; records and claims are preserved";
        }
      }
    }

    function applyFilters() {
      const query = (searchInput?.value || "").toLowerCase().trim();
      let visibleCount = 0;
      let firstVisibleCard = null;

      studentCards.forEach((card) => {
        const name = (card.getAttribute("data-user-name") || "").toLowerCase();
        const email = (card.getAttribute("data-user-email") || "").toLowerCase();
        const studentId = (card.getAttribute("data-student-id") || "").toLowerCase();
        const collegeCode = card.getAttribute("data-college-code") || "";
        const programCode = card.getAttribute("data-program-code") || "";
        const isActive = card.getAttribute("data-user-active") === "true";

        const matchesQuery = !query || name.includes(query) || email.includes(query) || studentId.includes(query);
        const matchesCollege = currentCollege === "all" || collegeCode === currentCollege;
        const matchesDegree = currentDegree === "all" || programCode === currentDegree;
        const matchesActive = !hideInactive || isActive;

        if (matchesQuery && matchesCollege && matchesDegree && matchesActive) {
          card.style.display = "";
          visibleCount++;
          if (!firstVisibleCard) firstVisibleCard = card;
        } else {
          card.style.display = "none";
        }
      });

      if (visibleCountLabel) visibleCountLabel.textContent = String(visibleCount);
      if (leftListCounter) leftListCounter.textContent = `${visibleCount} accounts`;

      if (noCardsMessage) {
        if (visibleCount === 0) {
          noCardsMessage.classList.remove("hidden");
        } else {
          noCardsMessage.classList.add("hidden");
        }
      }

      // If currently selected card is hidden by filters, pick first visible card
      if (currentSelectedCard && currentSelectedCard.style.display === "none") {
        if (firstVisibleCard) {
          updateDossier(firstVisibleCard);
        }
      }
    }

    // Update degree options based on selected college
    function updateDegreeDropdownOptions() {
      if (!degreeSelect) return;
      const optgroups = degreeSelect.querySelectorAll("optgroup");
      optgroups.forEach((og) => {
        const groupCollege = og.getAttribute("data-college-group");
        if (currentCollege === "all" || groupCollege === currentCollege) {
          og.style.display = "";
        } else {
          og.style.display = "none";
        }
      });
      // If current selected degree is now in a hidden optgroup, reset to 'all'
      const activeOption = degreeSelect.querySelector(`option[value="${degreeSelect.value}"]`);
      if (activeOption && activeOption.parentElement && activeOption.parentElement.tagName === "OPTGROUP") {
        if (activeOption.parentElement.style.display === "none") {
          degreeSelect.value = "all";
          currentDegree = "all";
        }
      }
    }

    // Attach card click handlers
    studentCards.forEach((card) => {
      card.addEventListener("click", () => updateDossier(card));
      card.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          updateDossier(card);
        }
      });
    });

    // College pills click
    collegePills.forEach((pill) => {
      pill.addEventListener("click", () => {
        collegePills.forEach((p) => {
          p.classList.remove("bg-forest-700", "text-white", "shadow-2xs", "active");
          p.classList.add("text-forest-900/80");
        });
        pill.classList.remove("text-forest-900/80");
        pill.classList.add("bg-forest-700", "text-white", "shadow-2xs", "active");

        currentCollege = pill.getAttribute("data-college") || "all";
        updateDegreeDropdownOptions();
        applyFilters();
      });
    });

    // Degree select change
    if (degreeSelect) {
      degreeSelect.addEventListener("change", () => {
        currentDegree = degreeSelect.value;
        applyFilters();
      });
    }

    // Search input
    if (searchInput) {
      searchInput.addEventListener("input", applyFilters);
    }

    // Toggle Hide Inactive / Suspended Users
    if (toggleHideInactiveBtn) {
      toggleHideInactiveBtn.addEventListener("click", () => {
        hideInactive = !hideInactive;
        toggleHideInactiveBtn.setAttribute("data-hide-inactive", String(hideInactive));
        if (hideInactive) {
          toggleHideInactiveBtn.className = "inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-forest-900 bg-forest-700 text-white font-bold text-xs transition-all cursor-pointer shadow-2xs active:scale-95";
          if (hideInactiveLabel) hideInactiveLabel.textContent = "Showing active (suspended hidden)";
        } else {
          toggleHideInactiveBtn.className = "inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-stone-300/60 bg-white hover:bg-stone-50 text-forest-900 font-bold text-xs transition-all cursor-pointer shadow-2xs active:scale-95";
          if (hideInactiveLabel) hideInactiveLabel.textContent = "Hide suspended users";
        }
        applyFilters();
      });
    }

    // Reset Filters button
    if (resetFiltersBtn) {
      resetFiltersBtn.addEventListener("click", () => {
        if (searchInput) searchInput.value = "";
        currentCollege = "all";
        currentDegree = "all";
        hideInactive = false;
        if (toggleHideInactiveBtn) {
          toggleHideInactiveBtn.setAttribute("data-hide-inactive", "false");
          toggleHideInactiveBtn.className = "inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-stone-300/60 bg-white hover:bg-stone-50 text-forest-900 font-bold text-xs transition-all cursor-pointer shadow-2xs active:scale-95";
          if (hideInactiveLabel) hideInactiveLabel.textContent = "Hide suspended users";
        }
        if (degreeSelect) degreeSelect.value = "all";

        collegePills.forEach((p) => {
          if (p.getAttribute("data-college") === "all") {
            p.classList.remove("text-forest-900/80");
            p.classList.add("bg-forest-700", "text-white", "shadow-2xs", "active");
          } else {
            p.classList.remove("bg-forest-700", "text-white", "shadow-2xs", "active");
            p.classList.add("text-forest-900/80");
          }
        });

        updateDegreeDropdownOptions();
        applyFilters();
      });
    }

    // Modal close helpers
    function closeAllModals() {
      [roleModal, statusModal, pwdModal, deleteModal].forEach((m) => {
        if (m) {
          m.classList.add("hidden");
          m.classList.remove("flex");
        }
      });
      if (pwdModalConfirmStep) pwdModalConfirmStep.classList.remove("hidden");
      if (pwdModalResultStep) pwdModalResultStep.classList.add("hidden");
      pendingTarget = null;
    }

    // Close on backdrop click & Escape key
    [roleModal, statusModal, pwdModal, deleteModal].forEach((m) => {
      if (m) {
        m.addEventListener("click", (e) => {
          if (e.target === m) closeAllModals();
        });
      }
    });

    window.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeAllModals();
    });

    // ==========================================
    // ACTION 1: Role Switch Trigger
    // ==========================================
    if (dossierToggleRoleBtn) {
      dossierToggleRoleBtn.addEventListener("click", () => {
        const userId = dossierToggleRoleBtn.getAttribute("data-user-id");
        const userEmail = dossierToggleRoleBtn.getAttribute("data-user-email");
        const userName = dossierToggleRoleBtn.getAttribute("data-user-name") || userEmail;
        const targetRole = dossierToggleRoleBtn.getAttribute("data-target-role") || "user";

        pendingTarget = { userId, userEmail, userName, targetRole, card: currentSelectedCard };

        if (roleModalTitle && roleModalDesc) {
          if (targetRole === "admin") {
            roleModalTitle.textContent = `Promote ${userName} to admin`;
            roleModalDesc.textContent = `Grant administrator privileges to ${userName} (${userEmail})? They will have full access to review claims, approve intake, and moderate reports.`;
          } else {
            roleModalTitle.textContent = `Demote ${userName} to student`;
            roleModalDesc.textContent = `Revoke administrative privileges for ${userName} (${userEmail}) and return their account to student permissions?`;
          }
        }

        if (roleModal) {
          roleModal.classList.remove("hidden");
          roleModal.classList.add("flex");
        }
      });
    }

    document.querySelectorAll(".close-role-modal").forEach((btn) => {
      btn.addEventListener("click", closeAllModals);
    });

    if (confirmRoleBtn) {
      confirmRoleBtn.addEventListener("click", async () => {
        if (!pendingTarget) return;
        const { userId, userEmail, targetRole, card } = pendingTarget;

        confirmRoleBtn.disabled = true;
        confirmRoleBtn.textContent = "Updating...";

        try {
          const res = await fetch("/api/admin/actions", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              action: "toggle_user_role",
              userId,
              newRole: targetRole,
              email: userEmail,
            }),
          });
          const data = await res.json().catch(() => ({}));

          if (data.ok) {
            showToast(`Role updated: ${pendingTarget.userName} is now ${targetRole === "admin" ? "an Administrator" : "a Student"}.`);
            if (card) {
              const isFac = card.getAttribute("data-is-faculty") === "true";
              card.setAttribute("data-user-role", targetRole);
              card.setAttribute(
                "data-portal-level",
                targetRole === "admin"
                  ? "Disciplinary Office Administrator"
                  : (isFac ? "Faculty Member (Standard Privileges)" : "Student")
              );
              updateDossier(card);
            }
            // Recalculate metrics
            const currentAdmins = document.querySelectorAll('.student-select-card[data-user-role="admin"]').length;
            const currentStudents = document.querySelectorAll('.student-select-card[data-user-role="user"]').length;
            if (metricAdmins) metricAdmins.textContent = String(currentAdmins);
            if (metricStudents) metricStudents.textContent = String(currentStudents);
          } else {
            showToast(data.error || "Failed to update user role.");
          }
        } catch {
          showToast("Network error updating role.");
        } finally {
          confirmRoleBtn.disabled = false;
          confirmRoleBtn.textContent = "Confirm role change";
          closeAllModals();
        }
      });
    }

    // ==========================================
    // ACTION 2: Status Suspend / Reactivate Trigger
    // ==========================================
    if (dossierToggleStatusBtn) {
      dossierToggleStatusBtn.addEventListener("click", () => {
        const userId = dossierToggleStatusBtn.getAttribute("data-user-id");
        const userEmail = dossierToggleStatusBtn.getAttribute("data-user-email");
        const userName = dossierToggleStatusBtn.getAttribute("data-user-name") || userEmail;
        const targetActive = dossierToggleStatusBtn.getAttribute("data-target-active") === "true";

        pendingTarget = { userId, userEmail, userName, targetActive, card: currentSelectedCard };

        if (statusModalTitle && statusModalDesc && statusModalBadge && confirmStatusBtn) {
          if (targetActive) {
            statusModalBadge.textContent = "Account reactivation";
            statusModalBadge.className = "rounded-full bg-forest-700/10 px-3 py-1 text-xs font-bold text-forest-700";
            statusModalTitle.textContent = `Reactivate ${userName}`;
            statusModalDesc.textContent = `Restore full access for ${userName} (${userEmail})? They will be able to report items and submit claims again.`;
            confirmStatusBtn.textContent = "Confirm reactivation";
            confirmStatusBtn.className = "rounded-full bg-forest-700 hover:bg-forest-900 active:scale-95 px-6 py-2.5 text-xs font-bold text-lime transition-all shadow-xs cursor-pointer";
          } else {
            statusModalBadge.textContent = "Account moderation";
            statusModalBadge.className = "rounded-full bg-danger/10 px-3 py-1 text-xs font-bold text-danger";
            statusModalTitle.textContent = `Suspend ${userName}`;
            statusModalDesc.textContent = `Are you sure you want to suspend ${userName} (${userEmail})? They will be temporarily blocked from submitting lost or found reports.`;
            confirmStatusBtn.textContent = "Confirm suspension";
            confirmStatusBtn.className = "rounded-full bg-danger hover:bg-danger/90 active:scale-95 px-6 py-2.5 text-xs font-bold text-white transition-all shadow-xs cursor-pointer";
          }
        }

        if (statusModal) {
          statusModal.classList.remove("hidden");
          statusModal.classList.add("flex");
        }
      });
    }

    document.querySelectorAll(".close-status-modal").forEach((btn) => {
      btn.addEventListener("click", closeAllModals);
    });

    if (confirmStatusBtn) {
      confirmStatusBtn.addEventListener("click", async () => {
        if (!pendingTarget) return;
        const { userId, userEmail, targetActive, card } = pendingTarget;

        confirmStatusBtn.disabled = true;
        confirmStatusBtn.textContent = "Processing...";

        try {
          const res = await fetch("/api/admin/actions", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              action: "toggle_user_status",
              userId,
              active: targetActive,
              email: userEmail,
            }),
          });
          const data = await res.json().catch(() => ({}));

          if (data.ok) {
            showToast(`Account status updated: ${pendingTarget.userName} is now ${targetActive ? "Active" : "Suspended"}.`);
            if (card) {
              card.setAttribute("data-user-active", targetActive ? "true" : "false");
              const badge = card.querySelector(".card-status-badge");
              if (badge) {
                if (targetActive) {
                  badge.className = "hidden card-status-badge";
                  badge.innerHTML = "";
                } else {
                  badge.className = "inline-flex items-center gap-1 rounded-full bg-danger/10 border border-danger/20 px-2 py-0.5 text-xs font-bold text-danger card-status-badge";
                  badge.innerHTML = '<span class="size-1.5 rounded-full bg-danger"></span> Suspended';
                }
              }
              updateDossier(card);
            }
            // Recalculate metrics
            const currentSuspended = document.querySelectorAll('.student-select-card[data-user-active="false"]').length;
            if (metricSuspended) metricSuspended.textContent = String(currentSuspended);
          } else {
            showToast(data.error || "Failed to update account status.");
          }
        } catch {
          showToast("Network error updating status.");
        } finally {
          confirmStatusBtn.disabled = false;
          confirmStatusBtn.textContent = "Confirm suspension";
          closeAllModals();
        }
      });
    }

    // ==========================================
    // ACTION 3: Password Reset Link Trigger
    // ==========================================
    if (dossierResetPwdBtn) {
      dossierResetPwdBtn.addEventListener("click", () => {
        const userEmail = dossierResetPwdBtn.getAttribute("data-user-email");
        const userName = dossierResetPwdBtn.getAttribute("data-user-name") || userEmail;
        pendingTarget = { userEmail, userName };

        if (pwdModalDesc) {
          pwdModalDesc.textContent = `Issue a temporary password for ${userName} (${userEmail})? They must change it after signing in.`;
        }

        if (pwdModalConfirmStep) pwdModalConfirmStep.classList.remove("hidden");
        if (pwdModalResultStep) pwdModalResultStep.classList.add("hidden");

        if (pwdModal) {
          pwdModal.classList.remove("hidden");
          pwdModal.classList.add("flex");
        }
      });
    }

    // Quick issue password buttons from top banner
    document.querySelectorAll(".quick-issue-pwd-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const userEmail = btn.getAttribute("data-user-email") || "";
        const userName = btn.getAttribute("data-user-name") || userEmail;

        // Find card in list and highlight it in dossier if available
        const card = document.querySelector(`.student-select-card[data-user-email="${userEmail}"]`);
        if (card) {
          updateDossier(card);
        }

        pendingTarget = { userEmail, userName, card };

        if (pwdModalDesc) {
          pwdModalDesc.textContent = `Issue a temporary password for ${userName} (${userEmail})? They must change it after signing in.`;
        }

        if (pwdModalConfirmStep) pwdModalConfirmStep.classList.remove("hidden");
        if (pwdModalResultStep) pwdModalResultStep.classList.add("hidden");

        if (pwdModal) {
          pwdModal.classList.remove("hidden");
          pwdModal.classList.add("flex");
        }
      });
    });

    // Copy generated password to clipboard
    if (copyGeneratedPwdBtn) {
      copyGeneratedPwdBtn.addEventListener("click", async () => {
        const textToCopy = pwdGeneratedValue?.textContent?.trim() || "";
        if (!textToCopy) return;

        try {
          if (navigator.clipboard && navigator.clipboard.writeText) {
            await navigator.clipboard.writeText(textToCopy);
          } else {
            const ta = document.createElement("textarea");
            ta.value = textToCopy;
            document.body.appendChild(ta);
            ta.select();
            document.execCommand("copy");
            document.body.removeChild(ta);
          }
          if (copyPwdBtnLabel) copyPwdBtnLabel.textContent = "Copied";
          copyGeneratedPwdBtn.classList.remove("bg-forest-700");
          copyGeneratedPwdBtn.classList.add("bg-[#2d6e4f]");
          setTimeout(() => {
            if (copyPwdBtnLabel) copyPwdBtnLabel.textContent = "Copy";
            copyGeneratedPwdBtn.classList.remove("bg-[#2d6e4f]");
            copyGeneratedPwdBtn.classList.add("bg-forest-700");
          }, 2000);
        } catch {
          showToast("Password copied to clipboard.");
        }
      });
    }

    document.querySelectorAll(".close-pwd-modal").forEach((btn) => {
      btn.addEventListener("click", closeAllModals);
    });

    if (confirmPwdBtn) {
      confirmPwdBtn.addEventListener("click", async () => {
        if (!pendingTarget) return;
        const { userEmail, userName } = pendingTarget;

        confirmPwdBtn.disabled = true;
        confirmPwdBtn.innerHTML = '<span>Issuing...</span>';

        try {
          const res = await fetch("/api/admin/actions", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              action: "reset_user_password",
              email: userEmail,
            }),
          });
          const data = await res.json().catch(() => ({}));

          if (data.ok && data.tempPassword) {
            // Populate step 2
            if (pwdGeneratedValue) pwdGeneratedValue.textContent = data.tempPassword;
            if (pwdResultUserName) pwdResultUserName.textContent = userName || userEmail;

            // Transition from Step 1 to Step 2
            if (pwdModalConfirmStep) pwdModalConfirmStep.classList.add("hidden");
            if (pwdModalResultStep) pwdModalResultStep.classList.remove("hidden");

            // Clean up reset badges on student card
            const card = document.querySelector(`.student-select-card[data-user-email="${userEmail}"]`);
            if (card) {
              card.removeAttribute("data-has-reset-request");
              const resetBadge = card.querySelector(".card-reset-badge");
              if (resetBadge) resetBadge.remove();
            }

            // Hide dossier reset warning if showing
            if (dossierResetWarning) dossierResetWarning.classList.add("hidden");

            // Reset dossier button styling if this student was selected
            if (dossierResetPwdBtn && dossierResetPwdBtn.getAttribute("data-user-email") === userEmail) {
              dossierResetPwdBtn.className = "inline-flex min-h-11 items-center justify-center rounded-full bg-canvas hover:bg-stone-200 px-4 py-2 text-xs font-bold text-forest-900 transition-all active:scale-95 cursor-pointer";
              dossierResetPwdBtn.textContent = "Reset password";
            }

            // Remove card from top pending requests banner if present
            const bannerCard = document.querySelector(`.pending-request-card[data-req-email="${userEmail}"]`);
            if (bannerCard) {
              bannerCard.remove();
              const remaining = document.querySelectorAll(".pending-request-card").length;
              if (remaining === 0) {
                const bannerSection = document.getElementById("pending-recovery-banner");
                if (bannerSection) bannerSection.remove();
              }
            }

            showToast(`Temporary password generated for ${userName}. Read it to them at the counter.`);
          } else {
            showToast(data.error || "Could not issue a temporary password.");
          }
        } catch {
          showToast("Could not issue a temporary password. Try again.");
        } finally {
          confirmPwdBtn.disabled = false;
          confirmPwdBtn.innerHTML = '<span>Issue temp password</span>';
        }
      });
    }

    // ==========================================
    // ACTION 4: Deactivate Account Trigger
    // ==========================================
    if (dossierDeleteUserBtn) {
      dossierDeleteUserBtn.addEventListener("click", () => {
        const userId = dossierDeleteUserBtn.getAttribute("data-user-id");
        const userEmail = dossierDeleteUserBtn.getAttribute("data-user-email");
        const userName = dossierDeleteUserBtn.getAttribute("data-user-name") || userEmail;

        pendingTarget = { userId, userEmail, userName, card: currentSelectedCard };

        if (deleteModalDesc) {
          deleteModalDesc.textContent = `Are you sure you want to deactivate ${userName} (${userEmail})?`;
        }

        if (deleteModal) {
          deleteModal.classList.remove("hidden");
          deleteModal.classList.add("flex");
        }
      });
    }

    document.querySelectorAll(".close-delete-modal").forEach((btn) => {
      btn.addEventListener("click", closeAllModals);
    });

    if (confirmDeleteBtn) {
      confirmDeleteBtn.addEventListener("click", async () => {
        if (!pendingTarget) return;
        const { userId, userEmail, userName } = pendingTarget;

        confirmDeleteBtn.disabled = true;
        confirmDeleteBtn.innerHTML = '<span>Deactivating...</span>';

        try {
          const res = await fetch("/api/admin/actions", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              action: "delete_user",
              userId,
              email: userEmail,
            }),
          });
          const data = await res.json().catch(() => ({}));

          if (data.ok) {
            showToast(`Account for ${userName} (${userEmail}) has been deactivated.`);
            // Reload so the card and dossier reflect the suspended state
            // without pretending the record was erased.
            setTimeout(() => window.location.reload(), 700);
          } else {
            showToast(data.error || "Failed to deactivate account.");
          }
        } catch {
          showToast("Network error deactivating account.");
        } finally {
          confirmDeleteBtn.disabled = false;
          confirmDeleteBtn.innerHTML = '<span>Deactivate account</span>';
          closeAllModals();
        }
      });
    }

    // Initialize with first card
    if (studentCards.length > 0) {
      updateDossier(studentCards[0]);
    }
  })();
</script>
