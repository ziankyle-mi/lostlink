---
import type { EnhancedCampusUser } from "~/data/campusPrograms";
import { COLLEGES, DEGREE_PROGRAMS } from "~/data/campusPrograms";

interface Props {
  users?: EnhancedCampusUser[];
  currentAdminEmail?: string;
}

const { users = [], currentAdminEmail = "dlsau.lostlink@dlsau.edu.ph" } = Astro.props;

function initialsOf(name: string, email: string): string {
  if (name && name.trim().length > 0) {
    const parts = name.trim().split(/\s+/).filter(Boolean);
    if (parts.length >= 2) return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
    if (parts.length === 1 && parts[0].length >= 2) return parts[0].slice(0, 2).toUpperCase();
  }
  const emailPart = email.split("@")[0].split(/[._-]/).filter(Boolean);
  if (emailPart.length >= 2) return (emailPart[0][0] + emailPart[1][0]).toUpperCase();
  return "ST";
}

function formatDate(isoStr?: string): string {
  if (!isoStr) return "Recently";
  const d = new Date(isoStr);
  return d.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
}

const totalCount = users.length;
const studentCount = users.filter((u) => u.role === "user" && !u.isFaculty).length;
const facultyCount = users.filter((u) => u.isFaculty).length;
const adminCount = users.filter((u) => u.role === "admin").length;
const suspendedCount = users.filter((u) => !u.active).length;

// College counts
const castCount = users.filter((u) => u.collegeCode === "CAST").length;
const cvmasCount = users.filter((u) => u.collegeCode === "CVMAS").length;
const cbmaCount = users.filter((u) => u.collegeCode === "CBMA").length;
const coedCount = users.filter((u) => u.collegeCode === "COED").length;

// Initial selected user for the right dossier
const defaultSelectedUser = users[0] || null;
---

<div class="space-y-7" id="campus-directory-root">
  <!-- Top 4 KPI Metrics for Users Management (aligned to SKILL.md Admin Metrics recipe) -->
  <section class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5" aria-label="Campus account metrics">
    <!-- Card 1: Total Accounts (White panel) -->
    <div class="rounded-3xl bg-white p-6 sm:p-7 border border-stone-200/60 shadow-xs flex flex-col justify-between">
      <p class="text-sm font-medium text-stone-600">Total accounts</p>
      <div class="mt-4">
        <p class="font-serif text-4xl sm:text-5xl font-black text-forest-900 tracking-tight leading-none" id="metric-total-users">
          {totalCount}
        </p>
        <p class="mt-3 text-xs text-stone-500 font-medium">Registered DLSAU accounts</p>
      </div>
    </div>

    <!-- Card 2: Students & Faculty (White panel) -->
    <div class="rounded-3xl bg-white p-6 sm:p-7 border border-stone-200/60 shadow-xs flex flex-col justify-between">
      <p class="text-sm font-medium text-stone-600">Students &amp; faculty</p>
      <div class="mt-4">
        <p class="font-serif text-4xl sm:text-5xl font-black text-forest-900 tracking-tight leading-none" id="metric-students">
          {studentCount + facultyCount}
        </p>
        <p class="mt-3 text-xs text-stone-500 font-medium">
          {studentCount} students &bull; {facultyCount} faculty
        </p>
      </div>
    </div>

    <!-- Card 3: Administrators (Signature Lime Accent Card from SKILL.md) -->
    <div class="rounded-3xl bg-[#d8ef8c] p-6 sm:p-7 text-forest-900 shadow-xs flex flex-col justify-between">
      <p class="text-sm font-bold text-forest-900">Administrators</p>
      <div class="mt-4">
        <p class="font-serif text-4xl sm:text-5xl font-black text-forest-900 tracking-tight leading-none" id="metric-admins">
          {adminCount}
        </p>
        <p class="mt-3 text-xs font-semibold text-forest-800">
          Security &amp; DO staff
        </p>
      </div>
    </div>

    <!-- Card 4: Suspended Accounts (Signature Dark Forest Green Card from SKILL.md) -->
    <div class="rounded-3xl bg-[#164f38] p-6 sm:p-7 text-white shadow-xs flex flex-col justify-between">
      <p class="text-sm font-medium text-stone-200">Suspended accounts</p>
      <div class="mt-4">
        <p class="font-serif text-4xl sm:text-5xl font-black text-white tracking-tight leading-none" id="metric-suspended">
          {suspendedCount}
        </p>
        <p class="mt-3 text-xs font-semibold text-[#d8ef8c]">
          {suspendedCount > 0 ? `${suspendedCount} restricted from reporting` : "All accounts in good standing"}
        </p>
      </div>
    </div>
  </section>

  <!-- Main Directory Card Container (Section card recipe from SKILL.md) -->
  <section class="rounded-3xl bg-white p-6 sm:p-8 border border-stone-200/60 shadow-xs space-y-6" id="users-directory-section">
    <!-- Header Row: Title & Subtitle -->
    <div class="pb-1">
      <h2 class="font-serif text-2xl sm:text-3xl font-black text-forest-900 leading-tight">
        Campus Accounts Directory
      </h2>
      <p class="mt-1 text-sm text-stone-500">
        Manage student profiles, program assignments, and administrative access privileges across all 4 colleges.
      </p>
    </div>

    <!-- College Filter Pills Bar: rounded-2xl only (never sm:rounded-full).
         This bar always wraps to 2 rows at admin widths, and rounded-full on a
         tall wrapped box resolves to ~50px corner arcs that cut into the first
         row, so the active "All accounts" pill overlapped the bar's left edge. -->
    <div class="relative flex flex-wrap items-center gap-2 rounded-2xl bg-[#ece5d6] p-1.5 sm:p-2 shadow-2xs border border-stone-300/50" id="college-pills-row">
      <button
        type="button"
        class="college-filter-pill active min-h-10 rounded-full bg-forest-700 px-4 sm:px-5 py-2 text-xs sm:text-sm font-bold text-white shadow-2xs transition-all active:scale-95 cursor-pointer shrink-0"
        data-college="all"
      >
        All accounts (<span class="college-count" id="count-all">{totalCount}</span>)
      </button>
      <button
        type="button"
        class="college-filter-pill min-h-10 rounded-full px-4 sm:px-5 py-2 text-xs sm:text-sm font-semibold text-forest-900/80 hover:bg-white/50 hover:text-forest-900 transition-all active:scale-95 cursor-pointer shrink-0"
        data-college="CAST"
      >
        CAST Tech &amp; Sciences (<span class="college-count" id="count-CAST">{castCount}</span>)
      </button>
      <button
        type="button"
        class="college-filter-pill min-h-10 rounded-full px-4 sm:px-5 py-2 text-xs sm:text-sm font-semibold text-forest-900/80 hover:bg-white/50 hover:text-forest-900 transition-all active:scale-95 cursor-pointer shrink-0"
        data-college="CVMAS"
      >
        CVMAS Agri-Vet (<span class="college-count" id="count-CVMAS">{cvmasCount}</span>)
      </button>
      <button
        type="button"
        class="college-filter-pill min-h-10 rounded-full px-4 sm:px-5 py-2 text-xs sm:text-sm font-semibold text-forest-900/80 hover:bg-white/50 hover:text-forest-900 transition-all active:scale-95 cursor-pointer shrink-0"
        data-college="CBMA"
      >
        CBMA Business (<span class="college-count" id="count-CBMA">{cbmaCount}</span>)
      </button>
      <button
        type="button"
        class="college-filter-pill min-h-10 rounded-full px-4 sm:px-5 py-2 text-xs sm:text-sm font-semibold text-forest-900/80 hover:bg-white/50 hover:text-forest-900 transition-all active:scale-95 cursor-pointer shrink-0"
        data-college="COED"
      >
        COED Education (<span class="college-count" id="count-COED">{coedCount}</span>)
      </button>
    </div>

    <!-- Secondary Controls Row: Degree Dropdown + Search Input + Summary Status -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-3 pt-2.5 border-t border-stone-100">
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5 flex-1 min-w-0">
        <!-- Degree Filter Dropdown -->
        <div class="relative w-full sm:w-56 shrink-0">
          <select
            id="user-degree-select"
            class="w-full appearance-none rounded-full bg-[#ece5d6] min-h-[2.5rem] py-2 pl-4 pr-9 text-xs font-bold text-forest-900 border border-stone-300/40 focus:bg-white focus:outline-none focus:ring-2 focus:ring-forest-700/25 transition-all cursor-pointer shadow-2xs"
          >
            <option value="all">All degree programs</option>
            <optgroup label="CAST (Technology & Sciences)" data-college-group="CAST">
              <option value="BSCS">BSCS - Computer Science</option>
              <option value="BSCpE">BSCpE - Computer Engineering</option>
              <option value="AB Psych">AB Psych - Psychology</option>
            </optgroup>
            <optgroup label="CVMAS (Agri-Vet & Food)" data-college-group="CVMAS">
              <option value="DVM">DVM - Veterinary Medicine</option>
              <option value="BSA">BSA - Agriculture (Salikneta)</option>
              <option value="BSFT">BSFT - Food Technology</option>
            </optgroup>
            <optgroup label="CBMA (Business & Management)" data-college-group="CBMA">
              <option value="BSA-Act">BSA-Act - Accountancy</option>
              <option value="BSBA-FM">BSBA-FM - Financial Management</option>
              <option value="BSBA-MM">BSBA-MM - Marketing Management</option>
              <option value="BSHM">BSHM - Hospitality Management</option>
              <option value="BSTM">BSTM - Tourism Management</option>
            </optgroup>
            <optgroup label="COED (Teacher Education)" data-college-group="COED">
              <option value="BEEd">BEEd - Elementary Education</option>
              <option value="BSEd">BSEd - Secondary Education</option>
            </optgroup>
          </select>
          <div class="pointer-events-none absolute right-3.5 top-1/2 -translate-y-1/2 text-stone-500">
            <svg class="size-3.5" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
            </svg>
          </div>
        </div>

        <!-- Search Input -->
        <div class="relative flex-1 min-w-[180px] max-w-sm">
          <input
            type="search"
            id="user-search-input"
            placeholder="Search by student name, ID, or @dlsau.edu.ph..."
            class="w-full min-h-[2.5rem] rounded-full bg-[#ece5d6] py-2 pl-9 pr-4 text-xs font-medium text-forest-900 placeholder:text-stone-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-forest-700/25 transition-all shadow-2xs border border-stone-300/40"
          />
          <svg
            class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 size-3.5 text-stone-500"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35m1.85-5.15a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
      </div>

      <!-- Live Count & Reset Link Summary -->
      <div class="flex items-center gap-2 text-xs font-semibold text-stone-500 shrink-0 flex-wrap">
        <span>
          Showing <strong id="visible-count-label" class="text-forest-900">{totalCount}</strong> of <span id="total-count-label">{totalCount}</span> accounts
        </span>
        <span class="text-stone-300">&bull;</span>
        <span class="inline-flex items-center gap-1.5 text-forest-900 font-bold">
          <span class="size-2 rounded-full bg-emerald-500"></span> Active
        </span>
        <span class="text-stone-300">&bull;</span>
        <span class="inline-flex items-center gap-1.5 text-stone-600 font-bold">
          <span class="size-2 rounded-full bg-[#9b2c1f]"></span> Suspended
        </span>
        <span class="text-stone-300">&bull;</span>
        <button
          type="button"
          id="reset-filters-btn"
          class="text-xs font-bold text-forest-900 underline underline-offset-4 hover:text-forest-700 transition-colors cursor-pointer"
        >
          Reset filters
        </button>
      </div>
    </div>

    <!-- 2-COLUMN SPLIT VIEW -->
    <div class="flex flex-col lg:flex-row items-start gap-6 pt-2">
      <!-- LEFT COLUMN: SELECT ACCOUNT (Fixed width on desktop) -->
      <div class="w-full lg:w-[330px] xl:w-[350px] shrink-0 space-y-2.5">
        <div class="flex items-center justify-between px-1">
          <span class="text-[11px] font-bold tracking-wider text-stone-400 uppercase">
            Select account
          </span>
          <span class="text-xs text-stone-400 font-medium" id="left-list-counter">
            {totalCount} accounts
          </span>
        </div>

        <!-- Scrollable Student Cards List -->
        <div
          class="space-y-1.5 max-h-[640px] overflow-y-auto pr-1 select-none custom-scroll"
          id="student-cards-list"
        >
          {users.map((u, idx) => {
            const initials = initialsOf(u.full_name, u.email);
            const isSelf = u.email.toLowerCase().trim() === currentAdminEmail.toLowerCase().trim();
            const isFirst = idx === 0;

            return (
              <div
                class={`student-select-card group relative flex items-center justify-between p-3 rounded-2xl border transition-all cursor-pointer ${
                  isFirst
                    ? "border-2 border-forest-700 bg-forest-700/5 shadow-xs selected-user"
                    : "border-stone-200/80 bg-white hover:border-stone-300 hover:bg-[#f5f1e6]/40"
                }`}
                data-user-id={u.id}
                data-user-name={u.full_name}
                data-user-email={u.email}
                data-user-role={u.role}
                data-user-active={u.active ? "true" : "false"}
                data-college-code={u.collegeCode}
                data-college-name={u.collegeName}
                data-program-code={u.programCode}
                data-program-name={u.programName}
                data-student-id={u.studentId}
                data-units={String(u.units)}
                data-year-level={u.yearLevel}
                data-is-faculty={u.isFaculty ? "true" : "false"}
                data-campus={u.campus}
                data-campus-subtext={u.campusSubtext}
                data-affiliation-text={u.affiliationText}
                data-portal-level={u.portalLevel}
                data-is-self={isSelf ? "true" : "false"}
                data-created-at={u.created_at}
                tabindex="0"
                role="button"
                aria-pressed={isFirst ? "true" : "false"}
              >
                <!-- Left: Avatar + Details -->
                <div class="flex items-center gap-2.5 min-w-0">
                  <div class="size-9.5 rounded-xl flex items-center justify-center font-serif text-xs font-black bg-[#eef2e3] text-forest-900 shrink-0 border border-stone-200/70">
                    {initials}
                  </div>
                  <div class="min-w-0">
                    <div class="flex items-center gap-1.5">
                      <p class="font-bold text-forest-900 text-xs sm:text-sm truncate leading-snug card-user-name">
                        {u.full_name}
                      </p>
                      {isSelf && (
                        <span class="inline-block rounded-full bg-forest-700/10 px-1.5 py-0.2 text-[9px] font-black text-forest-700 uppercase">
                          You
                        </span>
                      )}
                    </div>
                    <p class="text-[11px] text-stone-500 font-medium truncate mt-0.5">
                      <span class="font-semibold text-forest-800">{u.programCode}</span> &bull; {u.collegeCode}
                      {u.isFaculty && <span class="text-amber-800 font-bold"> &bull; Faculty</span>}
                    </p>
                  </div>
                </div>

                <!-- Right: Status Pill -->
                <div class="shrink-0 pl-1.5">
                  {u.active ? (
                    <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 border border-emerald-200 px-2 py-0.5 text-[10px] font-bold text-emerald-800 card-status-badge">
                      <span class="size-1.5 rounded-full bg-emerald-500"></span>
                      Active
                    </span>
                  ) : (
                    <span class="inline-flex items-center gap-1 rounded-full bg-rose-50 border border-rose-200 px-2 py-0.5 text-[10px] font-bold text-[#9b2c1f] card-status-badge">
                      <span class="size-1.5 rounded-full bg-[#9b2c1f]"></span>
                      Suspended
                    </span>
                  )}
                </div>
              </div>
            );
          })}
        </div>

        <!-- Empty Results Message in Left Column -->
        <div id="no-cards-message" class="hidden p-6 text-center bg-stone-50 rounded-2xl border border-stone-200">
          <p class="font-bold text-stone-600 text-xs">No campus accounts found</p>
          <p class="text-[11px] text-stone-400 mt-0.5">Try adjusting your college or degree filter.</p>
        </div>
      </div>

      <!-- RIGHT COLUMN: SELECTED STUDENT DOSSIER (Takes all remaining width!) -->
      <div class="w-full flex-1 min-w-0">
        <div class="rounded-3xl border border-stone-200/80 bg-[#faf8f4] p-5 sm:p-7 shadow-xs space-y-5" id="dossier-card">
          <!-- Dossier Header: Avatar + Name + Email + Top Badges -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-stone-200/70">
            <div class="flex items-center gap-3.5 min-w-0 flex-1">
              <div
                id="dossier-avatar"
                class="size-14 sm:size-16 rounded-2xl flex items-center justify-center font-serif text-xl sm:text-2xl font-black bg-[#164f38] text-[#d8ef8c] shadow-xs shrink-0 border border-[#24694b]"
              >
                {defaultSelectedUser ? initialsOf(defaultSelectedUser.full_name, defaultSelectedUser.email) : "DL"}
              </div>
              <div class="min-w-0 flex-1">
                <h3 id="dossier-name" class="font-serif text-xl sm:text-2xl lg:text-[1.75rem] font-black text-forest-900 tracking-tight leading-snug break-words">
                  {defaultSelectedUser?.full_name || "Select an account"}
                </h3>
                <p id="dossier-email" class="text-xs sm:text-sm text-stone-500 font-mono truncate mt-0.5">
                  {defaultSelectedUser?.email || "student@dlsau.edu.ph"}
                </p>
              </div>
            </div>

            <!-- Badges Row -->
            <div class="flex flex-wrap items-center sm:flex-col sm:items-end gap-2 shrink-0">
              <div id="dossier-status-container">
                {defaultSelectedUser?.active ? (
                  <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 border border-emerald-200 px-3 py-1 text-xs font-bold text-emerald-800">
                    <span class="size-2 rounded-full bg-emerald-500"></span>
                    Active account
                  </span>
                ) : (
                  <span class="inline-flex items-center gap-1.5 rounded-full bg-rose-50 border border-rose-200 px-3 py-1 text-xs font-bold text-[#9b2c1f]">
                    <span class="size-2 rounded-full bg-[#9b2c1f]"></span>
                    Suspended
                  </span>
                )}
              </div>
              <div id="dossier-role-container">
                {defaultSelectedUser?.role === "admin" ? (
                  <span class="inline-flex items-center gap-1 rounded-full bg-[#164f38] text-[#d8ef8c] px-3 py-1 text-xs font-bold uppercase tracking-wider shadow-2xs">
                    DO Admin
                  </span>
                ) : defaultSelectedUser?.isFaculty ? (
                  <span class="inline-flex items-center gap-1 rounded-full bg-[#d8ef8c] text-forest-900 border border-lime-600/30 px-3 py-1 text-xs font-bold uppercase tracking-wider">
                    Faculty
                  </span>
                ) : (
                  <span class="inline-flex items-center gap-1 rounded-full bg-[#ece5d6] text-forest-900 border border-stone-200 px-3 py-1 text-xs font-bold uppercase tracking-wider">
                    Student
                  </span>
                )}
              </div>
            </div>
          </div>

          <!-- Department & Campus Affiliation Banner -->
          <div class="rounded-2xl bg-[#ece5d6] border border-stone-300/50 p-3.5 space-y-1" id="dossier-affiliation-box">
            <div class="flex items-center gap-2 text-forest-900 font-bold text-xs uppercase tracking-wider">
              <svg class="size-4 shrink-0 text-forest-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M3 21h18M3 7v1a3 3 0 0 0 6 0V7m0 1a3 3 0 0 0 6 0V7m0 1a3 3 0 0 0 6 0V7H3l2-4h14l2 4"></path>
                <path d="M5 21V10.85M19 21V10.85M9 21v-4a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v4"></path>
              </svg>
              <span id="dossier-college-banner" class="break-words">
                {defaultSelectedUser ? `${defaultSelectedUser.collegeName} (${defaultSelectedUser.collegeCode}) • ${defaultSelectedUser.campus}` : "Department Affiliation"}
              </span>
            </div>
            <p id="dossier-affiliation-text" class="text-xs text-stone-600 leading-relaxed">
              {defaultSelectedUser?.affiliationText || "This account is provisioned under De La Salle Araneta University."}
            </p>
          </div>

          <!-- 4 Core Metric Cards Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <!-- 1. Enrolled Program -->
            <div class="rounded-2xl bg-white p-3.5 sm:p-4 border border-stone-200/70 shadow-2xs">
              <p class="text-[10px] font-bold uppercase tracking-wider text-stone-400">Enrolled program</p>
              <p id="dossier-program-code" class="mt-1 font-serif text-xl sm:text-2xl font-black text-forest-900 leading-none">
                {defaultSelectedUser?.programCode || "BSCS"}
              </p>
              <p id="dossier-program-name" class="mt-1 text-xs text-stone-500 font-medium leading-relaxed">
                {defaultSelectedUser?.programName || "Bachelor of Science in Computer Science"}
              </p>
            </div>

            <!-- 2. Student ID & Units -->
            <div class="rounded-2xl bg-white p-3.5 sm:p-4 border border-stone-200/70 shadow-2xs">
              <p class="text-[10px] font-bold uppercase tracking-wider text-stone-400">Student ID &amp; units</p>
              <p id="dossier-student-id" class="mt-1 font-mono text-xl sm:text-2xl font-black text-forest-900 leading-none">
                {defaultSelectedUser?.studentId || "2024-10144"}
              </p>
              <p id="dossier-units-level" class="mt-1 text-xs text-stone-500 font-medium leading-relaxed">
                {defaultSelectedUser?.isFaculty ? "Faculty Member • Active Load" : `${defaultSelectedUser?.units || 21} Units • ${defaultSelectedUser?.yearLevel || "3rd Year"}`}
              </p>
            </div>

            <!-- 3. Designated Campus / Lab -->
            <div class="rounded-2xl bg-white p-3.5 sm:p-4 border border-stone-200/70 shadow-2xs">
              <p class="text-[10px] font-bold uppercase tracking-wider text-stone-400">Campus location</p>
              <p id="dossier-campus" class="mt-1 font-bold text-sm sm:text-base text-forest-900 leading-snug">
                {defaultSelectedUser?.campus || "Victoneta Park (Main)"}
              </p>
              <p id="dossier-campus-subtext" class="mt-1 text-xs text-stone-500 font-medium leading-relaxed">
                {defaultSelectedUser?.campusSubtext || "Computer Science & AI Research Lab"}
              </p>
            </div>

            <!-- 4. Portal Access Level -->
            <div class="rounded-2xl bg-white p-3.5 sm:p-4 border border-stone-200/70 shadow-2xs">
              <p class="text-[10px] font-bold uppercase tracking-wider text-stone-400">Portal privileges</p>
              <p id="dossier-portal-level" class="mt-1 font-bold text-sm sm:text-base text-forest-900 leading-snug">
                {defaultSelectedUser?.portalLevel || "Student"}
              </p>
              <p id="dossier-portal-subtext" class="mt-1 text-xs text-stone-500 font-medium leading-relaxed">
                Standard LostLink reporting and claim submission privileges.
              </p>
            </div>
          </div>

          <!-- Account Activity Summary -->
          <div class="flex items-center justify-between text-xs text-stone-500 bg-white/80 rounded-xl px-3.5 py-2.5 border border-stone-200/60 flex-wrap gap-2">
            <span>Joined campus portal: <strong id="dossier-joined-date" class="text-forest-900">{formatDate(defaultSelectedUser?.created_at)}</strong></span>
            <span>Campus feed access: <strong class="text-emerald-700 font-bold">Verified @dlsau.edu.ph</strong></span>
          </div>

          <!-- Footer Action Bar: Account ID + Actions (Make Admin, Suspend, Reset Link, Delete Account) -->
          <div class="flex flex-wrap items-center justify-between gap-3 pt-4 border-t border-stone-200/70">
            <!-- Left: Account ID display -->
            <div class="font-mono text-xs font-semibold text-stone-600 bg-[#ece5d6] px-3.5 py-1.5 rounded-lg shrink-0" id="dossier-account-id-label">
              Account ID: {defaultSelectedUser?.studentId || "2024-10144"}
            </div>

            <!-- Right: Action Buttons Group -->
            <div class="flex items-center gap-2 flex-wrap">
              <!-- Make Admin Button -->
              <button
                type="button"
                id="dossier-toggle-role-btn"
                class="rounded-full px-4 py-2 text-xs font-bold transition-all active:scale-95 cursor-pointer bg-[#164f38]/10 hover:bg-[#164f38] hover:text-[#d8ef8c] text-[#164f38]"
                data-user-id={defaultSelectedUser?.id}
                data-user-email={defaultSelectedUser?.email}
                data-user-name={defaultSelectedUser?.full_name}
                data-target-role={defaultSelectedUser?.role === "admin" ? "user" : "admin"}
