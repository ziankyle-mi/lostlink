---
import { CATEGORIES, LOCATIONS, TOTAL } from "~/data/mockItems";
---

<section class="mx-auto w-full max-w-7xl px-4 sm:px-10 lg:px-14" aria-label="Campus feed filters">
  <div class="relative flex flex-wrap items-center justify-between gap-2.5 sm:gap-3 rounded-2xl sm:rounded-full bg-[#ece5d6] p-2 sm:p-2.5 shadow-2xs border border-stone-300/50">
    <!-- Left Filter Controls (Scaled up for substantial presence) -->
    <div class="flex flex-wrap items-center gap-1.5 sm:gap-2.5">
      <!-- All Items Filter Pill (Active by default) -->
      <button
        type="button"
        data-filter-type="all"
        class="filter-type-btn active min-h-10 sm:min-h-11 rounded-full bg-forest-700 px-4 sm:px-6 py-2 text-xs sm:text-[0.9375rem] font-bold text-white shadow-2xs transition-all cursor-pointer"
      >
        All Items
      </button>

      <!-- Found Filter Pill -->
      <button
        type="button"
        data-filter-type="found"
        class="filter-type-btn min-h-11 rounded-full px-4.5 sm:px-5 py-2 text-sm sm:text-[0.9375rem] font-semibold text-forest-900/80 transition-all hover:text-forest-900 hover:bg-white/40 cursor-pointer"
      >
        Found
      </button>

      <!-- Lost Filter Pill -->
      <button
        type="button"
        data-filter-type="lost"
        class="filter-type-btn min-h-11 rounded-full px-4.5 sm:px-5 py-2 text-sm sm:text-[0.9375rem] font-semibold text-forest-900/80 transition-all hover:text-forest-900 hover:bg-white/40 cursor-pointer"
      >
        Lost
      </button>

      <!-- Category Dropdown Pill -->
      <div class="relative">
        <button
          type="button"
          id="category-dropdown-btn"
          aria-haspopup="listbox"
          aria-expanded="false"
          class="flex min-h-11 items-center gap-2 rounded-full border border-stone-200/90 bg-white px-4.5 sm:px-5 py-2 text-sm sm:text-[0.9375rem] font-semibold text-forest-900 shadow-2xs transition-all hover:bg-stone-50 cursor-pointer"
        >
          <span id="selected-category-label">Category</span>
          <svg class="size-3.5 text-forest-900/70" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <div
          id="category-dropdown-menu"
          role="listbox"
          class="absolute left-0 top-13 z-40 hidden min-w-[210px] rounded-2xl border border-line bg-white p-2 shadow-xl"
        >
          {CATEGORIES.map((cat) => (
            <button
              type="button"
              role="option"
              data-category={cat}
              class="category-option block w-full rounded-xl px-3.5 py-2.5 text-left text-sm font-medium text-forest-900 hover:bg-[#f5f1e6] cursor-pointer"
            >
              {cat}
            </button>
          ))}
        </div>
      </div>

      <!-- Location Dropdown Pill -->
      <div class="relative">
        <button
          type="button"
          id="location-dropdown-btn"
          aria-haspopup="listbox"
          aria-expanded="false"
          class="flex min-h-11 items-center gap-2 rounded-full border border-stone-200/90 bg-white px-4.5 sm:px-5 py-2 text-sm sm:text-[0.9375rem] font-semibold text-forest-900 shadow-2xs transition-all hover:bg-stone-50 cursor-pointer"
        >
          <span id="selected-location-label">Location</span>
          <svg class="size-3.5 text-forest-900/70" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <div
          id="location-dropdown-menu"
          role="listbox"
          class="absolute left-0 top-13 z-40 hidden min-w-[220px] rounded-2xl border border-line bg-white p-2 shadow-xl"
        >
          {LOCATIONS.map((loc) => (
            <button
              type="button"
              role="option"
              data-location={loc}
              class="location-option block w-full rounded-xl px-3.5 py-2.5 text-left text-sm font-medium text-forest-900 hover:bg-[#f5f1e6] cursor-pointer"
            >
              {loc}
            </button>
          ))}
        </div>
      </div>

      <!-- Date Dropdown Pill -->
      <div class="relative">
        <button
          type="button"
          id="date-dropdown-btn"
          aria-haspopup="listbox"
          aria-expanded="false"
          class="flex min-h-11 items-center gap-2 rounded-full border border-stone-200/90 bg-white px-4.5 sm:px-5 py-2 text-sm sm:text-[0.9375rem] font-semibold text-forest-900 shadow-2xs transition-all hover:bg-stone-50 cursor-pointer"
        >
          <span id="selected-date-label">Date</span>
          <svg class="size-3.5 text-forest-900/70" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <div
          id="date-dropdown-menu"
          role="listbox"
          class="absolute left-0 top-13 z-40 hidden min-w-[180px] rounded-2xl border border-line bg-white p-2 shadow-xl"
        >
          <button type="button" data-date="all" class="date-option block w-full rounded-xl px-3.5 py-2.5 text-left text-sm font-medium text-forest-900 hover:bg-[#f5f1e6] cursor-pointer">
            All dates
          </button>
          <button type="button" data-date="today" class="date-option block w-full rounded-xl px-3.5 py-2.5 text-left text-sm font-medium text-forest-900 hover:bg-[#f5f1e6] cursor-pointer">
            Today
          </button>
          <button type="button" data-date="week" class="date-option block w-full rounded-xl px-3.5 py-2.5 text-left text-sm font-medium text-forest-900 hover:bg-[#f5f1e6] cursor-pointer">
            Past 7 days
          </button>
          <button type="button" data-date="month" class="date-option block w-full rounded-xl px-3.5 py-2.5 text-left text-sm font-medium text-forest-900 hover:bg-[#f5f1e6] cursor-pointer">
            Past 30 days
          </button>
        </div>
      </div>
    </div>

    <!-- Right Controls: Counter Badge and Reset Button -->
    <div class="flex items-center gap-2 sm:gap-2.5 ml-auto sm:ml-0">
      <!-- Item Counter Pill -->
      <span
        id="item-counter-badge"
        class="flex min-h-10 sm:min-h-11 items-center rounded-full bg-[#d8ef8c] px-3.5 sm:px-4.5 py-1.5 sm:py-2 text-xs sm:text-base font-black text-forest-900 border border-lime-600/30 shadow-2xs"
      >
        {TOTAL}
      </span>

      <!-- Reset Filters Pill Button -->
      <button
        type="button"
        id="reset-filters-btn"
        class="flex min-h-10 sm:min-h-11 items-center rounded-full border border-stone-200/90 bg-white px-4 sm:px-6 py-1.5 sm:py-2 text-xs sm:text-[0.9375rem] font-semibold text-forest-900 shadow-2xs transition-all hover:bg-stone-50 cursor-pointer"
      >
        Reset filters
      </button>
    </div>
  </div>
</section>
