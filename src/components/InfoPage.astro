---
import BrandHeader from "./BrandHeader.astro";
import SiteFooter from "./SiteFooter.astro";
import Base from "~/layouts/Base.astro";

/**
 * Slim page frame for reading pages (privacy, terms, help): one centered
 * card, no green panel, with a back link. Same header and footer as AuthShell.
 */
interface Props {
  title: string;
  heading: string;
  subheading?: string;
  description?: string;
}

const { title, heading, subheading, description } = Astro.props;

const signedIn = Boolean(Astro.locals.user);
const backHref = signedIn ? "/" : "/login";
const backLabel = signedIn ? "Back to dashboard" : "Back to sign in";
---

<Base title={title} description={description}>
  <div class="flex min-h-dvh flex-col bg-canvas px-4 sm:px-10 lg:px-14">
    <header class="flex items-center justify-between gap-4 border-b border-line py-5 sm:py-6">
      <BrandHeader />
      <p
        class="hidden text-[0.8125rem] font-medium tracking-wide text-forest-700 uppercase md:block"
      >
        DLSAU Campus Community
      </p>
    </header>

    <main class="flex flex-1 justify-center py-8 sm:py-10">
      <section
        class="w-full max-w-3xl rounded-card border border-line/70 bg-white px-6 py-8 shadow-card sm:px-10 sm:py-10"
        aria-labelledby="page-title"
      >
        <a
          href={backHref}
          class="inline-flex items-center gap-1.5 text-sm font-semibold text-forest-700 underline-offset-4 hover:underline"
        >
          <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"></path>
          </svg>
          {backLabel}
        </a>

        <h1
          id="page-title"
          class="mt-5 font-serif text-[clamp(1.875rem,3vw,2.5rem)] leading-[1.1] font-black text-ink"
        >
          {heading}
        </h1>
        {subheading && <p class="mt-3 text-[1.0625rem] text-sage-600">{subheading}</p>}
        <slot />
      </section>
    </main>

    <SiteFooter />
  </div>
</Base>
