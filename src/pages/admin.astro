const liveAuditEvents = liveLogs.map((log: any, idx: number) => {
  const parsed = parseAuditEvent(
    log.action,
    log.items?.name,
    log.item_id,
    userEmail,
    log.created_at,
    (log.action || "").includes("claim") ? "claim" : (log.action || "").includes("intake") ? "intake" : "user"
  );
  return {
    id: log.id || `live-${idx}`,
    ...parsed,
  };
});

const allAuditEvents = liveAuditEvents.length > 0 ? [...liveAuditEvents, ...defaultAuditEvents.slice(liveAuditEvents.length)] : defaultAuditEvents;
---

<Base
  title={`${currentTab === "users" ? "User Management" : "Admin Console"} | LostLink`}
  description="LostLink campus lost and found console for De La Salle Araneta University."
>
  <div class="min-h-screen bg-canvas text-forest-900 flex flex-col justify-between selection:bg-lime">
    <div>
      <!-- Top Announcement Ticker Bar matching overview1admin.png -->
      <AdminTicker />

      <!-- Main Layout Container -->
      <div class={`mx-auto w-full ${currentTab === "users" ? "max-w-[1660px]" : "max-w-[1520px]"} px-4 py-6 sm:px-6 sm:py-8 lg:px-10`}>
        <div class="flex flex-col-reverse lg:flex-row items-start gap-7 lg:gap-8">
          <!-- Main Content (Left Column) -->
          <main class="w-full flex-1 min-w-0 space-y-7">
            <!-- Header Row: Date Eyebrow, Overview Title, Search, CTA -->
            <div class="flex flex-col md:flex-row md:items-end justify-between gap-5">
              <div>
                <p class="text-xs font-bold tracking-[0.22em] text-stone-500 uppercase">
                  {dateEyebrow}
                </p>
