          <div id="create-ann-error" class="hidden text-xs font-semibold text-danger bg-danger/10 p-2.5 rounded-xl border border-danger/20"></div>

          <div class="flex items-center justify-between pt-1">
            <span class="text-[11px] text-stone-500 font-medium">Broadcasts immediately upon publishing</span>
            <button
              type="submit"
              id="create-ann-submit-btn"
              class="inline-flex min-h-11 items-center justify-center gap-2 rounded-full bg-forest-700 hover:bg-forest-900 active:scale-95 px-6 py-2 text-xs font-bold text-white transition-all shadow-xs cursor-pointer"
            >
              <span>Broadcast Announcement</span>
              <svg class="size-4 text-lime" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="22" y1="2" x2="11" y2="13"></line>
                <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
              </svg>
            </button>
          </div>
