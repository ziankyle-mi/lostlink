---
import Base from "~/layouts/Base.astro";
import AdminTicker from "~/components/admin/AdminTicker.astro";
import AdminSidebar from "~/components/admin/AdminSidebar.astro";
import AdminMetrics from "~/components/admin/AdminMetrics.astro";
import ClaimsVerificationTable from "~/components/admin/ClaimsVerificationTable.astro";
import IntakeQueue from "~/components/admin/IntakeQueue.astro";
import RecentActivity from "~/components/admin/RecentActivity.astro";
import UsersManagement from "~/components/admin/UsersManagement.astro";
import { INITIAL_CAMPUS_USERS, type CampusUser } from "~/data/mockUsers";
import { enrichCampusUser, type EnhancedCampusUser } from "~/data/campusPrograms";

import { roleForEmail } from "~/lib/session";
import { readEnv } from "~/lib/env";
import { createClient } from "@supabase/supabase-js";

const user = Astro.locals.user;
const userEmail = user?.email ?? "dlsau.lostlink@dlsau.edu.ph";
const isRealAdmin = user?.role === "admin" || roleForEmail(userEmail) === "admin";

// The admin console is guarded on the server: non-admins are sent back to the feed.
if (!isRealAdmin) {
  return Astro.redirect("/");
}

const currentTab = Astro.url.searchParams.get("tab") || "overview";

// Date formatting matching "SATURDAY, OCTOBER 10" from Figma
const today = new Date();
const dateEyebrow = today.toLocaleDateString("en-US", {
  weekday: "long",
  month: "long",
  day: "numeric",
}).toUpperCase();

// Query live data from Supabase
const env = Astro.locals.env || readEnv();
let liveMetrics = {
  itemsInCustody: 0,
  activeLostReports: 0,
  claimsToVerify: 0,
  returnedThisMonth: 0,
};
let liveClaims: any[] = [];
let liveIntake: any[] = [];
let liveLogs: any[] = [];
let allUsers: EnhancedCampusUser[] = [];

if (env.PUBLIC_SUPABASE_URL && (env.SUPABASE_SERVICE_ROLE_KEY || env.PUBLIC_SUPABASE_ANON_KEY)) {
  try {
    const supabase = createClient(
      env.PUBLIC_SUPABASE_URL,
      env.SUPABASE_SERVICE_ROLE_KEY || env.PUBLIC_SUPABASE_ANON_KEY,
      { auth: { persistSession: false } },
    );

    // Admin View: Live stats and records from entire campus
    const [
      custodyRes,
      lostRes,
      claimsRes,
      returnedRes,
      claimsListRes,
      intakeListRes,
      logsListRes,
      profilesRes,
    ] = await Promise.all([
      supabase
        .from("items")
        .select("id", { count: "exact", head: true })
        .eq("type", "found")
        .neq("status", "returned"),
      supabase
        .from("items")
        .select("id", { count: "exact", head: true })
        .eq("type", "lost")
        .neq("status", "resolved"),
      supabase
        .from("claims")
        .select("id", { count: "exact", head: true })
        .eq("status", "pending"),
      supabase
        .from("items")
        .select("id", { count: "exact", head: true })
        .in("status", ["claimed", "returned"]),
      supabase
        .from("claims")
        .select(`
          id,
          proof_description,
          status,
          created_at,
          items ( name, location, category ),
          profiles ( full_name, email )
        `)
        .order("created_at", { ascending: false })
        .limit(10),
      supabase
        .from("items")
        .select(`
          id,
          name,
          category,
          location,
          reference_code,
          created_at,
          profiles ( full_name, email )
        `)
        .eq("type", "found")
        .eq("status", "pending")
        .order("created_at", { ascending: false })
        .limit(10),
      supabase
        .from("admin_log")
        .select(`
          id,
          action,
          created_at,
          item_id,
          items ( name )
        `)
        .order("created_at", { ascending: false })
        .limit(8),
      supabase
        .from("profiles")
        .select("id, full_name, email, role, active, created_at")
        .order("created_at", { ascending: false })
        .limit(500),
    ]);

    liveMetrics = {
      itemsInCustody: custodyRes.count ?? 0,
      activeLostReports: lostRes.count ?? 0,
      claimsToVerify: claimsRes.count ?? 0,
      returnedThisMonth: returnedRes.count ?? 0,
    };

    if (claimsListRes.data) liveClaims = claimsListRes.data;
    if (intakeListRes.data) liveIntake = intakeListRes.data;
    if (logsListRes.data) liveLogs = logsListRes.data;

    let authUserMetaMap = new Map<string, any>();
    if (env.SUPABASE_SERVICE_ROLE_KEY && currentTab === "users") {
      try {
        const { data: authUsersData } = await supabase.auth.admin.listUsers({ perPage: 500 });
        if (authUsersData?.users) {
          for (const u of authUsersData.users) {
            if (u.user_metadata) {
              authUserMetaMap.set(u.id, u.user_metadata);
              if (u.email) authUserMetaMap.set(u.email.toLowerCase(), u.user_metadata);
            }
          }
        }
      } catch (e) {
        console.warn("[admin] auth.admin.listUsers note:", e);
      }
    }

    if (profilesRes.data && profilesRes.data.length > 0) {
      allUsers = profilesRes.data.map((p: any) => {
        const meta = authUserMetaMap.get(p.id) || authUserMetaMap.get((p.email || "").toLowerCase());
        return enrichCampusUser({
          ...p,
          user_metadata: meta,
        });
      });
    } else {
      allUsers = INITIAL_CAMPUS_USERS.map((u) => enrichCampusUser(u));
    }
  } catch (err) {
    console.warn("[admin] Live data query note:", err);
  }
} else {
  allUsers = INITIAL_CAMPUS_USERS.map((u) => enrichCampusUser(u));
}

// Full audit log events for the Full Audit Log modal
const defaultAuditEvents = [
  { id: "e1", title: "Claim approved: iPhone 13 Pro released", details: "Released to Maria Santos (2024-10144) • Ref: DLSAU-2026-F002", category: "claim", operator: "dlsau.lostlink@dlsau.edu.ph", time: "Today, 11:42 AM" },
  { id: "e2", title: "Custody confirmed: Hydro Flask 32oz intake", details: "Tag affixed, placed in Vault Shelf C-1 • Ref: DLSAU-2026-F005", category: "intake", operator: "dlsau.lostlink@dlsau.edu.ph", time: "Today, 10:15 AM" },
  { id: "e3", title: "Account promoted to administrator", details: "Promoted Prof. Lourdes Carandang (Faculty) to DO Admin", category: "user", operator: "dlsau.lostlink@dlsau.edu.ph", time: "Yesterday, 4:20 PM" },
  { id: "e4", title: "Custody confirmed: Casio fx-991EX calculator", details: "Intake verified at DO Room 102 • Ref: DLSAU-2026-F009", category: "intake", operator: "dlsau.lostlink@dlsau.edu.ph", time: "Oct 13, 2:10 PM" },
  { id: "e5", title: "Claim verification requested: Blue backpack", details: "Claimant submitted proof photo • Ref: DLSAU-2026-F014", category: "claim", operator: "dlsau.lostlink@dlsau.edu.ph", time: "Oct 12, 9:30 AM" },
  { id: "e6", title: "Account moderation: User suspended", details: "Suspended Marc Daniel Hernandez pending disciplinary review", category: "user", operator: "dlsau.lostlink@dlsau.edu.ph", time: "Oct 11, 3:45 PM" },
  { id: "e7", title: "Claim approved: Leather wallet released", details: "Released to Christian Reyes • Ref: DLSAU-2026-F001", category: "claim", operator: "dlsau.lostlink@dlsau.edu.ph", time: "Oct 10, 1:15 PM" },
  { id: "e8", title: "Custody confirmed: DLSAU ID card (CAST)", details: "Placed in Locker Vault A-1 • Ref: DLSAU-2026-F003", category: "intake", operator: "dlsau.lostlink@dlsau.edu.ph", time: "Oct 9, 11:00 AM" },
];

const liveAuditEvents = liveLogs.map((log: any, idx: number) => ({
  id: log.id || `live-${idx}`,
  title: log.items?.name ? `Admin action: ${log.items.name}` : `System log: ${log.action || "Audit record"}`,
  details: `Action: ${log.action || "Custodial change"} • Ref: ${log.item_id ? log.item_id.slice(0, 8) : "System"}`,
  category: (log.action || "").includes("claim") ? "claim" : (log.action || "").includes("intake") ? "intake" : "user",
  operator: userEmail,
  time: log.created_at ? new Date(log.created_at).toLocaleTimeString("en-US", { hour: "numeric", minute: "2-digit" }) : "Recently",
}));

const allAuditEvents = liveAuditEvents.length > 0 ? [...liveAuditEvents, ...defaultAuditEvents.slice(liveAuditEvents.length)] : defaultAuditEvents;
---

<Base
  title={`${currentTab === "users" ? "User Management" : "Admin Console"} | LostLink`}
  description="LostLink campus lost and found console for De La Salle Araneta University."
>
  <div class="min-h-screen bg-[#f5f1e6] text-[#082e1a] flex flex-col justify-between selection:bg-[#d8ef8c]">
    <div>
      <!-- Top Announcement Ticker Bar matching overview1admin.png -->
      <AdminTicker />

      <!-- Main Layout Container -->
      <div class={`mx-auto w-full ${currentTab === "users" ? "max-w-[1660px]" : "max-w-[1520px]"} px-4 py-6 sm:px-6 sm:py-8 lg:px-10`}>
        <div class="flex flex-col-reverse lg:flex-row items-start gap-7 lg:gap-8">
          <!-- Main Content (Left Column) -->
          <main class="w-full flex-1 min-w-0 space-y-7">
            <!-- Header Row: Date Eyebrow, Overview Title, Search, CTA -->
            <div class="flex flex-col md:flex-row md:items-end justify-between gap-5">
              <div>
                <p class="text-xs font-bold tracking-[0.22em] text-stone-500 uppercase">
                  {dateEyebrow}
                </p>
                <h1 class="mt-1 font-serif text-4xl sm:text-5xl lg:text-[3.25rem] font-black text-forest-900 tracking-tight leading-none">
                  {currentTab === "users" ? "User Management" : "Overview"}
                </h1>
              </div>

              <!-- Top Right Controls -->
              <div class="flex items-center gap-3 sm:gap-4 flex-wrap sm:flex-nowrap">
                {currentTab === "users" ? (
                  <a
                    href="/admin"
                    class="flex min-h-[3rem] shrink-0 items-center gap-2 rounded-full bg-forest-700 hover:bg-forest-900 active:scale-95 px-5 sm:px-6 py-2.5 text-sm font-bold text-white transition-all shadow-xs cursor-pointer"
                  >
                    <span>&larr; Back to overview</span>
                  </a>
                ) : (
                  <>
                    <div class="relative flex-1 sm:w-72 lg:w-80">
                      <input
                        type="search"
                        id="overview-search-input"
                        placeholder="Search items, students, claims.."
                        class="w-full min-h-[3rem] rounded-full bg-[#ece5d6] py-2.5 pl-11 pr-4 text-sm text-forest-900 placeholder:text-stone-500 placeholder:font-normal focus:bg-white focus:outline-none focus:ring-2 focus:ring-forest-700/25 transition-all shadow-2xs border-0"
                      />
                      <svg
                        class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 size-4.5 text-stone-500"
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="2"
                        aria-hidden="true"
                      >
                        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35m1.85-5.15a7 7 0 11-14 0 7 7 0 0114 0z" />
                      </svg>
                    </div>

                    <button
                      type="button"
                      id="log-found-cta-btn"
                      class="flex min-h-[3rem] shrink-0 items-center gap-2 rounded-full bg-forest-700 hover:bg-forest-900 active:scale-95 px-5 sm:px-6 py-2.5 text-sm font-bold text-white transition-all shadow-xs cursor-pointer"
                    >
                      <span>Log a found item</span>
                      <span class="text-base font-black leading-none">+</span>
                    </button>
                  </>
                )}
              </div>
            </div>

            {currentTab === "users" ? (
              <UsersManagement users={allUsers} currentAdminEmail={userEmail} />
            ) : (
              <>
                <!-- Row 1: 4 KPI Stat Cards -->
                <AdminMetrics role="admin" metrics={liveMetrics} />

                <!-- Row 2: Claims to verify Table Card -->
                <ClaimsVerificationTable role="admin" liveClaims={liveClaims} />

                <!-- Row 3: Two Columns Split (Waiting for intake + Recent activity) -->
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 sm:gap-7">
                  <IntakeQueue role="admin" liveIntake={liveIntake} />
                  <RecentActivity role="admin" liveLogs={liveLogs} />
                </div>
              </>
            )}
          </main>

          <!-- Floating Admin Sidebar (Right Column) -->
          <div class="w-full lg:w-auto shrink-0 lg:sticky lg:top-8 self-start">
            <AdminSidebar
              role="admin"
              activeTab={currentTab}
              userEmail={userEmail}
              metrics={liveMetrics}
            />
          </div>
        </div>
      </div>
    </div>

    <!-- Campus Footer -->
    <footer class="mt-14 border-t border-stone-200/70 bg-[#ece5d6]/70 py-6 text-center text-xs text-stone-500">
      <div class="mx-auto max-w-7xl px-4 flex flex-col sm:flex-row items-center justify-between gap-3">
        <p>&copy; {today.getFullYear()} LostLink &bull; De La Salle Araneta University Disciplinary & Security Office</p>
        <div class="flex items-center gap-4 font-semibold text-forest-900">
          <a href="/" class="hover:underline">Campus Feed</a>
          <a href="/help" class="hover:underline">Guidelines</a>
          <a href="/privacy" class="hover:underline">Privacy</a>
        </div>
      </div>
    </footer>
  </div>

  <!-- Interactive Review Claim Modal -->
  <div
    id="review-claim-modal"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 backdrop-blur-xs p-4"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modal-claim-title"
  >
    <div class="w-full max-w-lg rounded-[2rem] bg-white p-7 shadow-2xl border border-stone-200/80">
      <div class="flex items-center justify-between border-b border-stone-100 pb-4">
        <div>
          <span class="rounded-full bg-[#164f38]/10 px-3 py-1 text-xs font-bold text-[#164f38]">
            Claim Verification Dossier
          </span>
          <h3 id="modal-claim-title" class="font-serif text-2xl font-black text-forest-900 mt-2">
            Item Claim Review
          </h3>
        </div>
        <button
          type="button"
          id="close-review-modal-btn"
          class="size-9 rounded-full bg-stone-100 hover:bg-stone-200 flex items-center justify-center text-stone-600 transition-colors cursor-pointer"
        >
          &times;
        </button>
      </div>

      <div class="mt-5 space-y-4 text-sm">
        <div class="rounded-2xl bg-[#f5f1e6] p-4 border border-stone-200/60">
          <p class="text-xs font-bold text-stone-500 uppercase">Item to Release</p>
          <p id="modal-item-name" class="font-bold text-forest-900 text-base mt-0.5"></p>
          <p class="text-xs text-stone-500 mt-1">Claimant: <strong id="modal-claimant-name" class="text-stone-800"></strong></p>
        </div>

        <div>
          <p class="text-xs font-bold text-stone-500 uppercase">Private Details Provided by Claimant</p>
          <p id="modal-private-details" class="mt-1.5 rounded-xl bg-stone-50 p-3.5 text-stone-800 border border-stone-200 text-xs sm:text-sm font-medium"></p>
        </div>

        <div class="rounded-xl border border-lime-600/30 bg-[#d8ef8c]/30 p-3 text-xs text-[#164f38]">
          <strong>Verification Protocol:</strong> Check the physical item in custody against these private details before handing it over. Ensure claimant signs the custody logbook.
        </div>
      </div>

      <div class="mt-6 flex items-center justify-end gap-3 pt-4 border-t border-stone-100">
        <button
          type="button"
          id="modal-reject-btn"
          class="rounded-full bg-stone-100 hover:bg-stone-200 px-5 py-2.5 text-xs font-bold text-stone-700 transition-colors cursor-pointer"
        >
          Flag / Request Details
        </button>
        <button
          type="button"
          id="modal-release-btn"
          class="rounded-full bg-[#d8ef8c] hover:bg-[#cbe675] px-6 py-2.5 text-xs font-black text-[#164f38] transition-all shadow-xs cursor-pointer"
        >
          Approve &amp; Release Item
        </button>
      </div>
    </div>
  </div>

  <!-- Modal 1: Campus Intake Guidelines Modal -->
  <div
    id="intake-guidelines-modal"
    class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/50 p-4 backdrop-blur-sm"
    role="dialog"
    aria-modal="true"
    aria-labelledby="intake-guidelines-title"
  >
    <div class="relative w-full max-w-xl rounded-card border border-line bg-white p-6 sm:p-8 shadow-card max-h-[90dvh] overflow-y-auto">
      <div class="flex items-center justify-between border-b border-stone-100 pb-4">
        <div>
          <span class="rounded-full bg-[#164f38]/10 px-3 py-1 text-xs font-bold text-[#164f38]">
            Disciplinary Office SOP
          </span>
          <h3 id="intake-guidelines-title" class="font-serif text-2xl font-black text-forest-900 mt-2">
            Campus Intake &amp; Custody Guidelines
          </h3>
        </div>
        <button
          type="button"
          class="close-intake-modal size-9 rounded-full bg-stone-100 hover:bg-stone-200 active:scale-95 flex items-center justify-center text-stone-600 transition-colors cursor-pointer text-lg"
          aria-label="Close dialog"
        >
          &times;
        </button>
      </div>

      <div class="mt-5 space-y-4 text-xs sm:text-sm text-stone-700">
        <div class="rounded-2xl bg-[#ece5d6] p-4 border border-stone-300/40 text-forest-900 space-y-1">
          <p class="font-bold text-xs uppercase tracking-wider">Official Turn-in Location</p>
          <p class="text-sm font-semibold">Disciplinary &amp; Security Office &bull; Admin Building Room 102</p>
          <p class="text-xs text-stone-600">Operating hours: Monday to Friday, 8:00 AM &ndash; 5:00 PM</p>
        </div>

        <div class="space-y-3">
          <div class="flex items-start gap-3 rounded-xl border border-stone-200/80 p-3.5 bg-white shadow-2xs">
            <span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-forest-700 text-xs font-black text-white">1</span>
            <div>
              <p class="font-bold text-forest-900 text-xs sm:text-sm">Physical Handover &amp; Inspection</p>
              <p class="text-xs text-stone-500 mt-0.5">Finder presents the recovered item. Inspect device state, verify power condition, and note distinguishing marks or accessories.</p>
            </div>
          </div>

          <div class="flex items-start gap-3 rounded-xl border border-stone-200/80 p-3.5 bg-white shadow-2xs">
            <span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-forest-700 text-xs font-black text-white">2</span>
            <div>
              <p class="font-bold text-forest-900 text-xs sm:text-sm">Digital Tagging &amp; Reference Code Assignment</p>
              <p class="text-xs text-stone-500 mt-0.5">Click "Confirm intake" in the intake queue to generate the permanent campus reference token (e.g. DLSAU-2026-F089) and affix the physical barcode tag.</p>
            </div>
          </div>

          <div class="flex items-start gap-3 rounded-xl border border-stone-200/80 p-3.5 bg-white shadow-2xs">
            <span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-forest-700 text-xs font-black text-white">3</span>
            <div>
              <p class="font-bold text-forest-900 text-xs sm:text-sm">Secure Storage Placement</p>
              <p class="text-xs text-stone-500 mt-0.5">Store valuables, phones, calculators, and IDs in Office Locker Vault A-D. Store large bags and tumblers in Storage Cage 1.</p>
            </div>
          </div>

          <div class="flex items-start gap-3 rounded-xl border border-stone-200/80 p-3.5 bg-white shadow-2xs">
            <span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-forest-700 text-xs font-black text-white">4</span>
            <div>
              <p class="font-bold text-forest-900 text-xs sm:text-sm">30-Day Mandatory Retention</p>
              <p class="text-xs text-stone-500 mt-0.5">Items remain in active claim status for 30 days. After 30 days without an approved claim, items become eligible for extended custody or campus donation.</p>
            </div>
          </div>

          <div class="flex items-start gap-3 rounded-xl border border-stone-200/80 p-3.5 bg-white shadow-2xs">
            <span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-forest-700 text-xs font-black text-white">5</span>
            <div>
              <p class="font-bold text-forest-900 text-xs sm:text-sm">Custody Release Protocol</p>
              <p class="text-xs text-stone-500 mt-0.5">Verify student ID against the claimant profile and approved claim ticket. Have the student sign the Physical Custody Release Logbook.</p>
            </div>
          </div>
        </div>
      </div>

      <div class="mt-6 flex items-center justify-end pt-4 border-t border-stone-100">
        <button
          type="button"
          class="close-intake-modal rounded-full bg-forest-700 hover:bg-forest-900 active:scale-95 px-6 py-2.5 text-xs font-bold text-white transition-all shadow-xs cursor-pointer"
        >
          Understood, close
        </button>
      </div>
    </div>
  </div>

  <!-- Modal 2: Full Audit Log Modal -->
  <div
    id="audit-log-modal"
    class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/50 p-4 backdrop-blur-sm"
    role="dialog"
    aria-modal="true"
    aria-labelledby="audit-log-modal-title"
  >
    <div class="relative w-full max-w-3xl rounded-card border border-line bg-white p-6 sm:p-8 shadow-card max-h-[90dvh] overflow-y-auto">
      <div class="flex items-center justify-between border-b border-stone-100 pb-4">
        <div>
          <span class="rounded-full bg-forest-700/10 px-3 py-1 text-xs font-bold text-forest-700">
            Campus Audit Trail
          </span>
          <h3 id="audit-log-modal-title" class="font-serif text-2xl font-black text-forest-900 mt-2">
            Full Administrative Audit Log
          </h3>
          <p class="text-xs text-stone-500 mt-0.5">Chronological record of verified claims, custodial intakes, role alterations, and account moderation.</p>
        </div>
        <button
          type="button"
          class="close-audit-modal size-9 rounded-full bg-stone-100 hover:bg-stone-200 active:scale-95 flex items-center justify-center text-stone-600 transition-colors cursor-pointer text-lg"
          aria-label="Close dialog"
        >
          &times;
        </button>
      </div>

      <!-- Filter chips for audit log -->
      <div class="mt-4 flex items-center gap-1.5 overflow-x-auto pb-1 flex-wrap" id="audit-filter-pills">
        <button type="button" class="audit-filter-pill active rounded-full bg-forest-700 px-3.5 py-1 text-xs font-bold text-white shadow-2xs transition-all active:scale-95 cursor-pointer" data-audit-filter="all">
          All activity ({allAuditEvents.length})
        </button>
        <button type="button" class="audit-filter-pill rounded-full bg-stone-100 hover:bg-stone-200 px-3.5 py-1 text-xs font-semibold text-stone-700 transition-all active:scale-95 cursor-pointer" data-audit-filter="claim">
          Claim verifications
        </button>
        <button type="button" class="audit-filter-pill rounded-full bg-stone-100 hover:bg-stone-200 px-3.5 py-1 text-xs font-semibold text-stone-700 transition-all active:scale-95 cursor-pointer" data-audit-filter="intake">
          Custodial intake
        </button>
        <button type="button" class="audit-filter-pill rounded-full bg-stone-100 hover:bg-stone-200 px-3.5 py-1 text-xs font-semibold text-stone-700 transition-all active:scale-95 cursor-pointer" data-audit-filter="user">
          User moderation
        </button>
      </div>

      <!-- Audit Events List -->
      <div class="mt-4 divide-y divide-stone-100 max-h-[420px] overflow-y-auto pr-1" id="audit-events-container">
        {allAuditEvents.map((evt) => (
          <div class="audit-event-row flex items-center justify-between gap-3 py-3" data-event-category={evt.category}>
            <div class="flex items-center gap-3 min-w-0">
              <div class="size-9 rounded-xl flex items-center justify-center font-serif text-xs font-black bg-[#eef2e3] text-forest-900 shrink-0">
                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </div>
              <div class="min-w-0">
                <p class="font-bold text-forest-900 text-xs sm:text-sm truncate">
                  {evt.title}
                </p>
                <p class="text-[11px] text-stone-500 truncate mt-0.5">
                  {evt.details} &bull; <span class="font-mono text-stone-600">{evt.operator}</span>
                </p>
              </div>
            </div>
            <span class="shrink-0 text-xs font-mono font-medium text-stone-500">
              {evt.time}
            </span>
          </div>
        ))}
      </div>

      <div class="mt-6 flex items-center justify-between pt-4 border-t border-stone-100">
        <span class="text-xs text-stone-500 font-medium">Logged securely with cryptographic integrity &bull; DLSAU Security Office</span>
        <button
          type="button"
          class="close-audit-modal rounded-full bg-stone-100 hover:bg-stone-200 active:scale-95 px-5 py-2 text-xs font-bold text-stone-700 transition-colors cursor-pointer"
        >
          Close
        </button>
      </div>
    </div>
  </div>

  <!-- Modal 3: Unclaimed Overdue Items Modal -->
  <div
    id="unclaimed-items-modal"
    class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/50 p-4 backdrop-blur-sm"
