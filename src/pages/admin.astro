    iconBg: "bg-stone-50 text-forest-900 border-line",
    description: "Temporarily suspended account pending Disciplinary Office student affairs review.",
    target: "Marc Daniel Hernandez",
    operator: "dlsau.lostlink@dlsau.edu.ph",
    category: "user",
    time: "Oct 11, 3:45 PM",
  },
  {
    id: "e7",
    title: "Claim Approved: Leather Wallet Released",
    badgeText: "Claim Approved",
    badgeClass: "bg-lime text-forest-900 border-lime-600/30",
    iconType: "check",
    iconBg: "bg-forest-700 text-white border-forest-900",
    description: "Physical ID inspected. Item released to student Christian Reyes.",
    target: "Leather wallet (Ref: DLSAU-2026-F001)",
    operator: "dlsau.lostlink@dlsau.edu.ph",
    category: "claim",
    time: "Oct 10, 1:15 PM",
  },
  {
    id: "e8",
    title: "Custody Intake: DLSAU Student ID Card",
    badgeText: "Custody Intake",
    badgeClass: "bg-lime text-forest-900 border-lime-600/30",
    iconType: "box",
    iconBg: "bg-stone-50 text-forest-700 border-line",
    description: "Placed in secure Locker Vault A-1 (CAST Department lost card drawer).",
    target: "DLSAU ID Card (Ref: DLSAU-2026-F003)",
    operator: "dlsau.lostlink@dlsau.edu.ph",
    category: "intake",
    time: "Oct 9, 11:00 AM",
  },
];

const liveAuditEvents = liveLogs.map((log: any, idx: number) => {
  const parsed = parseAuditEvent(
    log.action,
    log.items?.name,
    log.item_id,
    userEmail,
    log.created_at,
    (log.action || "").includes("claim") ? "claim" : (log.action || "").includes("intake") ? "intake" : "user"
  );
  return {
    id: log.id || `live-${idx}`,
    ...parsed,
  };
});

const allAuditEvents = liveAuditEvents.length > 0 ? [...liveAuditEvents, ...defaultAuditEvents.slice(liveAuditEvents.length)] : defaultAuditEvents;

const mappedAdminClaims = liveClaims && liveClaims.length > 0
  ? liveClaims.map((c: any) => ({
      id: c.id,
      name: c.items?.name ?? "Reported Item",
      location: c.items?.location ? `Found at ${c.items.location}` : "Campus grounds",
      iconBg: "bg-sage-200",
      iconType: c.items?.category === "IDs, Cards & Wallets" ? "wallet" : "id-card",
      claimant: c.profiles?.full_name ?? "Student Claimant",
      studentId: c.profiles?.email ? c.profiles.email.split("@")[0] : "Verified Student",
      status: c.status === "verified" ? "verified" : (c.status === "denied" ? "denied" : "pending"),
      statusText: c.status === "verified" ? "Verified & Released" : (c.status === "denied" ? "Denied" : "Awaiting visit"),
      statusStyle: c.status === "verified" ? "bg-lime text-forest-900" : (c.status === "denied" ? "bg-danger/10 text-danger" : "bg-[#ece5d6] text-forest-900"),
      time: c.created_at ? new Date(c.created_at).toLocaleDateString("en-US", { month: "short", day: "numeric" }) : "Recently",
      privateDetails: c.proof_description ?? "Proof details provided during claim verification.",
    }))
  : adminClaims;

const allClaimsForModal = mappedAdminClaims;
const pendingClaimsCount = allClaimsForModal.filter((c: any) => c.status === "pending").length;
const verifiedClaimsCount = allClaimsForModal.filter((c: any) => c.status === "verified").length;
const deniedClaimsCount = allClaimsForModal.filter((c: any) => c.status === "denied").length;
---

<Base
  title={`${currentTab === "users" ? "User Management" : "Admin Console"} | LostLink`}
  description="LostLink campus lost and found console for De La Salle Araneta University."
>
  <div class="min-h-screen bg-canvas text-forest-900 flex flex-col justify-between selection:bg-lime">
    <div>
      <!-- Top Announcement Ticker Bar matching overview1admin.png -->
      <AdminTicker announcements={liveAnnouncements.filter((a) => a.active)} />

      <!-- Main Layout Container -->
      <div class={`mx-auto w-full ${currentTab === "users" ? "max-w-[1660px]" : "max-w-[1520px]"} px-4 py-6 sm:px-10 sm:py-8 lg:px-14`}>
        <div class="flex flex-col-reverse lg:flex-row items-start gap-7 lg:gap-8">
          <!-- Main Content (Left Column) -->
          <main class="w-full flex-1 min-w-0 space-y-7">
            <!-- Header Row: Date Eyebrow, Overview Title, Search, CTA -->
            <div class="flex flex-col md:flex-row md:items-end justify-between gap-5">
              <div>
                <p class="text-xs font-bold tracking-[0.22em] text-stone-500 uppercase">
                  {dateEyebrow}
                </p>
                <h1 class="mt-1 font-serif text-4xl sm:text-5xl lg:text-[3.25rem] font-black text-forest-900 tracking-tight leading-none">
                  {currentTab === "users" ? "User management" : "Overview"}
                </h1>
              </div>

              <!-- Top Right Controls -->
              <div class="flex items-center gap-3 sm:gap-4 flex-wrap sm:flex-nowrap">
                {currentTab === "users" ? (
                  <a
                    href="/admin"
                    class="flex min-h-[3rem] shrink-0 items-center gap-2 rounded-full bg-forest-700 hover:bg-forest-900 active:scale-95 px-5 sm:px-6 py-2.5 text-sm font-bold text-white transition-all shadow-xs cursor-pointer"
                  >
                    <span>&larr; Back to overview</span>
                  </a>
                ) : (
                  <>
                    <div class="relative flex-1 sm:w-72 lg:w-80">
                      <input
                        type="search"
                        id="overview-search-input"
                        placeholder="Search items, students, claims.."
                        class="w-full min-h-[3rem] rounded-full bg-[#ece5d6] py-2.5 pl-11 pr-4 text-sm text-forest-900 placeholder:text-stone-500 placeholder:font-normal focus:bg-white focus:outline-none focus:ring-2 focus:ring-forest-700/25 transition-all shadow-2xs border-0"
                      />
                      <svg
                        class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 size-4.5 text-stone-500"
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="2"
                        aria-hidden="true"
                      >
                        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35m1.85-5.15a7 7 0 11-14 0 7 7 0 0114 0z" />
                      </svg>
                    </div>

                    <button
                      type="button"
                      id="open-announcements-cta-btn"
                      class="flex min-h-[3rem] shrink-0 items-center gap-2 rounded-full border border-forest-900/15 bg-white hover:bg-stone-50 active:scale-95 px-4.5 sm:px-5 py-2.5 text-sm font-bold text-forest-900 transition-all shadow-2xs cursor-pointer"
                      title="Manage campus notices and alerts broadcast across student headers"
                    >
                      <svg class="size-4 text-forest-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                        <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                      </svg>
                      <span>Broadcast</span>
                      <span class="inline-flex items-center justify-center min-w-5 h-5 px-1.5 text-xs font-black rounded-full bg-lime text-forest-950">
                        {liveAnnouncements.filter((a) => a.active).length}
                      </span>
                    </button>

                    <button
                      type="button"
                      id="log-found-cta-btn"
                      class="flex min-h-[3rem] shrink-0 items-center gap-2 rounded-full bg-forest-700 hover:bg-forest-900 active:scale-95 px-5 sm:px-6 py-2.5 text-sm font-bold text-white transition-all shadow-2xs cursor-pointer"
                    >
                      <span>Log a found item</span>
                      <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 5v14M5 12h14" />
                      </svg>
                    </button>
                  </>
                )}
              </div>
            </div>

            {currentTab === "users" ? (
              <UsersManagement
                users={allUsers}
                currentAdminEmail={userEmail}
                pendingRecoveryRequests={pendingRecoveryRequests}
              />
            ) : (
              <>
                <!-- Row 1: 4 KPI Stat Cards -->
                <AdminMetrics role="admin" metrics={liveMetrics} />

                <!-- Row 2: Claims to verify Table Card -->
                <ClaimsVerificationTable role="admin" liveClaims={liveClaims} />

                <!-- Row 3: Two Columns Split (Waiting for intake + Recent activity) -->
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 sm:gap-7">
                  <IntakeQueue role="admin" liveIntake={liveIntake} />
                  <RecentActivity role="admin" liveLogs={liveLogs} />
                </div>
              </>
            )}
          </main>

          <!-- Floating Admin Sidebar (Right Column) -->
          <div class="w-full lg:w-auto shrink-0 lg:sticky lg:top-8 self-start">
            <AdminSidebar
              role="admin"
              activeTab={currentTab}
              userEmail={userEmail}
              metrics={liveMetrics}
              unclaimedCount={unclaimedOverdue.length}
              pendingRecoveryCount={pendingRecoveryRequests.length}
              announcementsCount={liveAnnouncements.filter((a) => a.active).length}
            />
          </div>
        </div>
      </div>
    </div>

    <!-- Campus Footer -->
    <DashboardFooter wide />
  </div>

  <!-- Interactive Review Claim Modal -->
  <div
    id="review-claim-modal"
    class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/50 backdrop-blur-sm p-4"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modal-claim-title"
  >
    <div class="w-full max-w-lg rounded-card bg-white p-7 shadow-card border border-stone-200/60">
      <div class="flex items-center justify-between border-b border-stone-100 pb-4">
        <div>
          <span class="rounded-full bg-forest-700/10 px-3 py-1 text-xs font-bold text-forest-700">
            Claim verification dossier
          </span>
          <h3 id="modal-claim-title" class="font-serif text-2xl font-black text-forest-900 mt-2">
            Item claim review
          </h3>
        </div>
        <button
          type="button"
          id="close-review-modal-btn"
          class="size-11 rounded-full bg-stone-100 hover:bg-stone-200 flex items-center justify-center text-stone-600 transition-colors cursor-pointer"
        >
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <div class="mt-5 space-y-4 text-sm">
        <div class="rounded-2xl bg-canvas p-4 border border-stone-200/60">
          <p class="text-xs font-bold text-stone-500 uppercase">Item to Release</p>
          <p id="modal-item-name" class="font-bold text-forest-900 text-base mt-0.5"></p>
          <p class="text-xs text-stone-500 mt-1">Claimant: <strong id="modal-claimant-name" class="text-stone-800"></strong></p>
        </div>

        <div>
          <p class="text-xs font-bold text-stone-500 uppercase">Private Details Provided by Claimant</p>
          <p id="modal-private-details" class="mt-1.5 rounded-xl bg-stone-50 p-3.5 text-stone-800 border border-stone-200 text-xs sm:text-sm font-medium"></p>
        </div>

        <div class="rounded-xl border border-lime-600/30 bg-lime/30 p-3 text-xs text-forest-700">
          <strong>Verification protocol:</strong> Check the physical item in custody against these private details before handing it over. Ensure claimant signs the custody logbook.
        </div>
      </div>

      <div class="mt-6 flex items-center justify-end gap-3 pt-4 border-t border-stone-100">
        <button
          type="button"
          id="modal-reject-btn"
          class="inline-flex min-h-11 items-center justify-center rounded-full bg-stone-100 hover:bg-stone-200 px-5 py-2.5 text-sm font-bold text-stone-700 transition-colors cursor-pointer"
        >
          Flag / request details
        </button>
        <button
          type="button"
          id="modal-release-btn"
          class="inline-flex min-h-11 items-center justify-center rounded-full bg-lime hover:bg-[#c9e376] px-6 py-2.5 text-sm font-black text-forest-700 transition-all shadow-2xs cursor-pointer"
        >
          Approve and release item
        </button>
      </div>
    </div>
  </div>

  <!-- Modal 1: Campus Intake Guidelines Modal -->
  <div
    id="intake-guidelines-modal"
    class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/50 p-4 backdrop-blur-sm"
    role="dialog"
    aria-modal="true"
    aria-labelledby="intake-guidelines-title"
  >
    <div class="relative w-full max-w-xl rounded-card border border-line bg-white p-6 sm:p-8 shadow-card max-h-[90dvh] overflow-y-auto">
      <div class="flex items-center justify-between border-b border-stone-100 pb-4">
        <div>
          <span class="rounded-full bg-forest-700/10 px-3 py-1 text-xs font-bold text-forest-700">
            Disciplinary Office SOP
          </span>
          <h3 id="intake-guidelines-title" class="font-serif text-2xl font-black text-forest-900 mt-2">
            Campus intake and custody guidelines
          </h3>
        </div>
        <button
          type="button"
          class="close-intake-modal size-11 rounded-full bg-stone-100 hover:bg-stone-200 active:scale-95 flex items-center justify-center text-stone-600 transition-colors cursor-pointer"
          aria-label="Close dialog"
        >
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <div class="mt-5 space-y-4 text-xs sm:text-sm text-stone-700">
        <div class="rounded-2xl bg-[#ece5d6] p-4 border border-stone-300/40 text-forest-900 space-y-1">
          <p class="font-bold text-xs uppercase tracking-wider">Official Turn-in Location</p>
          <p class="text-sm font-semibold">Disciplinary &amp; Security Office &bull; Admin Building Room 102</p>
          <p class="text-xs text-stone-600">Operating hours: Monday to Friday, 8:00 AM &ndash; 5:00 PM</p>
        </div>

        <div class="space-y-3">
          <div class="flex items-start gap-3 rounded-xl border border-stone-200/80 p-3.5 bg-white shadow-2xs">
            <span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-forest-700 text-xs font-black text-white">1</span>
            <div>
              <p class="font-bold text-forest-900 text-xs sm:text-sm">Physical handover &amp; inspection</p>
              <p class="text-xs text-stone-500 mt-0.5">Finder presents the recovered item. Inspect device state, verify power condition, and note distinguishing marks or accessories.</p>
            </div>
          </div>

          <div class="flex items-start gap-3 rounded-xl border border-stone-200/80 p-3.5 bg-white shadow-2xs">
            <span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-forest-700 text-xs font-black text-white">2</span>
            <div>
              <p class="font-bold text-forest-900 text-xs sm:text-sm">Digital tagging &amp; reference code assignment</p>
              <p class="text-xs text-stone-500 mt-0.5">Click "Confirm intake" in the intake queue to generate the permanent campus reference token (e.g. DLSAU-2026-F089) and affix the physical barcode tag.</p>
            </div>
          </div>

          <div class="flex items-start gap-3 rounded-xl border border-stone-200/80 p-3.5 bg-white shadow-2xs">
            <span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-forest-700 text-xs font-black text-white">3</span>
            <div>
              <p class="font-bold text-forest-900 text-xs sm:text-sm">Secure storage placement</p>
              <p class="text-xs text-stone-500 mt-0.5">Store valuables, phones, calculators, and IDs in Office Locker Vault A-D. Store large bags and tumblers in Storage Cage 1.</p>
            </div>
          </div>

          <div class="flex items-start gap-3 rounded-xl border border-stone-200/80 p-3.5 bg-white shadow-2xs">
            <span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-forest-700 text-xs font-black text-white">4</span>
            <div>
              <p class="font-bold text-forest-900 text-xs sm:text-sm">30-Day Mandatory Retention</p>
              <p class="text-xs text-stone-500 mt-0.5">Items remain in active claim status for 30 days. After 30 days without an approved claim, items become eligible for extended custody or campus donation.</p>
            </div>
          </div>

          <div class="flex items-start gap-3 rounded-xl border border-stone-200/80 p-3.5 bg-white shadow-2xs">
            <span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-forest-700 text-xs font-black text-white">5</span>
            <div>
              <p class="font-bold text-forest-900 text-xs sm:text-sm">Custody release protocol</p>
              <p class="text-xs text-stone-500 mt-0.5">Verify student ID against the claimant profile and approved claim ticket. Have the student sign the Physical Custody Release Logbook.</p>
            </div>
          </div>
        </div>
      </div>

      <div class="mt-6 flex items-center justify-end pt-4 border-t border-stone-100">
        <button
          type="button"
          class="close-intake-modal rounded-full bg-forest-700 hover:bg-forest-900 active:scale-95 px-6 py-2.5 text-xs font-bold text-white transition-all shadow-xs cursor-pointer"
        >
          Understood, close
        </button>
      </div>
    </div>
  </div>

  <!-- Modal 1b: Reject Report Reason Modal -->
  <div
    id="reject-report-modal"
    class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/50 p-4 backdrop-blur-sm"
    role="dialog"
    aria-modal="true"
    aria-labelledby="reject-report-title"
  >
    <div class="relative w-full max-w-lg rounded-card border border-line bg-white p-6 sm:p-8 shadow-card max-h-[90dvh] overflow-y-auto">
      <div class="flex items-start justify-between gap-4 border-b border-stone-100 pb-4">
        <div>
          <span class="rounded-full bg-danger/10 px-3 py-1 text-xs font-bold text-danger">
            Report review
          </span>
          <h3 id="reject-report-title" class="font-serif text-2xl font-black text-forest-900 mt-2">
            Reject report
          </h3>
          <p class="mt-1 text-sm text-stone-500">The reporter will see this reason on their profile.</p>
        </div>
        <button
          type="button"
          id="reject-report-close-btn"
          class="size-11 rounded-full bg-stone-100 hover:bg-stone-200 active:scale-95 flex items-center justify-center text-stone-600 transition-colors cursor-pointer"
          aria-label="Close dialog"
        >
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <div class="mt-5 space-y-4">
        <div class="rounded-2xl bg-stone-50 border border-stone-200/80 p-4">
          <div class="flex items-center justify-between gap-2">
            <p class="text-xs font-bold uppercase tracking-wider text-stone-500">Item Report</p>
            <span id="reject-report-desc-badge" class="hidden text-[11px] font-bold px-2 py-0.5 rounded-full border"></span>
          </div>
          <p id="reject-report-name" class="mt-1 font-bold text-forest-900 text-base">Item</p>

          <div class="mt-3 pt-2.5 border-t border-stone-200/60">
            <p class="text-[11px] font-bold uppercase tracking-wider text-stone-400">Submitted description:</p>
            <p id="reject-report-desc-preview" class="mt-1 text-xs text-stone-700 bg-white p-3 rounded-xl border border-stone-200 leading-relaxed italic">
              Loading description...
            </p>
          </div>
        </div>

        <div>
          <div class="flex items-center justify-between mb-2">
            <label for="reject-report-reason" class="block text-xs font-bold text-forest-900">
              Reason for rejection <span class="text-danger">*</span>
            </label>
            <span class="text-[11px] text-stone-400 font-medium">Select a preset or customize</span>
          </div>

          <!-- Quick Preset Reasons -->
          <div class="flex flex-wrap gap-1.5 mb-2.5" id="reject-presets-container">
            <button
              type="button"
              class="reject-preset-chip inline-flex items-center gap-1.5 text-xs font-bold px-3 py-1.5 rounded-full border border-forest-700/30 bg-forest-700/10 text-forest-900 hover:bg-forest-700 hover:text-white transition-all cursor-pointer shadow-2xs"
              data-reason="Incomplete description: Please provide specific details including item brand, exact color, contents, and any unique distinguishing marks, scratches, or stickers."
            >
              <span>📝</span>
              <span>Incomplete description</span>
            </button>
            <button
              type="button"
              class="reject-preset-chip inline-flex items-center gap-1.5 text-xs font-bold px-3 py-1.5 rounded-full border border-stone-200 bg-stone-50 text-stone-700 hover:bg-forest-700 hover:text-white transition-all cursor-pointer shadow-2xs"
              data-reason="Unclear photo: The uploaded photo does not clearly show the item. Please resubmit with a clear, well-lit photo."
            >
              <span>📸</span>
              <span>Unclear photo</span>
            </button>
            <button
              type="button"
              class="reject-preset-chip inline-flex items-center gap-1.5 text-xs font-bold px-3 py-1.5 rounded-full border border-stone-200 bg-stone-50 text-stone-700 hover:bg-forest-700 hover:text-white transition-all cursor-pointer shadow-2xs"
              data-reason="Duplicate report: This item has already been reported and logged in the campus directory."
            >
              <span>📋</span>
              <span>Duplicate report</span>
            </button>
            <button
              type="button"
              class="reject-preset-chip inline-flex items-center gap-1.5 text-xs font-bold px-3 py-1.5 rounded-full border border-stone-200 bg-stone-50 text-stone-700 hover:bg-forest-700 hover:text-white transition-all cursor-pointer shadow-2xs"
              data-reason="Policy non-compliant: This item report does not meet campus lost & found intake criteria."
            >
              <span>🚫</span>
              <span>Policy non-compliant</span>
            </button>
          </div>

          <textarea
            id="reject-report-reason"
            rows="3"
            minlength="5"
            maxlength="500"
            placeholder="Select a preset above or type custom instructions for the student..."
            class="w-full rounded-xl border border-line bg-white p-3 text-sm text-forest-900 placeholder:text-stone-400 focus:outline-none focus:ring-2 focus:ring-forest-700/30"
          ></textarea>
          <p id="reject-report-error" class="hidden mt-1.5 text-xs font-semibold text-danger"></p>
        </div>
      </div>

      <div class="mt-6 flex items-center justify-end gap-3 pt-4 border-t border-stone-100">
        <button
          type="button"
          id="reject-report-cancel-btn"
          class="inline-flex min-h-11 items-center justify-center rounded-full bg-stone-100 hover:bg-stone-200 px-5 py-2.5 text-sm font-bold text-stone-700 transition-colors cursor-pointer"
        >
          Cancel
        </button>
        <button
          type="button"
          id="reject-report-confirm-btn"
          class="inline-flex min-h-11 items-center justify-center rounded-full bg-danger hover:bg-danger/90 px-6 py-2.5 text-sm font-bold text-white transition-all shadow-2xs cursor-pointer"
        >
          Reject report
        </button>
      </div>
    </div>
  </div>

  <!-- Modal 2: Full Audit Log Modal -->
  <!-- Modal 2: Full Audit Log Modal -->
  <div
    id="audit-log-modal"
    class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/50 p-3 sm:p-5 backdrop-blur-sm transition-all"
    role="dialog"
    aria-modal="true"
    aria-labelledby="audit-log-modal-title"
  >
