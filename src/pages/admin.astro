              </label>
              <select
                id="ann-urgency-select"
                name="urgency"
                class="w-full min-h-[2.75rem] px-3 py-2 text-sm bg-white rounded-xl border border-line focus:border-forest-700 focus:ring-2 focus:ring-forest-700/20 outline-none transition-all font-semibold text-forest-900 cursor-pointer"
              >
                <option value="info">ℹ️ General Notice (Info)</option>
                <option value="warning">⚠️ Important / Warning</option>
                <option value="alert">🚨 Urgent Alert</option>
              </select>
            </div>
          </div>

          <div>
            <label for="ann-content-input" class="block text-xs font-bold text-forest-900 mb-1">
              Notice Content &amp; Instructions <span class="text-danger">*</span>
            </label>
            <textarea
              id="ann-content-input"
              name="content"
              required
              minlength="10"
              maxlength="500"
              rows="3"
              placeholder="e.g. All unclaimed items from the 1st semester are currently held at the Student Affairs Office (AGH 2nd Floor). Please present your valid DLSAU ID card before the Friday cutoff."
              class="w-full p-3.5 text-sm bg-white rounded-xl border border-line focus:border-forest-700 focus:ring-2 focus:ring-forest-700/20 outline-none transition-all placeholder:text-stone-400 font-medium text-forest-900 resize-y"
            ></textarea>
