---
import Base from "~/layouts/Base.astro";
import AdminTicker from "~/components/admin/AdminTicker.astro";
import AdminSidebar from "~/components/admin/AdminSidebar.astro";
import AdminMetrics from "~/components/admin/AdminMetrics.astro";
import ClaimsVerificationTable from "~/components/admin/ClaimsVerificationTable.astro";
import IntakeQueue from "~/components/admin/IntakeQueue.astro";
import RecentActivity from "~/components/admin/RecentActivity.astro";
import UsersManagement from "~/components/admin/UsersManagement.astro";
import { enrichCampusUser, type EnhancedCampusUser } from "~/data/campusPrograms";
import { actions } from "astro:actions";
import {
  CUSTODY_EXTENSION_DAYS,
  CUSTODY_OVERDUE_DAYS,
  custodyAgeLabel,
  daysInCustody,
  isCustodyOverdue,
} from "~/lib/custody";

import { readEnv } from "~/lib/env";
import { createClient } from "@supabase/supabase-js";

const logoutResult = Astro.getActionResult(actions.logout);
if (logoutResult && !logoutResult.error && logoutResult.data?.redirect) {
  return Astro.redirect(logoutResult.data.redirect, 302);
}

const user = Astro.locals.user;
const userEmail = user?.email ?? "dlsau.lostlink@dlsau.edu.ph";
const isRealAdmin = user?.role === "admin";

// The admin console is guarded on the server: non-admins are sent back to the feed.
if (!isRealAdmin) {
  return Astro.redirect("/");
}

const currentTab = Astro.url.searchParams.get("tab") || "overview";

// Date formatting matching "SATURDAY, OCTOBER 10" from Figma
const today = new Date();
const dateEyebrow = today.toLocaleDateString("en-US", {
  weekday: "long",
  month: "long",
  day: "numeric",
}).toUpperCase();

// Query live data from Supabase
const env = Astro.locals.env || readEnv();
let liveMetrics = {
  itemsInCustody: 0,
  activeLostReports: 0,
  claimsToVerify: 0,
  returnedThisMonth: 0,
};
let liveClaims: any[] = [];
let liveIntake: any[] = [];
let liveLogs: any[] = [];
let allUsers: EnhancedCampusUser[] = [];

export interface PendingRecoveryRequest {
  email: string;
  requestedAt: string;
  name?: string;
  program?: string;
  studentId?: string;
  collegeCode?: string;
}
let pendingRecoveryRequests: PendingRecoveryRequest[] = [];

interface OverdueCustodyItem {
  id: string;
  name: string;
  category: string;
  location: string;
  referenceCode: string | null;
  days: number;
  extendedUntil: string | null;
  reporterName: string;
}
let unclaimedOverdue: OverdueCustodyItem[] = [];
let custodyColumnsMissing = false;

// Office decision posted from the Unclaimed Items Review (real DB write).
const custodyResult = Astro.getActionResult(actions.custodyDecision);
const custodyNotice = custodyResult
  ? custodyResult.error
    ? custodyResult.error.message
    : custodyResult.data?.message
  : undefined;
const custodyNoticeOk = Boolean(custodyResult?.data?.ok);
// Keep the modal open after a decision so the officer can continue working.
const custodyModalReopen = Boolean(custodyResult);

if (env.PUBLIC_SUPABASE_URL && env.SUPABASE_SERVICE_ROLE_KEY) {
  try {
    const supabase = createClient(
      env.PUBLIC_SUPABASE_URL,
      env.SUPABASE_SERVICE_ROLE_KEY,
      { auth: { persistSession: false } },
    );

    // Admin View: Live stats and records from entire campus
    const [
      custodyRes,
      lostRes,
      claimsRes,
      returnedRes,
      claimsListRes,
      intakeListRes,
      logsListRes,
      profilesRes,
      recoveryLogsRes,
    ] = await Promise.all([
      supabase
        .from("items")
        .select("id", { count: "exact", head: true })
        .eq("type", "found")
        .eq("status", "approved"),
      supabase
        .from("items")
        .select("id", { count: "exact", head: true })
        .eq("type", "lost")
        .neq("status", "resolved"),
      supabase
        .from("claims")
        .select("id", { count: "exact", head: true })
        .eq("status", "pending"),
      supabase
        .from("items")
        .select("id", { count: "exact", head: true })
        .eq("status", "claimed"),
      supabase
        .from("claims")
        .select(`
          id,
          proof_description,
          status,
          created_at,
          items ( name, location, category ),
          profiles ( full_name, email )
        `)
        .order("created_at", { ascending: false })
        .limit(10),
      supabase
        .from("items")
        .select(`
          id,
          name,
          category,
          location,
          reference_code,
          created_at,
          profiles ( full_name, email )
        `)
        .eq("type", "found")
        .eq("status", "pending")
        .order("created_at", { ascending: false })
        .limit(10),
      supabase
        .from("admin_log")
        .select(`
          id,
          action,
          created_at,
          item_id,
          items ( name )
        `)
        .order("created_at", { ascending: false })
        .limit(8),
      supabase
        .from("profiles")
        .select("*")
        .order("created_at", { ascending: false })
        .limit(500),
      supabase
        .from("admin_log")
        .select("id, action, created_at")
        .or("action.like.password_recovery_requested:%,action.like.temp_password_issued:%")
        .order("created_at", { ascending: false })
        .limit(100),
    ]);

    liveMetrics = {
      itemsInCustody: custodyRes.count ?? 0,
      activeLostReports: lostRes.count ?? 0,
      claimsToVerify: claimsRes.count ?? 0,
      returnedThisMonth: returnedRes.count ?? 0,
    };

    if (claimsListRes.data) liveClaims = claimsListRes.data;
    if (intakeListRes.data) liveIntake = intakeListRes.data;
    if (logsListRes.data) liveLogs = logsListRes.data;

    // Unclaimed Items Review: real scan of found items still in office custody
    // past the 30-day window. Needs the two custody columns; see
    // docs/migrations.sql. A missing column degrades to the empty state
    // instead of breaking the admin console.
    {
      const cutoff = new Date(Date.now() - CUSTODY_OVERDUE_DAYS * 86400000).toISOString();
      const { data: overdueData, error: overdueError } = await supabase
        .from("items")
        .select(`
          id,
          name,
          category,
          location,
          reference_code,
          created_at,
          custody_extended_until,
          donation_turnover,
          profiles ( full_name )
        `)
        .eq("type", "found")
        .eq("status", "approved")
        .eq("donation_turnover", false)
        .lt("created_at", cutoff)
        .order("created_at", { ascending: true });

      if (overdueError) {
        custodyColumnsMissing = true;
        console.warn("[admin] unclaimed review needs docs/migrations.sql:", overdueError.message);
      } else if (overdueData) {
        unclaimedOverdue = overdueData
          .filter((row: any) => isCustodyOverdue(row))
          .map((row: any) => ({
            id: row.id,
            name: row.name,
            category: row.category,
            location: row.location,
            referenceCode: row.reference_code,
            days: daysInCustody(row.created_at),
            extendedUntil: row.custody_extended_until,
            reporterName: row.profiles?.full_name ?? "Unknown reporter",
          }));
      }
    }

    let authUserMetaMap = new Map<string, any>();
    if (env.SUPABASE_SERVICE_ROLE_KEY && currentTab === "users") {
      try {
        const { data: authUsersData } = await supabase.auth.admin.listUsers({ perPage: 500 });
        if (authUsersData?.users) {
          for (const u of authUsersData.users) {
            if (u.user_metadata) {
              authUserMetaMap.set(u.id, u.user_metadata);
              if (u.email) authUserMetaMap.set(u.email.toLowerCase(), u.user_metadata);
            }
          }
        }
      } catch (e) {
        console.warn("[admin] auth.admin.listUsers note:", e);
      }
    }

    if (profilesRes.data && profilesRes.data.length > 0) {
      allUsers = profilesRes.data.map((p: any) => {
        const meta = authUserMetaMap.get(p.id) || authUserMetaMap.get((p.email || "").toLowerCase());
        return enrichCampusUser({
          ...p,
          program: p.program || meta?.program,
          user_metadata: meta,
        });
      });
    }

    // Process Password Recovery Requests from admin_log
    if (recoveryLogsRes?.data && recoveryLogsRes.data.length > 0) {
      const emailStatusMap = new Map<string, { status: "requested" | "issued"; requestedAt: string }>();
      for (const log of recoveryLogsRes.data) {
        const rawAction = log.action || "";
        if (rawAction.startsWith("password_recovery_requested:")) {
          const email = rawAction.replace("password_recovery_requested:", "").trim().toLowerCase();
          if (!emailStatusMap.has(email)) {
            emailStatusMap.set(email, { status: "requested", requestedAt: log.created_at });
          }
        } else if (rawAction.startsWith("temp_password_issued:")) {
          const email = rawAction.replace("temp_password_issued:", "").trim().toLowerCase();
          if (!emailStatusMap.has(email)) {
            emailStatusMap.set(email, { status: "issued", requestedAt: log.created_at });
          }
        }
      }

      for (const [email, info] of emailStatusMap.entries()) {
        if (info.status === "requested") {
          const matchedUser = allUsers.find((u: any) => (u.email || "").toLowerCase() === email);
          pendingRecoveryRequests.push({
            email,
            requestedAt: info.requestedAt,
            name: matchedUser?.full_name,
            program: matchedUser?.programName,
            studentId: matchedUser?.studentId,
            collegeCode: matchedUser?.collegeCode,
          });
        }
      }
    }

    // Fallback: also scan notifications for recent password recovery requests not yet issued
    if (pendingRecoveryRequests.length === 0) {
      try {
        const { data: recNotifs } = await supabase
          .from("notifications")
          .select("message, created_at")
          .ilike("message", "%Password recovery request for%")
          .order("created_at", { ascending: false })
          .limit(20);
        if (recNotifs && recNotifs.length > 0) {
          for (const notif of recNotifs) {
            const match = notif.message.match(/Password recovery request for ([^\s.]+@[^\s]+)/i);
            if (match && match[1]) {
              const email = match[1].toLowerCase().trim();
              const alreadyIssued = liveLogs.some(
                (l: any) => (l.action || "").includes("temp_password_issued:") && (l.action || "").toLowerCase().includes(email)
              );
              if (!alreadyIssued && !pendingRecoveryRequests.some((p) => p.email === email)) {
                const matchedUser = allUsers.find((u: any) => (u.email || "").toLowerCase() === email);
                pendingRecoveryRequests.push({
                  email,
                  requestedAt: notif.created_at,
                  name: matchedUser?.full_name,
                  program: matchedUser?.programName,
                  studentId: matchedUser?.studentId,
                  collegeCode: matchedUser?.collegeCode,
                });
              }
            }
          }
        }
      } catch (notifQueryErr) {
        console.warn("[admin] Recovery notifications check note:", notifQueryErr);
      }
    }
  } catch (err) {
    console.warn("[admin] Live data query note:", err);
  }
}

// Helper function to turn raw system logs into friendly, plain English for university staff
function parseAuditEvent(
  rawAction: string,
  itemName?: string,
  itemId?: string,
  operatorEmail?: string,
  createdAt?: string,
  eventCategory?: string
) {
  const action = (rawAction || "").trim();
  const operator = operatorEmail || "dlsau.lostlink@dlsau.edu.ph";

  let formattedTime = "Recently";
  if (createdAt) {
    const d = new Date(createdAt);
    if (!isNaN(d.getTime())) {
      const isToday = new Date().toDateString() === d.toDateString();
      const timeStr = d.toLocaleTimeString("en-US", { hour: "numeric", minute: "2-digit" });
      formattedTime = isToday
        ? `Today, ${timeStr}`
        : `${d.toLocaleDateString("en-US", { month: "short", day: "numeric" })}, ${timeStr}`;
    }
  }

  // 1. User Deleted (e.g. "user_deleted: student.testdelete@dlsau.edu.ph")
  if (action.startsWith("user_deleted:")) {
    const target = action.replace("user_deleted:", "").trim();
    return {
      title: "Student Account Deleted",
      badgeText: "Account Deleted",
      badgeClass: "bg-danger/10 text-danger border-danger/20",
      iconType: "delete",
      iconBg: "bg-danger/10 text-danger border-danger/20",
      description: `Permanently removed account record for ${target}.`,
      target,
      operator,
      category: "user",
      time: formattedTime,
    };
  }

  // 1b. Password Recovery Requested by Student
  if (action.startsWith("password_recovery_requested:")) {
    const target = action.replace("password_recovery_requested:", "").trim();
    return {
      title: "Password Recovery Requested",
      badgeText: "Reset Pending",
      badgeClass: "bg-amber-100 text-amber-900 border-amber-300",
      iconType: "key",
      iconBg: "bg-amber-50 text-amber-800 border-amber-200",
      description: `${target} requested a password reset. Awaiting DLSAU ID verification at Security Office.`,
      target,
      operator: "Student Portal",
      category: "user",
      time: formattedTime,
    };
  }

  // 2. Password Reset Sent / Temp Password Issued
  if (action.startsWith("password_reset_sent:") || action.startsWith("temp_password_issued:")) {
    const target = action.replace("password_reset_sent:", "").replace("temp_password_issued:", "").trim();
    return {
      title: "Temporary Password Issued",
      badgeText: "Recovery",
      badgeClass: "bg-[#ece5d6] text-forest-900 border-stone-300",
      iconType: "key",
      iconBg: "bg-stone-50 text-forest-700 border-line",
      description: `Dispatched official security verification and temporary credentials to ${target}.`,
      target,
      operator,
      category: "user",
      time: formattedTime,
    };
  }

  // 3. Status Updated (e.g. "status_updated: maria.santos@dlsau.edu.ph set to suspended")
  if (action.startsWith("status_updated:")) {
    const isSuspended = action.includes("suspended");
    const target = action.replace("status_updated:", "").replace(/set to (suspended|active)/, "").trim();
    return {
      title: isSuspended ? "User Account Suspended" : "User Account Reactivated",
      badgeText: isSuspended ? "Suspended" : "Active",
      badgeClass: isSuspended ? "bg-[#ece5d6] text-forest-900 border-stone-300" : "bg-lime text-forest-900 border-lime-600/30",
      iconType: isSuspended ? "suspend" : "activate",
      iconBg: isSuspended ? "bg-stone-50 text-forest-900 border-line" : "bg-forest-700/10 text-forest-700 border-forest-700/20",
      description: isSuspended ? `Temporarily suspended access for ${target}.` : `Restored full active access for ${target}.`,
      target,
      operator,
      category: "user",
      time: formattedTime,
    };
  }

  // 4. Role Updated (e.g. "role_updated: juan.reyes@dlsau.edu.ph set to admin")
  if (action.startsWith("role_updated:")) {
    const isAdminRole = action.includes("admin");
    const target = action.replace("role_updated:", "").replace(/set to (admin|student)/, "").trim();
    return {
      title: isAdminRole ? "Granted Administrator Privileges" : "Permissions Changed to Student",
      badgeText: isAdminRole ? "Admin Promoted" : "Role Changed",
      badgeClass: isAdminRole ? "bg-forest-700 text-lime border-forest-900" : "bg-stone-100 text-stone-700 border-stone-200",
      iconType: isAdminRole ? "shield" : "user",
      iconBg: isAdminRole ? "bg-forest-700 text-lime border-forest-900" : "bg-stone-100 text-stone-600 border-stone-200",
      description: isAdminRole
        ? `Promoted ${target} to Disciplinary Office Administrator.`
        : `Changed permissions for ${target} to standard campus student.`,
      target,
      operator,
      category: "user",
      time: formattedTime,
    };
  }

  // 5. Item Removed from Feed
  if (action.startsWith("item_removed:") || action.includes("removed from feed")) {
    const item = itemName || action.replace("item_removed:", "").trim();
    return {
      title: "Campus Feed Post Removed",
      badgeText: "Post Removed",
      badgeClass: "bg-danger/10 text-danger border-danger/20",
      iconType: "trash",
      iconBg: "bg-danger/10 text-danger border-danger/20",
      description: `Removed public post for "${item}" from campus view.`,
      target: item,
      operator,
      category: "claim",
      time: formattedTime,
    };
  }

  // 6. Claim verification
  if (action.includes("claim") || action.includes("approved") || action.includes("released")) {
    const item = itemName || "Claimed item";
    return {
      title: "Claim Approved & Released",
      badgeText: "Claim Approved",
      badgeClass: "bg-lime text-forest-900 border-lime-600/30",
      iconType: "check",
      iconBg: "bg-forest-700 text-white border-forest-900",
      description: action.replace(/^System log:\s*/i, ""),
      target: item,
      operator,
      category: "claim",
      time: formattedTime,
    };
  }

  // 7. Intake / Vault
  if (action.includes("intake") || action.includes("custody") || action.includes("vault")) {
    const item = itemName || "Campus item";
    return {
      title: "Item Received in Vault Custody",
      badgeText: "Custody Intake",
      badgeClass: "bg-lime text-forest-900 border-lime-600/30",
      iconType: "box",
      iconBg: "bg-stone-50 text-forest-700 border-line",
      description: action.replace(/^System log:\s*/i, ""),
      target: item,
      operator,
      category: "intake",
      time: formattedTime,
    };
  }

  // 8. General fallback
  const cleanTitle = action
    .replace(/^System log:\s*/i, "")
    .replace(/_/g, " ")
    .replace(/\b\w/g, (c) => c.toUpperCase());

  return {
    title: cleanTitle || "Administrative Record",
    badgeText: "Audit Record",
    badgeClass: "bg-stone-100 text-stone-700 border-stone-200",
    iconType: "general",
    iconBg: "bg-stone-100 text-stone-600 border-stone-200",
    description: `Action recorded in security log • Ref: ${itemId ? itemId.slice(0, 8) : "System"}`,
    target: itemName || "",
    operator,
    category: (eventCategory || "user") as "claim" | "intake" | "user",
    time: formattedTime,
  };
}

