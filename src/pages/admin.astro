          ) : (
            liveAnnouncements.map((ann) => {
              const urgencyStyle =
                ann.urgency === "alert"
                  ? "bg-danger/10 text-danger border-danger/30"
                  : ann.urgency === "warning"
                    ? "bg-amber-500/10 text-amber-700 border-amber-500/30"
                    : "bg-forest-700/10 text-forest-700 border-forest-700/30";
              const urgencyEmoji = ann.urgency === "alert" ? "🚨" : ann.urgency === "warning" ? "⚠️" : "ℹ️";
              const isDatabaseRecord = !ann.id.startsWith("default-");

              return (
                <div
                  class={`announcement-row rounded-2xl border p-4.5 transition-all shadow-2xs ${
                    ann.active ? "bg-white border-line hover:border-forest-700/40" : "bg-stone-50/70 border-stone-200 opacity-60"
                  }`}
                  data-ann-id={ann.id}
                  data-ann-active={ann.active ? "true" : "false"}
                >
                  <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-3">
                    <div class="min-w-0 flex-1">
                      <div class="flex flex-wrap items-center gap-2 mb-1.5">
                        <span class={`rounded-full px-2.5 py-0.5 text-xs font-bold border ${urgencyStyle}`}>
                          {urgencyEmoji} {ann.urgency.toUpperCase()}
                        </span>
                        <span class={`rounded-full px-2 py-0.5 text-[11px] font-black uppercase tracking-wider ${
                          ann.active ? "bg-lime text-forest-900 border border-lime-600/30" : "bg-stone-200 text-stone-600"
                        }`}>
                          {ann.active ? "Live Broadcast" : "Hidden"}
                        </span>
                        {ann.created_at && (
                          <span class="text-xs text-stone-400 font-medium tabular-nums">
                            {new Date(ann.created_at).toLocaleDateString("en-US", { month: "short", day: "numeric", hour: "2-digit", minute: "2-digit" })}
                          </span>
                        )}
                      </div>
                      <h5 class="text-sm sm:text-base font-bold text-forest-900 leading-snug">
                        {ann.title}
                      </h5>
                      <p class="mt-1 text-xs sm:text-sm text-stone-600 leading-relaxed">
                        {ann.content}
                      </p>
                    </div>

                    <div class="flex items-center sm:flex-col sm:items-end gap-2 shrink-0 pt-2 sm:pt-0 border-t sm:border-t-0 border-stone-100">
                      {isDatabaseRecord ? (
                        <>
                          <button
                            type="button"
                            class="toggle-ann-btn inline-flex min-h-9 items-center justify-center rounded-full border border-line bg-white hover:bg-stone-50 active:scale-95 px-3.5 py-1 text-xs font-bold text-forest-900 transition-all shadow-2xs cursor-pointer"
                            data-ann-id={ann.id}
                            data-ann-active={ann.active ? "true" : "false"}
                          >
                            {ann.active ? "Pause notice" : "Activate notice"}
                          </button>
                          <button
                            type="button"
                            class="delete-ann-btn inline-flex min-h-9 items-center justify-center gap-1 rounded-full bg-stone-100 hover:bg-danger/10 hover:text-danger active:scale-95 px-3 py-1 text-xs font-bold text-stone-600 transition-all cursor-pointer"
                            data-ann-id={ann.id}
                            data-ann-title={ann.title}
                          >
                            <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                              <polyline points="3 6 5 6 21 6"></polyline>
                              <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                            </svg>
                            <span>Delete</span>
                          </button>
                        </>
                      ) : (
                        <span class="inline-block text-[11px] font-semibold text-stone-400 px-2.5 py-1 rounded-full bg-stone-100">
                          System default
                        </span>
                      )}
                    </div>
                  </div>
                </div>
              );
            })
          )}
        </div>
      </div>

      <!-- Modal Footer -->
      <div class="mt-6 flex items-center justify-between gap-3 pt-4 border-t border-line/80">
        <div class="flex items-center gap-1.5 text-xs text-stone-500 font-medium hidden sm:flex">
          <svg class="size-4 text-forest-700 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
          <span>De La Salle Araneta University &bull; Official Campus Broadcast Network</span>
        </div>
        <button
          type="button"
          class="close-announcements-modal min-h-10 rounded-full border border-line bg-white hover:bg-stone-50 active:scale-95 px-6 py-2 text-xs font-bold text-forest-900 transition-all shadow-2xs cursor-pointer ml-auto"
        >
          Close
        </button>
      </div>
