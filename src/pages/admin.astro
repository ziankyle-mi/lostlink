  <!-- Quick Toast Notification -->
  <div
    id="toast-notification"
    class={`fixed bottom-6 right-6 z-[110] translate-y-3 rounded-2xl px-5 py-3.5 text-sm font-bold text-white shadow-xl transition-all ${custodyNotice ? (custodyNoticeOk ? "block bg-forest-900" : "block bg-danger") : "hidden"}`}
  >
    <div class="flex items-center gap-3">
      <span
        class={`flex size-6 items-center justify-center rounded-full text-xs font-black ${custodyNoticeOk ? "bg-lime text-forest-700" : "bg-white/20 text-white"}`}
      >
        {custodyNoticeOk ? (
          <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 6 9 17l-5-5" />
          </svg>
        ) : (
          "!"
        )}
      </span>
      <span id="toast-message">{custodyNotice ?? "Action processed successfully."}</span>
    </div>
  </div>

  <script>
    // @ts-nocheck -- legacy DOM script, migrated out of is:inline for CSP.
    // Client-side interactions
    (function () {
      const modal = document.getElementById("review-claim-modal");
      const closeBtn = document.getElementById("close-review-modal-btn");
      const releaseBtn = document.getElementById("modal-release-btn");
      const rejectBtn = document.getElementById("modal-reject-btn");
      const toast = document.getElementById("toast-notification");
      const toastMsg = document.getElementById("toast-message");

      // Modals
      const intakeModal = document.getElementById("intake-guidelines-modal");
      const auditModal = document.getElementById("audit-log-modal");
      const allClaimsModal = document.getElementById("all-claims-modal");
      const unclaimedModal = document.getElementById("unclaimed-items-modal");
      const rejectReportModal = document.getElementById("reject-report-modal");
      const rejectReportName = document.getElementById("reject-report-name");
      const rejectReportReason = document.getElementById("reject-report-reason");
      const rejectReportError = document.getElementById("reject-report-error");
      const rejectReportConfirm = document.getElementById("reject-report-confirm-btn");
      const rejectReportCancel = document.getElementById("reject-report-cancel-btn");
      const rejectReportClose = document.getElementById("reject-report-close-btn");
      const rejectReportDescPreview = document.getElementById("reject-report-desc-preview");
      const rejectReportDescBadge = document.getElementById("reject-report-desc-badge");
      const rejectPresetChips = document.querySelectorAll(".reject-preset-chip");
      let pendingRejectItem = null;

      const openIntakeBtn = document.getElementById("open-intake-guidelines-btn");
      const openAuditBtn = document.getElementById("open-audit-log-btn");
      const openAllClaimsBtn = document.getElementById("open-all-claims-btn");
      const sidebarAuditLink = document.getElementById("sidebar-activity-log-link");
      const openUnclaimedBtn = document.getElementById("open-unclaimed-modal-btn");
      const announcementsModal = document.getElementById("announcements-modal");
      const openAnnouncementsBtn = document.getElementById("open-announcements-cta-btn");
      const sidebarAnnouncementsBtn = document.getElementById("open-announcements-modal-btn");
      const closeAnnouncementsBtns = document.querySelectorAll(".close-announcements-modal");
      const createAnnForm = document.getElementById("create-announcement-form");
      const createAnnError = document.getElementById("create-ann-error");
      const createAnnSubmit = document.getElementById("create-ann-submit-btn");

      const modalItemName = document.getElementById("modal-item-name");
      const modalClaimant = document.getElementById("modal-claimant-name");
      const modalDetails = document.getElementById("modal-private-details");

      let activeClaimId = "";
      let activeClaimButton = null;
      let activeClaimRow = null;

      function showToast(msg) {
        if (!toast || !toastMsg) return;
        toastMsg.textContent = msg;
        toast.classList.remove("hidden");
        setTimeout(() => toast.classList.add("hidden"), 3500);
      }

      function closeAllModals() {
        [modal, intakeModal, auditModal, allClaimsModal, unclaimedModal, rejectReportModal, announcementsModal].forEach((m) => {
          if (m) {
            m.classList.add("hidden");
            m.classList.remove("flex");
          }
        });
      }

      function openRejectReportModal(itemId, itemName, itemDesc, button) {
        pendingRejectItem = { id: itemId, name: itemName, button };
        if (rejectReportName) rejectReportName.textContent = itemName || "Report";
        if (rejectReportReason) rejectReportReason.value = "";
        if (rejectReportError) {
          rejectReportError.textContent = "";
          rejectReportError.classList.add("hidden");
        }

        const trimmedDesc = (itemDesc || "").trim();
        if (rejectReportDescPreview) {
          rejectReportDescPreview.textContent = trimmedDesc.length > 0 ? `"${trimmedDesc}"` : "No description provided.";
        }

        if (rejectReportDescBadge) {
          rejectReportDescBadge.classList.remove("hidden");
          if (trimmedDesc.length < 30) {
            rejectReportDescBadge.textContent = `⚠️ Short / Incomplete (${trimmedDesc.length} chars)`;
            rejectReportDescBadge.className = "text-[11px] font-bold px-2 py-0.5 rounded-full border bg-danger/10 text-danger border-danger/30";
          } else {
            rejectReportDescBadge.textContent = `✓ ${trimmedDesc.length} characters`;
            rejectReportDescBadge.className = "text-[11px] font-bold px-2 py-0.5 rounded-full border bg-lime/20 text-forest-900 border-lime-600/30";
          }
        }

        // Reset preset chips
        rejectPresetChips.forEach((chip, idx) => {
          chip.classList.remove("bg-forest-700", "text-white");
          chip.classList.add("bg-stone-50", "text-stone-700");
          // If description is short, auto-highlight the incomplete description chip
          if (trimmedDesc.length < 30 && idx === 0) {
            chip.classList.remove("bg-stone-50", "text-stone-700");
            chip.classList.add("bg-forest-700", "text-white");
            if (rejectReportReason) {
              rejectReportReason.value = chip.getAttribute("data-reason") || "";
            }
          }
        });

        if (rejectReportModal) {
          closeAllModals();
          rejectReportModal.classList.remove("hidden");
          rejectReportModal.classList.add("flex");
          rejectReportReason?.focus();
        }
      }

      // Wire up preset chips click
      rejectPresetChips.forEach((chip) => {
        chip.addEventListener("click", () => {
          const reason = chip.getAttribute("data-reason") || "";
          if (rejectReportReason) {
            rejectReportReason.value = reason;
            rejectReportReason.focus();
          }
          rejectPresetChips.forEach((c) => {
            c.classList.remove("bg-forest-700", "text-white");
            c.classList.add("bg-stone-50", "text-stone-700");
          });
          chip.classList.remove("bg-stone-50", "text-stone-700");
          chip.classList.add("bg-forest-700", "text-white");
        });
      });

      // Feature 1: Open & Close Intake Guidelines Modal
      if (openIntakeBtn && intakeModal) {
        openIntakeBtn.addEventListener("click", () => {
          closeAllModals();
          intakeModal.classList.remove("hidden");
          intakeModal.classList.add("flex");
        });
      }
      document.querySelectorAll(".close-intake-modal").forEach((btn) => {
        btn.addEventListener("click", closeAllModals);
      });

      // Feature 2: Open & Close Full Audit Log Modal + Category Filtering & Live Search
      const auditSearchInput = document.getElementById("audit-log-search");
      const auditFilterPills = document.querySelectorAll(".audit-filter-pill");
      const auditEventRows = document.querySelectorAll(".audit-event-row");
      const auditEmptyState = document.getElementById("audit-empty-state");
      let currentAuditFilter = "all";
      let currentAuditQuery = "";

      function filterAuditRows() {
        let visibleCount = 0;
        auditEventRows.forEach((row) => {
          const cat = row.getAttribute("data-event-category");
          const text = row.textContent.toLowerCase();
          const matchesCat = currentAuditFilter === "all" || cat === currentAuditFilter;
          const matchesQuery = !currentAuditQuery || text.includes(currentAuditQuery);
          const show = matchesCat && matchesQuery;
          row.style.display = show ? "" : "none";
          if (show) visibleCount++;
        });
        if (auditEmptyState) {
          auditEmptyState.classList.toggle("hidden", visibleCount > 0);
        }
      }

      function openAuditLog() {
        closeAllModals();
        if (auditSearchInput) {
          auditSearchInput.value = "";
          currentAuditQuery = "";
        }
        currentAuditFilter = "all";
        auditFilterPills.forEach((p) => {
          const isAll = p.getAttribute("data-audit-filter") === "all";
          p.classList.toggle("bg-forest-700", isAll);
          p.classList.toggle("text-white", isAll);
          p.classList.toggle("shadow-2xs", isAll);
          p.classList.toggle("active", isAll);
          p.classList.toggle("bg-stone-100", !isAll);
          p.classList.toggle("text-stone-700", !isAll);
        });
        filterAuditRows();
        if (auditModal) {
          auditModal.classList.remove("hidden");
          auditModal.classList.add("flex");
        }
      }

      if (openAuditBtn) openAuditBtn.addEventListener("click", openAuditLog);
      if (sidebarAuditLink) {
        sidebarAuditLink.addEventListener("click", (e) => {
          e.preventDefault();
          openAuditLog();
        });
      }
      document.querySelectorAll(".close-audit-modal").forEach((btn) => {
        btn.addEventListener("click", closeAllModals);
      });

      // Audit Category Filtering
      auditFilterPills.forEach((pill) => {
        pill.addEventListener("click", () => {
          auditFilterPills.forEach((p) => {
            p.classList.remove("bg-forest-700", "text-white", "shadow-2xs", "active");
            p.classList.add("bg-stone-100", "text-stone-700");
          });
          pill.classList.remove("bg-stone-100", "text-stone-700");
          pill.classList.add("bg-forest-700", "text-white", "shadow-2xs", "active");

          currentAuditFilter = pill.getAttribute("data-audit-filter") || "all";
          filterAuditRows();
        });
      });

      // Audit Live Search Input
      if (auditSearchInput) {
        auditSearchInput.addEventListener("input", (e) => {
          currentAuditQuery = e.target.value.toLowerCase().trim();
          filterAuditRows();
        });
      }

      // Feature 2b: Open & Close All Claims Modal + Filtering & Live Search
      const allClaimsSearchInput = document.getElementById("all-claims-search");
      const allClaimsFilterPills = document.querySelectorAll(".all-claims-filter-pill");
      const allClaimRows = document.querySelectorAll(".all-claims-row");
      const allClaimsEmptyState = document.getElementById("all-claims-empty-state");
      let currentClaimFilter = "all";
      let currentClaimQuery = "";

      function filterClaimRows() {
        let visibleCount = 0;
        allClaimRows.forEach((row) => {
          const status = row.getAttribute("data-claim-status");
          const text = row.textContent.toLowerCase();
          const matchesStatus = currentClaimFilter === "all" || status === currentClaimFilter;
          const matchesQuery = !currentClaimQuery || text.includes(currentClaimQuery);
          const show = matchesStatus && matchesQuery;
          row.style.display = show ? "" : "none";
          if (show) visibleCount++;
        });
        if (allClaimsEmptyState) {
          allClaimsEmptyState.classList.toggle("hidden", visibleCount > 0);
        }
      }

      function openAllClaims() {
        closeAllModals();
        if (allClaimsSearchInput) {
          allClaimsSearchInput.value = "";
          currentClaimQuery = "";
        }
        currentClaimFilter = "all";
        allClaimsFilterPills.forEach((p) => {
          const isAll = p.getAttribute("data-claim-filter") === "all";
          p.classList.toggle("bg-forest-700", isAll);
          p.classList.toggle("text-white", isAll);
          p.classList.toggle("shadow-2xs", isAll);
          p.classList.toggle("active", isAll);
          p.classList.toggle("bg-stone-100", !isAll);
          p.classList.toggle("text-stone-700", !isAll);
        });
        filterClaimRows();
        if (allClaimsModal) {
          allClaimsModal.classList.remove("hidden");
          allClaimsModal.classList.add("flex");
        }
      }

      if (openAllClaimsBtn) openAllClaimsBtn.addEventListener("click", openAllClaims);
      document.querySelectorAll(".close-all-claims-modal").forEach((btn) => {
        btn.addEventListener("click", closeAllModals);
      });

      allClaimsFilterPills.forEach((pill) => {
        pill.addEventListener("click", () => {
          allClaimsFilterPills.forEach((p) => {
            p.classList.remove("bg-forest-700", "text-white", "shadow-2xs", "active");
            p.classList.add("bg-stone-100", "text-stone-700");
          });
          pill.classList.remove("bg-stone-100", "text-stone-700");
          pill.classList.add("bg-forest-700", "text-white", "shadow-2xs", "active");

          currentClaimFilter = pill.getAttribute("data-claim-filter") || "all";
          filterClaimRows();
        });
      });

      if (allClaimsSearchInput) {
        allClaimsSearchInput.addEventListener("input", (e) => {
          currentClaimQuery = e.target.value.toLowerCase().trim();
          filterClaimRows();
        });
      }

      // Automatically open if navigated to with #all-claims
      if (window.location.hash === "#all-claims") {
        openAllClaims();
      }
      window.addEventListener("hashchange", () => {
        if (window.location.hash === "#all-claims") {
          openAllClaims();
        }
      });

      // Feature 3: Open & Close Unclaimed Overdue Items Modal + Actions
      if (openUnclaimedBtn && unclaimedModal) {
        openUnclaimedBtn.addEventListener("click", () => {
          closeAllModals();
          unclaimedModal.classList.remove("hidden");
          unclaimedModal.classList.add("flex");
        });
      }
      document.querySelectorAll(".close-unclaimed-modal").forEach((btn) => {
        btn.addEventListener("click", closeAllModals);
      });

      // Unclaimed Items Review: Extend and Mark for donation are real forms
      // posting to actions.custodyDecision, so nothing is faked in the browser.
      // Backdrop click dismissal & Escape key for all modals
      [modal, intakeModal, auditModal, allClaimsModal, unclaimedModal, rejectReportModal].forEach((m) => {
        if (m) {
          m.addEventListener("click", (e) => {
            if (e.target === m) closeAllModals();
          });
        }
      });

      window.addEventListener("keydown", (e) => {
        if (e.key === "Escape") closeAllModals();
      });

      // Review buttons
      document.querySelectorAll(".claim-review-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          if (allClaimsModal) {
            allClaimsModal.classList.add("hidden");
            allClaimsModal.classList.remove("flex");
          }

          activeClaimId = btn.getAttribute("data-claim-id") || "";
          activeClaimButton = btn;
          activeClaimRow = btn.closest(".grid") || btn.closest(".all-claims-row");

          const item = btn.getAttribute("data-claim-item") || "Item";
          const claimant = btn.getAttribute("data-claim-claimant") || "Student";
          const details = btn.getAttribute("data-claim-details") || "No private details available.";

          if (modalItemName) modalItemName.textContent = item;
          if (modalClaimant) modalClaimant.textContent = claimant;
          if (modalDetails) modalDetails.textContent = details;

          if (modal) {
            modal.classList.remove("hidden");
            modal.classList.add("flex");
          }
        });
      });

      if (closeBtn) {
        closeBtn.addEventListener("click", () => {
          if (modal) {
            modal.classList.add("hidden");
            modal.classList.remove("flex");
          }
        });
      }

      if (releaseBtn) {
        releaseBtn.addEventListener("click", async () => {
          releaseBtn.disabled = true;
          releaseBtn.textContent = "Processing...";

          try {
            const res = await fetch("/api/admin/actions", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ action: "verify_claim", claimId: activeClaimId }),
            });
            const data = await res.json().catch(() => ({}));
            if (data.ok) {
              showToast("Claim approved & item marked as claimed in custody.");
              if (data.itemId) {
                try {
                  const storedClaimed = JSON.parse(sessionStorage.getItem("lostlink_claimed_items") || "[]");
                  if (!storedClaimed.includes(data.itemId)) {
                    storedClaimed.push(data.itemId);
                    sessionStorage.setItem("lostlink_claimed_items", JSON.stringify(storedClaimed));
                  }
                } catch (e) {}
              }
              if (activeClaimButton) {
                activeClaimButton.textContent = "Verified \u2713";
                activeClaimButton.disabled = true;
                activeClaimButton.classList.add("text-stone-400", "cursor-default");
              }
              if (activeClaimRow) {
                const statusSpan = activeClaimRow.querySelector("span[class*='rounded-full']");
                if (statusSpan) {
                  statusSpan.textContent = "Verified";
                  statusSpan.className = "inline-block rounded-full px-3 py-1 text-xs font-bold leading-none bg-lime text-forest-700";
                }
              }
            } else {
              showToast(data.error || "Could not process claim verification.");
            }
          } catch (err) {
            showToast("Network error. The claim was not verified.");
          } finally {
            releaseBtn.disabled = false;
            releaseBtn.textContent = "Approve and release item";
            if (modal) {
              modal.classList.add("hidden");
              modal.classList.remove("flex");
            }
          }
        });
      }

      if (rejectBtn) {
        rejectBtn.addEventListener("click", async () => {
          rejectBtn.disabled = true;
          rejectBtn.textContent = "Denying...";

          try {
            const res = await fetch("/api/admin/actions", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ action: "deny_claim", claimId: activeClaimId }),
            });
            const data = await res.json().catch(() => ({}));
            if (data.ok) {
              showToast("Claim denied and claimant notified.");
              if (activeClaimButton) {
                activeClaimButton.textContent = "Denied";
                activeClaimButton.disabled = true;
                activeClaimButton.classList.add("text-stone-400", "cursor-default");
              }
              if (activeClaimRow) {
                const statusSpan = activeClaimRow.querySelector("span[class*='rounded-full']");
                if (statusSpan) {
                  statusSpan.textContent = "Denied";
                  statusSpan.className = "inline-block rounded-full px-3 py-1 text-xs font-bold leading-none bg-danger/10 text-danger";
                }
              }
            } else {
              showToast(data.error || "Could not deny claim.");
            }
          } catch (err) {
            showToast("Network error. The claim was not denied.");
          } finally {
            rejectBtn.disabled = false;
            rejectBtn.textContent = "Flag / Request Details";
            if (modal) {
              modal.classList.add("hidden");
              modal.classList.remove("flex");
            }
          }
        });
      }

      // Approve / confirm intake. Lost reports publish; found items enter custody.
      document.querySelectorAll(".confirm-intake-btn").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const name = btn.getAttribute("data-intake-name") || "Item";
          const itemId = btn.getAttribute("data-intake-id");
          const itemType = btn.getAttribute("data-intake-type") || "found";
          const idleLabel = itemType === "lost" ? "Approve report" : "Confirm received";
          btn.disabled = true;
          btn.textContent = "Saving...";

          try {
            const res = await fetch("/api/admin/actions", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ action: "confirm_intake", itemId }),
            });
            const data = await res.json().catch(() => ({}));
            if (!res.ok || !data.ok) {
              btn.disabled = false;
              btn.textContent = idleLabel;
              showToast(data.error || "Could not approve the report.");
              return;
            }
            btn.textContent = itemType === "lost" ? "Approved \u2713" : "Received \u2713";
            btn.classList.remove("bg-lime");
            btn.classList.add("bg-stone-200", "text-stone-600", "cursor-default");
            showToast(data.message || `Approved "${name}".`);
          } catch (err) {
            btn.disabled = false;
            btn.textContent = idleLabel;
            showToast("Network error. The report was not approved.");
          }
        });
      });

      // Reject intake report buttons: open the reason modal, never fake success.
      document.querySelectorAll(".remove-intake-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          const name = btn.getAttribute("data-intake-name") || "Item";
          const itemId = btn.getAttribute("data-intake-id");
          if (!itemId) {
            showToast("This report cannot be rejected.");
            return;
          }
          const desc = btn.getAttribute("data-intake-desc") || "";
          openRejectReportModal(itemId, name, desc, btn);
        });
      });

      [rejectReportCancel, rejectReportClose].forEach((btn) => {
        if (btn) btn.addEventListener("click", closeAllModals);
      });

      if (rejectReportConfirm) {
        rejectReportConfirm.addEventListener("click", async () => {
          if (!pendingRejectItem) return;
          const reason = (rejectReportReason?.value || "").trim();
          if (reason.length < 5) {
            if (rejectReportError) {
              rejectReportError.textContent = "Please provide a reason of at least 5 characters.";
              rejectReportError.classList.remove("hidden");
            }
            return;
          }

          if (rejectReportError) rejectReportError.classList.add("hidden");
          rejectReportConfirm.disabled = true;
          const originalLabel = rejectReportConfirm.textContent;
          rejectReportConfirm.textContent = "Rejecting...";

          try {
            const res = await fetch("/api/admin/actions", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ action: "reject_report", itemId: pendingRejectItem.id, reason }),
            });
            const data = await res.json().catch(() => ({}));
            if (!res.ok || !data.ok) {
              if (rejectReportError) {
                rejectReportError.textContent = data.error || "Could not reject the report.";
                rejectReportError.classList.remove("hidden");
              }
              return;
            }

            const row = pendingRejectItem.button?.closest("[data-intake-row]");
            if (row) {
              row.style.transition = "all 0.3s ease-out";
              row.style.opacity = "0";
              row.style.transform = "scale(0.9)";
              setTimeout(() => row.remove(), 300);
            }
            showToast(`Report "${pendingRejectItem.name}" rejected. The reporter can see the reason.`);
            pendingRejectItem = null;
            closeAllModals();
          } catch (err) {
            if (rejectReportError) {
              rejectReportError.textContent = "Network error. The report was not rejected.";
              rejectReportError.classList.remove("hidden");
            }
          } finally {
            rejectReportConfirm.disabled = false;
            rejectReportConfirm.textContent = originalLabel;
          }
        });
      }

      // Quick search filter
      const searchInput = document.getElementById("overview-search-input");
      if (searchInput) {
        searchInput.addEventListener("input", (e) => {
          const q = (e.target.value || "").toLowerCase().trim();
          document.querySelectorAll("#claims .divide-y > div").forEach((row) => {
            const text = (row.textContent || "").toLowerCase();
            row.style.display = !q || text.includes(q) ? "" : "none";
          });
        });
      }

      // Log CTA button
      const logBtn = document.getElementById("log-found-cta-btn");
      if (logBtn) {
        logBtn.addEventListener("click", () => {
          window.location.href = "/";
        });
      }

      // Announcements Modal and Action Handlers
      function openAnnouncements() {
        closeAllModals();
        if (announcementsModal) {
          announcementsModal.classList.remove("hidden");
          announcementsModal.classList.add("flex");
          document.getElementById("ann-title-input")?.focus();
        }
      }

      if (openAnnouncementsBtn) openAnnouncementsBtn.addEventListener("click", openAnnouncements);
      if (sidebarAnnouncementsBtn) sidebarAnnouncementsBtn.addEventListener("click", openAnnouncements);
      closeAnnouncementsBtns.forEach((btn) => btn.addEventListener("click", closeAllModals));

      if (createAnnForm) {
        createAnnForm.addEventListener("submit", async (e) => {
          e.preventDefault();
          const title = (document.getElementById("ann-title-input")?.value || "").trim();
          const urgency = document.getElementById("ann-urgency-select")?.value || "info";
          const content = (document.getElementById("ann-content-input")?.value || "").trim();

          if (title.length < 5 || content.length < 10) {
            if (createAnnError) {
              createAnnError.textContent = "Title must be at least 5 characters and notice content at least 10 characters.";
              createAnnError.classList.remove("hidden");
            }
            return;
          }

          if (createAnnError) createAnnError.classList.add("hidden");
          if (createAnnSubmit) {
            createAnnSubmit.disabled = true;
            createAnnSubmit.textContent = "Publishing broadcast...";
          }

          try {
            const res = await fetch("/api/admin/actions", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ action: "create_announcement", title, urgency, content }),
            });
            const data = await res.json().catch(() => ({}));
            if (!res.ok || !data.ok) {
              if (createAnnError) {
                createAnnError.textContent = data.error || "Failed to publish announcement.";
                createAnnError.classList.remove("hidden");
              }
              return;
            }

            showToast("📢 Announcement broadcast live across campus!");
            setTimeout(() => {
              window.location.reload();
            }, 900);
          } catch (err) {
            if (createAnnError) {
              createAnnError.textContent = "Network error. Failed to broadcast announcement.";
              createAnnError.classList.remove("hidden");
            }
          } finally {
            if (createAnnSubmit) {
              createAnnSubmit.disabled = false;
              createAnnSubmit.textContent = "Broadcast Announcement";
            }
          }
        });
      }

      // Toggle announcement live broadcast status
      document.querySelectorAll(".toggle-ann-btn").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const annId = btn.getAttribute("data-ann-id");
          const currentActive = btn.getAttribute("data-ann-active") === "true";
          const nextActive = !currentActive;
          btn.disabled = true;

          try {
            const res = await fetch("/api/admin/actions", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ action: "toggle_announcement_status", id: annId, active: nextActive }),
            });
            const data = await res.json().catch(() => ({}));
            if (res.ok && data.ok) {
              btn.setAttribute("data-ann-active", String(nextActive));
              btn.textContent = nextActive ? "Pause notice" : "Activate notice";
              const row = btn.closest(".announcement-row");
              if (row) {
                row.setAttribute("data-ann-active", String(nextActive));
                if (nextActive) {
                  row.classList.remove("bg-stone-50/70", "opacity-60");
                  row.classList.add("bg-white");
                } else {
                  row.classList.add("bg-stone-50/70", "opacity-60");
                  row.classList.remove("bg-white");
                }
              }
              showToast(nextActive ? "Announcement broadcast activated!" : "Announcement paused from broadcast.");
            } else {
              showToast(data.error || "Failed to update announcement.");
            }
          } catch {
            showToast("Network error updating announcement.");
          } finally {
            btn.disabled = false;
          }
        });
      });

      // Delete announcement
      document.querySelectorAll(".delete-ann-btn").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const annId = btn.getAttribute("data-ann-id");
          const annTitle = btn.getAttribute("data-ann-title") || "Announcement";
          if (!confirm(`Are you sure you want to delete "${annTitle}"? This cannot be undone.`)) {
            return;
          }
          btn.disabled = true;

          try {
            const res = await fetch("/api/admin/actions", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ action: "delete_announcement", id: annId }),
            });
            const data = await res.json().catch(() => ({}));
            if (res.ok && data.ok) {
              const row = btn.closest(".announcement-row");
              if (row) {
                row.style.transition = "all 0.3s ease-out";
                row.style.opacity = "0";
                row.style.transform = "scale(0.95)";
                setTimeout(() => row.remove(), 300);
              }
              showToast("Announcement deleted.");
            } else {
              showToast(data.error || "Failed to delete announcement.");
            }
          } catch {
            showToast("Network error deleting announcement.");
          } finally {
            btn.disabled = false;
          }
        });
      });
    })();
  </script>
</Base>