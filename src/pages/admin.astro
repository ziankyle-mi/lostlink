      </div>

      <!-- Active Broadcasts Registry Section -->
      <div class="mt-6">
        <div class="flex items-center justify-between mb-3">
          <h4 class="text-xs font-black tracking-widest uppercase text-forest-900 flex items-center gap-2">
            <span>📡</span>
            <span>Current Announcements ({liveAnnouncements.length})</span>
