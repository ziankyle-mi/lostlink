---
import { actions, isInputError } from "astro:actions";
import Background from "~/components/Background.astro";
import BrandHeader from "~/components/BrandHeader.astro";
import Icon from "~/components/Icon.astro";
import TrustBadges from "~/components/TrustBadges.astro";
import { safeNextPath } from "~/lib/auth";
import { hasSupabase } from "~/lib/env";
import { devBypassEnabled, policyFromEnv } from "~/lib/session";
import Base from "~/layouts/Base.astro";

const env = Astro.locals.env;
const nextPath = safeNextPath(Astro.url.searchParams.get("next"));
const errorCode = Astro.url.searchParams.get("error");

// Form actions cannot redirect on their own in Astro 5, so they return a path
// and the page sends the redirect.
const googleResult = Astro.getActionResult(actions.googleSignIn);
if (googleResult && !googleResult.error && googleResult.data?.redirect) {
  return Astro.redirect(googleResult.data.redirect, 302);
}

const devResult = Astro.getActionResult(actions.devLogin);
if (devResult && !devResult.error && devResult.data?.redirect) {
  return Astro.redirect(devResult.data.redirect, 302);
}

if (Astro.locals.user) {
  return Astro.redirect(nextPath);
}

const messages: Record<string, string> = {
  domain: "That is not a DLSAU account. Sign in with your school email.",
  oauth: "Google sign-in did not finish. Try again.",
  state: "That sign-in link expired. Try again.",
  session: "That sign-in link expired. Try again.",
  config: "Sign-in is not set up yet. The owner still needs the Supabase keys.",
};
const errorMessage = errorCode ? messages[errorCode] : undefined;

const devOpen = devBypassEnabled(env);
const supabaseReady = hasSupabase(env);
const domainMissing = policyFromEnv(env).allowedDomain.trim() === "";
const devError =
  devResult?.error && !isInputError(devResult.error) ? devResult.error.message : undefined;
const devFieldError = isInputError(devResult?.error)
  ? devResult.error.fields.email?.[0]
  : undefined;
---

<Base title="Sign in | LostLink" description="Sign in to LostLink with your DLSAU account.">
  <main class="relative flex min-h-dvh flex-col">
    <Background />

    <div class="relative flex flex-1 flex-col px-6 py-8 sm:px-10 sm:py-10">
      <BrandHeader />

      <div class="flex flex-1 items-center justify-center py-10">
        <div class="grid w-full max-w-4xl items-center gap-10 md:grid-cols-2 md:gap-16">
          <div class="order-2 md:order-1">
            <p class="font-serif text-3xl leading-[1.25] text-forest-900 sm:text-4xl">
              <span class="font-bold">"Lost things</span> their way back<span
                class="font-bold"
                aria-hidden="true">&nbsp;"</span>
            </p>
            <p class="mt-5 flex items-center gap-3 text-sage-700">
              <span class="h-px w-10 bg-sage-400"></span>
              <span class="text-xs">LostLink &middot; DLSAU</span>
            </p>
          </div>

          <section
            class="order-1 w-full max-w-sm justify-self-center rounded-card bg-surface p-8 shadow-card sm:p-10 md:order-2"
            aria-labelledby="login-title"
          >
            <h1 id="login-title" class="eyebrow text-center text-forest-900">Login</h1>

            {
              errorMessage && (
                <p
                  role="alert"
                  class="mt-6 rounded-control border border-sage-400/60 bg-cream px-4 py-3 text-xs leading-snug text-sage-700"
                >
                  {errorMessage}
                </p>
              )
            }

            <form method="POST" action={actions.googleSignIn} class="mt-8">
              <input type="hidden" name="next" value={nextPath} />
              <button
                type="submit"
                class="flex min-h-11 w-full items-center justify-center gap-2 rounded-control bg-forest-700 px-4 py-3 eyebrow text-cream transition-colors hover:bg-forest-900"
              >
                <Icon name="google" class="size-4" />
                Login
              </button>
            </form>

            <p class="mt-3 text-center text-[0.6875rem] text-sage-600">
              Only DLSAU accounts can sign in.
            </p>

            {
              !supabaseReady && (
                <p class="mt-4 text-center text-[0.6875rem] leading-snug text-sage-400">
                  Google sign-in needs PUBLIC_SUPABASE_URL and PUBLIC_SUPABASE_ANON_KEY in .env.
                </p>
              )
            }

            {
              devOpen && (
                <div class="mt-8 border-t border-line pt-6">
                  <p class="eyebrow text-center text-sage-400">Local dev only</p>
                  <form method="POST" action={actions.devLogin} class="mt-4 space-y-3">
                    <input type="hidden" name="next" value={nextPath} />
                    <label class="block">
                      <span class="block text-[0.6875rem] text-sage-600">Email</span>
                      <input
                        type="email"
                        name="email"
                        value="student@dlsau.test"
                        required
                        autocomplete="off"
                        aria-describedby={devError || devFieldError ? "dev-login-error" : undefined}
                        class="mt-1 min-h-11 w-full rounded-control border border-line bg-cream px-3 text-sm text-forest-900 placeholder:text-sage-400"
                      />
                    </label>
                    {(devError || devFieldError) && (
                      <p id="dev-login-error" role="alert" class="text-[0.6875rem] text-sage-700">
                        {devFieldError ?? devError}
                      </p>
                    )}
                    <button
                      type="submit"
                      class="min-h-11 w-full rounded-control border border-forest-700 px-4 py-2.5 text-xs font-medium text-forest-700 transition-colors hover:bg-cream"
                    >
                      Continue without Google
                    </button>
                  </form>
                  {domainMissing && (
                    <p class="mt-3 text-[0.6875rem] leading-snug text-sage-400">
                      ALLOWED_EMAIL_DOMAIN is not set, so every valid email passes here.
                    </p>
                  )}
                </div>
              )
            }
          </section>
        </div>
      </div>

      <TrustBadges />
    </div>
  </main>
</Base>