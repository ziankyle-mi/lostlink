---
import { actions, isInputError } from "astro:actions";
import AuthShell from "~/components/AuthShell.astro";
import PasswordField from "~/components/PasswordField.astro";
import SubmitButton from "~/components/SubmitButton.astro";
import { safeNextPath } from "~/lib/auth";
import { devBypassEnabled } from "~/lib/session";

const env = Astro.locals.env;
const nextPath = safeNextPath(Astro.url.searchParams.get("next"));

// The register and reset actions redirect here with ?registered=1 or ?updated=1.
const params = Astro.url.searchParams;
const notice =
  params.get("registered") === "1"
    ? "Check your email to confirm your account, then sign in."
    : params.get("updated") === "1"
      ? "Password updated. Sign in with your new password."
      : undefined;

// Form actions cannot redirect on their own in Astro 5, so they return a path
// and the page sends the redirect.
const loginResult = Astro.getActionResult(actions.login);
if (loginResult && !loginResult.error && loginResult.data?.redirect) {
  return Astro.redirect(loginResult.data.redirect, 302);
}

const devResult = Astro.getActionResult(actions.devLogin);
if (devResult && !devResult.error && devResult.data?.redirect) {
  return Astro.redirect(devResult.data.redirect, 302);
}

if (Astro.locals.user) {
  return Astro.redirect(nextPath);
}

const loginError =
  loginResult?.error && !isInputError(loginResult.error)
    ? loginResult.error.message
    : undefined;
const loginFields = isInputError(loginResult?.error) ? loginResult.error.fields : undefined;
const fieldError = (name: "email" | "password") => loginFields?.[name]?.[0] ?? undefined;

const devError =
  devResult?.error && !isInputError(devResult.error) ? devResult.error.message : undefined;

const devOpen = devBypassEnabled(env);
---

<AuthShell
  title="Sign in | LostLink"
  heading="Welcome Back."
  subheading="Sign in to reconnect with your belongings."
  description="Sign in to LostLink with your DLSAU account."
>
  {
    (notice || loginError) && (
      <p role={loginError ? "alert" : "status"} class="notice">
        {loginError ?? notice}
      </p>
    )
  }

  <form method="POST" action={actions.login} class="mt-8">
    <input type="hidden" name="next" value={nextPath} />

    <div>
      <label for="email" class="label">University Email</label>
      <input
        id="email"
        type="email"
        name="email"
        class="field"
        placeholder="you@dlsau.edu.ph"
        autocomplete="email"
        required
        aria-invalid={fieldError("email") ? true : undefined}
        aria-describedby={fieldError("email") ? "email-error" : undefined}
      />
      {
        fieldError("email") && (
          <p id="email-error" role="alert" class="field-error">
            {fieldError("email")}
          </p>
        )
      }
    </div>

    <PasswordField
      id="password"
      name="password"
      label="Password"
      autocomplete="current-password"
      error={fieldError("password")}
      class="mt-6"
    />

    <div class="mt-5 flex flex-wrap items-center justify-between gap-3">
      <label class="flex cursor-pointer items-center gap-2.5 text-[0.9375rem] text-sage-700">
        <input
          type="checkbox"
          name="remember"
          value="on"
          class="size-5 shrink-0 cursor-pointer rounded accent-forest-700"
        />
        Remember me
      </label>
      <a
        href="/forgot-password"
        class="text-[0.9375rem] text-sage-600 underline underline-offset-4 hover:text-forest-700"
      >
        Forget Password?
      </a>
    </div>

    <div class="mt-8">
      <SubmitButton label="Sign in" busy="Signing in..." arrow />
    </div>

    <p class="caption">
      New to LostLink?
      <a href="/register">Create an account</a>
    </p>
  </form>

  {
    devOpen && (
      <div class="mt-8 flex flex-col items-center gap-2 border-t border-line pt-6">
        <form method="POST" action={actions.devLogin}>
          <input type="hidden" name="next" value={nextPath} />
          <button
            type="submit"
            class="text-xs font-medium text-sage-600 underline underline-offset-4 hover:text-forest-700"
          >
            Test login (dev)
          </button>
        </form>
        {devError && (
          <p role="alert" class="field-error">
            {devError}
          </p>
        )}
      </div>
    )
  }
</AuthShell>
