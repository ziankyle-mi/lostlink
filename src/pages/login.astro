---
import { actions, isInputError } from "astro:actions";
import AuthShell from "~/components/AuthShell.astro";
import PasswordField from "~/components/PasswordField.astro";
import SubmitButton from "~/components/SubmitButton.astro";
import { safeNextPath } from "~/lib/auth";
import { devBypassEnabled } from "~/lib/session";

const env = Astro.locals.env;
const nextPath = safeNextPath(Astro.url.searchParams.get("next"));

// The register and reset actions redirect here with ?registered=1 or ?updated=1.
const params = Astro.url.searchParams;
const notice =
  params.get("registered") === "1"
    ? "Check your email to confirm your account, then sign in."
    : params.get("updated") === "1"
      ? "Password updated. Sign in with your new password."
      : params.get("timeout") === "1"
        ? "Your session expired due to inactivity for your account security. Please sign in again."
        : params.get("suspended") === "1"
          ? "This account has been suspended by the Disciplinary Office. Access to campus services is restricted."
          : undefined;

// Form actions cannot redirect on their own in Astro 5, so they return a path
// and the page sends the redirect.
const loginResult = Astro.getActionResult(actions.login);
if (loginResult && !loginResult.error && loginResult.data?.redirect) {
  return Astro.redirect(loginResult.data.redirect, 302);
}

const devResult = Astro.getActionResult(actions.devLogin);
if (devResult && !devResult.error && devResult.data?.redirect) {
  return Astro.redirect(devResult.data.redirect, 302);
}

if (Astro.locals.user) {
  return Astro.redirect(nextPath);
}

const loginError =
  loginResult?.error && !isInputError(loginResult.error)
    ? loginResult.error.message
    : undefined;
const loginFields = isInputError(loginResult?.error) ? loginResult.error.fields : undefined;
const fieldError = (name: "email" | "password") => loginFields?.[name]?.[0] ?? undefined;

const devError =
  devResult?.error && !isInputError(devResult.error) ? devResult.error.message : undefined;

const devOpen = devBypassEnabled(env);
---

<AuthShell
  title="Sign in | LostLink"
  heading="Welcome Back."
  subheading="Sign in to reconnect with your belongings."
  description="Sign in to LostLink with your DLSAU account."
>
  {
    (notice || loginError) && (
      (notice?.includes("suspended") || loginError?.includes("suspended")) ? (
        <div
          role="alert"
          class="mt-6 rounded-2xl border border-[#9b2c1f]/25 bg-[#9b2c1f]/10 p-4 sm:p-5 text-forest-900 shadow-2xs flex items-start gap-3.5"
        >
          <div class="flex size-9 sm:size-10 shrink-0 items-center justify-center rounded-xl bg-[#9b2c1f] text-white shadow-2xs">
            <svg class="size-4.5 sm:size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
          </div>
          <div class="space-y-1 min-w-0 flex-1">
            <p class="text-sm font-bold text-[#9b2c1f] leading-snug">
              Account suspended by Disciplinary Office
            </p>
            <p class="text-xs sm:text-[0.8125rem] text-forest-900/85 leading-relaxed">
              {loginError ?? notice}
            </p>
            <p class="text-xs text-stone-500 pt-0.5">
              To appeal or inquire, please visit the Disciplinary &amp; Security Office at LSB Building #3 or contact <a href="mailto:studentaffairs@dlsau.edu.ph" class="font-bold text-forest-700 underline underline-offset-2 hover:text-forest-900">studentaffairs@dlsau.edu.ph</a>.
            </p>
          </div>
        </div>
      ) : (
        <div
          role={loginError ? "alert" : "status"}
          class={`mt-6 rounded-2xl border p-4 text-xs sm:text-[0.8125rem] leading-relaxed shadow-2xs flex items-center gap-3 ${
            loginError
              ? "border-[#9b2c1f]/20 bg-[#9b2c1f]/10 text-[#9b2c1f] font-medium"
              : "border-line/80 bg-canvas text-forest-900/85"
          }`}
        >
          <div class={`flex size-8 shrink-0 items-center justify-center rounded-xl ${loginError ? "bg-[#9b2c1f] text-white" : "bg-forest-700/10 text-forest-700"}`}>
            <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
              {loginError ? (
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              ) : (
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              )}
            </svg>
          </div>
          <p class="min-w-0 flex-1 leading-normal">
            {loginError ?? notice}
          </p>
        </div>
      )
    )
  }

  <form method="POST" action={actions.login} class="mt-8">
    <input type="hidden" name="next" value={nextPath} />

    <div>
      <label for="email" class="label">University Email</label>
      <input
        id="email"
        type="email"
        name="email"
        class="field"
        placeholder="you@dlsau.edu.ph"
        autocomplete="email"
        required
        aria-invalid={fieldError("email") ? true : undefined}
        aria-describedby={fieldError("email") ? "email-error" : undefined}
      />
      {
        fieldError("email") && (
          <p id="email-error" role="alert" class="field-error">
            {fieldError("email")}
          </p>
        )
      }
    </div>

    <PasswordField
      id="password"
      name="password"
      label="Password"
      autocomplete="current-password"
      error={fieldError("password")}
      class="mt-6"
    />

    <div class="mt-5 flex flex-wrap items-center justify-between gap-3">
      <label class="flex cursor-pointer items-center gap-2.5 text-[0.9375rem] text-sage-700">
        <input
          type="checkbox"
          name="remember"
          value="on"
          class="size-5 shrink-0 cursor-pointer rounded accent-forest-700"
        />
        Remember me
      </label>
      <a
        href="/forgot-password"
        class="text-[0.9375rem] text-sage-600 underline underline-offset-4 hover:text-forest-700"
      >
        Forget Password?
      </a>
    </div>

    <div class="mt-8">
      <SubmitButton label="LOGIN" busy="Signing in..." arrow />
    </div>
  </form>

  <p class="caption">
    Don't have an Account?
    <a href="/register">Register Here</a>
  </p>

  {
    devOpen && (
      <div class="mt-8 flex flex-col items-center gap-2 border-t border-line pt-6">
        <form method="POST" action={actions.devLogin}>
          <input type="hidden" name="next" value={nextPath} />
          <button
            type="submit"
            class="text-xs font-medium text-sage-600 underline underline-offset-4 hover:text-forest-700"
          >
            Test login (dev)
          </button>
        </form>
        {devError && (
          <p role="alert" class="field-error">
            {devError}
          </p>
        )}
      </div>
    )
  }
</AuthShell>
