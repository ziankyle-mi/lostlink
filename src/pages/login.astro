---
import { actions, isInputError } from "astro:actions";
import AuthShell from "~/components/AuthShell.astro";
import SubmitButton from "~/components/SubmitButton.astro";
import { safeNextPath } from "~/lib/auth";
import { devBypassEnabled } from "~/lib/session";

const env = Astro.locals.env;
const nextPath = safeNextPath(Astro.url.searchParams.get("next"));
const noticeCode = Astro.url.searchParams.get("notice");

const notices: Record<string, string> = {
  registered: "Check your email to confirm your account, then sign in.",
  updated: "Password updated. Sign in with your new password.",
};
const notice = noticeCode ? notices[noticeCode] : undefined;

// Form actions cannot redirect on their own in Astro 5, so they return a path
// and the page sends the redirect.
const loginResult = Astro.getActionResult(actions.login);
if (loginResult && !loginResult.error && loginResult.data?.redirect) {
  return Astro.redirect(loginResult.data.redirect, 302);
}

const devResult = Astro.getActionResult(actions.devLogin);
if (devResult && !devResult.error && devResult.data?.redirect) {
  return Astro.redirect(devResult.data.redirect, 302);
}

if (Astro.locals.user) {
  return Astro.redirect(nextPath);
}

const loginError =
  loginResult?.error && !isInputError(loginResult.error)
    ? loginResult.error.message
    : undefined;
const loginFields = isInputError(loginResult?.error) ? loginResult.error.fields : undefined;
const fieldError = (name: "email" | "password") => loginFields?.[name]?.[0] ?? undefined;

const devError =
  devResult?.error && !isInputError(devResult.error) ? devResult.error.message : undefined;

const devOpen = devBypassEnabled(env);
---

<AuthShell
  title="Login | LostLink"
  heading="LOGIN"
  description="Sign in to LostLink with your DLSAU account."
>
  {
    (notice || loginError) && (
      <p role={loginError ? "alert" : "status"} class="notice">
        {loginError ?? notice}
      </p>
    )
  }

  <form method="POST" action={actions.login} class="mt-11">
    <input type="hidden" name="next" value={nextPath} />

    <label class="block">
      <span class="sr-only">Email</span>
      <input
        type="email"
        name="email"
        class="field"
        placeholder="Email"
        autocomplete="email"
        required
        aria-invalid={fieldError("email") ? true : undefined}
        aria-describedby={fieldError("email") ? "email-error" : undefined}
      />
    </label>
    {
      fieldError("email") && (
        <p id="email-error" role="alert" class="field-error">
          {fieldError("email")}
        </p>
      )
    }

    <label class="mt-9 block">
      <span class="sr-only">Password</span>
      <input
        type="password"
        name="password"
        class="field"
        placeholder="Password"
        autocomplete="current-password"
        required
        aria-invalid={fieldError("password") ? true : undefined}
        aria-describedby={fieldError("password") ? "password-error" : undefined}
      />
    </label>
    {
      fieldError("password") && (
        <p id="password-error" role="alert" class="field-error">
          {fieldError("password")}
        </p>
      )
    }

    <div class="mt-5 flex flex-wrap items-center justify-between gap-4">
      <label class="flex cursor-pointer items-center gap-2.5 text-[0.9375rem] font-medium text-forest-900">
        <input
          type="checkbox"
          name="remember"
          value="on"
          class="size-4.5 shrink-0 rounded accent-forest-700 cursor-pointer"
        />
        Remember me
      </label>
      <a
        href="/forgot-password"
        class="text-[0.9375rem] font-semibold text-forest-700 hover:text-forest-900 underline underline-offset-4 decoration-forest-700/40 hover:decoration-forest-900"
      >
        Forgot Password?
      </a>
    </div>

    <div class="mt-14 flex justify-center">
      <SubmitButton label="LOGIN" busy="Signing in..." />
    </div>

    <p class="caption text-[0.9375rem] text-forest-900/80">
      Don't have an account?
      <a href="/register" class="font-bold text-forest-700 underline underline-offset-4 decoration-forest-700/50 hover:text-forest-900">Register Here</a>
    </p>
  </form>

  {
    devOpen && (
      <div class="mt-8 flex flex-col items-center gap-2 border-t border-line/50 pt-6">
        <form method="POST" action={actions.devLogin}>
          <input type="hidden" name="next" value={nextPath} />
          <button
            type="submit"
            class="text-[0.72rem] font-medium uppercase tracking-[0.16em] text-sage-600 underline-offset-4 hover:text-forest-700 hover:underline"
          >
            Test login (dev)
          </button>
        </form>
        {devError && (
          <p role="alert" class="text-[0.75rem] text-sage-700">
            {devError}
          </p>
        )}
      </div>
    )
  }
</AuthShell>