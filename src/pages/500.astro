---
import Base from "~/layouts/Base.astro";
---

<Base title="Something Went Wrong | LostLink" description="LostLink could not complete that request.">
  <main class="min-h-screen bg-canvas text-forest-900 flex items-center justify-center px-6 py-16">
    <div class="w-full max-w-lg rounded-3xl border border-stone-200 bg-white p-8 sm:p-10 shadow-card text-center">
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-stone-500">Error 500</p>
      <h1 class="mt-3 font-serif text-3xl sm:text-4xl font-black tracking-tight">Something went wrong</h1>
      <p class="mt-3 text-sm leading-relaxed text-stone-600">
        The request could not be completed. Please try again. If it keeps happening, contact the
        Disciplinary &amp; Security Office.
      </p>
      <a
        href="/"
        class="mt-7 inline-flex items-center justify-center rounded-full bg-forest-700 px-6 py-3 text-sm font-bold text-white transition-colors hover:bg-forest-900"
      >
        Back to the campus feed
      </a>
    </div>
  </main>
</Base>
