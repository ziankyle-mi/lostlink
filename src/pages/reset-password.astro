---
import { actions, isInputError } from "astro:actions";
import AuthShell from "~/components/AuthShell.astro";
import SubmitButton from "~/components/SubmitButton.astro";

const resetResult = Astro.getActionResult(actions.resetPassword);
if (resetResult && !resetResult.error && resetResult.data?.redirect) {
  return Astro.redirect(resetResult.data.redirect, 302);
}

const resetError =
  resetResult?.error && !isInputError(resetResult.error)
    ? resetResult.error.message
    : undefined;
const fields = isInputError(resetResult?.error) ? resetResult.error.fields : undefined;
const fieldError = (name: "password" | "confirm") => fields?.[name]?.[0] ?? undefined;
---

<AuthShell
  title="Create New Password | LostLink"
  heading="Create New Password"
  subheading="Choose a secure password for your LostLink account."
  description="Create a new password for your DLSAU LostLink account."
>  {
    resetError && (
      <p role="alert" class="notice mt-4">
        {resetError}
      </p>
    )
  }

  <form method="POST" action={actions.resetPassword} class="mt-8 space-y-5">
    <div>
      <label for="password" class="label">New Password</label>
      <input
        id="password"
        type="password"
        name="password"
        class="field"
        placeholder="At least 8 characters"
        autocomplete="new-password"
        required
        aria-invalid={fieldError("password") ? true : undefined}
        aria-describedby={fieldError("password") ? "password-error" : undefined}
      />
      {
        fieldError("password") && (
          <p id="password-error" role="alert" class="field-error mt-1.5">
            {fieldError("password")}
          </p>
        )
      }
    </div>

    <div>
      <label for="confirm" class="label">Confirm New Password</label>
      <input
        id="confirm"
        type="password"
        name="confirm"
        class="field"
        placeholder="Re-enter your new password"
        autocomplete="new-password"
        required
        aria-invalid={fieldError("confirm") ? true : undefined}
        aria-describedby={fieldError("confirm") ? "confirm-error" : undefined}
      />
      {
        fieldError("confirm") && (
          <p id="confirm-error" role="alert" class="field-error mt-1.5">
            {fieldError("confirm")}
          </p>
        )
      }
    </div>

    <div class="pt-3">
      <SubmitButton label="Update Password" busy="Updating..." arrow />
    </div>

    <p class="caption pt-2 text-center text-sm text-sage-600">
      <a href="/login" class="font-bold underline underline-offset-4 hover:text-forest-900 transition-colors">
        Back to Sign in
      </a>
    </p>
  </form>
</AuthShell>