---
import { actions, isInputError } from "astro:actions";
import Background from "~/components/Background.astro";
import BrandHeader from "~/components/BrandHeader.astro";
import TrustBadges from "~/components/TrustBadges.astro";
import Base from "~/layouts/Base.astro";

const resetResult = Astro.getActionResult(actions.resetPassword);
if (resetResult && !resetResult.error && resetResult.data?.redirect) {
  return Astro.redirect(resetResult.data.redirect, 302);
}

const resetError =
  resetResult?.error && !isInputError(resetResult.error)
    ? resetResult.error.message
    : undefined;
const fields = isInputError(resetResult?.error) ? resetResult.error.fields : undefined;
const fieldError = (name: "password" | "confirm") => fields?.[name]?.[0] ?? undefined;
---

<Base title="New Password | LostLink" description="Choose a new LostLink password.">
  <main class="relative flex min-h-dvh flex-col">
    <Background />

    <div class="relative mx-auto flex w-full max-w-[1440px] flex-1 flex-col px-5 py-6 sm:px-9 sm:py-8">
      <BrandHeader />

      <div class="flex flex-1 flex-col items-center justify-center gap-12 py-10 md:grid md:grid-cols-2 md:items-center md:gap-8 md:py-6">
        <div class="hidden max-w-md md:block md:self-end md:pb-16">
          <p class="font-serif text-[2.6rem] leading-[1.22] text-forest-900">
            <span class="text-forest-700">&ldquo;</span><span class="font-bold">Lost <span
              class="text-forest-600">things</span></span><br />
            their way<br />
            <span class="font-bold">back</span> <span class="text-forest-700">&ldquo;</span>
          </p>
          <p class="mt-6 flex items-center gap-3 text-sage-700">
            <span class="h-px w-12 bg-sage-400"></span>
            <span class="text-[0.9rem]">LostLink &middot; DLSAU</span>
          </p>
        </div>

        <section
          class="w-full max-w-[34rem] justify-self-center rounded-[1.5rem] bg-card-tint px-7 py-10 shadow-card sm:px-12 sm:py-12"
          aria-labelledby="reset-title"
        >
          <h1
            id="reset-title"
            class="text-center text-[1.35rem] font-medium tracking-[0.06em] text-ink"
          >
            NEW PASSWORD
          </h1>

          {
            resetError && (
              <p
                role="alert"
                class="mt-6 rounded-control border border-line/60 bg-surface/70 px-4 py-3 text-xs leading-snug text-sage-700"
              >
                {resetError}
              </p>
            )
          }

          <form method="POST" action={actions.resetPassword} class="mt-9">
            <label class="block">
              <span class="sr-only">New password</span>
              <input
                type="password"
                name="password"
                class="field"
                placeholder="New password"
                autocomplete="new-password"
                required
                aria-invalid={fieldError("password") ? true : undefined}
                aria-describedby={fieldError("password") ? "password-error" : undefined}
              />
            </label>
            {
              fieldError("password") && (
                <p id="password-error" role="alert" class="mt-1.5 text-[0.7rem] text-sage-700">
                  {fieldError("password")}
                </p>
              )
            }

            <label class="mt-8 block">
              <span class="sr-only">Confirm new password</span>
              <input
                type="password"
                name="confirm"
                class="field"
                placeholder="Confirm new password"
                autocomplete="new-password"
                required
                aria-invalid={fieldError("confirm") ? true : undefined}
                aria-describedby={fieldError("confirm") ? "confirm-error" : undefined}
              />
            </label>
            {
              fieldError("confirm") && (
                <p id="confirm-error" role="alert" class="mt-1.5 text-[0.7rem] text-sage-700">
                  {fieldError("confirm")}
                </p>
              )
            }

            <div class="mt-12 flex justify-center">
              <button
                type="submit"
                class="min-h-11 w-full max-w-[11.5rem] rounded-control bg-forest-700 px-6 py-2.5 text-[0.8rem] font-medium tracking-[0.1em] text-white transition-colors hover:bg-forest-900"
              >
                Save
              </button>
            </div>

            <p class="mt-4 text-center text-[0.7rem] text-sage-700">
              <a href="/login" class="font-semibold text-ink hover:text-forest-700">
                Back to Login
              </a>
            </p>
          </form>
        </section>
      </div>

      <TrustBadges />
    </div>
  </main>
</Base>