---
import { actions, isInputError } from "astro:actions";
import AuthShell from "~/components/AuthShell.astro";

const resetResult = Astro.getActionResult(actions.resetPassword);
if (resetResult && !resetResult.error && resetResult.data?.redirect) {
  return Astro.redirect(resetResult.data.redirect, 302);
}

const resetError =
  resetResult?.error && !isInputError(resetResult.error)
    ? resetResult.error.message
    : undefined;
const fields = isInputError(resetResult?.error) ? resetResult.error.fields : undefined;
const fieldError = (name: "password" | "confirm") => fields?.[name]?.[0] ?? undefined;
---

<AuthShell
  title="New Password | LostLink"
  heading="NEW PASSWORD"
  description="Choose a new LostLink password."
>
  {
    resetError && (
      <p role="alert" class="notice">
        {resetError}
      </p>
    )
  }

  <form method="POST" action={actions.resetPassword} class="mt-11">
    <label class="block">
      <span class="sr-only">New password</span>
      <input
        type="password"
        name="password"
        class="field"
        placeholder="New password"
        autocomplete="new-password"
        required
        aria-invalid={fieldError("password") ? true : undefined}
        aria-describedby={fieldError("password") ? "password-error" : undefined}
      />
    </label>
    {
      fieldError("password") && (
        <p id="password-error" role="alert" class="field-error">
          {fieldError("password")}
        </p>
      )
    }

    <label class="mt-9 block">
      <span class="sr-only">Confirm new password</span>
      <input
        type="password"
        name="confirm"
        class="field"
        placeholder="Confirm new password"
        autocomplete="new-password"
        required
        aria-invalid={fieldError("confirm") ? true : undefined}
        aria-describedby={fieldError("confirm") ? "confirm-error" : undefined}
      />
    </label>
    {
      fieldError("confirm") && (
        <p id="confirm-error" role="alert" class="field-error">
          {fieldError("confirm")}
        </p>
      )
    }

    <div class="mt-14 flex justify-center">
      <button type="submit" class="btn-primary">Save</button>
    </div>

    <p class="caption">
      <a href="/login">Back to Login</a>
    </p>
  </form>
</AuthShell>