---
import { actions } from "astro:actions";
import Background from "~/components/Background.astro";
import BrandHeader from "~/components/BrandHeader.astro";
import TrustBadges from "~/components/TrustBadges.astro";
import Base from "~/layouts/Base.astro";

// The middleware already redirects logged-out visitors to /login.
const user = Astro.locals.user;

const logoutResult = Astro.getActionResult(actions.logout);
if (logoutResult && !logoutResult.error && logoutResult.data?.redirect) {
  return Astro.redirect(logoutResult.data.redirect, 302);
}
---

<Base title="Dashboard | LostLink">
  <main class="relative flex min-h-dvh flex-col">
    <Background />

    <div class="relative flex flex-1 flex-col px-6 py-8 sm:px-10 sm:py-10">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <BrandHeader />

        <div class="flex items-center gap-3">
          <span class="rounded-full bg-forest-700/10 px-3 py-1.5 text-xs font-semibold text-forest-900">
            {user?.email}
          </span>
          <form method="POST" action={actions.logout}>
            <button
              type="submit"
              class="min-h-10 cursor-pointer rounded-lg border border-forest-700 bg-surface px-4 py-2 text-xs font-bold tracking-wider text-forest-700 uppercase shadow-sm transition-all hover:bg-forest-700 hover:text-white hover:shadow-md active:scale-95"
            >
              Sign out
            </button>
          </form>
        </div>
      </div>

      <div class="flex flex-1 items-center justify-center py-10">
        <section
          class="w-full max-w-sm rounded-card bg-surface p-8 text-center shadow-card sm:p-10"
          aria-labelledby="dashboard-title"
        >
          <h1 id="dashboard-title" class="eyebrow text-forest-900 tracking-widest">SYSTEM PREVIEW</h1>
          <p class="mt-6 font-serif text-2xl font-bold text-forest-900">hehe not yet finished</p>
        </section>
      </div>

      <TrustBadges />
    </div>
  </main>
</Base>