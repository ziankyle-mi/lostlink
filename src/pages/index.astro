---
import { actions } from "astro:actions";
import Base from "~/layouts/Base.astro";
import StudentNavbar from "~/components/StudentNavbar.astro";
import FilterBar from "~/components/FilterBar.astro";
import HeroFeed from "~/components/HeroFeed.astro";
import DashboardGrid from "~/components/DashboardGrid.astro";
import DashboardFooter from "~/components/DashboardFooter.astro";
import ItemClaimModal from "~/components/ItemClaimModal.astro";
import ReportModal from "~/components/ReportModal.astro";
import AdminRemoveModal from "~/components/admin/AdminRemoveModal.astro";
import { createClient } from "@supabase/supabase-js";
import { ALL_ITEMS, type DashboardItem } from "~/data/mockItems";
import { roleForEmail } from "~/lib/session";

// The middleware redirects unauthenticated visitors to /login.
const user = Astro.locals.user;
const userEmail = user?.email ?? "";
const isRealAdmin = user?.role === "admin" || (userEmail ? roleForEmail(userEmail) === "admin" : false);

const logoutResult = Astro.getActionResult(actions.logout);
if (logoutResult && !logoutResult.error && logoutResult.data?.redirect) {
  return Astro.redirect(logoutResult.data.redirect, 302);
}

const env = Astro.locals.env;
let liveItems: DashboardItem[] = [];

if (env?.PUBLIC_SUPABASE_URL && (env.SUPABASE_SERVICE_ROLE_KEY || env.PUBLIC_SUPABASE_ANON_KEY)) {
  try {
    const supabase = createClient(
      env.PUBLIC_SUPABASE_URL,
      env.SUPABASE_SERVICE_ROLE_KEY || env.PUBLIC_SUPABASE_ANON_KEY,
      { auth: { persistSession: false } }
    );
    const { data: dbItems } = await supabase
      .from("items")
      .select("*")
      .order("created_at", { ascending: false });
    // Campus feed only displays active, approved items waiting to be claimed or found.
    // When an item is claimed, resolved, or rejected, it is automatically hidden from this public feed.
    const visibleDbItems = (dbItems || []).filter(
      (item) => item.status === "approved",
    );

    if (visibleDbItems.length > 0) {
      liveItems = visibleDbItems.map((row) => {
        let images: string[] = [];
        if (row.photo_path) {
          try {
            if (typeof row.photo_path === "string" && row.photo_path.startsWith("[")) {
              images = JSON.parse(row.photo_path);
            } else {
              images = [row.photo_path];
            }
          } catch {
            images = [row.photo_path];
          }
        }

        const d = row.event_date ? new Date(row.event_date) : new Date(row.created_at);
        const formattedDate = !isNaN(d.getTime())
          ? d.toLocaleDateString("en-US", { month: "short", day: "numeric" })
          : "Recently";

        const iconMap: Record<string, DashboardItem["icon"]> = {
          "IDs, Cards & Wallets": "wallet",
          "Keys & Keychains": "keys",
          "Electronics": "laptop",
          "Bags & Backpacks": "backpack",
          "Water Bottles & Tumblers": "bottle",
          "Clothing & Apparel": "umbrella",
          "Books, Stationery & School Supplies": "id-card",
          "Accessories, Jewelry & Eyewear": "earbuds",
          "Personal Care & Miscellaneous": "wallet",
        };

        return {
          id: row.id,
          type: (row.type === "found" || row.type === "lost") ? row.type : "found",
          name: row.name,
          category: (row.category || "Personal Care & Miscellaneous") as DashboardItem["category"],
          location: row.location || "Campus",
          locationPrefix: row.type === "found" ? "Found at" : "Last seen at",
          date: formattedDate,
          eventDate: row.event_date || (row.created_at ? row.created_at.split("T")[0] : ""),
          icon: iconMap[row.category] || "wallet",
          tint: row.type === "found" ? "#e4ecd6" : "#dee8e0",
          actionLabel: row.type === "found" ? "Claim this item" : "I found this",
          referenceCode: row.reference_code ?? undefined,
          description: row.description || "",
          images,
        };
      });
    }
  } catch (err) {
    console.error("[index] Error loading live items:", err);
  }
}

const isDbConfigured = Boolean(env?.PUBLIC_SUPABASE_URL && (env.SUPABASE_SERVICE_ROLE_KEY || env.PUBLIC_SUPABASE_ANON_KEY));
const allFeedItems: DashboardItem[] = isDbConfigured ? liveItems : ALL_ITEMS;
const feedFoundCount = allFeedItems.filter((i) => i.type === "found").length;
const feedLostCount = allFeedItems.filter((i) => i.type === "lost").length;
---

<Base title="LostLink | DLSAU Lost & Found System" description="Campus lost and found system for De La Salle Araneta University.">
  <div class="min-h-screen bg-canvas text-forest-900 flex flex-col justify-between selection:bg-lime">
    <div>
      <!-- Top Navigation and Announcement Ticker -->
      <StudentNavbar userEmail={user?.email ?? "student@dlsau.edu.ph"} />

      <!-- Filter Controls Toolbar -->
      <div class="mt-4 relative z-30">
        <FilterBar totalCount={allFeedItems.length} />
      </div>

      <!-- Campus Feed Headline & Two CTA Action Cards -->
      <HeroFeed foundCount={feedFoundCount} lostCount={feedLostCount} />

      <!-- 8-Card Campus Feed Grid -->
      <DashboardGrid items={allFeedItems} isAdmin={isRealAdmin} />
    </div>

    <!-- Campus Footer -->
    <DashboardFooter />
  </div>

  <!-- Interactive Modals -->
  <ItemClaimModal isAdmin={isRealAdmin} />
  <ReportModal />
  {isRealAdmin && <AdminRemoveModal />}

  <!-- Client-side Interactive Filtering, Modals, and Search Logic -->
  <script is:inline>
    (function () {
      // State
      let currentFilterType = "all";
      let currentCategory = "All Categories";
      let currentLocation = "All Locations";
      let currentDate = "all";
      let searchQuery = "";

      const cardTotal = () => document.querySelectorAll(".item-card").length;
      const emptyState = document.getElementById("empty-state");
      const counterBadge = document.getElementById("item-counter-badge");
      const feedSubtitle = document.getElementById("feed-subtitle");
      const loadMoreBtn = document.getElementById("load-more-btn");
      const searchInput = document.getElementById("global-search-input");
      const itemsGrid = document.getElementById("items-grid");

      // Fast path: filtering is instant DOM show/hide on already-rendered cards,
      // so we do NOT flash the skeleton grid (that added a 150ms lag on every
      // click). Skeleton is only used by load-more / async paths.
      function applyGridWithTransition(action) {
        action();
      }

      // The search box lives in the navbar, far above the item grid, so a
      // search used to filter cards invisibly below the fold — the user had
      // no idea anything happened unless they scrolled. When a query appears
      // (empty -> non-empty), bring the grid into view so results are seen.
      let lastSearchQuery = "";
      function scrollResultsIntoView() {
        const feed = document.getElementById("feed");
        if (!feed) return;
        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        feed.scrollIntoView({ behavior: reduceMotion ? "auto" : "smooth", block: "start" });
      }
      function maybeScrollOnSearch(value) {
        const wasEmpty = lastSearchQuery.trim() === "";
        const isEmpty = value.trim() === "";
        lastSearchQuery = value;
        // Only on the transition into an active search, not every keystroke.
        if (wasEmpty && !isEmpty) scrollResultsIntoView();
      }

      // Date-range match against the card's ISO eventDate (data-item-event-date).
      function matchesDate(eventDate, range) {
        if (range === "all") return true;
        if (!eventDate) return false;
        const d = new Date(eventDate + "T00:00:00");
        if (Number.isNaN(d.getTime())) return false;
        const now = new Date();
        const startOfToday = new Date(now.getFullYear(), now.getMonth(), now.getDate());
        if (range === "today") {
          return d.getTime() === startOfToday.getTime();
        }
        if (range === "week") {
          const days = (startOfToday - d) / 86400000;
          return days >= 0 && days < 7;
        }
        if (range === "month") {
          const days = (startOfToday - d) / 86400000;
          return days >= 0 && days < 30;
        }
        return true;
      }

      // Prune previously removed or claimed demo/mock items in this session
      try {
        const storedRemoved = JSON.parse(sessionStorage.getItem("lostlink_removed_items") || "[]");
        const storedClaimed = JSON.parse(sessionStorage.getItem("lostlink_claimed_items") || "[]");
        const allPruned = [...new Set([...storedRemoved, ...storedClaimed])];
        allPruned.forEach((prunedId) => {
          const remCard = document.querySelector(`.item-card[data-item-id="${prunedId}"]`);
          if (remCard) {
            const p = remCard.parentElement;
            if (p && p.classList.contains("extra-item")) p.remove();
            else remCard.remove();
          }
        });
      } catch (e) {}

      function updateGrid() {
        let visibleCount = 0;
        let totalMatches = 0;
        const currentCards = document.querySelectorAll(".item-card");

        currentCards.forEach((card) => {
          const type = card.dataset.itemType;
          const category = card.dataset.itemCategory;
          const location = card.dataset.itemLocation;
          const name = (card.dataset.itemName || "").toLowerCase();
          const desc = (card.dataset.itemDesc || "").toLowerCase();
          const eventDate = card.dataset.itemEventDate || "";

          const matchesType = currentFilterType === "all" || type === currentFilterType;
          const matchesCategory = currentCategory === "All Categories" || category === currentCategory;
          const matchesLocation = currentLocation === "All Locations" || location === currentLocation;
          const matchesDateRange = matchesDate(eventDate, currentDate);
          const query = searchQuery.trim().toLowerCase();
          const matchesSearch = !query || name.includes(query) || desc.includes(query) || category.toLowerCase().includes(query) || location.toLowerCase().includes(query);

          const matches = matchesType && matchesCategory && matchesLocation && matchesDateRange && matchesSearch;

          // The grid's direct children are the <article> for the first 8 cards
          // and an ".extra-item" wrapper <div> for the rest. Hiding only the
          // article inside a visible wrapper still leaves that wrapper in the
          // grid as an empty cell, which shows up as a gap in the card grid.
          // Always toggle visibility on the element that is the grid child,
          // and keep the article's own hidden state in sync for the counters.
          const parent = card.parentElement;
          const isExtra = !!parent && parent.classList.contains("extra-item");
          // Extras are only eligible once "Load more" / "View all" revealed them.
          const isExtraLoaded = !isExtra || parent.classList.contains("is-loaded");

          if (matches) {
            totalMatches++;
          }

          if (matches && isExtraLoaded) {
            card.classList.remove("hidden");
            if (isExtra) parent.classList.remove("hidden");
            visibleCount++;
          } else {
            card.classList.add("hidden");
            if (isExtra) parent.classList.add("hidden");
          }
        });

        // Update counter & subtitle
        const isDefaultView =
          currentFilterType === "all" &&
          currentCategory === "All Categories" &&
          currentLocation === "All Locations" &&
          currentDate === "all" &&
          !searchQuery;

        if (counterBadge) {
          counterBadge.textContent = String(isDefaultView ? cardTotal() : totalMatches);
        }

        if (feedSubtitle) {
          const totalBase = isDefaultView ? cardTotal() : totalMatches;
          feedSubtitle.textContent = `Showing ${visibleCount} of ${totalBase} items, newest first.`;
        }

        // Empty state
        if (emptyState) {
          if (visibleCount === 0) {
            emptyState.classList.remove("hidden");
          } else {
            emptyState.classList.add("hidden");
          }
        }
      }

      // Filter Type Buttons (All, Found, Lost)
      const typeButtons = document.querySelectorAll(".filter-type-btn");
      typeButtons.forEach((btn) => {
        btn.addEventListener("click", () => {
          typeButtons.forEach((b) => {
            b.classList.remove("bg-forest-700", "text-white", "shadow-2xs", "active");
            b.classList.add("text-forest-900/80");
          });
          btn.classList.add("bg-forest-700", "text-white", "shadow-2xs", "active");
          btn.classList.remove("text-forest-900/80");

          currentFilterType = btn.dataset.filterType || "all";
          applyGridWithTransition(updateGrid);
        });
      });

      // Nav bar links for Found / Lost Items
      document.querySelectorAll("[data-nav-filter]").forEach((link) => {
        link.addEventListener("click", (e) => {
          e.preventDefault();
          const targetType = link.dataset.navFilter;
          const targetBtn = document.querySelector(`.filter-type-btn[data-filter-type="${targetType}"]`);
          if (targetBtn) targetBtn.click();
          const feed = document.getElementById("feed");
          if (feed) feed.scrollIntoView({ behavior: "smooth" });
        });
      });

      // Live search inputs (both desktop and mobile)
      const mobileSearchInput = document.getElementById("mobile-search-input");
      if (searchInput) {
        searchInput.addEventListener("input", (e) => {
          searchQuery = e.target.value;
          if (mobileSearchInput) mobileSearchInput.value = searchQuery;
          updateGrid();
          maybeScrollOnSearch(searchQuery);
        });
      }
      if (mobileSearchInput) {
        mobileSearchInput.addEventListener("input", (e) => {
          searchQuery = e.target.value;
          if (searchInput) searchInput.value = searchQuery;
          updateGrid();
          maybeScrollOnSearch(searchQuery);
        });
      }

      // Dropdowns: Category, Location, Date
      function closeAllDropdowns() {
        document.querySelectorAll("[id$='-dropdown-menu'], #user-menu-dropdown, #notif-popover").forEach((m) => m.classList.add("hidden"));
        document.querySelectorAll("#category-dropdown-btn, #location-dropdown-btn, #date-dropdown-btn").forEach((b) => {
          b.setAttribute("aria-expanded", "false");
          b.querySelector("svg")?.classList.remove("rotate-180");
        });
      }

      function updateDropdownState(menuId, optionClass, dataAttr, selectedVal) {
        const menu = document.getElementById(menuId);
        if (!menu) return;
        menu.querySelectorAll("." + optionClass).forEach((opt) => {
          const optVal = opt.dataset[dataAttr];
          const isSelected = optVal === selectedVal || (!optVal && selectedVal === "all");
          opt.classList.toggle("bg-[#ece5d6]", isSelected);
          opt.classList.toggle("font-semibold", isSelected);
          opt.classList.toggle("text-forest-950", isSelected);
          const check = opt.querySelector(".location-check, .category-check, .date-check");
          if (check) check.classList.toggle("hidden", !isSelected);
        });
      }

      function setupDropdown(btnId, menuId, optionClass, onSelect) {
        const btn = document.getElementById(btnId);
        const menu = document.getElementById(menuId);
        if (!btn || !menu) return;

        btn.addEventListener("click", (e) => {
          e.stopPropagation();
          const isClosed = menu.classList.contains("hidden");
          closeAllDropdowns();
          if (isClosed) {
            menu.classList.remove("hidden");
            btn.setAttribute("aria-expanded", "true");
            btn.querySelector("svg")?.classList.add("rotate-180");
          }
        });

        menu.querySelectorAll("." + optionClass).forEach((opt) => {
          opt.addEventListener("click", (e) => {
            e.stopPropagation();
            onSelect(opt);
            menu.classList.add("hidden");
            btn.setAttribute("aria-expanded", "false");
            btn.querySelector("svg")?.classList.remove("rotate-180");
          });
        });
      }

      setupDropdown("category-dropdown-btn", "category-dropdown-menu", "category-option", (opt) => {
        const val = opt.dataset.category;
        currentCategory = val;
        const label = document.getElementById("selected-category-label");
        if (label) label.textContent = val === "All Categories" ? "Category" : val;
        updateDropdownState("category-dropdown-menu", "category-option", "category", currentCategory);
        applyGridWithTransition(updateGrid);
      });

      setupDropdown("location-dropdown-btn", "location-dropdown-menu", "location-option", (opt) => {
        const val = opt.dataset.location;
        currentLocation = val;
        const label = document.getElementById("selected-location-label");
        if (label) label.textContent = val === "All Locations" ? "Location" : val;
        updateDropdownState("location-dropdown-menu", "location-option", "location", currentLocation);
        applyGridWithTransition(updateGrid);
      });

      setupDropdown("date-dropdown-btn", "date-dropdown-menu", "date-option", (opt) => {
        const label = document.getElementById("selected-date-label");
        if (label) label.textContent = opt.textContent.trim();
        currentDate = opt.dataset.date || "all";
        updateDropdownState("date-dropdown-menu", "date-option", "date", currentDate);
        applyGridWithTransition(updateGrid);
      });

      // Initialize default active markers
      updateDropdownState("category-dropdown-menu", "category-option", "category", "All Categories");
      updateDropdownState("location-dropdown-menu", "location-option", "location", "All Locations");
      updateDropdownState("date-dropdown-menu", "date-option", "date", "all");

      // Reset filters
      function resetAllFilters() {
        currentFilterType = "all";
        currentCategory = "All Categories";
        currentLocation = "All Locations";
        currentDate = "all";
        searchQuery = "";

        if (searchInput) {
          searchInput.value = "";
          searchInput.dispatchEvent(new Event("input"));
        }
        if (mobileSearchInput) {
          mobileSearchInput.value = "";
          mobileSearchInput.dispatchEvent(new Event("input"));
        }
        const allBtn = document.querySelector('.filter-type-btn[data-filter-type="all"]');
        if (allBtn) {
          typeButtons.forEach((b) => {
            b.classList.remove("bg-forest-700", "text-white", "shadow-2xs", "active");
            b.classList.add("text-forest-900/75");
          });
          allBtn.classList.add("bg-forest-700", "text-white", "shadow-2xs", "active");
          allBtn.classList.remove("text-forest-900/75");
        }

        const catLabel = document.getElementById("selected-category-label");
        if (catLabel) catLabel.textContent = "Category";
        const locLabel = document.getElementById("selected-location-label");
        if (locLabel) locLabel.textContent = "Location";
        const dateLabel = document.getElementById("selected-date-label");
        if (dateLabel) dateLabel.textContent = "Date";

        updateDropdownState("category-dropdown-menu", "category-option", "category", "All Categories");
        updateDropdownState("location-dropdown-menu", "location-option", "location", "All Locations");
        updateDropdownState("date-dropdown-menu", "date-option", "date", "all");


        closeAllDropdowns();
        applyGridWithTransition(updateGrid);
      }

      const resetBtn = document.getElementById("reset-filters-btn");
      if (resetBtn) resetBtn.addEventListener("click", resetAllFilters);

      const emptyClearBtn = document.getElementById("empty-clear-filters-btn");
      if (emptyClearBtn) emptyClearBtn.addEventListener("click", resetAllFilters);

      const viewAllBtn = document.getElementById("view-all-items-btn");
      if (viewAllBtn) {
        viewAllBtn.addEventListener("click", () => {
          resetAllFilters();
          const extraItems = document.querySelectorAll(".extra-item");
          extraItems.forEach((item) => {
            item.classList.add("is-loaded");
            item.classList.remove("hidden");
          });
          updateGrid();
          if (loadMoreBtn) {
            loadMoreBtn.textContent = `All ${cardTotal()} items displayed`;
            loadMoreBtn.disabled = true;
            loadMoreBtn.classList.add("opacity-60", "cursor-default");
          }
        });
      }

      // Load More items
      if (loadMoreBtn) {
        loadMoreBtn.addEventListener("click", () => {
          const extraItems = document.querySelectorAll(".extra-item");
          let unhiddenCount = 0;
          extraItems.forEach((item) => {
            if (!item.classList.contains("is-loaded")) {
              item.classList.add("is-loaded");
              item.classList.remove("hidden");
              unhiddenCount++;
            }
          });
          if (unhiddenCount > 0) {
            updateGrid();
            loadMoreBtn.textContent = `All ${cardTotal()} items displayed`;
            loadMoreBtn.disabled = true;
            loadMoreBtn.classList.add("opacity-60", "cursor-default");
          }
        });
      }

      // Close filter dropdowns on click outside
      document.addEventListener("click", (e) => {
        document.querySelectorAll("[id$='-dropdown-menu']").forEach((m) => {
          if (!m.contains(e.target)) {
            m.classList.add("hidden");
          }
        });
        document.querySelectorAll("#category-dropdown-btn, #location-dropdown-btn, #date-dropdown-btn").forEach((b) => {
          const menuId = b.id.replace("-btn", "-menu");
          const menu = document.getElementById(menuId);
          if (!menu || menu.classList.contains("hidden")) {
            b.setAttribute("aria-expanded", "false");
            b.querySelector("svg")?.classList.remove("rotate-180");
          }
        });
      });

      // Claim / Details Modal
      const claimModal = document.getElementById("claim-modal-backdrop");
      const closeClaimModal = document.getElementById("close-claim-modal");
      const cancelClaimBtn = document.getElementById("cancel-claim-btn");

      function openItemModal(card) {
        if (!claimModal) return;
        window.activeModalCard = card;
        const name = card.dataset.itemName;
        const type = card.dataset.itemType;
        const category = card.dataset.itemCategory;
        const location = card.dataset.itemLocation;
        const date = card.dataset.itemDate;
        const desc = card.dataset.itemDesc;
        const ref = card.dataset.itemRef;
        let images = [];
        try {
          images = JSON.parse(card.dataset.itemImages || "[]");
        } catch (e) {
          images = [];
        }

        document.getElementById("modal-item-title").textContent = name;
        document.getElementById("modal-category").textContent = category;
        document.getElementById("modal-location").textContent = location;
        document.getElementById("modal-date").textContent = date;
        document.getElementById("modal-description").textContent = desc;

        // Render photo gallery in claim modal if photos exist
        const imagesContainer = document.getElementById("modal-images-container");
        const imagesGallery = document.getElementById("modal-images-gallery");
        if (imagesContainer && imagesGallery) {
          imagesGallery.replaceChildren();
          if (images.length > 0) {
            imagesContainer.classList.remove("hidden");
            images.forEach((imgSrc, idx) => {
              const imgEl = document.createElement("img");
              imgEl.src = imgSrc;
              imgEl.alt = `${name} - Photo ${idx + 1}`;
              imgEl.className = "h-24 w-28 shrink-0 rounded-xl border border-stone-200 object-cover shadow-2xs";
              imagesGallery.appendChild(imgEl);
            });
          } else {
            imagesContainer.classList.add("hidden");
          }
        }

        const typeBadge = document.getElementById("modal-type-badge");
        const refContainer = document.getElementById("modal-ref-container");
        const proofLabel = document.getElementById("modal-proof-label");
        const submitBtn = document.getElementById("submit-claim-btn");

        if (type === "found") {
          typeBadge.textContent = "FOUND";
          typeBadge.className = "rounded-full px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wider bg-forest-700 text-white";
          if (refContainer) {
            refContainer.classList.remove("hidden");
            document.getElementById("modal-ref-code").textContent = ref || "LL-4821";
          }
          if (proofLabel) proofLabel.textContent = "Describe Proof of Ownership";
          if (submitBtn) submitBtn.textContent = "Submit Claim Verification";
        } else {
          typeBadge.textContent = "LOST";
          typeBadge.className = "rounded-full px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wider bg-[#d8ef8c] text-forest-900 border border-lime-600/30";
          if (refContainer) refContainer.classList.add("hidden");
          if (proofLabel) proofLabel.textContent = "Did you find this? Let the owner know";
          if (submitBtn) submitBtn.textContent = "Notify Finder / Report Found";
        }

        const successMsg = document.getElementById("claim-success-msg");
        if (successMsg) successMsg.classList.add("hidden");
        const form = document.getElementById("claim-submit-form");
        if (form) form.classList.remove("hidden");

        claimModal.classList.remove("hidden");
        claimModal.classList.add("flex");
      }

      function hideClaimModal() {
        if (!claimModal) return;
        claimModal.classList.add("hidden");
        claimModal.classList.remove("flex");
      }

      // Delegated card click listener on grid (supports both initial and dynamically added cards)
      if (itemsGrid) {
        itemsGrid.addEventListener("click", (e) => {
          if (e.target.closest(".slider-prev") || e.target.closest(".slider-next")) {
            return;
          }
          if (e.target.closest(".admin-remove-card-btn")) {
            return;
          }
          const actionLink = e.target.closest("a[href^='/item/']");
          if (actionLink) {
            e.preventDefault();
          }
          const card = e.target.closest(".item-card");
          if (card) {
            openItemModal(card);
          }
        });
      }

      // Slidable Photo Carousel Controls (prev/next buttons)
      document.addEventListener("click", (e) => {
        const prevBtn = e.target.closest(".slider-prev");
        const nextBtn = e.target.closest(".slider-next");
        if (prevBtn || nextBtn) {
          e.stopPropagation();
          e.preventDefault();
          const slider = (prevBtn || nextBtn).closest(".card-slider");
          if (!slider) return;
          const track = slider.querySelector(".slider-track");
          const count = parseInt(slider.dataset.imagesCount || "1", 10);
          const badgeIdx = slider.querySelector(".current-slide-idx");
          let currentIdx = parseInt(slider.dataset.currentIdx || "0", 10);

          if (prevBtn) {
            currentIdx = (currentIdx - 1 + count) % count;
          } else {
            currentIdx = (currentIdx + 1) % count;
          }

          slider.dataset.currentIdx = String(currentIdx);
          if (track) track.style.transform = `translateX(-${currentIdx * 100}%)`;
          if (badgeIdx) badgeIdx.textContent = String(currentIdx + 1);
        }
      }, true);

      // Touch swipe support for card-slider on mobile
      let touchStartX = 0;
      let touchStartY = 0;
      let activeSlider = null;

      document.addEventListener("touchstart", (e) => {
        activeSlider = e.target.closest(".card-slider");
        if (activeSlider) {
          touchStartX = e.touches[0].clientX;
          touchStartY = e.touches[0].clientY;
        }
      }, { passive: true });

      document.addEventListener("touchend", (e) => {
        if (!activeSlider) return;
        const touchEndX = e.changedTouches[0].clientX;
        const touchEndY = e.changedTouches[0].clientY;
        const diffX = touchEndX - touchStartX;
        const diffY = touchEndY - touchStartY;

        if (Math.abs(diffX) > 35 && Math.abs(diffX) > Math.abs(diffY)) {
          const count = parseInt(activeSlider.dataset.imagesCount || "1", 10);
          if (count > 1) {
            let currentIdx = parseInt(activeSlider.dataset.currentIdx || "0", 10);
            if (diffX < 0) {
              currentIdx = (currentIdx + 1) % count;
            } else {
              currentIdx = (currentIdx - 1 + count) % count;
            }
            activeSlider.dataset.currentIdx = String(currentIdx);
            const track = activeSlider.querySelector(".slider-track");
            const badgeIdx = activeSlider.querySelector(".current-slide-idx");
            if (track) track.style.transform = `translateX(-${currentIdx * 100}%)`;
            if (badgeIdx) badgeIdx.textContent = String(currentIdx + 1);
          }
        }
        activeSlider = null;
      }, { passive: true });

      if (closeClaimModal) closeClaimModal.addEventListener("click", hideClaimModal);
      if (cancelClaimBtn) cancelClaimBtn.addEventListener("click", hideClaimModal);

      // Copy reference code in claim modal
      const modalCopyBtn = document.getElementById("modal-copy-ref-btn");
      if (modalCopyBtn) {
        modalCopyBtn.addEventListener("click", async (e) => {
          e.stopPropagation();
          const refEl = document.getElementById("modal-ref-code");
          const refText = refEl ? refEl.textContent.trim() : "";
          if (!refText) return;
          try {
            await navigator.clipboard.writeText(refText);
            const tooltip = modalCopyBtn.querySelector(".copy-ref-tooltip");
            if (tooltip) tooltip.classList.add("visible");
            showToast(`Reference code ${refText} copied to clipboard!`, "success");
            setTimeout(() => {
              if (tooltip) tooltip.classList.remove("visible");
            }, 2000);
          } catch (err) {
            console.warn("Clipboard copy failed:", err);
          }
        });
      }

      window.handleClaimSubmit = async function () {
        const form = document.getElementById("claim-submit-form");
        const successMsg = document.getElementById("claim-success-msg");
        const proofInput = document.getElementById("proof-description-input");
        const submitBtn = document.getElementById("submit-claim-btn");

        const proofText = proofInput ? proofInput.value.trim() : "";
        const targetCard = window.activeModalCard;
        const itemId = targetCard ? targetCard.dataset.itemId : "";

        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = "Submitting claim verification...";
        }

        try {
          await fetch("/api/claims", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              itemId: itemId || "item-1",
              proofDescription: proofText || "Identifying marks and proof of ownership provided.",
            }),
          });
        } catch (err) {
          console.warn("[claims] Submit notice:", err);
        }

        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = "Submit Claim Verification";
        }
        if (form) form.classList.add("hidden");
        if (successMsg) successMsg.classList.remove("hidden");
        showToast("Claim verification submitted to Security Office!", "success");
        setTimeout(hideClaimModal, 2200);
      };

      // Admin Post Removal Controls (Only functional for authorized admins)
      const removeModal = document.getElementById("admin-remove-modal-backdrop");
      const removeNameEl = document.getElementById("admin-remove-item-name");
      const removeConfirmBtn = document.getElementById("admin-remove-confirm-btn");
      const removeCancelBtn = document.getElementById("admin-remove-cancel-btn");
      const removeCloseX = document.getElementById("admin-remove-close-x");
      let itemPendingRemovalId = null;

      function openAdminRemoveModal(itemId, itemName) {
        if (!removeModal) return;
        itemPendingRemovalId = itemId;
        if (removeNameEl) removeNameEl.textContent = `"${itemName}"`;
        removeModal.classList.remove("hidden");
        removeModal.classList.add("flex");
      }

      function hideAdminRemoveModal() {
        if (!removeModal) return;
        itemPendingRemovalId = null;
        removeModal.classList.add("hidden");
        removeModal.classList.remove("flex");
      }

      if (removeCancelBtn) removeCancelBtn.addEventListener("click", hideAdminRemoveModal);
      if (removeCloseX) removeCloseX.addEventListener("click", hideAdminRemoveModal);
      if (removeModal) {
        removeModal.addEventListener("click", (e) => {
          if (e.target === removeModal) hideAdminRemoveModal();
        });
      }

      // Quick remove click on card button
      document.addEventListener("click", (e) => {
        const removeCardBtn = e.target.closest(".admin-remove-card-btn");
        if (removeCardBtn) {
          e.stopPropagation();
          e.preventDefault();
          const itemId = removeCardBtn.dataset.itemId;
          const itemName = removeCardBtn.dataset.itemName || "this post";
          openAdminRemoveModal(itemId, itemName);
        }
      });

      // Remove button inside ItemClaimModal
      const modalAdminRemoveBtn = document.getElementById("modal-admin-remove-btn");
      if (modalAdminRemoveBtn) {
        modalAdminRemoveBtn.addEventListener("click", (e) => {
          e.stopPropagation();
          if (window.activeModalCard) {
            const itemId = window.activeModalCard.dataset.itemId;
            const itemName = window.activeModalCard.dataset.itemName || "this post";
            openAdminRemoveModal(itemId, itemName);
          }
        });
      }

      function showToast(msg, type) {
        if (window.llToast) {
          window.llToast(msg, type || "success");
        }
      }

      if (removeConfirmBtn) {
        removeConfirmBtn.addEventListener("click", async () => {
          if (!itemPendingRemovalId) return;
          const targetId = itemPendingRemovalId;
          const originalBtnHtml = removeConfirmBtn.innerHTML;
          removeConfirmBtn.disabled = true;
          removeConfirmBtn.innerHTML = `
            <svg class="size-4 animate-spin text-white" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
            </svg>
            <span>Removing...</span>
          `;

          try {
            const resp = await fetch("/api/admin/actions", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({
                action: "remove_post",
                itemId: targetId,
              }),
            });
            const data = await resp.json();
            if (!resp.ok && !data.ok) {
              showToast(data.error || "Failed to remove post.", "error");
              removeConfirmBtn.disabled = false;
              removeConfirmBtn.innerHTML = originalBtnHtml;
              return;
            }
          } catch (err) {
            console.warn("[admin] Remove post request note:", err);
          }

          // Remember removed item in sessionStorage so it persists during demo
          try {
            const stored = JSON.parse(sessionStorage.getItem("lostlink_removed_items") || "[]");
            if (!stored.includes(targetId)) {
              stored.push(targetId);
              sessionStorage.setItem("lostlink_removed_items", JSON.stringify(stored));
            }
          } catch (e) {}

          // Animate out and remove card from DOM
          const card = document.querySelector(`.item-card[data-item-id="${targetId}"]`);
          if (card) {
            card.style.transition = "all 0.3s ease-out";
            card.style.opacity = "0";
            card.style.transform = "scale(0.85)";
            setTimeout(() => {
              const parent = card.parentElement;
              if (parent && parent.classList.contains("extra-item")) {
                parent.remove();
              } else {
                card.remove();
              }
              updateGrid();
            }, 300);
          }

          removeConfirmBtn.disabled = false;
          removeConfirmBtn.innerHTML = originalBtnHtml;
          hideAdminRemoveModal();
          hideClaimModal();
          showToast("Post removed from campus listings.");
        });
      }

      // Report Modal
      const reportModal = document.getElementById("report-modal-backdrop");
      const closeReportModal = document.getElementById("close-report-modal");
      const cancelReportBtn = document.getElementById("cancel-report-btn");

      function openReport(type) {
        if (!reportModal) return;
        const foundChoice = document.getElementById("report-choice-found");
        const lostChoice = document.getElementById("report-choice-lost");
        const typeInput = document.getElementById("report-type-val");
        const photoStar = document.getElementById("photo-req-star");
        const photoBadge = document.getElementById("photo-req-badge");
        const photoHint = document.getElementById("photo-req-hint");
        const validationError = document.getElementById("photo-validation-error");

        if (validationError) validationError.classList.add("hidden");

        if (type === "found") {
          typeInput.value = "found";
          foundChoice.classList.add("border-[#164f38]", "bg-[#164f38]/5");
          foundChoice.classList.remove("border-stone-200/90", "bg-white");
          const foundCheck = foundChoice.querySelector(".choice-check");
          if (foundCheck) {
            foundCheck.classList.remove("hidden");
            foundCheck.classList.add("flex");
          }

          lostChoice.classList.remove("border-[#164f38]", "bg-[#d8ef8c]/25");
          lostChoice.classList.add("border-stone-200/90", "bg-white");
          const lostCheck = lostChoice.querySelector(".choice-check");
          if (lostCheck) {
            lostCheck.classList.add("hidden");
            lostCheck.classList.remove("flex");
          }

          if (photoStar) photoStar.classList.remove("hidden");
          if (photoBadge) {
            photoBadge.textContent = "1 required (max 3)";
            photoBadge.className = "rounded-full bg-[#164f38]/10 px-2.5 py-0.5 text-xs font-bold text-[#164f38]";
          }
          if (photoHint) {
            photoHint.textContent = "Upload clear photos so the owner can identify it. Compressed automatically for crisp, fast display.";
          }
        } else {
          typeInput.value = "lost";
          lostChoice.classList.add("border-[#164f38]", "bg-[#d8ef8c]/25");
          lostChoice.classList.remove("border-stone-200/90", "bg-white");
          const lostCheck = lostChoice.querySelector(".choice-check");
          if (lostCheck) {
            lostCheck.classList.remove("hidden");
            lostCheck.classList.add("flex");
          }

          foundChoice.classList.remove("border-[#164f38]", "bg-[#164f38]/5");
          foundChoice.classList.add("border-stone-200/90", "bg-white");
          const foundCheck = foundChoice.querySelector(".choice-check");
          if (foundCheck) {
            foundCheck.classList.add("hidden");
            foundCheck.classList.remove("flex");
          }

          if (photoStar) photoStar.classList.add("hidden");
          if (photoBadge) {
            photoBadge.textContent = "Optional (max 3)";
            photoBadge.className = "rounded-full bg-stone-100 px-2.5 py-0.5 text-xs font-bold text-stone-600";
          }
          if (photoHint) {
            photoHint.textContent = "Optional: Add reference photos if you have them. Photos are compressed for quick display.";
          }
        }

        const successMsg = document.getElementById("report-success-msg");
        if (successMsg) successMsg.classList.add("hidden");
        const form = document.getElementById("quick-report-form");
        if (form) form.classList.remove("hidden");

        reportModal.classList.remove("hidden");
        reportModal.classList.add("flex");
      }

      function hideReportModal() {
        if (!reportModal) return;
        reportModal.classList.add("hidden");
        reportModal.classList.remove("flex");
      }

      document.querySelectorAll("[data-open-report]").forEach((btn) => {
        btn.addEventListener("click", () => openReport(btn.dataset.openReport));
      });

      const topPostBtn = document.getElementById("top-post-item-btn");
      if (topPostBtn) topPostBtn.addEventListener("click", () => openReport("found"));

      const foundChoice = document.getElementById("report-choice-found");
      if (foundChoice) foundChoice.addEventListener("click", () => openReport("found"));

      const lostChoice = document.getElementById("report-choice-lost");
      if (lostChoice) lostChoice.addEventListener("click", () => openReport("lost"));

      window.openReport = openReport;

      // Handle ?report=found, ?report=lost, or ?search=... from external links / other pages
      try {
        const urlParams = new URLSearchParams(window.location.search);
        const reportParam = urlParams.get("report");
        if (reportParam === "found" || reportParam === "lost") {
          openReport(reportParam);
        }
        const searchParam = urlParams.get("search");
        if (searchParam && searchInput) {
          searchInput.value = searchParam;
          searchQuery = searchParam;
          updateGrid();
          maybeScrollOnSearch(searchParam);
        }
      } catch (e) {}

      if (closeReportModal) closeReportModal.addEventListener("click", hideReportModal);
      if (cancelReportBtn) cancelReportBtn.addEventListener("click", hideReportModal);

      // Handle Post Report Submission with Real Supabase Storage Upload & Feed Update
      window.handleReportSubmit = async function () {
        const typeInput = document.getElementById("report-type-val");
        const reportType = typeInput ? typeInput.value : "found";
        const photos = window.reportUploadedPhotos || [];
        const validationError = document.getElementById("photo-validation-error");

        // VALIDATION RULE:
        // Found items MUST have 1 to 3 photos! Cannot post without validation.
        // Lost items: Photos are optional (0 to 3).
        if (reportType === "found" && photos.length < 1) {
          if (validationError) {
            validationError.classList.remove("hidden");
            const dropzone = document.getElementById("photo-dropzone");
            if (dropzone) dropzone.scrollIntoView({ behavior: "smooth", block: "nearest" });
          }
          return; // Block submission!
        }

        const nameInput = document.getElementById("report-name");
        const catSelect = document.getElementById("report-category");
        const locSelect = document.getElementById("report-location");
        const otherInput = document.getElementById("report-location-other");
        const descInput = document.getElementById("report-desc");

        const submitBtn = document.getElementById("report-submit-btn");
        const submitBtnText = document.getElementById("report-submit-btn-text");
        const submitBtnSpinner = document.getElementById("report-submit-btn-spinner");

        // Set Loading state
        if (submitBtn) submitBtn.disabled = true;
        if (submitBtnSpinner) submitBtnSpinner.classList.remove("hidden");
        if (submitBtnText) {
          submitBtnText.textContent = photos.length > 0 ? "Uploading to Cloud Storage..." : "Posting report...";
        }

        const itemName = nameInput ? nameInput.value.trim() : "Reported Item";
        const itemCategory = catSelect ? catSelect.value : "Personal Care & Miscellaneous";
        const itemLocation = (locSelect && locSelect.value === "__other__")
          ? (otherInput ? otherInput.value.trim() : "Campus")
          : (locSelect ? locSelect.value : "Campus");
        const itemDesc = descInput ? descInput.value.trim() : "";
        const locationPrefix = reportType === "found" ? "Found at" : "Last seen at";
        const actionLabel = reportType === "found" ? "Claim this item" : "I found this";
        let refCode = reportType === "found" ? `LL-${Math.floor(4000 + Math.random() * 900)}` : "";
        let itemId = `item-${Date.now()}`;
        const currentDate = "Just now";

        // Step 1: Upload Photos to Supabase Storage Bucket
        let finalPhotoUrls = photos;
        if (photos.length > 0) {
          try {
            const uploadRes = await fetch("/api/upload", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ images: photos }),
            });
            if (uploadRes.ok) {
              const uploadJson = await uploadRes.json();
              if (uploadJson.urls && uploadJson.urls.length > 0) {
                finalPhotoUrls = uploadJson.urls;
              }
            } else {
              const errJson = await uploadRes.json().catch(() => ({}));
              console.warn("[upload] Storage API response:", errJson);
            }
          } catch (uploadErr) {
            console.warn("[upload] Storage fetch failed, using local preview:", uploadErr);
          }
        }

        // Step 2: Persist Item to Database
        if (submitBtnText) submitBtnText.textContent = "Saving report...";
        try {
          const itemRes = await fetch("/api/items", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              type: reportType,
              name: itemName,
              category: itemCategory,
              location: itemLocation,
              description: itemDesc,
              photoUrls: finalPhotoUrls,
            }),
          });
          const itemJson = await itemRes.json().catch(() => ({}));

          if (itemRes.ok && itemJson.item) {
            itemId = itemJson.item.id;
            if (itemJson.item.reference_code) {
              refCode = itemJson.item.reference_code;
            }
          } else {
            const errorMsg = itemJson.error || "Could not save report. Please check your inputs.";
            const valError = document.getElementById("photo-validation-error");
            if (valError) {
              const textSpan = valError.querySelector("span");
              if (textSpan) textSpan.textContent = errorMsg;
              else valError.textContent = errorMsg;
              valError.classList.remove("hidden");
            }
            if (typeof window.llToast === "function") {
              window.llToast(errorMsg, "error");
            } else {
              alert(errorMsg);
            }
            if (submitBtn) submitBtn.disabled = false;
            if (submitBtnSpinner) submitBtnSpinner.classList.add("hidden");
            if (submitBtnText) submitBtnText.textContent = "Submit Report";
            return;
          }
        } catch (itemErr) {
          console.warn("[items] Database save notice:", itemErr);
          const errorMsg = "Network error saving report. Please try again.";
          const valError = document.getElementById("photo-validation-error");
          if (valError) {
            const textSpan = valError.querySelector("span");
            if (textSpan) textSpan.textContent = errorMsg;
            else valError.textContent = errorMsg;
            valError.classList.remove("hidden");
          }
          if (submitBtn) submitBtn.disabled = false;
          if (submitBtnSpinner) submitBtnSpinner.classList.add("hidden");
          if (submitBtnText) submitBtnText.textContent = "Submit Report";
          return;
        }

        // Build newly created card DOM with confirmed photo URLs
        const newCard = document.createElement("article");
        newCard.className = "item-card group relative flex flex-col justify-between overflow-hidden rounded-card border border-line/80 bg-white shadow-2xs transition-all duration-200 hover:-translate-y-1 hover:shadow-card cursor-pointer";
        newCard.dataset.itemId = itemId;
        newCard.dataset.itemType = reportType;
        newCard.dataset.itemCategory = itemCategory;
        newCard.dataset.itemLocation = itemLocation;
        newCard.dataset.itemName = itemName;
        newCard.dataset.itemDesc = itemDesc;
        newCard.dataset.itemDate = currentDate;
        newCard.dataset.itemAction = actionLabel;
        newCard.dataset.itemRef = refCode;
        newCard.dataset.itemImages = JSON.stringify(finalPhotoUrls);

        // Build top graphic area with photos / slider or illustration
        let topGraphicHtml = "";
        const statusBadge = `
          <span class="absolute left-4 top-4 z-20 rounded-full px-3.5 py-1 text-xs font-bold uppercase tracking-wider ${
            reportType === "found"
              ? "bg-forest-700 text-white shadow-xs"
              : "bg-[#d8ef8c] text-forest-900 border border-lime-600/30 shadow-xs"
          }">
            ${reportType.toUpperCase()}
          </span>
        `;

        if (finalPhotoUrls.length > 0) {
          const slidesHtml = finalPhotoUrls.map((src, i) => `
            <div class="slider-slide relative h-full w-full shrink-0 bg-stone-900/5">
              <img src="${src}" alt="${itemName} - Photo ${i + 1}" loading="lazy" class="h-full w-full object-cover" />
            </div>
          `).join("");

          const sliderControls = finalPhotoUrls.length > 1 ? `
            <button type="button" class="slider-prev absolute left-2.5 top-1/2 -translate-y-1/2 z-20 flex size-10 items-center justify-center rounded-full border border-line/60 bg-white/95 text-forest-900 shadow-2xs backdrop-blur-xs transition-all after:absolute after:-inset-0.5 after:rounded-full after:content-[''] hover:border-forest-700 hover:bg-forest-700 hover:text-white active:scale-95 cursor-pointer" aria-label="Previous photo" title="Previous photo">
              <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
            </button>
            <button type="button" class="slider-next absolute right-2.5 top-1/2 -translate-y-1/2 z-20 flex size-10 items-center justify-center rounded-full border border-line/60 bg-white/95 text-forest-900 shadow-2xs backdrop-blur-xs transition-all after:absolute after:-inset-0.5 after:rounded-full after:content-[''] hover:border-forest-700 hover:bg-forest-700 hover:text-white active:scale-95 cursor-pointer" aria-label="Next photo" title="Next photo">
              <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
            </button>
            <div class="slider-badge absolute bottom-3 right-3 z-20 rounded-full border border-line/60 bg-white/95 px-2.5 py-1 text-xs font-bold text-forest-900 shadow-2xs backdrop-blur-xs">
              <span class="current-slide-idx text-forest-700">1</span><span class="font-medium text-stone-500">/${finalPhotoUrls.length}</span>
            </div>
          ` : "";

          topGraphicHtml = `
            <div class="relative flex h-48 sm:h-52 lg:h-56 w-full items-center justify-center overflow-hidden bg-stone-100">
              ${statusBadge}
              <div class="card-slider relative h-full w-full overflow-hidden" data-images-count="${finalPhotoUrls.length}" data-current-idx="0">
                <div class="slider-track flex h-full w-full transition-transform duration-300 ease-out">
                  ${slidesHtml}
                </div>
                ${sliderControls}
              </div>
            </div>
          `;
        } else {
          topGraphicHtml = `
            <div class="relative flex h-48 sm:h-52 lg:h-56 w-full items-center justify-center overflow-hidden transition-colors" style="background-color: #dee8e0;">
              ${statusBadge}
              <div class="flex size-16 items-center justify-center rounded-full bg-forest-700/10 text-forest-700">
                <svg class="size-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                </svg>
              </div>
            </div>
          `;
        }

        // Escape user text to prevent XSS injection
        const safeCategory = String(itemCategory || "").replace(/[&<>"']/g, (m) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[m]);
        const safeName = String(itemName || "").replace(/[&<>"']/g, (m) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[m]);
        const safeLocation = String(itemLocation || "").replace(/[&<>"']/g, (m) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[m]);
        const safeLocationPrefix = String(locationPrefix || "").replace(/[&<>"']/g, (m) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[m]);
        const safeDate = String(currentDate || "").replace(/[&<>"']/g, (m) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[m]);
        const safeActionLabel = String(actionLabel || "").replace(/[&<>"']/g, (m) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[m]);

        newCard.innerHTML = `
          ${topGraphicHtml}
          <div class="flex flex-1 flex-col justify-between bg-white p-5 sm:p-6">
            <div>
              <p class="text-xs font-bold uppercase tracking-wider text-stone-500">${safeCategory}</p>
              <h3 class="mt-1 text-base sm:text-lg lg:text-xl font-bold tracking-tight text-forest-900 line-clamp-1">${safeName}</h3>
            </div>
            <div class="mt-5 flex items-end justify-between gap-3">
              <div class="min-w-0 flex-1">
                <p class="text-xs font-medium leading-none text-stone-400">${safeLocationPrefix}</p>
                <p class="mt-1.5 text-sm sm:text-base font-bold text-forest-900 line-clamp-1">${safeLocation}</p>
              </div>
              <p class="shrink-0 whitespace-nowrap font-serif text-xl sm:text-2xl font-black leading-none text-forest-900">${safeDate}</p>
            </div>
            <div class="mt-4 flex items-center justify-between border-t border-line/60 pt-4 text-sm font-bold text-forest-900 group-hover:text-forest-700">
              <span>${safeActionLabel}</span>
              <span class="transition-transform group-hover:translate-x-1.5" aria-hidden="true">→</span>
            </div>
          </div>
        `;

        // Prepend to items grid so it immediately appears in "Latest on campus"
        if (itemsGrid) {
          itemsGrid.prepend(newCard);
        }

        // Update counts
        const allCards = document.querySelectorAll(".item-card:not(.hidden)");
        const totalCards = document.querySelectorAll(".item-card");
        if (counterBadge) counterBadge.textContent = String(totalCards.length);
        if (feedSubtitle) {
          feedSubtitle.textContent = `Showing ${allCards.length} of ${totalCards.length} items, newest first.`;
        }

        // Reset submit button state
        if (submitBtn) submitBtn.disabled = false;
        if (submitBtnSpinner) submitBtnSpinner.classList.add("hidden");
        if (submitBtnText) submitBtnText.textContent = "Submit Report";

        // Reset form & photos
        const form = document.getElementById("quick-report-form");
        if (form) {
          form.reset();
          form.classList.add("hidden");
        }
        if (window.resetReportPhotos) window.resetReportPhotos();

        // Show success confirmation
        const successMsg = document.getElementById("report-success-msg");
        if (successMsg) successMsg.classList.remove("hidden");

        // Show the reference code with a copy button so the reporter can save
        // the tag code they must write on the item before turning it in.
        const refRow = document.getElementById("report-success-ref");
        const refCodeEl = document.getElementById("report-success-ref-code");
        const copyRefBtn = document.getElementById("report-copy-ref-btn");
        const hasRef = reportType === "found" && refCode;
        if (refRow) refRow.classList.toggle("hidden", !hasRef);
        if (hasRef && refCodeEl) refCodeEl.textContent = refCode;

        if (copyRefBtn) {
          copyRefBtn.onclick = async () => {
            try {
              await navigator.clipboard.writeText(refCode);
              const tooltip = copyRefBtn.querySelector(".copy-ref-tooltip");
              const copyLabel = copyRefBtn.querySelector(".copy-label");
              if (tooltip) tooltip.classList.add("visible");
              if (copyLabel) copyLabel.textContent = "Copied!";
              showToast("Reference code " + refCode + " copied!", "success");
              setTimeout(() => {
                if (tooltip) tooltip.classList.remove("visible");
                if (copyLabel) copyLabel.textContent = "Copy";
              }, 2000);
            } catch (err) {
              console.warn("Clipboard copy failed:", err);
              showToast("Copy failed. Code: " + refCode, "error");
            }
          };
        }

        showToast("Report posted to Campus Feed! Ref: " + refCode, "success");

        // Give the reporter time to read and copy the code before auto-closing.
        setTimeout(hideReportModal, hasRef ? 6000 : 1600);
      };

      // Parse search from URL params if arriving from another page
      const urlParams = new URLSearchParams(window.location.search);
      const urlSearch = urlParams.get("search");
      if (urlSearch && searchInput) {
        searchInput.value = urlSearch;
        searchInput.dispatchEvent(new Event("input"));
      }
    })();
  </script>
</Base>