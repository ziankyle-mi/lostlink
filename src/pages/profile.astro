---
import { actions } from "astro:actions";
import Base from "~/layouts/Base.astro";
import StudentNavbar from "~/components/StudentNavbar.astro";
import DashboardFooter from "~/components/DashboardFooter.astro";

// The middleware redirects unauthenticated visitors to /login.
const user = Astro.locals.user;

const logoutResult = Astro.getActionResult(actions.logout);
if (logoutResult && !logoutResult.error && logoutResult.data?.redirect) {
  return Astro.redirect(logoutResult.data.redirect, 302);
}

function initialsOf(email: string): string {
  const segments = email.split("@")[0].split(/[._-]/).filter(Boolean);
  if (segments.length >= 2) return (segments[0][0] + segments[1][0]).toUpperCase();
  if (segments.length === 1 && segments[0].length >= 2) return segments[0].slice(0, 2).toUpperCase();
  return "MR";
}

const email = user?.email ?? "";
---

<Base title="Profile | LostLink" description="Your LostLink profile, reports, and claims.">
  <div class="min-h-screen bg-canvas text-forest-900 flex flex-col justify-between">
    <div>
      <StudentNavbar userEmail={email || undefined} />

      <main class="mx-auto w-full max-w-7xl px-5 py-10 sm:px-10 lg:px-14">
        <h1 class="font-serif text-3xl sm:text-4xl font-black text-ink">Profile</h1>

        <!-- Account card -->
        <section class="mt-6 rounded-card border border-line/70 bg-white p-6 sm:p-8 shadow-card">
          <div class="flex items-center gap-4">
            <span
              class="flex size-14 shrink-0 items-center justify-center rounded-full border border-lime-600/30 bg-lime text-lg font-black text-forest-900"
            >
              {initialsOf(email)}
            </span>
            <div class="min-w-0">
              <p class="truncate text-base font-bold text-forest-900" title={email}>
                {email || "Signed out"}
              </p>
              <span class="mt-1 inline-block rounded-full bg-forest-700/10 px-2.5 py-0.5 text-xs font-semibold text-forest-900">
                DLSAU Student
              </span>
            </div>
          </div>
        </section>

        <!-- My Reports -->
        <section class="mt-8">
          <h2 class="text-lg font-bold text-forest-900">My Reports</h2>
          <div class="mt-3 rounded-card border border-line/70 bg-white p-8 text-center shadow-2xs">
            <p class="text-sm font-semibold text-forest-900">No reports yet</p>
            <p class="mt-1 text-sm text-sage-600">
              Items you lose or find will appear here once you post them.
            </p>
            <a
              href="/"
              class="mt-4 inline-flex min-h-10 items-center rounded-control bg-forest-700 px-6 py-2 text-sm font-semibold text-white hover:bg-forest-900 transition-colors"
            >
              Post an item
            </a>
          </div>
        </section>

        <!-- My Claims -->
        <section class="mt-8">
          <h2 class="text-lg font-bold text-forest-900">My Claims</h2>
          <div class="mt-3 rounded-card border border-line/70 bg-white p-8 text-center shadow-2xs">
            <p class="text-sm font-semibold text-forest-900">No claims yet</p>
            <p class="mt-1 text-sm text-sage-600">
              Claims you submit for found items will appear here with their status.
            </p>
          </div>
        </section>
      </main>
    </div>

    <DashboardFooter />
  </div>
</Base>
