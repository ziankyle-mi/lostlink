---
import Base from "~/layouts/Base.astro";
import StudentNavbar from "~/components/StudentNavbar.astro";
import { roleForEmail } from "~/lib/session";
import { createClient } from "@supabase/supabase-js";
import { readEnv } from "~/lib/env";

// Middleware protects this route, but fallback guard ensures user exists
const user = Astro.locals.user;
if (!user) {
  return Astro.redirect("/login", 302);
}

const userEmail = user.email || "student@dlsau.edu.ph";
const isUserAdmin = user.role === "admin" || roleForEmail(userEmail) === "admin";

function initialsOf(emailStr: string): string {
  const segments = emailStr.split("@")[0].split(/[._-]/).filter(Boolean);
  if (segments.length >= 2) return (segments[0][0] + segments[1][0]).toUpperCase();
  if (segments.length === 1 && segments[0].length >= 2) return segments[0].slice(0, 2).toUpperCase();
  return "ST";
}

const env = readEnv();
let myReports: any[] = [];
let myClaims: any[] = [];
let profileName = userEmail.split("@")[0].replace(/[._]/g, " ");

if (env.PUBLIC_SUPABASE_URL && (env.SUPABASE_SERVICE_ROLE_KEY || env.PUBLIC_SUPABASE_ANON_KEY)) {
  try {
    const supabase = createClient(
      env.PUBLIC_SUPABASE_URL,
      env.SUPABASE_SERVICE_ROLE_KEY || env.PUBLIC_SUPABASE_ANON_KEY,
      { auth: { persistSession: false } }
    );

    // 1. Resolve Profile ID
    const { data: profile } = await supabase
      .from("profiles")
      .select("id, full_name, email, role")
      .eq("email", userEmail.toLowerCase().trim())
      .maybeSingle();

    const profileId = profile?.id || user.id;
    if (profile?.full_name) profileName = profile.full_name;

    // 2. Fetch My Reported Items
    if (profileId) {
      const { data: reports } = await supabase
        .from("items")
        .select("*")
        .eq("reporter_id", profileId)
        .order("created_at", { ascending: false });

      if (reports) myReports = reports;

      // 3. Fetch My Submitted Claims
      const { data: claims } = await supabase
        .from("claims")
        .select(`
          id,
          item_id,
          proof_description,
          status,
          created_at,
          items (
            id,
            name,
            type,
            category,
            location,
            reference_code,
            status,
            photo_path
          )
        `)
        .eq("claimant_id", profileId)
        .order("created_at", { ascending: false });

      if (claims) myClaims = claims;
    }
  } catch (err) {
    console.warn("[profile] Data fetch note:", err);
  }
}

const totalReports = myReports.length;
const activeReports = myReports.filter((r) => r.status === "pending" || r.status === "approved").length;
const totalClaims = myClaims.length;

function parsePhotos(photoPath?: string | null): string[] {
  if (!photoPath) return [];
  try {
    if (photoPath.startsWith("[")) return JSON.parse(photoPath);
    return [photoPath];
  } catch {
    return [photoPath];
  }
}
---

<Base
  title="My Activity | LostLink"
  description="Track your reported lost & found items and active claims at De La Salle Araneta University."
>
  <div class="min-h-screen bg-[#f5f1e6] text-[#082e1a] flex flex-col justify-between selection:bg-[#d8ef8c]">
    <div>
      <!-- Top Navbar -->
      <StudentNavbar userEmail={userEmail} />

      <!-- Main Container -->
      <main class="mx-auto w-full max-w-6xl px-4 py-6 sm:px-6 sm:py-8 lg:px-8 space-y-8">
        <!-- Student Header Card -->
        <div class="rounded-3xl border border-stone-200/80 bg-white p-6 sm:p-8 shadow-xs flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
          <div class="flex items-center gap-4 sm:gap-5">
            <span class="flex size-14 sm:size-16 items-center justify-center rounded-2xl bg-forest-900 text-lg sm:text-xl font-black text-[#d8ef8c] shadow-xs">
              {initialsOf(userEmail)}
            </span>
            <div>
              <div class="flex items-center gap-2.5 flex-wrap">
                <h1 class="text-xl sm:text-2xl font-black text-forest-900 capitalize leading-tight">
                  {profileName}
                </h1>
                <span class="rounded-full bg-forest-700/10 px-2.5 py-0.5 text-xs font-bold text-forest-800">
                  {isUserAdmin ? "Security Office Staff" : "DLSAU Student / Faculty"}
                </span>
              </div>
              <p class="mt-1 text-xs sm:text-sm text-stone-500 font-medium">
                {userEmail}
              </p>
            </div>
          </div>

          <!-- Quick Actions -->
          <div class="flex items-center gap-3 w-full sm:w-auto">
            <a
              href="/"
              class="flex-1 sm:flex-none text-center rounded-full border border-stone-200 bg-stone-50 px-4 py-2.5 text-xs sm:text-sm font-bold text-forest-900 hover:bg-stone-100 transition-colors cursor-pointer"
            >
              Campus Feed
            </a>
            {isUserAdmin && (
              <a
                href="/admin"
                class="flex-1 sm:flex-none text-center rounded-full bg-forest-900 px-4 py-2.5 text-xs sm:text-sm font-bold text-[#d8ef8c] hover:bg-forest-800 transition-colors shadow-xs cursor-pointer"
              >
                Admin Console &rarr;
              </a>
            )}
          </div>
        </div>

        <!-- 3 Quick KPI Stat Counters -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div class="rounded-2xl border border-stone-200/80 bg-white p-5 shadow-2xs">
            <p class="text-xs font-bold text-stone-500 uppercase tracking-wider">Total Items Reported</p>
            <p class="mt-2 font-serif text-3xl font-black text-forest-900">{totalReports}</p>
          </div>
          <div class="rounded-2xl border border-stone-200/80 bg-white p-5 shadow-2xs">
            <p class="text-xs font-bold text-stone-500 uppercase tracking-wider">Active Reports</p>
            <p class="mt-2 font-serif text-3xl font-black text-amber-700">{activeReports}</p>
          </div>
          <div class="rounded-2xl border border-stone-200/80 bg-white p-5 shadow-2xs">
            <p class="text-xs font-bold text-stone-500 uppercase tracking-wider">Claims Submitted</p>
            <p class="mt-2 font-serif text-3xl font-black text-forest-700">{totalClaims}</p>
          </div>
        </div>

        <!-- Section 1: My Reported Items -->
        <section class="space-y-4">
          <div class="flex items-center justify-between gap-4">
            <div>
              <h2 class="text-xl sm:text-2xl font-black text-forest-900">
                Items I Reported
              </h2>
              <p class="text-xs sm:text-sm text-stone-500">
                Track status, administrative verification, and handover for items you reported.
              </p>
            </div>
            <a
              href="/"
              class="inline-flex items-center gap-1.5 rounded-full bg-forest-900 px-4 py-2 text-xs font-bold text-white shadow-xs hover:bg-forest-800 transition-colors"
            >
              <span>+ Post an item</span>
            </a>
          </div>

          {myReports.length === 0 ? (
            <div class="rounded-3xl border border-dashed border-stone-300 bg-white/60 p-10 text-center">
              <div class="mx-auto flex size-12 items-center justify-center rounded-full bg-stone-100 text-stone-400">
                <svg class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" />
                </svg>
              </div>
              <h3 class="mt-3 text-base font-bold text-forest-900">No reports submitted yet</h3>
              <p class="mt-1 text-xs text-stone-500 max-w-sm mx-auto">
                Lost an item or found someone else's property on campus? Post a report to alert the community.
              </p>
              <a
                href="/"
                class="mt-4 inline-block rounded-full bg-forest-900 px-5 py-2 text-xs font-bold text-[#d8ef8c] hover:bg-forest-800 transition-colors"
              >
                Go to Feed & Report
              </a>
            </div>
          ) : (
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
              {myReports.map((item) => {
                const photos = parsePhotos(item.photo_path);
                const hasPhoto = photos.length > 0;
                return (
                  <article class="flex flex-col justify-between rounded-2xl border border-stone-200 bg-white p-5 shadow-2xs hover:shadow-card transition-shadow">
                    <div>
                      <div class="flex items-center justify-between gap-2 mb-3">
                        <span class={`rounded-full px-2.5 py-0.5 text-[11px] font-bold uppercase tracking-wider ${
                          item.type === "found" ? "bg-forest-700 text-white" : "bg-[#d8ef8c] text-forest-900"
                        }`}>
                          {item.type}
                        </span>

                        <span class={`rounded-full px-2.5 py-0.5 text-[11px] font-bold ${
                          item.status === "approved"
                            ? "bg-emerald-100 text-emerald-800 border border-emerald-300"
                            : item.status === "pending"
                              ? "bg-amber-100 text-amber-800 border border-amber-300"
                              : item.status === "claimed" || item.status === "resolved"
                                ? "bg-blue-100 text-blue-800 border border-blue-300"
                                : "bg-rose-100 text-rose-800 border border-rose-300"
                        }`}>
                          {item.status.toUpperCase()}
                        </span>
                      </div>

                      {hasPhoto && (
                        <div class="mb-3.5 h-36 w-full overflow-hidden rounded-xl bg-stone-100 border border-stone-200">
                          <img src={photos[0]} alt={item.name} class="h-full w-full object-cover" loading="lazy" />
                        </div>
                      )}

                      <h3 class="font-bold text-base text-forest-900 line-clamp-1">
                        {item.name}
                      </h3>
                      <p class="text-xs text-stone-500 mt-0.5">
                        {item.category} &bull; {item.location}
                      </p>

                      {item.reference_code && (
                        <div class="mt-3 inline-flex items-center gap-1.5 rounded-lg bg-stone-100 px-2.5 py-1 text-xs font-mono font-bold text-forest-800">
                          <span>Tag: {item.reference_code}</span>
                          <button
                            type="button"
                            class="copy-ref-btn p-0.5 text-forest-900/70 hover:text-forest-900"
                            data-copy-ref={item.reference_code}
                            title="Copy tag code"
                            aria-label="Copy tag code"
                          >
                            <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                            </svg>
                            <span class="copy-ref-tooltip">Copied!</span>
                          </button>
                        </div>
                      )}

                      {item.status === "pending" && item.type === "found" && (
                        <p class="mt-2.5 text-xs text-amber-800 bg-amber-50 rounded-lg p-2 border border-amber-200">
                          &bull; Please drop this item off at the Security Office with tag code.
                        </p>
                      )}

                      {item.status === "rejected" && item.reject_reason && (
                        <p class="mt-2.5 text-xs text-rose-800 bg-rose-50 rounded-lg p-2 border border-rose-200">
                          Reason: {item.reject_reason}
                        </p>
                      )}
                    </div>

                    <div class="mt-4 pt-3 border-t border-stone-100 flex items-center justify-between text-xs">
                      <span class="text-stone-400 font-medium">
                        {item.event_date || (item.created_at ? item.created_at.split("T")[0] : "Recently")}
                      </span>
                      <a
                        href={`/item/${item.id}`}
                        class="font-bold text-forest-900 hover:text-forest-700 underline"
                      >
                        View details &rarr;
                      </a>
                    </div>
                  </article>
                );
              })}
            </div>
          )}
        </section>

        <!-- Section 2: My Submitted Claims -->
        <section class="space-y-4 pt-4 border-t border-stone-200/80">
          <div>
            <h2 class="text-xl sm:text-2xl font-black text-forest-900">
              My Submitted Claims
            </h2>
            <p class="text-xs sm:text-sm text-stone-500">
              Ownership verification requests you have submitted to the Security Office.
            </p>
          </div>

          {myClaims.length === 0 ? (
            <div class="rounded-3xl border border-dashed border-stone-300 bg-white/60 p-10 text-center">
              <div class="mx-auto flex size-12 items-center justify-center rounded-full bg-stone-100 text-stone-400">
                <svg class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <h3 class="mt-3 text-base font-bold text-forest-900">No claims submitted</h3>
              <p class="mt-1 text-xs text-stone-500 max-w-sm mx-auto">
                Spotted your lost item on the feed? Click "Claim this item" and submit unique identifying proof.
              </p>
              <a
                href="/"
                class="mt-4 inline-block rounded-full bg-forest-900 px-5 py-2 text-xs font-bold text-[#d8ef8c] hover:bg-forest-800 transition-colors"
              >
                Browse Campus Feed
              </a>
            </div>
          ) : (
            <div class="space-y-3">
              {myClaims.map((claim) => {
                const targetItem = claim.items;
                return (
                  <div class="rounded-2xl border border-stone-200 bg-white p-5 shadow-2xs flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div class="space-y-1.5 flex-1 min-w-0">
                      <div class="flex items-center gap-2.5 flex-wrap">
                        <h4 class="font-bold text-base text-forest-900">
                          {targetItem?.name || "Item Claim"}
                        </h4>
                        {targetItem?.reference_code && (
                          <span class="inline-flex items-center gap-1 rounded bg-stone-100 px-2 py-0.5 text-xs font-mono font-bold text-stone-600">
                            <span>{targetItem.reference_code}</span>
                            <button
                              type="button"
                              class="copy-ref-btn p-0.5 text-forest-900/70 hover:text-forest-900"
                              data-copy-ref={targetItem.reference_code}
                              title="Copy reference code"
                              aria-label="Copy reference code"
                            >
                              <svg class="size-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                              </svg>
                              <span class="copy-ref-tooltip">Copied!</span>
                            </button>
                          </span>
                        )}
                        <span class={`rounded-full px-2.5 py-0.5 text-xs font-bold ${
                          claim.status === "verified"
                            ? "bg-emerald-100 text-emerald-800 border border-emerald-300"
                            : claim.status === "pending"
                              ? "bg-amber-100 text-amber-800 border border-amber-300"
                              : claim.status === "denied"
                                ? "bg-rose-100 text-rose-800 border border-rose-300"
                                : "bg-stone-100 text-stone-600"
                        }`}>
                          {claim.status === "verified"
                            ? "VERIFIED &bull; VISIT SECURITY OFFICE"
                            : claim.status === "pending"
                              ? "UNDER REVIEW"
                              : claim.status === "denied"
                                ? "DENIED"
                                : "WITHDRAWN"}
                        </span>
                      </div>

                      <p class="text-xs text-stone-600 italic bg-stone-50 p-2.5 rounded-xl border border-stone-200/60 line-clamp-2">
                        &ldquo;{claim.proof_description}&rdquo;
                      </p>

                      <p class="text-[11px] text-stone-400">
                        Submitted on {new Date(claim.created_at).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}
                      </p>
                    </div>

                    {targetItem?.id && (
                      <a
                        href={`/item/${targetItem.id}`}
                        class="shrink-0 rounded-full border border-forest-900/20 bg-forest-900/5 px-4 py-2 text-xs font-bold text-forest-900 hover:bg-forest-900/10 text-center transition-colors"
                      >
                        View Item &rarr;
                      </a>
                    )}
                  </div>
                );
              })}
            </div>
          )}
        </section>
      </main>
    </div>

    <!-- Campus Footer -->
    <footer class="mt-14 border-t border-stone-200/70 bg-[#ece5d6]/70 py-6 text-center text-xs text-stone-500">
      <div class="mx-auto max-w-6xl px-4 flex flex-col sm:flex-row items-center justify-between gap-3">
        <p>&copy; {new Date().getFullYear()} LostLink &bull; De La Salle Araneta University</p>
        <div class="flex items-center gap-4 font-semibold text-forest-900">
          <a href="/" class="hover:underline">Campus Feed</a>
          <a href="/help" class="hover:underline">Guidelines</a>
          <a href="/privacy" class="hover:underline">Privacy</a>
        </div>
      </div>
    </footer>
  </div>

  <script>
    document.addEventListener("click", async (e) => {
      const btn = (e.target as HTMLElement).closest("[data-copy-ref]");
      if (!btn) return;
      const ref = btn.getAttribute("data-copy-ref");
      if (!ref) return;

      try {
        await navigator.clipboard.writeText(ref);
        const tooltip = btn.querySelector(".copy-ref-tooltip");
        if (tooltip) tooltip.classList.add("visible");
        if ((window as any).llToast) {
          (window as any).llToast(`Reference code ${ref} copied!`, "success");
        }
        setTimeout(() => {
          if (tooltip) tooltip.classList.remove("visible");
        }, 2000);
      } catch (err) {
        console.warn("Clipboard copy failed:", err);
      }
    });
  </script>
</Base>
