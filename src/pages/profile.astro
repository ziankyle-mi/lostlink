---
import { actions } from "astro:actions";
import Base from "~/layouts/Base.astro";
import StudentNavbar from "~/components/StudentNavbar.astro";
import DashboardFooter from "~/components/DashboardFooter.astro";
import Icon from "~/components/Icon.astro";
import { createFastClient, isFallbackUser, isHostInUnreachableCooldown } from "~/lib/supabase";
import { readEnv } from "~/lib/env";
import { ACCESS_COOKIE } from "~/lib/auth";
import { devBypassEnabled } from "~/lib/session";
import {
  DEMO_CLAIMS_COOKIE,
  DEMO_ITEMS_COOKIE,
  getMergedDemoItems,
  parseDemoClaims,
} from "~/data/demoStore";
import { photoPathsFromColumn, signPhotoPaths } from "~/lib/storage";
import { DEGREE_PROGRAMS, enrichCampusUser } from "~/data/campusPrograms";
import {
  DEMO_REGISTERED_COOKIE,
  INITIAL_CAMPUS_USERS,
  getCombinedDemoRegisteredUsers,
} from "~/data/mockUsers";

const logoutResult = Astro.getActionResult(actions.logout);
if (logoutResult && !logoutResult.error && logoutResult.data?.redirect) {
  return Astro.redirect(logoutResult.data.redirect, 302);
}

// Middleware protects this route, but fallback guard ensures user exists
const user = Astro.locals.user;
if (!user) {
  return Astro.redirect("/login", 302);
}

const userEmail = user.email || "student@dlsau.edu.ph";
let isUserAdmin = user.role === "admin";

function initialsOf(emailStr: string): string {
  const segments = emailStr.split("@")[0].split(/[._-]/).filter(Boolean);
  if (segments.length >= 2) return (segments[0][0] + segments[1][0]).toUpperCase();
  if (segments.length === 1 && segments[0].length >= 2) return segments[0].slice(0, 2).toUpperCase();
  return "ST";
}

const today = new Date();
const dateEyebrow = today.toLocaleDateString("en-US", {
  weekday: "long",
  month: "long",
  day: "numeric",
}).toUpperCase();

const env = Astro.locals.env || readEnv();
let myReports: any[] = [];
let myClaims: any[] = [];
let recentLogins: any[] = [];
let profileName = userEmail.split("@")[0].replace(/[._]/g, " ");
let userProgramCode: string | undefined = undefined;
let userStudentId: string | undefined = undefined;
let userYearLevel: string | undefined = undefined;

const accessToken = Astro.cookies.get(ACCESS_COOKIE)?.value;
const useDemoFallback =
  devBypassEnabled(env) ||
  isFallbackUser(user, accessToken) ||
  isHostInUnreachableCooldown(env.PUBLIC_SUPABASE_URL);

if (!useDemoFallback && env.PUBLIC_SUPABASE_URL && env.SUPABASE_SERVICE_ROLE_KEY) {
  try {
    const supabase = createFastClient(
      env.PUBLIC_SUPABASE_URL,
      env.SUPABASE_SERVICE_ROLE_KEY,
    );

    // 1. Resolve Profile ID
    const { data: profile } = await supabase
      .from("profiles")
      .select("*")
      .eq("email", userEmail.toLowerCase().trim())
      .maybeSingle();

    const profileId = profile?.id || user.id;
    if (profile?.role === "admin") isUserAdmin = true;
    if (profile?.full_name) profileName = profile.full_name;
    if (profile?.program) userProgramCode = profile.program;
    if (profile?.student_id) userStudentId = profile.student_id;
    if (profile?.year_level) userYearLevel = profile.year_level;

    // 2. Fetch My Reported Items
    if (profileId) {
      const { data: reports } = await supabase
        .from("items")
        .select("*")
        .eq("reporter_id", profileId)
        .order("created_at", { ascending: false });

      if (reports) myReports = reports;

      // 3. Fetch My Submitted Claims
      const { data: claims } = await supabase
        .from("claims")
        .select(`
          id,
          item_id,
          proof_description,
          status,
          created_at,
          items (
            id,
            name,
            type,
            category,
            location,
            reference_code,
            status,
            photo_path
          )
        `)
        .eq("claimant_id", profileId)
        .neq("status", "withdrawn")
        .order("created_at", { ascending: false });

      if (claims) myClaims = claims;

      // 4. Fetch My Recent Login Activity
      const { data: logins } = await supabase
        .from("login_activity")
        .select("id, ip_address, device_summary, created_at, auth_method")
        .eq("user_id", profileId)
        .order("created_at", { ascending: false })
        .limit(3);

      if (logins) recentLogins = logins;
    }
  } catch (err) {
    console.warn("[profile] Data fetch note:", err);
  }
}

// Fallback to demo registered users / campus directory if profile metadata wasn't fetched from DB
if (!userProgramCode || !userStudentId) {
  const demoRegistered = getCombinedDemoRegisteredUsers(
    Astro.cookies.get(DEMO_REGISTERED_COOKIE)?.value,
  );
  const matchedDemo = [...demoRegistered, ...INITIAL_CAMPUS_USERS].find(
    (u) => u.email.toLowerCase().trim() === userEmail.toLowerCase().trim(),
  );
  const enriched = enrichCampusUser(
    matchedDemo || { id: user.id, email: userEmail, role: user.role },
  );
  if (matchedDemo?.full_name || enriched.full_name) {
    profileName = matchedDemo?.full_name || enriched.full_name;
  }
  if (!userProgramCode) userProgramCode = enriched.programCode;
  if (!userStudentId && !enriched.isFaculty) userStudentId = enriched.studentId;
  if (!userYearLevel) userYearLevel = enriched.yearLevel;
}

if (myReports.length === 0) {
  const cleanEmail = userEmail.toLowerCase().trim();
  const demoMerged = getMergedDemoItems(Astro.cookies.get(DEMO_ITEMS_COOKIE)?.value);
  myReports = demoMerged
    .filter((i) => i.reporterEmail.toLowerCase().trim() === cleanEmail)
    .map((i) => ({
      id: i.id,
      type: i.type,
      name: i.name,
      category: i.category,
      location: i.location,
      reference_code: i.referenceCode,
      status: i.status,
      reject_reason: i.rejectReason,
      photo_path: i.images?.[0] ?? null,
      created_at: i.createdAt,
    }));
}

if (myClaims.length === 0) {
  const cleanEmail = userEmail.toLowerCase().trim();
  const demoMerged = getMergedDemoItems(Astro.cookies.get(DEMO_ITEMS_COOKIE)?.value);
  const demoClaims = parseDemoClaims(Astro.cookies.get(DEMO_CLAIMS_COOKIE)?.value);
  myClaims = demoClaims
    .filter((c) => c.claimantEmail.toLowerCase().trim() === cleanEmail && c.status !== "withdrawn")
    .map((c) => {
      const matched = demoMerged.find((i) => i.id === c.itemId);
      return {
        id: c.id,
        item_id: c.itemId,
        proof_description: c.proofDescription,
        status: c.status,
        created_at: c.createdAt,
        items: {
          id: c.itemId,
          name: matched?.name ?? c.itemName,
          type: matched?.type ?? "found",
          category: matched?.category ?? "Personal Care & Miscellaneous",
          location: matched?.location ?? c.itemLocation ?? "Campus",
          reference_code: matched?.referenceCode ?? c.itemReferenceCode,
          status: matched?.status ?? "approved",
          photo_path: matched?.images?.[0] ?? null,
        },
      };
    });
}

const totalReports = myReports.length;
const activeReports = myReports.filter((r) => r.status === "pending" || r.status === "approved").length;
const totalClaims = myClaims.length;
const userProgramInfo = userProgramCode ? DEGREE_PROGRAMS[userProgramCode] : undefined;

// Sign every remote storage photo once, keeping static local paths (/items/...) intact.
const profilePhotoPaths = Array.from(
  new Set(
    myReports
      .flatMap((item) => photoPathsFromColumn(item.photo_path))
      .filter((p) => !p.startsWith("/")),
  ),
);
const profileSignedPhotos =
  !useDemoFallback && profilePhotoPaths.length > 0
    ? await signPhotoPaths(env, profilePhotoPaths)
    : [];
const photoUrlByPath = new Map(profilePhotoPaths.map((path, i) => [path, profileSignedPhotos[i]]));

function parsePhotos(photoPath?: string | null): string[] {
  return photoPathsFromColumn(photoPath)
    .map((path) => (path.startsWith("/") ? path : photoUrlByPath.get(path) ?? ""))
    .filter((url) => url.length > 0);
}
---

<Base
  title="Student Profile & Activity | LostLink"
  description="Track your reported lost & found items and active claims at De La Salle Araneta University."
>
  <div class="min-h-screen bg-canvas text-forest-900 flex flex-col justify-between selection:bg-lime">
    <div>
      <!-- Top Navbar -->
      <StudentNavbar userEmail={userEmail} userRole={isUserAdmin ? "admin" : user.role} />

      <!-- Main Container (Page frame matching UI design system) -->
      <main class="mx-auto w-full max-w-7xl px-4 sm:px-10 lg:px-14 py-8 sm:py-10 space-y-8 sm:space-y-10">
        <!-- Page Eyebrow and Heading -->
        <div class="space-y-1.5">
          <p class="text-sm font-bold tracking-[0.25em] uppercase text-forest-900/70">
            {dateEyebrow}
          </p>
          <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl font-black tracking-tight text-forest-900 leading-tight">
            Student <span class="italic font-serif font-black">Overview</span>
          </h1>
          <p class="text-sm sm:text-base text-stone-600 max-w-2xl">
            Manage your reported campus items, verification requests, and property claims across De La Salle Araneta University.
          </p>
        </div>

        <!-- Student Account Card (Section card recipe) -->
        <section class="rounded-3xl bg-white border border-stone-200/60 shadow-xs p-6 sm:p-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
          <div class="flex items-center gap-4 sm:gap-5">
            <!-- Lime Avatar matching navbar token -->
            <span class="flex size-14 sm:size-16 shrink-0 items-center justify-center rounded-full bg-lime border border-lime-600/30 text-xl sm:text-2xl font-black text-forest-900 shadow-xs">
              {initialsOf(userEmail)}
            </span>
            <div>
              <div class="flex items-center gap-2.5 flex-wrap">
                <h2 class="font-serif text-2xl sm:text-3xl font-black text-forest-900 capitalize leading-tight">
                  {profileName}
                </h2>
                <span class="rounded-full bg-forest-700/10 px-3 py-1 text-xs font-bold text-forest-900">
                  {isUserAdmin ? "Security Office Staff" : "DLSAU Student / Faculty"}
                </span>
                {userProgramInfo && (
                  <span class="rounded-full bg-lime/60 border border-lime-600/40 px-3 py-1 text-xs font-bold text-forest-900 shadow-2xs">
                    {userProgramInfo.code} &middot; {userProgramInfo.collegeCode}
                  </span>
                )}
              </div>
              <p class="mt-1 text-sm text-stone-500 font-medium flex items-center gap-2 flex-wrap">
                <span>{userEmail}</span>
                {userStudentId && (
                  <span class="rounded bg-stone-100 border border-stone-200/80 px-2 py-0.5 text-xs font-semibold text-stone-700">
                    ID: {userStudentId}
                  </span>
                )}
                {userYearLevel && (
                  <span class="rounded bg-stone-100 border border-stone-200/80 px-2 py-0.5 text-xs font-semibold text-stone-700">
                    {userYearLevel}
                  </span>
                )}
                {userProgramInfo && (
                  <span class="text-forest-900 font-semibold">&middot; {userProgramInfo.name}</span>
                )}
              </p>
            </div>
          </div>

          <!-- Quick Action Buttons -->
          <div class="flex items-center gap-3 w-full md:w-auto flex-wrap sm:flex-nowrap">
            <a
              href="/?report=found"
              class="inline-flex min-h-11 items-center justify-center gap-2 rounded-full bg-forest-700 px-6 py-2.5 font-bold text-white hover:bg-forest-900 active:scale-95 shadow-2xs transition-all w-full sm:w-auto text-sm cursor-pointer"
            >
              <span>Post an item</span>
              <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 5v14M5 12h14" />
              </svg>
            </a>
            <a
              href="/"
              class="inline-flex min-h-11 items-center justify-center gap-2 rounded-full border border-stone-200/90 bg-white px-5 py-2.5 text-sm font-bold text-forest-900 shadow-2xs hover:bg-stone-50 active:scale-95 transition-all w-full sm:w-auto cursor-pointer"
            >
              Campus feed
            </a>
            {isUserAdmin && (
              <a
                href="/admin"
                class="inline-flex min-h-11 items-center justify-center gap-2 rounded-full border border-stone-200/90 bg-white px-5 py-2.5 text-sm font-bold text-forest-900 shadow-2xs hover:bg-stone-50 active:scale-95 transition-all w-full sm:w-auto cursor-pointer"
              >
                <svg class="size-4 text-forest-700/70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                </svg>
                <span>Admin Console</span>
                <span aria-hidden="true" class="text-xs text-stone-400">&rarr;</span>
              </a>
            )}
          </div>
        </section>

        <!-- KPI Metric Row (Recipe from ui-design-system with Card 3 in Lime) -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 sm:gap-5" aria-label="Student Activity Metrics">
          <!-- Card 1: Total Items Reported -->
          <div class="rounded-3xl bg-white p-6 sm:p-7 border border-stone-200/60 shadow-xs flex flex-col justify-between">
            <p class="text-sm font-medium text-stone-600">Total items reported</p>
            <div class="mt-4">
              <p class="font-serif text-4xl sm:text-5xl font-black text-forest-900 tracking-tight leading-none">
                {totalReports}
              </p>
              <p class="mt-3 text-xs text-stone-500 font-medium">
                Submitted to campus feed
              </p>
            </div>
          </div>

          <!-- Card 2: Active Reports -->
          <div class="rounded-3xl bg-white p-6 sm:p-7 border border-stone-200/60 shadow-xs flex flex-col justify-between">
            <p class="text-sm font-medium text-stone-600">Active reports</p>
            <div class="mt-4">
              <p class="font-serif text-4xl sm:text-5xl font-black text-forest-900 tracking-tight leading-none">
                {activeReports}
              </p>
              <p class="mt-3 text-xs text-stone-500 font-medium">
                Awaiting return or claim
              </p>
            </div>
          </div>

          <!-- Card 3: Claims Submitted (Lime Accent Card per recipe line 228) -->
          <div
            class="rounded-3xl p-6 sm:p-7 border border-lime-600/30 shadow-xs flex flex-col justify-between text-forest-900 bg-lime"
          >
            <p class="text-sm font-bold text-forest-900">Claims submitted</p>
            <div class="mt-4">
              <p class="font-serif text-4xl sm:text-5xl font-black text-forest-900 tracking-tight leading-none">
                {totalClaims}
              </p>
              <p class="mt-3 text-xs text-forest-900 font-semibold">
                Ownership verifications filed
              </p>
            </div>
          </div>
        </div>

        <!-- Campus Handover Protocol Callout Card -->
        <div
          class="relative overflow-hidden rounded-3xl p-6 sm:p-8 text-white flex flex-col md:flex-row items-start md:items-center justify-between gap-6 shadow-card border border-white/10 bg-forest-700"
        >
          <div class="relative space-y-2 max-w-2xl">
            <div class="flex items-center gap-2">
              <span class="inline-block rounded-full bg-white/10 px-3 py-1 text-xs font-black uppercase tracking-wider text-lime border border-white/10">
                CAMPUS HANDOVER PROTOCOL
              </span>
              <Icon name="shield" class="size-4 text-lime opacity-80" />
            </div>
            <h3 class="font-serif text-xl sm:text-2xl font-black text-white leading-tight">
              Have an item to drop off or retrieve?
            </h3>
            <p class="text-sm font-normal text-stone-200/90 leading-relaxed">
              The Disciplinary &amp; Security Office is located in the Life Science Building (LSB, Building #3) and is open Monday to Friday, 8:00 AM – 5:00 PM. Bring your student ID and reference tag code for secure handovers.
            </p>
          </div>
          <a
            href="/help"
            class="relative inline-flex min-h-11 shrink-0 items-center gap-2 rounded-full bg-lime px-6 py-2.5 font-bold text-forest-900 hover:bg-[#c9e376] active:scale-95 shadow-xs transition-all cursor-pointer text-sm"
          >
            <span>Turn-in guide</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>

        <!-- Section 1: My Reported Items (Section card recipe) -->
        <section class="rounded-3xl bg-white border border-stone-200/60 shadow-xs p-6 sm:p-8 space-y-6">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-stone-200/70">
            <div>
              <h2 class="font-serif text-2xl sm:text-3xl font-black text-forest-900 leading-tight">
                Items I reported
              </h2>
              <p class="mt-1 text-sm text-stone-500">
                Track administrative verification, campus custody, and handover status.
              </p>
            </div>
            <a
              href="/?report=found"
              class="inline-flex min-h-11 items-center gap-2 rounded-full bg-forest-700 px-5 py-2.5 text-sm font-bold text-white hover:bg-forest-900 active:scale-95 shadow-2xs transition-all w-fit cursor-pointer"
            >
              <span>Post an item</span>
              <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 5v14M5 12h14" />
              </svg>
            </a>
          </div>

          {myReports.length === 0 ? (
            <div class="rounded-3xl border border-dashed border-stone-300 bg-stone-50 p-10 text-center">
              <div class="mx-auto flex size-12 items-center justify-center rounded-2xl bg-canvas text-forest-700">
                <svg class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" />
                </svg>
              </div>
              <h3 class="mt-4 font-serif text-xl font-bold text-forest-900">No items reported yet</h3>
              <p class="mt-1 text-sm text-stone-500 max-w-sm mx-auto">
                Lost something on campus or found someone else's property? Post a report to alert the university community.
              </p>
              <a
                href="/?report=found"
                class="mt-5 inline-flex min-h-11 items-center gap-2 rounded-full bg-forest-700 px-6 py-2.5 text-sm font-bold text-white hover:bg-forest-900 active:scale-95 shadow-2xs transition-all cursor-pointer"
              >
                <span>Go to feed &amp; report</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
            </div>
          ) : (
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
              {myReports.map((item) => {
                const photos = parsePhotos(item.photo_path);
                const hasPhoto = photos.length > 0;
                return (
                  <article class="flex flex-col justify-between overflow-hidden rounded-2xl border border-stone-200/90 bg-white p-5 sm:p-6 shadow-2xs hover:shadow-card transition-all">
                    <div>
                      <div class="flex items-center justify-between gap-2 mb-3">
                        <span class={`rounded-full px-3.5 py-1 text-xs font-bold uppercase tracking-wider ${
                          item.type === "found" ? "bg-forest-700 text-white shadow-2xs" : "bg-lime text-forest-900 border border-lime-600/30 shadow-2xs"
                        }`}>
                          {item.type}
                        </span>

                        <span class={`rounded-full px-3.5 py-1 text-xs font-bold uppercase tracking-wider ${
                          item.status === "approved"
                            ? "bg-lime text-forest-900"
                            : item.status === "pending"
                              ? "bg-[#ece5d6] text-forest-900"
                              : item.status === "claimed" || item.status === "resolved"
                                ? "bg-forest-700 text-white"
                                : "bg-danger/10 text-danger"
                        }`}>
                          {item.status === "approved" ? "Live on feed" : item.status === "pending" ? "Under review" : item.status.toUpperCase()}
                        </span>
                      </div>

                      {hasPhoto && (
                        <div class="mb-4 h-40 w-full overflow-hidden rounded-xl bg-stone-100 border border-stone-200/80">
                          <img src={photos[0]} alt={item.name} class="h-full w-full object-cover" loading="lazy" />
                        </div>
                      )}

                      <h3 class="font-bold text-base sm:text-lg text-forest-900 line-clamp-1 tracking-tight">
                        {item.name}
                      </h3>
                      <p class="text-xs text-stone-500 mt-1 font-medium">
                        {item.category} &bull; {item.location}
                      </p>

                      {item.reference_code && (
                        <div class="mt-3.5 inline-flex items-center gap-1.5 rounded-lg bg-canvas px-2.5 py-1 text-xs tabular-nums font-bold text-forest-900">
                          <span>Tag: {item.reference_code}</span>
                          <button
                            type="button"
                            class="copy-ref-btn relative -m-1 flex size-7 items-center justify-center rounded-full text-forest-900/70 hover:bg-stone-200 hover:text-forest-900 cursor-pointer after:absolute after:-inset-2 after:content-['']"
                            data-copy-ref={item.reference_code}
                            title="Copy tag code"
                            aria-label="Copy tag code"
                          >
                            <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                            </svg>
                            <span class="copy-ref-tooltip">Copied</span>
                          </button>
                        </div>
                      )}

                      {item.status === "pending" && item.type === "found" && (
                        <p class="mt-3 text-xs text-forest-900 bg-lime/30 rounded-xl p-3 border border-lime-600/40 leading-relaxed font-medium">
                          &bull; Please drop this item off at the Security Office (Admin 1F) with reference tag code.
                        </p>
                      )}

                      {item.status === "rejected" && item.reject_reason && (
                        <p class="mt-3 text-xs text-danger bg-danger/10 rounded-xl p-3 border border-danger/20 leading-relaxed font-medium">
                          Reason: {item.reject_reason}
                        </p>
                      )}
                    </div>

                    <div class="mt-5 pt-3.5 border-t border-stone-100 flex items-center justify-between text-xs">
                      <span class="text-stone-400 font-medium">
                        {item.event_date || (item.created_at ? item.created_at.split("T")[0] : "Recently")}
                      </span>
                      <a
                        href={`/item/${item.id}`}
                        class="inline-flex min-h-11 items-center font-bold text-forest-900 underline underline-offset-4 hover:text-forest-700"
                      >
                        View details &rarr;
                      </a>
                    </div>
                  </article>
                );
              })}
            </div>
          )}
        </section>

        <!-- Section 2: My Submitted Claims (Section card + Table row recipe) -->
        <section id="all-claims" class="rounded-3xl bg-white border border-stone-200/60 shadow-xs p-6 sm:p-8 space-y-6">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-stone-200/70">
            <div>
              <h2 class="font-serif text-2xl sm:text-3xl font-black text-forest-900 leading-tight">
                My submitted claims
              </h2>
              <p class="mt-1 text-sm text-stone-500">
                Ownership verification requests submitted to the Security &amp; Disciplinary Office.
              </p>
            </div>
            <a
              href="/"
              class="text-sm font-bold text-forest-900 underline underline-offset-4 hover:text-forest-700"
            >
              Browse campus feed &rarr;
            </a>
          </div>

          {myClaims.length === 0 ? (
            <div class="rounded-3xl border border-dashed border-stone-300 bg-stone-50 p-10 text-center">
              <div class="mx-auto flex size-12 items-center justify-center rounded-2xl bg-sage-200 text-forest-700">
                <svg class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <h3 class="mt-4 font-serif text-xl font-bold text-forest-900">No claims submitted</h3>
              <p class="mt-1 text-sm text-stone-500 max-w-sm mx-auto">
                Spotted your lost item on the feed? Click "Claim this item" and submit unique identifying proof.
              </p>
              <a
                href="/"
                class="mt-5 inline-flex min-h-11 items-center gap-2 rounded-full bg-forest-700 px-6 py-2.5 text-sm font-bold text-white hover:bg-forest-900 active:scale-95 shadow-2xs transition-all cursor-pointer"
              >
                <span>Browse campus feed</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
            </div>
          ) : (
            <div class="space-y-3">
              {myClaims.map((claim) => {
                const targetItem = claim.items;
                return (
                  <div class="flex items-center gap-4 rounded-2xl border border-stone-200/80 bg-stone-50 p-4 sm:p-5 hover:bg-white transition-all shadow-2xs flex-col sm:flex-row sm:items-center justify-between">
                    <div class="flex items-start sm:items-center gap-4 min-w-0 flex-1 w-full sm:w-auto">
                      <div class="flex size-12 shrink-0 items-center justify-center rounded-2xl bg-sage-200 text-forest-900">
                        <svg class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                        </svg>
                      </div>
                      <div class="min-w-0 flex-1 space-y-1">
                        <div class="flex items-center gap-2.5 flex-wrap">
                          <h4 class="font-bold text-base text-forest-900">
                            {targetItem?.name || "Item claim"}
                          </h4>
                          {targetItem?.reference_code && (
                            <span class="inline-flex items-center gap-1 rounded bg-canvas px-2 py-0.5 text-xs tabular-nums font-bold text-forest-900">
                              <span>{targetItem.reference_code}</span>
                              <button
                                type="button"
                                class="copy-ref-btn relative -m-1 flex size-7 items-center justify-center rounded-full text-forest-900/70 hover:bg-stone-200 hover:text-forest-900 cursor-pointer after:absolute after:-inset-2 after:content-['']"
                                data-copy-ref={targetItem.reference_code}
                                title="Copy reference code"
                                aria-label="Copy reference code"
                              >
                                <svg class="size-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                  <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                                </svg>
                                <span class="copy-ref-tooltip">Copied</span>
                              </button>
                            </span>
                          )}
                          <span class={`claim-status-badge rounded-full px-3 py-1 text-xs font-bold ${
                            claim.status === "verified"
                              ? "bg-lime text-forest-900"
                              : claim.status === "pending"
                                ? "bg-[#ece5d6] text-forest-900"
                                : "bg-danger/10 text-danger"
                          }`}>
                            {claim.status === "verified"
                              ? "Verified · visit DO"
                              : claim.status === "pending"
                                ? "Under review"
                                : "Denied"}
                          </span>
                        </div>
                        <p class="text-xs text-stone-600 line-clamp-1 italic">
                          &ldquo;{claim.proof_description}&rdquo;
                        </p>
                        <p class="text-xs text-stone-400 font-medium">
                          Submitted {new Date(claim.created_at).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}
                        </p>
                      </div>
                    </div>
                    <div class="shrink-0 flex items-center gap-3 mt-2 sm:mt-0">
                      {claim.status === "pending" && (
                        <button
                          type="button"
                          data-withdraw-claim={claim.id}
                          data-withdraw-label={targetItem?.name || "this item"}
                          class="withdraw-claim-btn inline-flex min-h-11 items-center justify-center rounded-full border border-danger/20 bg-danger/10 hover:bg-danger/20 active:scale-95 px-4 py-2 text-sm font-bold text-danger transition-all shadow-2xs cursor-pointer"
                        >
                          Withdraw
                        </button>
                      )}
                      {targetItem?.id && (
                        <a
                          href={`/item/${targetItem.id}`}
                          class="inline-flex min-h-11 items-center text-sm font-bold text-forest-900 underline underline-offset-4 hover:text-forest-700"
                        >
                          View item &rarr;
                        </a>
                      )}
                    </div>
                  </div>
                );
              })}
            </div>
          )}
        </section>

        <!-- Section 3: Security & Recent Sign-In Activity Card -->
        <section class="rounded-3xl bg-white border border-stone-200/60 shadow-xs p-6 sm:p-8 space-y-4">
          <div class="flex items-center justify-between pb-3 border-b border-stone-100 flex-wrap gap-2">
            <div>
              <div class="flex items-center gap-2">
                <span class="size-2 rounded-full bg-forest-700 animate-pulse"></span>
                <span class="text-xs font-bold uppercase tracking-wider text-forest-900/60">Account Security</span>
              </div>
              <h3 class="font-serif text-xl sm:text-2xl font-bold text-forest-900 mt-1">
                Recent Sign-in Activity
              </h3>
            </div>
            <span class="text-xs font-medium text-stone-500 bg-canvas/80 px-3 py-1.5 rounded-full border border-stone-200/70">
              Audit logging active
            </span>
          </div>

          <div class="space-y-2.5">
            {recentLogins.length > 0 ? (
              recentLogins.map((login) => (
                <div class="flex items-center justify-between p-3.5 rounded-2xl bg-stone-50/80 border border-stone-200/70 text-xs text-stone-700 flex-wrap gap-2">
                  <div class="flex items-center gap-3">
                    <div class="size-8 rounded-full bg-forest-700/10 text-forest-900 flex items-center justify-center font-bold">
                      <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                    </div>
                    <div>
                      <span class="font-bold text-forest-900">{login.device_summary || "Active Device"}</span>
                      <span class="text-stone-400 mx-1.5">&bull;</span>
                      <span class="font-mono text-stone-500">{login.ip_address || "Network Verified"}</span>
                    </div>
                  </div>
                  <span class="text-stone-500 font-medium">
                    {new Date(login.created_at).toLocaleString("en-US", { month: "short", day: "numeric", hour: "numeric", minute: "2-digit" })}
                  </span>
                </div>
              ))
            ) : (
              <div class="p-4 rounded-2xl bg-canvas/60 border border-dashed border-stone-200 text-xs text-stone-500 text-center">
                Current active session verified. Sign-in events are safely logged into the university audit record.
              </div>
            )}
          </div>
        </section>
      </main>
    </div>

    <!-- Campus Dashboard Footer -->
    <DashboardFooter />
  </div>

  <script>
    document.addEventListener("click", async (e) => {
      const btn = (e.target as HTMLElement).closest("[data-copy-ref]");
      if (!btn) return;
      const ref = btn.getAttribute("data-copy-ref");
      if (!ref) return;

      try {
        await navigator.clipboard.writeText(ref);
        const tooltip = btn.querySelector(".copy-ref-tooltip");
        if (tooltip) tooltip.classList.add("visible");
        if ((window as any).llToast) {
          (window as any).llToast(`Reference code ${ref} copied`, "success");
        }
        setTimeout(() => {
          if (tooltip) tooltip.classList.remove("visible");
        }, 2000);
      } catch (err) {
        console.warn("Clipboard copy failed:", err);
      }
    });

    document.addEventListener("click", async (e) => {
      const btn = (e.target as HTMLElement).closest(".withdraw-claim-btn") as HTMLButtonElement | null;
      if (!btn) return;

      const claimId = btn.getAttribute("data-withdraw-claim");
      const label = btn.getAttribute("data-withdraw-label") || "this item";
      if (!claimId) return;
      if (!confirm(`Withdraw your claim for "${label}"? The security office will no longer review it.`)) {
        return;
      }

      btn.disabled = true;
      const idleLabel = btn.textContent;
      btn.textContent = "Withdrawing...";

      try {
        const resp = await fetch("/api/claims", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ action: "withdraw", claimId }),
        });
        const data = await resp.json().catch(() => ({}));
        if (!resp.ok || !data.ok) {
          throw new Error(data.error || "Could not withdraw the claim.");
        }

        const row = btn.closest(".rounded-2xl.border") as HTMLElement | null;
        if (row) {
          row.style.transition = "all 0.3s ease-out";
          row.style.opacity = "0";
          row.style.transform = "scale(0.98)";
          setTimeout(() => row.remove(), 300);
        }
        if ((window as any).llToast) {
          (window as any).llToast("Claim withdrawn.", "success");
        }
      } catch (err) {
        btn.disabled = false;
        btn.textContent = idleLabel;
        const msg = err instanceof Error ? err.message : "Could not withdraw the claim.";
        if ((window as any).llToast) {
          (window as any).llToast(msg, "error");
        } else {
          alert(msg);
        }
      }
    });
  </script>
</Base>
