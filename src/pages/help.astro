---
import InfoPage from "~/components/InfoPage.astro";
import AboutTeam from "~/components/AboutTeam.astro";
import { CAMPUS_BUILDINGS } from "~/data/campusBuildings";

const faqs = [
  {
    q: "Where is the official Lost & Found office on campus?",
    a: "The Disciplinary & Security Office is located at the Life Science Building (LSB, Building #3). All physical found items are held here in secure custody, and all approved claims must be collected from this office.",
  },
  {
    q: "How do I report a lost item?",
    a: "Log in with your DLSAU account, click 'Post an item', choose 'Lost', and fill in the item name, category, campus location, date, and description. An admin reviews it before it appears publicly on the campus feed.",
  },
  {
    q: "How do I report a found item?",
    a: "Choose 'Found' in the report form and describe the item. Bring the physical item to the security office at Life Science Building (LSB, Building #3). You will be issued a reference code to write on the item tag.",
  },
  {
    q: "How do I claim an item?",
    a: "Open the item card on the feed and click 'Claim this item'. Provide unique private details, markings, or contents that only the owner would know. Security staff compare your proof with the physical item held at LSB.",
  },
  {
    q: "Where do I pick up a verified item?",
    a: "Once your claim status updates to 'Verified', visit the Disciplinary & Security Office at Life Science Building (LSB, Building #3). Bring your claim reference code (e.g. LL-4821) and your valid DLSAU student/staff ID.",
  },
  {
    q: "What are the office hours for drop-off and pickup?",
    a: "The LostLink Custody & Security Office at LSB is open Monday to Friday, 8:00 AM to 5:00 PM (excluding university holidays).",
  },
  {
    q: "What do the item statuses mean?",
    a: "Pending means security staff are reviewing the report. Approved means it is visible on the campus feed. Claimed or Resolved means the item has been returned to its rightful owner. Rejected includes an explanation from the office.",
  },
];
---

<InfoPage
  title="Help & Campus Map | LostLink"
  heading="Help & Campus Directory"
  subheading="Everything you need to know about reporting, claiming, and navigating DLSAU lost & found custody."
  description="Help guidelines, FAQs, and campus map for De La Salle Araneta University LostLink system."
>
  <!-- Primary Custody Office Callout Banner -->
  <section class="mt-8 rounded-3xl p-6 sm:p-7 text-white shadow-card border border-white/10 bg-forest-700">
    <div class="flex items-center gap-2">
      <span class="inline-block rounded-full bg-lime px-3 py-1 text-xs font-black tracking-wider text-forest-700 uppercase shadow-xs">
        Official claim &amp; custody office
      </span>
      <span class="size-2 rounded-full bg-lime" aria-hidden="true"></span>
    </div>

    <h2 class="mt-3 font-serif text-2xl sm:text-3xl font-black text-white leading-tight">
      Life Science Building (LSB) — Building #3
    </h2>

    <p class="mt-2 text-sm text-stone-200/95 leading-relaxed max-w-2xl">
      The university's centralized lost and found custody intake and verification office is stationed on the ground floor of the <strong>Life Science Building (LSB)</strong>. All physical items must be turned in and claimed here.
    </p>

    <div class="mt-5 grid grid-cols-1 sm:grid-cols-3 gap-3 pt-4 border-t border-white/10 text-xs">
      <div>
        <p class="text-stone-400 font-bold uppercase tracking-wider text-xs">Office location</p>
        <p class="mt-0.5 font-bold text-white">LSB Building #3, Ground Floor</p>
      </div>
      <div>
        <p class="text-stone-400 font-bold uppercase tracking-wider text-xs">Operating hours</p>
        <p class="mt-0.5 font-bold text-white">Mon – Fri, 8:00 AM – 5:00 PM</p>
      </div>
      <div>
        <p class="text-stone-400 font-bold uppercase tracking-wider text-xs">Pickup requirements</p>
        <p class="mt-0.5 font-bold text-white">DLSAU ID + Claim Reference Code</p>
      </div>
    </div>
  </section>

  <!-- Interactive Campus Map Section -->
  <section class="mt-10 rounded-3xl bg-white border border-stone-200/70 p-6 sm:p-8 shadow-xs" id="campus-map">
    <div class="flex flex-wrap items-end justify-between gap-3 pb-5 border-b border-stone-100">
      <div>
        <h2 class="font-serif text-2xl font-black text-forest-900 tracking-tight">
          DLSAU campus map
        </h2>
        <p class="mt-1 text-sm text-stone-500">
          Buildings and designated custody drop-off points.
        </p>
      </div>

      <button
        type="button"
        id="open-map-lightbox"
        class="inline-flex min-h-11 items-center justify-center gap-1.5 rounded-full border border-stone-200/90 bg-white hover:bg-stone-50 px-4 py-2 text-xs font-bold text-forest-900 shadow-2xs transition-all cursor-pointer"
      >
        <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 9V5a1 1 0 011-1h4M20 9V5a1 1 0 00-1-1h-4M4 15v4a1 1 0 001 1h4M20 15v4a1 1 0 01-1 1h-4" />
        </svg>
        <span>Expand map</span>
      </button>
    </div>

    <!-- Map preview: fixed aspect ratio, click to open full-screen lightbox -->
    <button
      type="button"
      id="map-preview-btn"
      class="group mt-6 block w-full overflow-hidden rounded-2xl border border-stone-200 bg-stone-50 focus:outline-none focus-visible:ring-4 focus-visible:ring-forest-700/20 cursor-zoom-in"
      aria-label="Expand campus map"
    >
      <div class="relative aspect-[16/10] w-full">
        <img
          src="/campus-map.jpg"
          alt="De La Salle Araneta University illustrated top-down campus map"
          class="absolute inset-0 h-full w-full object-cover object-center transition-transform duration-500 group-hover:scale-[1.02]"
          loading="lazy"
        />
        <div class="absolute inset-0 flex items-center justify-center bg-forest-900/0 transition-colors duration-300 group-hover:bg-forest-900/10">
          <span class="flex size-12 items-center justify-center rounded-full bg-white/90 text-forest-900 shadow-xs opacity-0 transition-opacity duration-300 group-hover:opacity-100">
            <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 9V5a1 1 0 011-1h4M20 9V5a1 1 0 00-1-1h-4M4 15v4a1 1 0 001 1h4M20 15v4a1 1 0 01-1 1h-4M9 9h6v6H9z" />
            </svg>
          </span>
        </div>
      </div>
    </button>

    <!-- Collapsible directory: keeps the page clean, expands on demand -->
    <details class="group mt-5 [&_summary::-webkit-details-marker]:hidden">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-3 rounded-2xl border border-stone-200/70 bg-stone-50/60 px-4 py-3 transition-colors hover:bg-stone-100/70">
        <span class="flex items-center gap-2 text-sm font-bold text-forest-900">
          <span>Campus directory</span>
          <span class="rounded-full bg-lime px-2 py-0.5 text-xs font-black text-forest-900">
            {CAMPUS_BUILDINGS.length}
          </span>
        </span>
        <svg class="size-4 shrink-0 text-forest-900/60 transition-transform duration-200 group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </summary>

      <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-2.5">
        {CAMPUS_BUILDINGS.map((b) => (
          <div
            class={`flex items-start gap-3 rounded-2xl p-3.5 border transition-all ${
              b.isClaimOffice
                ? "bg-lime/25 border-lime-600/40 shadow-xs"
                : "bg-stone-50/70 hover:bg-stone-100/70 border-stone-200/60"
            }`}
          >
            <span
              class={`flex size-7 shrink-0 items-center justify-center rounded-full text-xs font-black shadow-xs ${
                b.isClaimOffice ? "bg-forest-700 text-lime" : "bg-[#ece5d6] text-forest-900 border border-stone-200"
              }`}
            >
              {b.id}
            </span>
            <div class="min-w-0">
              <p class="font-bold text-forest-900 text-xs sm:text-sm truncate">
                {b.name}
              </p>
              {b.subtitle && (
                <p class={`text-xs truncate mt-0.5 ${b.isClaimOffice ? "text-forest-900 font-bold" : "text-stone-500"}`}>
                  {b.subtitle}
                </p>
              )}
            </div>
          </div>
        ))}
      </div>
    </details>
  </section>

  <!-- Full-screen map lightbox -->
  <div
    id="map-lightbox"
    class="fixed inset-0 z-[70] hidden items-center justify-center bg-black/50 backdrop-blur-sm p-4"
    role="dialog"
    aria-modal="true"
    aria-label="Campus map"
  >
    <div class="relative w-full max-w-5xl">
      <button
        id="close-map-lightbox"
        type="button"
        class="absolute -top-12 right-0 flex size-11 items-center justify-center rounded-full bg-white/10 text-white hover:bg-white/20 transition-colors cursor-pointer"
        aria-label="Close map"
      >
        <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
      <img
        src="/campus-map.jpg"
        alt="De La Salle Araneta University illustrated top-down campus map"
        class="w-full max-h-[85vh] rounded-2xl object-contain"
      />
    </div>
  </div>

  <script>
    // @ts-nocheck -- legacy DOM script, migrated out of is:inline for CSP.
    (function () {
      var lightbox = document.getElementById("map-lightbox");
      var previewBtn = document.getElementById("map-preview-btn");
      var expandBtn = document.getElementById("open-map-lightbox");
      var closeBtn = document.getElementById("close-map-lightbox");
      if (!lightbox) return;

      function openMap() {
        lightbox.classList.remove("hidden");
        lightbox.classList.add("flex");
        document.body.style.overflow = "hidden";
        if (closeBtn) closeBtn.focus();
      }
      function closeMap() {
        lightbox.classList.add("hidden");
        lightbox.classList.remove("flex");
        document.body.style.overflow = "";
        if (previewBtn) previewBtn.focus();
      }

      if (previewBtn) previewBtn.addEventListener("click", openMap);
      if (expandBtn) expandBtn.addEventListener("click", openMap);
      if (closeBtn) closeBtn.addEventListener("click", closeMap);
      lightbox.addEventListener("click", function (e) {
        if (e.target === lightbox) closeMap();
      });
      document.addEventListener("keydown", function (e) {
        if (e.key === "Escape" && !lightbox.classList.contains("hidden")) closeMap();
      });
    })();
  </script>

  <!-- FAQ Section -->
  <section class="mt-10 rounded-3xl bg-white border border-stone-200/70 p-6 sm:p-8 shadow-xs">
    <h2 class="font-serif text-2xl font-black text-forest-900 tracking-tight pb-4 border-b border-stone-100">
      Frequently asked questions
    </h2>

    <dl class="mt-6 space-y-6">
      {
        faqs.map((faq) => (
          <div class="border-b border-stone-100/80 pb-5 last:border-b-0 last:pb-0">
            <dt class="text-[0.9375rem] font-bold text-forest-900">{faq.q}</dt>
            <dd class="mt-1.5 text-[0.9375rem] leading-relaxed text-sage-700">{faq.a}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <AboutTeam />
</InfoPage>
