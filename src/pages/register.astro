---
import { actions, isInputError } from "astro:actions";
import AuthShell from "~/components/AuthShell.astro";
import PasswordField from "~/components/PasswordField.astro";
import SubmitButton from "~/components/SubmitButton.astro";
import { devBypassEnabled } from "~/lib/session";
import { COLLEGES, DEGREE_PROGRAMS } from "~/data/campusPrograms";
import { STANDARD_YEAR_LEVELS, DVM_YEAR_LEVELS } from "~/lib/schemas";

// Group programs by college for the select element
const programsByCollege = Object.entries(COLLEGES).map(([cCode, cInfo]) => ({
  college: cInfo,
  programs: Object.values(DEGREE_PROGRAMS).filter((p) => p.collegeCode === cCode),
}));

// If user submits registration successfully, redirect accordingly
const registerResult = Astro.getActionResult(actions.register);
if (registerResult && !registerResult.error && registerResult.data?.redirect) {
  return Astro.redirect(registerResult.data.redirect, 302);
}

const registerError =
  registerResult?.error && !isInputError(registerResult.error)
    ? registerResult.error.message
    : undefined;
const fields = isInputError(registerResult?.error) ? registerResult.error.fields : undefined;
const fieldError = (
  name: "name" | "email" | "password" | "agree" | "program" | "studentId" | "yearLevel",
) => fields?.[name]?.[0] ?? undefined;

const devOpen = devBypassEnabled(Astro.locals.env);
---

<AuthShell
  title="Create Account | LostLink"
  heading="Join the community!"
  description="Create your LostLink account with a DLSAU email."
>
  {
    registerError && (
      <p role="alert" class="notice">
        {registerError}
      </p>
    )
  }

  <form method="POST" action={actions.register} class="mt-6 space-y-4">
    <!-- Full Name -->
    <div>
      <label for="name" class="label">Full Name</label>
      <input
        id="name"
        type="text"
        name="name"
        class="field"
        placeholder="e.g. Renee De La Cruz"
        autocomplete="name"
        required
        aria-invalid={fieldError("name") ? true : undefined}
        aria-describedby={fieldError("name") ? "name-error" : undefined}
      />
      {
        fieldError("name") && (
          <p id="name-error" role="alert" class="field-error">
            {fieldError("name")}
          </p>
        )
      }
    </div>

    <!-- University Email -->
    <div>
      <label for="email" class="label">University Email</label>
      <input
        id="email"
        type="email"
        name="email"
        class="field"
        placeholder="you@dlsau.edu.ph"
        autocomplete="email"
        required
        aria-invalid={fieldError("email") ? true : undefined}
        aria-describedby={fieldError("email") ? "email-error" : undefined}
      />
      {
        fieldError("email") && (
          <p id="email-error" role="alert" class="field-error">
            {fieldError("email")}
          </p>
        )
      }
    </div>

    <!-- Role Selection Pills from createnewacc.png -->
    <div>
      <label class="label">Role</label>
      <input type="hidden" name="role" id="role-input" value="student" />
      <div class="grid grid-cols-2 gap-2.5">
        <button
          type="button"
          data-role="student"
          class="role-btn active flex min-h-11 items-center justify-center rounded-control bg-forest-700 text-xs sm:text-sm font-bold text-white shadow-2xs transition-all cursor-pointer"
        >
          Student
        </button>
        <button
          type="button"
          data-role="faculty"
          class="role-btn flex min-h-11 items-center justify-center rounded-control border border-line bg-canvas/40 text-xs sm:text-sm font-medium text-forest-900/70 transition-all hover:bg-canvas cursor-pointer"
        >
          Faculty
        </button>
      </div>
      <p class="caption mt-1.5">
        New accounts start as Student. Admin access is assigned by the Security Office.
      </p>
    </div>

    <!-- Degree Program / Academic Affiliation Selection -->
    <div>
      <div class="flex items-center justify-between mb-1.5">
        <label for="program" class="label mb-0" id="program-label">
          Degree Program
        </label>
        <span class="text-[0.6875rem] font-bold text-forest-800 bg-[#d8ef8c]/50 border border-forest-700/20 px-2 py-0.5 rounded-full">
          Required for DLSAU Verification
        </span>
      </div>
      <div class="relative">
        <select
          id="program"
          name="program"
          required
          class="field appearance-none pr-10 cursor-pointer font-medium text-forest-900 bg-white"
          aria-invalid={fieldError("program") ? true : undefined}
          aria-describedby={fieldError("program") ? "program-error" : "program-hint"}
        >
          <option value="" disabled selected>Select your degree program...</option>
          {programsByCollege.map(({ college, programs }) => (
            <optgroup label={`${college.code} — ${college.name}`} class="font-bold text-forest-900 bg-stone-50">
              {programs.map((p) => (
                <option value={p.code} class="font-normal text-forest-900 py-1">
                  {p.code} — {p.name}
                </option>
              ))}
            </optgroup>
          ))}
        </select>
        <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3.5 text-forest-700">
          <svg class="size-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
          </svg>
        </div>
      </div>
      <p id="program-hint" class="caption mt-1.5">
        Your college and program are verified by the Security Office when claiming or verifying campus items.
      </p>
      {
        fieldError("program") && (
          <p id="program-error" role="alert" class="field-error mt-1">
            {fieldError("program")}
          </p>
        )
      }
    </div>

    <!-- Student-Only Fields: Student ID & Year Level (hidden/inapplicable for Faculty and Admin) -->
    <div id="student-fields" class="space-y-4 transition-all">
      <!-- Student ID Field -->
      <div>
        <div class="flex items-center justify-between mb-1.5">
          <label for="studentId" class="label mb-0">Student ID</label>
          <span class="text-[0.6875rem] font-bold text-forest-800 bg-[#d8ef8c]/50 border border-forest-700/20 px-2 py-0.5 rounded-full">
            Required for Students
          </span>
        </div>
        <input
          id="studentId"
          type="text"
          name="studentId"
          class="field"
          placeholder="e.g. 2024-10144"
          autocomplete="off"
          required
          aria-invalid={fieldError("studentId") ? true : undefined}
          aria-describedby={fieldError("studentId") ? "studentId-error" : "studentId-hint"}
        />
        <p id="studentId-hint" class="caption mt-1.5">
          Official DLSAU student ID number found on your campus ID card.
        </p>
        {
          fieldError("studentId") && (
            <p id="studentId-error" role="alert" class="field-error mt-1">
              {fieldError("studentId")}
            </p>
          )
        }
      </div>

      <!-- Year Level Dropdown -->
      <div>
        <div class="flex items-center justify-between mb-1.5">
          <label for="yearLevel" class="label mb-0">Year Level</label>
          <span class="text-[0.6875rem] font-bold text-forest-800 bg-[#d8ef8c]/50 border border-forest-700/20 px-2 py-0.5 rounded-full">
            Required for Students
          </span>
        </div>
        <div class="relative">
          <select
            id="yearLevel"
            name="yearLevel"
            required
            class="field appearance-none pr-10 cursor-pointer font-medium text-forest-900 bg-white"
            aria-invalid={fieldError("yearLevel") ? true : undefined}
            aria-describedby={fieldError("yearLevel") ? "yearLevel-error" : "yearLevel-hint"}
          >
            <option value="" disabled selected>Select your current year level...</option>
            {STANDARD_YEAR_LEVELS.map((level) => (
              <option value={level} class="py-1 text-forest-900">
                {level}
              </option>
            ))}
            <option value="5th Year" class="py-1 text-forest-900 hidden dvm-only-option" id="opt-5th-year">
              5th Year (DVM Clinician)
            </option>
            <option value="6th Year" class="py-1 text-forest-900 hidden dvm-only-option" id="opt-6th-year">
              6th Year (DVM Clinician)
            </option>
          </select>
          <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3.5 text-forest-700">
            <svg class="size-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
            </svg>
          </div>
        </div>
        <p id="yearLevel-hint" class="caption mt-1.5">
          Your current academic standing at De La Salle Araneta University.
        </p>
        {
          fieldError("yearLevel") && (
            <p id="yearLevel-error" role="alert" class="field-error mt-1">
              {fieldError("yearLevel")}
            </p>
          )
        }
      </div>
    </div>

    <!-- Password Field -->
    <PasswordField
      id="password"
      name="password"
      label="Password"
      placeholder="Password"
      autocomplete="new-password"
      error={fieldError("password")}
    />

    <!-- Terms and Conditions Checkbox -->
    <label class="flex cursor-pointer items-center gap-2.5 text-[0.9375rem] text-sage-700 pt-1">
      <input
        type="checkbox"
        name="agree"
        value="on"
        required
        class="size-5 shrink-0 cursor-pointer rounded accent-forest-700"
        aria-describedby={fieldError("agree") ? "agree-error" : undefined}
      />
      I have read the
      <a href="/terms" class="font-semibold text-ink underline underline-offset-4 hover:text-forest-700">terms &amp; Conditions</a>
    </label>
    {
      fieldError("agree") && (
        <p id="agree-error" role="alert" class="field-error">
          {fieldError("agree")}
        </p>
      )
    }

    <!-- Submit Button -->
    <div class="pt-2">
      <SubmitButton label="Create Account" busy="Creating account..." />
    </div>

    <p class="caption">
      Already have an account?
      <a href="/login">Log in here</a>
    </p>
  </form>

  {
    devOpen && (
      <div class="mt-6 border-t border-line pt-5 text-center">
        <form method="POST" action={actions.devLogin}>
          <input type="hidden" name="next" value="/" />
          <button
            type="submit"
            class="text-xs font-medium text-sage-600 underline underline-offset-4 hover:text-forest-700 cursor-pointer"
          >
            Test login (dev)
          </button>
        </form>
      </div>
    )
  }

  <!-- Interactive script for Role pill selection, dynamic program labels, and student fields toggle -->
  <script is:inline>
    (function () {
      const roleBtns = document.querySelectorAll(".role-btn");
      const roleInput = document.getElementById("role-input");
      const programLabel = document.getElementById("program-label");
      const programHint = document.getElementById("program-hint");
      const studentFields = document.getElementById("student-fields");
      const studentIdInput = document.getElementById("studentId");
      const yearLevelSelect = document.getElementById("yearLevel");

      function syncRoleUI(role) {
        const isStudent = role === "student" || !role;

        // Toggle student-only fields (hidden & disabled for Faculty / Admin)
        if (studentFields) {
          if (isStudent) {
            studentFields.classList.remove("hidden");
            if (studentIdInput) {
              studentIdInput.removeAttribute("disabled");
              studentIdInput.setAttribute("required", "");
            }
            if (yearLevelSelect) {
              yearLevelSelect.removeAttribute("disabled");
              yearLevelSelect.setAttribute("required", "");
            }
          } else {
            studentFields.classList.add("hidden");
            if (studentIdInput) {
              studentIdInput.removeAttribute("required");
              studentIdInput.setAttribute("disabled", "true");
              studentIdInput.value = "";
            }
            if (yearLevelSelect) {
              yearLevelSelect.removeAttribute("required");
              yearLevelSelect.setAttribute("disabled", "true");
              yearLevelSelect.value = "";
            }
          }
        }

        // Update labels for program
        if (programLabel && programHint) {
          if (role === "faculty") {
            programLabel.textContent = "College / Academic Department";
            programHint.textContent = "Select your teaching or administrative college department.";
          } else if (role === "admin") {
            programLabel.textContent = "Office / Department Affiliation";
            programHint.textContent = "Select your affiliated campus department.";
          } else {
            programLabel.textContent = "Degree Program";
            programHint.textContent = "Your college and program are verified by the Security Office when claiming or verifying campus items.";
          }
        }
      }

      const programSelect = document.getElementById("program");
      const yearLevelHint = document.getElementById("yearLevel-hint");
      const opt5 = document.getElementById("opt-5th-year");
      const opt6 = document.getElementById("opt-6th-year");

      function syncYearLevelsForProgram(programCode) {
        const isDvm = programCode === "DVM";
        if (opt5 && opt6) {
          if (isDvm) {
            opt5.classList.remove("hidden");
            opt5.removeAttribute("disabled");
            opt6.classList.remove("hidden");
            opt6.removeAttribute("disabled");
            if (yearLevelHint) {
              yearLevelHint.textContent = "Doctor of Veterinary Medicine is a 6-year professional program (1st to 6th Year).";
            }
          } else {
            opt5.classList.add("hidden");
            opt5.setAttribute("disabled", "true");
            opt6.classList.add("hidden");
            opt6.setAttribute("disabled", "true");
            if (yearLevelSelect && (yearLevelSelect.value === "5th Year" || yearLevelSelect.value === "6th Year")) {
              yearLevelSelect.value = "";
            }
            if (yearLevelHint) {
              yearLevelHint.textContent = "Your current academic standing at De La Salle Araneta University.";
            }
          }
        }
      }

      if (programSelect) {
        programSelect.addEventListener("change", (e) => {
          syncYearLevelsForProgram(e.target.value);
        });
        if (programSelect.value) {
          syncYearLevelsForProgram(programSelect.value);
        }
      }

      roleBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          roleBtns.forEach((b) => {
            b.classList.remove("bg-forest-700", "text-white", "font-bold", "active");
            b.classList.add("border", "border-line", "bg-canvas/40", "text-forest-900/70", "font-medium");
          });
          btn.classList.add("bg-forest-700", "text-white", "font-bold", "active");
          btn.classList.remove("border", "border-line", "bg-canvas/40", "text-forest-900/70", "font-medium");

          const role = btn.dataset.role || "student";
          if (roleInput) {
            roleInput.value = role;
          }

          syncRoleUI(role);
        });
      });
    })();
  </script>
</AuthShell>
