---
import { actions, isInputError } from "astro:actions";
import AuthShell from "~/components/AuthShell.astro";
import PasswordField from "~/components/PasswordField.astro";
import SubmitButton from "~/components/SubmitButton.astro";
import { devBypassEnabled } from "~/lib/session";

// If user submits registration successfully, redirect accordingly
const registerResult = Astro.getActionResult(actions.register);
if (registerResult && !registerResult.error && registerResult.data?.redirect) {
  return Astro.redirect(registerResult.data.redirect, 302);
}

const registerError =
  registerResult?.error && !isInputError(registerResult.error)
    ? registerResult.error.message
    : undefined;
const fields = isInputError(registerResult?.error) ? registerResult.error.fields : undefined;
const fieldError = (name: "name" | "email" | "password" | "agree") =>
  fields?.[name]?.[0] ?? undefined;

const devOpen = devBypassEnabled(Astro.locals.env);
---

<AuthShell
  title="Create Account | LostLink"
  heading="Join the community!"
  description="Create your LostLink account with a DLSAU email."
>
  {
    registerError && (
      <p role="alert" class="notice">
        {registerError}
      </p>
    )
  }

  <form method="POST" action={actions.register} class="mt-6 space-y-4">
    <!-- Full Name -->
    <div>
      <label for="name" class="label">Full Name</label>
      <input
        id="name"
        type="text"
        name="name"
        class="field"
        placeholder="e.g. Renee De La Cruz"
        autocomplete="name"
        required
        aria-invalid={fieldError("name") ? true : undefined}
        aria-describedby={fieldError("name") ? "name-error" : undefined}
      />
      {
        fieldError("name") && (
          <p id="name-error" role="alert" class="field-error">
            {fieldError("name")}
          </p>
        )
      }
    </div>

    <!-- University Email -->
    <div>
      <label for="email" class="label">University Email</label>
      <input
        id="email"
        type="email"
        name="email"
        class="field"
        placeholder="you@dlsau.edu.ph"
        autocomplete="email"
        required
        aria-invalid={fieldError("email") ? true : undefined}
        aria-describedby={fieldError("email") ? "email-error" : undefined}
      />
      {
        fieldError("email") && (
          <p id="email-error" role="alert" class="field-error">
            {fieldError("email")}
          </p>
        )
      }
    </div>

    <!-- Role Selection Pills from createnewacc.png -->
    <div>
      <label class="label">Role</label>
      <input type="hidden" name="role" id="role-input" value="student" />
      <div class="grid grid-cols-3 gap-2.5">
        <button
          type="button"
          data-role="student"
          class="role-btn active flex min-h-11 items-center justify-center rounded-control bg-forest-700 text-xs sm:text-sm font-bold text-white shadow-2xs transition-all cursor-pointer"
        >
          Student
        </button>
        <button
          type="button"
          data-role="faculty"
          class="role-btn flex min-h-11 items-center justify-center rounded-control border border-line bg-canvas/40 text-xs sm:text-sm font-medium text-forest-900/70 transition-all hover:bg-canvas cursor-pointer"
        >
          Faculty
        </button>
        <button
          type="button"
          data-role="admin"
          class="role-btn flex min-h-11 items-center justify-center rounded-control border border-line bg-canvas/40 text-xs sm:text-sm font-medium text-forest-900/70 transition-all hover:bg-canvas cursor-pointer"
        >
          Admin
        </button>
      </div>
      <p class="caption mt-1.5">
        New accounts start as Student. Admin access is assigned by the Security Office.
      </p>
    </div>

    <!-- Password Field -->
    <PasswordField
      id="password"
      name="password"
      label="Password"
      placeholder="Password"
      autocomplete="new-password"
      error={fieldError("password")}
    />

    <!-- Terms and Conditions Checkbox -->
    <label class="flex cursor-pointer items-center gap-2.5 text-[0.9375rem] text-sage-700 pt-1">
      <input
        type="checkbox"
        name="agree"
        value="on"
        required
        class="size-5 shrink-0 cursor-pointer rounded accent-forest-700"
        aria-describedby={fieldError("agree") ? "agree-error" : undefined}
      />
      I have read the
      <a href="/terms" class="font-semibold text-ink underline underline-offset-4 hover:text-forest-700">terms &amp; Conditions</a>
    </label>
    {
      fieldError("agree") && (
        <p id="agree-error" role="alert" class="field-error">
          {fieldError("agree")}
        </p>
      )
    }

    <!-- Submit Button -->
    <div class="pt-2">
      <SubmitButton label="Create Account" busy="Creating account..." />
    </div>

    <p class="caption">
      Already have an account?
      <a href="/login">Log in here</a>
    </p>
  </form>

  {
    devOpen && (
      <div class="mt-6 border-t border-line pt-5 text-center">
        <form method="POST" action={actions.devLogin}>
          <input type="hidden" name="next" value="/" />
          <button
            type="submit"
            class="text-xs font-medium text-sage-600 underline underline-offset-4 hover:text-forest-700 cursor-pointer"
          >
            Test login (dev)
          </button>
        </form>
      </div>
    )
  }

  <!-- Interactive script for Role pill selection -->
  <script is:inline>
    (function () {
      const roleBtns = document.querySelectorAll(".role-btn");
      const roleInput = document.getElementById("role-input");

      roleBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          roleBtns.forEach((b) => {
            b.classList.remove("bg-forest-700", "text-white", "font-bold", "active");
            b.classList.add("border", "border-line", "bg-canvas/40", "text-forest-900/70", "font-medium");
          });
          btn.classList.add("bg-forest-700", "text-white", "font-bold", "active");
          btn.classList.remove("border", "border-line", "bg-canvas/40", "text-forest-900/70", "font-medium");

          if (roleInput) {
            roleInput.value = btn.dataset.role || "student";
          }
        });
      });
    })();
  </script>
</AuthShell>
