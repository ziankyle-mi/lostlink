---
import { actions, isInputError } from "astro:actions";
import AuthShell from "~/components/AuthShell.astro";
import { devBypassEnabled } from "~/lib/session";

if (Astro.locals.user) {
  return Astro.redirect("/");
}

const registerResult = Astro.getActionResult(actions.register);
if (registerResult && !registerResult.error && registerResult.data?.redirect) {
  return Astro.redirect(registerResult.data.redirect, 302);
}

const registerError =
  registerResult?.error && !isInputError(registerResult.error)
    ? registerResult.error.message
    : undefined;
const fields = isInputError(registerResult?.error) ? registerResult.error.fields : undefined;
const fieldError = (name: "name" | "email" | "password" | "agree") =>
  fields?.[name]?.[0] ?? undefined;

const devOpen = devBypassEnabled(Astro.locals.env);
---

<AuthShell
  title="Register | LostLink"
  heading="REGISTER"
  description="Create your LostLink account with a DLSAU email."
>
  {
    registerError && (
      <p role="alert" class="notice">
        {registerError}
      </p>
    )
  }

  <form method="POST" action={actions.register} class="mt-11">
    <label class="block">
      <span class="sr-only">Name</span>
      <input
        type="text"
        name="name"
        class="field"
        placeholder="Name"
        autocomplete="name"
        required
        aria-invalid={fieldError("name") ? true : undefined}
        aria-describedby={fieldError("name") ? "name-error" : undefined}
      />
    </label>
    {
      fieldError("name") && (
        <p id="name-error" role="alert" class="field-error">
          {fieldError("name")}
        </p>
      )
    }

    <label class="mt-9 block">
      <span class="sr-only">Email</span>
      <input
        type="email"
        name="email"
        class="field"
        placeholder="Email"
        autocomplete="email"
        required
        aria-invalid={fieldError("email") ? true : undefined}
        aria-describedby={fieldError("email") ? "email-error" : undefined}
      />
    </label>
    {
      fieldError("email") && (
        <p id="email-error" role="alert" class="field-error">
          {fieldError("email")}
        </p>
      )
    }

    <label class="mt-9 block">
      <span class="sr-only">Password</span>
      <input
        type="password"
        name="password"
        class="field"
        placeholder="Password"
        autocomplete="new-password"
        required
        aria-invalid={fieldError("password") ? true : undefined}
        aria-describedby={fieldError("password") ? "password-error" : undefined}
      />
    </label>
    {
      fieldError("password") && (
        <p id="password-error" role="alert" class="field-error">
          {fieldError("password")}
        </p>
      )
    }

    <label class="mt-5 flex cursor-pointer items-center gap-2.5 text-[0.8125rem] text-ink/80">
      <input
        type="checkbox"
        name="agree"
        value="on"
        class="size-4 shrink-0 accent-forest-700"
        aria-describedby={fieldError("agree") ? "agree-error" : undefined}
      />
      I agree to the terms and conditions
    </label>
    {
      fieldError("agree") && (
        <p id="agree-error" role="alert" class="field-error">
          {fieldError("agree")}
        </p>
      )
    }

    <div class="mt-14 flex justify-center">
      <button type="submit" class="btn-primary">Register</button>
    </div>

    <p class="caption">
      Already have an account?
      <a href="/login">Log in here</a>
    </p>
  </form>

  {
    devOpen && (
      <div class="mt-8 border-t border-line/50 pt-6 text-center">
        <form method="POST" action={actions.devLogin}>
          <input type="hidden" name="next" value="/" />
          <button
            type="submit"
            class="text-[0.72rem] font-medium uppercase tracking-[0.16em] text-sage-600 underline-offset-4 hover:text-forest-700 hover:underline"
          >
            Test login (dev)
          </button>
        </form>
      </div>
    )
  }
</AuthShell>