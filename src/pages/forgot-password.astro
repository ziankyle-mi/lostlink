---
import { actions, isInputError } from "astro:actions";
import AuthShell from "~/components/AuthShell.astro";
import SubmitButton from "~/components/SubmitButton.astro";

const sent = Astro.url.searchParams.get("sent") === "1";
const expired = Astro.url.searchParams.get("expired") === "1";

const forgotResult = Astro.getActionResult(actions.forgotPassword);
if (forgotResult && !forgotResult.error && forgotResult.data?.redirect) {
  return Astro.redirect(forgotResult.data.redirect, 302);
}

const forgotError =
  forgotResult?.error && !isInputError(forgotResult.error)
    ? forgotResult.error.message
    : undefined;
const fields = isInputError(forgotResult?.error) ? forgotResult.error.fields : undefined;
const emailError = fields?.email?.[0];
---

<AuthShell
  title="Forget Password | LostLink"
  heading="Forget Password?"
  subheading="DLSAU Account Recovery"
  description="Reset your LostLink password."
>
  {
    sent ? (
      <div class="mt-6 space-y-4">
        <div class="rounded-2xl border border-line bg-[#f5f1e6]/90 p-5 text-forest-900">
          <div class="flex items-center gap-2">
            <span class="flex size-6 items-center justify-center rounded-full bg-forest-700 text-white text-xs font-bold">✓</span>
            <p class="font-bold text-sm sm:text-base">Reset Request Recorded</p>
          </div>
          <p class="mt-2 text-xs sm:text-sm text-stone-700 leading-relaxed">
            Because DLSAU student inboxes block automated external emails, your password reset request has been logged for campus staff.
          </p>
          <div class="mt-3.5 rounded-xl bg-white/90 p-3.5 border border-line/60 text-xs sm:text-sm text-stone-700">
            <p class="font-bold text-forest-900">How to get your new password:</p>
            <p class="mt-1 leading-relaxed">
              Contact your LostLink administrator or visit the <strong>Campus Security Office</strong>. The administrator will reset your temporary password directly in the database.
            </p>
            <p class="mt-2 font-mono text-xs font-semibold text-forest-700">
              Admin Contact: dlsau.lostlink@dlsau.edu.ph
            </p>
          </div>
          <p class="mt-3 text-xs text-stone-600">
            Once updated, a confirmation notification will appear in your account's notification bell when you sign in.
          </p>
        </div>

        <div class="text-center pt-2">
          <a
            href="/login"
            class="inline-flex min-h-11 items-center justify-center rounded-full bg-forest-700 px-7 py-2.5 text-sm font-bold text-white transition-all hover:bg-forest-900 active:scale-95 shadow-2xs"
          >
            Back to Login
          </a>
        </div>
      </div>
    ) : (
      <>
        <!-- Default student password tip -->
        <div class="mt-6 rounded-2xl border border-line bg-[#f5f1e6]/80 p-4 text-xs sm:text-sm text-stone-700">
          <p class="font-bold text-forest-900 flex items-center gap-1.5">
            <span>💡</span> Did you know? Default Student Password:
          </p>
          <p class="mt-1 leading-relaxed text-stone-600">
            Your initial password is your <strong>lowercase last name</strong>. If your last name has fewer than 6 letters, <strong>123456</strong> was added (e.g. <code class="rounded bg-white px-1.5 py-0.5 font-mono font-semibold text-forest-900">cruz123456</code> or <code class="rounded bg-white px-1.5 py-0.5 font-mono font-semibold text-forest-900">laguidao</code>).
          </p>
        </div>

        {(expired || forgotError) && (
          <p role="alert" class="notice mt-4">
            {expired ? "That reset link expired. Send a new one." : forgotError}
          </p>
        )}

        <form method="POST" action={actions.forgotPassword} class="mt-6 space-y-4">
          <div>
            <label for="email" class="label">University Email</label>
            <input
              id="email"
              type="email"
              name="email"
              class="field"
              placeholder="you@dlsau.edu.ph"
              autocomplete="email"
              required
              aria-invalid={emailError ? true : undefined}
              aria-describedby={emailError ? "email-error" : undefined}
            />
            {emailError && (
              <p id="email-error" role="alert" class="field-error mt-1.5">
                {emailError}
              </p>
            )}
          </div>

          <p class="text-xs text-stone-500 leading-relaxed">
            Enter your DLSAU email to submit a password reset request to campus administrators.
          </p>

          <div class="pt-2">
            <SubmitButton label="Request Password Reset" busy="Submitting..." arrow />
          </div>

          <p class="caption pt-2">
            Remembered it?
            <a href="/login">Back to Login</a>
          </p>
        </form>
      </>
    )
  }
</AuthShell>