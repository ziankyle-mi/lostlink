---
import { actions, isInputError } from "astro:actions";
import Background from "~/components/Background.astro";
import BrandHeader from "~/components/BrandHeader.astro";
import TrustBadges from "~/components/TrustBadges.astro";
import Base from "~/layouts/Base.astro";

const sent = Astro.url.searchParams.get("sent") === "1";
const expired = Astro.url.searchParams.get("expired") === "1";

const forgotResult = Astro.getActionResult(actions.forgotPassword);
if (forgotResult && !forgotResult.error && forgotResult.data?.redirect) {
  return Astro.redirect(forgotResult.data.redirect, 302);
}

const forgotError =
  forgotResult?.error && !isInputError(forgotResult.error)
    ? forgotResult.error.message
    : undefined;
const fields = isInputError(forgotResult?.error) ? forgotResult.error.fields : undefined;
const emailError = fields?.email?.[0];
---

<Base title="Forget Password | LostLink" description="Reset your LostLink password.">
  <main class="relative flex min-h-dvh flex-col">
    <Background />

    <div class="relative mx-auto flex w-full max-w-[1440px] flex-1 flex-col px-5 py-6 sm:px-9 sm:py-8">
      <BrandHeader />

      <div class="flex flex-1 flex-col items-center justify-center gap-12 py-10 md:grid md:grid-cols-2 md:items-center md:gap-8 md:py-6">
        <div class="hidden max-w-md md:block md:self-end md:pb-16">
          <p class="font-serif text-[2.6rem] leading-[1.22] text-forest-900">
            <span class="text-forest-700">&ldquo;</span><span class="font-bold">Lost <span
              class="text-forest-600">things</span></span><br />
            their way<br />
            <span class="font-bold">back</span> <span class="text-forest-700">&ldquo;</span>
          </p>
          <p class="mt-6 flex items-center gap-3 text-sage-700">
            <span class="h-px w-12 bg-sage-400"></span>
            <span class="text-[0.9rem]">LostLink &middot; DLSAU</span>
          </p>
        </div>

        <section
          class="w-full max-w-[34rem] justify-self-center rounded-[1.5rem] bg-card-tint px-7 py-10 shadow-card sm:px-12 sm:py-12"
          aria-labelledby="forgot-title"
        >
          <h1
            id="forgot-title"
            class="text-center text-[1.35rem] font-medium tracking-[0.06em] text-ink"
          >
            FORGET PASSWORD
          </h1>

          {
            sent ? (
              <p role="status" class="mt-8 text-center text-xs leading-relaxed text-sage-700">
                If that email has an account, a reset link is on its way. Check your inbox, then
                open the link on this device.
              </p>
            ) : (
              <>
                {(expired || forgotError) && (
                  <p
                    role="alert"
                    class="mt-6 rounded-control border border-line/60 bg-surface/70 px-4 py-3 text-xs leading-snug text-sage-700"
                  >
                    {expired
                      ? "That reset link expired. Send a new one."
                      : forgotError}
                  </p>
                )}

                <form method="POST" action={actions.forgotPassword} class="mt-9">
                  <label class="block">
                    <span class="sr-only">Email</span>
                    <input
                      type="email"
                      name="email"
                      class="field"
                      placeholder="Email"
                      autocomplete="email"
                      required
                      aria-invalid={emailError ? true : undefined}
                      aria-describedby={emailError ? "email-error" : undefined}
                    />
                  </label>
                  {emailError && (
                    <p id="email-error" role="alert" class="mt-1.5 text-[0.7rem] text-sage-700">
                      {emailError}
                    </p>
                  )}

                  <div class="mt-12 flex justify-center">
                    <button
                      type="submit"
                      class="min-h-11 w-full max-w-[11.5rem] rounded-control bg-forest-700 px-6 py-2.5 text-[0.8rem] font-medium tracking-[0.1em] text-white transition-colors hover:bg-forest-900"
                    >
                      Send Link
                    </button>
                  </div>

                  <p class="mt-4 text-center text-[0.7rem] text-sage-700">
                    Remembered it?
                    <a href="/login" class="font-semibold text-ink hover:text-forest-700">
                      Back to Login
                    </a>
                  </p>
                </form>
              </>
            )
          }
        </section>
      </div>

      <TrustBadges />
    </div>
  </main>
</Base>