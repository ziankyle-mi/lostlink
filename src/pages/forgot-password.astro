---
import { actions, isInputError } from "astro:actions";
import AuthShell from "~/components/AuthShell.astro";

const sent = Astro.url.searchParams.get("sent") === "1";
const expired = Astro.url.searchParams.get("expired") === "1";

const forgotResult = Astro.getActionResult(actions.forgotPassword);
if (forgotResult && !forgotResult.error && forgotResult.data?.redirect) {
  return Astro.redirect(forgotResult.data.redirect, 302);
}

const forgotError =
  forgotResult?.error && !isInputError(forgotResult.error)
    ? forgotResult.error.message
    : undefined;
const fields = isInputError(forgotResult?.error) ? forgotResult.error.fields : undefined;
const emailError = fields?.email?.[0];
---

<AuthShell
  title="Forget Password | LostLink"
  heading="FORGET PASSWORD"
  description="Reset your LostLink password."
>
  {
    sent ? (
      <p role="status" class="notice mt-11">
        If that email has an account, a reset link is on its way. Check your inbox, then open the
        link on this device.
      </p>
    ) : (
      <>
        {(expired || forgotError) && (
          <p role="alert" class="notice">
            {expired ? "That reset link expired. Send a new one." : forgotError}
          </p>
        )}

        <form method="POST" action={actions.forgotPassword} class="mt-11">
          <label class="block">
            <span class="sr-only">Email</span>
            <input
              type="email"
              name="email"
              class="field"
              placeholder="Email"
              autocomplete="email"
              required
              aria-invalid={emailError ? true : undefined}
              aria-describedby={emailError ? "email-error" : undefined}
            />
          </label>
          {emailError && (
            <p id="email-error" role="alert" class="field-error">
              {emailError}
            </p>
          )}

          <div class="mt-14 flex justify-center">
            <button type="submit" class="btn-primary">
              Send Link
            </button>
          </div>

          <p class="caption">
            Remembered it?
            <a href="/login">Back to Login</a>
          </p>
        </form>
      </>
    )
  }
</AuthShell>