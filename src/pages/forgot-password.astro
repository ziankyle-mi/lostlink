---
import { actions, isInputError } from "astro:actions";
import AuthShell from "~/components/AuthShell.astro";
import SubmitButton from "~/components/SubmitButton.astro";

const sent = Astro.url.searchParams.get("sent") === "1";
const expired = Astro.url.searchParams.get("expired") === "1";

const forgotResult = Astro.getActionResult(actions.forgotPassword);
if (forgotResult && !forgotResult.error && forgotResult.data?.redirect) {
  return Astro.redirect(forgotResult.data.redirect, 302);
}

const forgotError =
  forgotResult?.error && !isInputError(forgotResult.error)
    ? forgotResult.error.message
    : undefined;
const fields = isInputError(forgotResult?.error) ? forgotResult.error.fields : undefined;
const emailError = fields?.email?.[0];
---

<AuthShell
  title="Account Recovery | LostLink"
  heading="Reset password"
  subheading="Enter your university email to recover your LostLink account."
  description="Recover your LostLink account and reset your institutional password."
>
  {
    sent ? (
      <div class="mt-8 space-y-6">
        <!-- Official Confirmation Card -->
        <div class="rounded-2xl border border-line/80 bg-stone-50 p-6 text-forest-900 shadow-2xs">
          <div class="flex items-center gap-3">
            <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-forest-700 text-white shadow-xs">
              <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 6 9 17l-5-5" />
              </svg>
            </span>
            <div>
              <p class="text-xs font-bold uppercase tracking-wider text-stone-500">
                Security Office Process
              </p>
              <h2 class="text-base sm:text-lg font-bold text-forest-900 leading-tight">
                Recovery Request Logged
              </h2>
            </div>
          </div>

          <p class="mt-4 text-xs sm:text-sm text-stone-700 leading-relaxed">
            No reset email was sent. LostLink account recovery is handled in person by the Security Office.
          </p>

          <!-- Procedure Box -->
          <div class="mt-4 rounded-xl border border-line/70 bg-white p-4 text-xs sm:text-sm text-stone-700 space-y-3">
            <p class="font-bold text-forest-900 uppercase tracking-wide text-xs">
              Next Steps for Credential Retrieval:
            </p>
            <div class="space-y-2.5">
              <div class="flex items-start gap-2.5">
                <span class="flex size-5 shrink-0 items-center justify-center rounded-full bg-forest-700 text-xs font-black text-white mt-0.5">
                  1
                </span>
                <p class="leading-normal">
                  <strong>In-Person Verification:</strong> Present your valid DLSAU ID card or Certificate of Registration (COR) at the <strong>Disciplinary Office</strong> (Admin Building, 1F) or the <strong>Campus Security Office</strong>.
                </p>
              </div>
              <div class="flex items-start gap-2.5">
                <span class="flex size-5 shrink-0 items-center justify-center rounded-full bg-forest-700 text-xs font-black text-white mt-0.5">
                  2
                </span>
                <p class="leading-normal">
                  <strong>Temporary Password:</strong> After your ID is verified, the office issues a temporary password. Sign in with it and you will be asked to set a new password right away.
                </p>
              </div>
            </div>

            <div class="pt-2 border-t border-stone-100 flex items-center justify-between flex-wrap gap-2 text-xs">
              <span class="text-stone-500">Office Support:</span>
              <a href="mailto:dlsau.lostlink@dlsau.edu.ph" class="tabular-nums font-bold text-forest-700 hover:underline">
                dlsau.lostlink@dlsau.edu.ph
              </a>
            </div>
          </div>

          <p class="mt-4 text-xs text-stone-500 leading-relaxed">
            Your temporary password also appears in your in-app notifications after it is issued.
          </p>
        </div>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2">
          <a
            href="/login"
            class="flex min-h-11 w-full sm:w-auto items-center justify-center rounded-full bg-forest-700 px-8 py-2.5 text-sm font-bold text-white transition-all hover:bg-forest-900 active:scale-95 shadow-2xs"
          >
            Back to sign in
          </a>
          <a
            href="/help"
            class="flex min-h-11 w-full sm:w-auto items-center justify-center rounded-full border border-line bg-white px-6 py-2.5 text-sm font-semibold text-forest-900 hover:bg-stone-50 transition-colors"
          >
            Help &amp; Guidelines
          </a>
        </div>
      </div>
    ) : (
      <>
        {(expired || forgotError) && (
          <p role="alert" class="notice mt-6">
            {expired ? "That recovery session expired. Sign in again or submit a new request." : forgotError}
          </p>
        )}

        <form method="POST" action={actions.forgotPassword} class="mt-8 space-y-5">
          <div>
            <label for="email" class="label">University Email</label>
            <input
              id="email"
              type="email"
              name="email"
              class="field"
              placeholder="you@dlsau.edu.ph"
              autocomplete="email"
              required
              aria-invalid={emailError ? true : undefined}
              aria-describedby={emailError ? "email-error" : undefined}
            />
            {emailError && (
              <p id="email-error" role="alert" class="field-error mt-1.5">
                {emailError}
              </p>
            )}
            <p class="mt-2 text-xs text-stone-500">
              Only registered @dlsau.edu.ph institutional addresses are recognized.
            </p>
          </div>

          <div class="pt-2">
            <SubmitButton label="Submit Recovery Request" busy="Submitting Request..." arrow />
          </div>

          <p class="caption pt-2 text-center text-sm text-sage-600">
            Remembered your credentials?
            <a href="/login" class="font-bold underline underline-offset-4 hover:text-forest-900 transition-colors ml-1">
              Back to sign in
            </a>
          </p>
        </form>
      </>
    )
  }
</AuthShell>