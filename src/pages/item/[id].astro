---
import Base from "~/layouts/Base.astro";
import StudentNavbar from "~/components/StudentNavbar.astro";
import { ALL_ITEMS } from "~/data/mockItems";
import { createClient } from "@supabase/supabase-js";
import { readEnv } from "~/lib/env";

const { id } = Astro.params;

// Resolve user session (if logged in)
const user = Astro.locals.user;
const userEmail = user?.email || "";

const env = Astro.locals.env || readEnv();
let item: any = null;
let isReporter = false;

// 1. Check Supabase
if (id && env.PUBLIC_SUPABASE_URL && (env.SUPABASE_SERVICE_ROLE_KEY || env.PUBLIC_SUPABASE_ANON_KEY)) {
  try {
    const supabase = createClient(
      env.PUBLIC_SUPABASE_URL,
      env.SUPABASE_SERVICE_ROLE_KEY || env.PUBLIC_SUPABASE_ANON_KEY,
      { auth: { persistSession: false } }
    );

    const { data: dbItem } = await supabase
      .from("items")
      .select("*, profiles!reporter_id(id, full_name, email)")
      .eq("id", id)
      .maybeSingle();

    if (dbItem) {
      let photos: string[] = [];
      if (dbItem.photo_path) {
        try {
          if (dbItem.photo_path.startsWith("[")) {
            photos = JSON.parse(dbItem.photo_path);
          } else {
            photos = [dbItem.photo_path];
          }
        } catch {
          photos = [dbItem.photo_path];
        }
      }

      item = {
        id: dbItem.id,
        name: dbItem.name,
        type: dbItem.type,
        category: dbItem.category,
        location: dbItem.location,
        eventDate: dbItem.event_date || (dbItem.created_at ? dbItem.created_at.split("T")[0] : "Recently"),
        description: dbItem.description,
        status: dbItem.status,
        referenceCode: dbItem.reference_code,
        images: photos,
        reporterId: dbItem.reporter_id,
        reporterEmail: dbItem.profiles?.email,
      };

      if (user && dbItem.profiles?.email) {
        isReporter = dbItem.profiles.email.toLowerCase() === userEmail.toLowerCase();
      }
    }
  } catch (err) {
    console.warn("[item] Supabase item fetch note:", err);
  }
}

// 2. Fallback: Only check mock items array if live Supabase is not configured
const isDbConfigured = Boolean(env?.PUBLIC_SUPABASE_URL && (env.SUPABASE_SERVICE_ROLE_KEY || env.PUBLIC_SUPABASE_ANON_KEY));
if (!item && id && !isDbConfigured) {
  const mock = ALL_ITEMS.find((m) => m.id === id);
  if (mock) {
    item = {
      id: mock.id,
      name: mock.name,
      type: mock.type,
      category: mock.category,
      location: mock.location,
      eventDate: mock.eventDate || mock.date,
      description: mock.description,
      status: "approved",
      referenceCode: mock.referenceCode,
      images: mock.images ?? [],
      reporterId: null,
      reporterEmail: null,
    };
  }
}
---

<Base
  title={item ? `${item.name} | LostLink` : "Item Not Found | LostLink"}
  description={item ? `${item.type.toUpperCase()}: ${item.name} at De La Salle Araneta University` : "Item details on LostLink"}
>
  <div class="min-h-screen bg-[#f5f1e6] text-[#082e1a] flex flex-col justify-between selection:bg-[#d8ef8c]">
    <div>
      <!-- Top Navbar -->
      <StudentNavbar userEmail={userEmail} />

      <!-- Main Container -->
      <main class="mx-auto w-full max-w-5xl px-4 py-6 sm:px-6 sm:py-8 lg:px-8 space-y-6">
        <!-- Breadcrumb Link -->
        <div>
          <a
            href="/"
            class="inline-flex items-center gap-1.5 rounded-full border border-stone-200 bg-white/80 px-4 py-1.5 text-xs font-bold text-forest-900 shadow-2xs hover:bg-white hover:text-forest-700 transition-colors"
          >
            <span>&larr;</span>
            <span>Back to Campus Feed</span>
          </a>
        </div>

        {!item ? (
          <div class="rounded-3xl border border-dashed border-stone-300 bg-white p-12 text-center">
            <div class="mx-auto flex size-14 items-center justify-center rounded-full bg-stone-100 text-stone-400">
              <svg class="size-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h1 class="mt-4 font-serif text-2xl font-black text-forest-900">Item not found</h1>
            <p class="mt-1 text-sm text-stone-500 max-w-md mx-auto">
              This item may have been removed, resolved, or the link is expired.
            </p>
            <a
              href="/"
              class="mt-6 inline-block rounded-full bg-forest-900 px-6 py-2.5 text-xs font-bold text-[#d8ef8c] hover:bg-forest-800 transition-colors shadow-xs"
            >
              Browse Campus Feed
            </a>
          </div>
        ) : (
          <div class="grid grid-cols-1 md:grid-cols-12 gap-8 rounded-3xl border border-stone-200/80 bg-white p-6 sm:p-8 lg:p-10 shadow-xs">
            <!-- Left Column: Photos Gallery -->
            <div class="md:col-span-5 space-y-4">
              <div class="relative aspect-square w-full overflow-hidden rounded-2xl bg-stone-100 border border-stone-200 shadow-inner flex items-center justify-center">
                <!-- Status Badges -->
                <div class="absolute left-3 top-3 z-10 flex items-center gap-2">
                  <span class={`rounded-full px-3 py-1 text-xs font-bold uppercase tracking-wider ${
                    item.type === "found" ? "bg-forest-700 text-white shadow-xs" : "bg-[#d8ef8c] text-forest-900 shadow-xs border border-lime-600/30"
                  }`}>
                    {item.type}
                  </span>
                  <span class={`rounded-full px-3 py-1 text-xs font-bold uppercase tracking-wider ${
                    item.status === "approved"
                      ? "bg-emerald-100 text-emerald-800 border border-emerald-300"
                      : item.status === "claimed" || item.status === "resolved"
                        ? "bg-blue-100 text-blue-800 border border-blue-300"
                        : "bg-amber-100 text-amber-800 border border-amber-300"
                  }`}>
                    {item.status}
                  </span>
                </div>

                {item.images && item.images.length > 0 ? (
                  <img
                    id="main-item-photo"
                    src={item.images[0]}
                    alt={item.name}
                    class="h-full w-full object-cover transition-all"
                  />
                ) : (
                  <div class="flex flex-col items-center justify-center text-stone-400 p-6 text-center">
                    <svg class="size-16 text-forest-700/20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                    </svg>
                    <p class="mt-2 text-xs font-medium text-stone-500">No photo uploaded</p>
                  </div>
                )}
              </div>

              <!-- Thumbnails row if multiple photos -->
              {item.images && item.images.length > 1 && (
                <div class="flex items-center gap-2.5 overflow-x-auto pb-1">
                  {item.images.map((photo: string, idx: number) => (
                    <button
                      type="button"
                      class="size-16 shrink-0 overflow-hidden rounded-xl border border-stone-200 hover:border-forest-700 transition-colors cursor-pointer"
                      onclick={`document.getElementById('main-item-photo').src = '${photo}';`}
                    >
                      <img src={photo} alt={`Photo ${idx + 1}`} class="h-full w-full object-cover" />
                    </button>
                  ))}
                </div>
              )}

              {item.referenceCode && (
                <div class="rounded-2xl bg-[#f5f1e6] p-4 border border-stone-200/80 text-center">
                  <p class="text-xs font-bold uppercase tracking-wider text-stone-500">Security Office Tag Code</p>
                  <div class="mt-1 flex items-center justify-center gap-2">
                    <span id="item-detail-ref-code" class="font-mono text-xl font-black text-forest-900 tracking-wider">{item.referenceCode}</span>
                    <button
                      type="button"
                      id="copy-item-ref-btn"
                      data-ref={item.referenceCode}
                      class="copy-ref-btn"
                      aria-label="Copy reference tag code"
                      title="Copy code"
                    >
                      <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                      </svg>
                      <span class="copy-label">Copy</span>
                      <span class="copy-ref-tooltip">Copied!</span>
                    </button>
                  </div>
                  <p class="mt-1.5 text-[11px] text-stone-500">Bring this code to the campus security office for identification.</p>
                </div>
              )}
            </div>

            <!-- Right Column: Details & Claim Action -->
            <div class="md:col-span-7 flex flex-col justify-between space-y-6">
              <div class="space-y-4">
                <div>
                  <p class="text-xs font-bold uppercase tracking-wider text-stone-500">{item.category}</p>
                  <h1 class="mt-1 font-serif text-2xl sm:text-3xl lg:text-4xl font-black text-forest-900 leading-tight">
                    {item.name}
                  </h1>
                </div>

                <div class="grid grid-cols-2 gap-3 rounded-2xl bg-stone-50 p-4 border border-stone-200/60 text-xs sm:text-sm">
                  <div>
                    <p class="text-stone-400 font-medium">Location</p>
                    <p class="font-bold text-forest-900 mt-0.5">{item.location}</p>
                  </div>
                  <div>
                    <p class="text-stone-400 font-medium">Date Reported</p>
                    <p class="font-bold text-forest-900 mt-0.5">{item.eventDate}</p>
                  </div>
                </div>

                <div>
                  <h3 class="text-xs font-bold uppercase tracking-wider text-stone-400">Description</h3>
                  <p class="mt-1 text-sm text-stone-700 whitespace-pre-line leading-relaxed bg-[#fbf9f4] p-4 rounded-2xl border border-stone-200/60">
                    {item.description}
                  </p>
                </div>
              </div>

              <!-- Action Area -->
              <div class="pt-6 border-t border-stone-200">
                {item.type === "found" && item.status === "approved" && (
                  <div>
                    {isReporter ? (
                      <div class="rounded-2xl bg-forest-50 p-4 border border-forest-200 text-forest-900 text-xs">
                        <p class="font-bold">You reported this found item.</p>
                        <p class="mt-0.5 text-stone-600">Thank you for turning it over to the Security Office. It is registered on the campus network.</p>
                      </div>
                    ) : (
                      <div class="rounded-2xl border border-forest-700/20 bg-forest-900/5 p-5 space-y-4">
                        <div>
                          <h3 class="font-bold text-base text-forest-900">Claim this item</h3>
                          <p class="text-xs text-stone-600 mt-0.5">
                            Is this your property? Describe unique identifying marks or details so security officers can verify your claim.
                          </p>
                        </div>

                        <form id="standalone-claim-form" class="space-y-3">
                          <input type="hidden" id="claim-target-id" value={item.id} />
                          <div>
                            <label for="standalone-proof-input" class="block text-xs font-bold text-forest-900">
                              Proof of Ownership
                            </label>
                            <textarea
                              id="standalone-proof-input"
                              required
                              minlength="20"
                              rows="3"
                              placeholder="Describe stickers, scratches, lock combinations, contents, or serial numbers..."
                              class="mt-1.5 w-full rounded-xl border border-line bg-white p-3 text-xs sm:text-sm text-forest-900 placeholder:text-stone-400 focus:outline-none focus:ring-2 focus:ring-forest-700/30"
                            ></textarea>
                          </div>

                          <button
                            type="submit"
                            id="standalone-submit-claim-btn"
                            class="w-full rounded-full bg-forest-900 py-3 text-xs sm:text-sm font-bold text-[#d8ef8c] hover:bg-forest-800 transition-colors shadow-xs cursor-pointer active:scale-98"
                          >
                            Submit Claim to Security Office
                          </button>
                        </form>

                        <div id="standalone-claim-success" class="hidden rounded-xl bg-emerald-100 p-4 border border-emerald-300 text-emerald-900 text-xs text-center font-bold">
                          ✓ Claim request submitted! The Security Office will review your proof. Check <a href="/profile" class="underline">My Activity</a> for status updates.
                        </div>
                      </div>
                    )}
                  </div>
                )}

                {item.type === "found" && item.status === "claimed" && (
                  <div class="rounded-2xl bg-emerald-50 p-4 border border-emerald-200 text-emerald-900 text-xs">
                    <p class="font-bold">✓ Item Claimed & Returned</p>
                    <p class="mt-0.5 text-stone-600">This item has been verified by the Security Office and successfully returned to its owner.</p>
                  </div>
                )}

                {item.type === "lost" && (
                  <div class="rounded-2xl bg-lime-50 p-4 border border-lime-200 text-forest-900 text-xs">
                    <p class="font-bold">Have you found this lost item?</p>
                    <p class="mt-0.5 text-stone-600">
                      Please drop it off at the DLSAU Disciplinary &amp; Security Office at Life Science Building (LSB, Building #3) or post a "Found" report on the feed so the owner can be notified.
                    </p>
                  </div>
                )}
              </div>
            </div>
          </div>
        )}
      </main>
    </div>

    <!-- Campus Footer -->
    <footer class="mt-14 border-t border-stone-200/70 bg-[#ece5d6]/70 py-6 text-center text-xs text-stone-500">
      <div class="mx-auto max-w-5xl px-4 flex flex-col sm:flex-row items-center justify-between gap-3">
        <p>&copy; {new Date().getFullYear()} LostLink &bull; De La Salle Araneta University</p>
        <div class="flex items-center gap-4 font-semibold text-forest-900">
          <a href="/" class="hover:underline">Campus Feed</a>
          <a href="/profile" class="hover:underline">My Activity</a>
          <a href="/help" class="hover:underline">Guidelines</a>
        </div>
      </div>
    </footer>
  </div>

  <script>
    // Copy reference code to clipboard
    const copyRefBtn = document.getElementById("copy-item-ref-btn");
    if (copyRefBtn) {
      copyRefBtn.addEventListener("click", async () => {
        const refCode = copyRefBtn.dataset.ref;
        if (!refCode) return;
        try {
          await navigator.clipboard.writeText(refCode);
          const tooltip = copyRefBtn.querySelector(".copy-ref-tooltip");
          const copyLabel = copyRefBtn.querySelector(".copy-label");
          if (tooltip) tooltip.classList.add("visible");
          if (copyLabel) copyLabel.textContent = "Copied!";
          if ((window as any).llToast) {
            (window as any).llToast(`Reference code ${refCode} copied!`, "success");
          }
          setTimeout(() => {
            if (tooltip) tooltip.classList.remove("visible");
            if (copyLabel) copyLabel.textContent = "Copy";
          }, 2000);
        } catch (err) {
          console.warn("Clipboard copy failed:", err);
        }
      });
    }

    const claimForm = document.getElementById("standalone-claim-form");
    const claimSuccess = document.getElementById("standalone-claim-success");
    const submitBtn = document.getElementById("standalone-submit-claim-btn");

    if (claimForm) {
      claimForm.addEventListener("submit", async (e) => {
        e.preventDefault();
        const itemId = (document.getElementById("claim-target-id") as HTMLInputElement)?.value;
        const proofInput = document.getElementById("standalone-proof-input") as HTMLTextAreaElement;
        const proofText = proofInput?.value.trim() || "";

        if (submitBtn) {
          submitBtn.setAttribute("disabled", "true");
          submitBtn.textContent = "Submitting claim verification...";
        }

        try {
          const resp = await fetch("/api/claims", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              itemId,
              proofDescription: proofText,
            }),
          });
          const data = await resp.json();
          if (resp.ok && data.ok) {
            claimForm.classList.add("hidden");
            claimSuccess?.classList.remove("hidden");
            if ((window as any).llToast) {
              (window as any).llToast("Claim verification submitted to Security Office!", "success");
            }
          } else {
            const errorMsg = data.error || "Could not submit claim. Please try again.";
            if ((window as any).llToast) {
              (window as any).llToast(errorMsg, "error");
            } else {
              alert(errorMsg);
            }
            if (submitBtn) {
              submitBtn.removeAttribute("disabled");
              submitBtn.textContent = "Submit Claim to Security Office";
            }
          }
        } catch (err) {
          console.error("Error submitting claim:", err);
          if ((window as any).llToast) {
            (window as any).llToast("Network error submitting claim. Please check your connection.", "error");
          } else {
            alert("Error submitting claim. Please check your connection.");
          }
          if (submitBtn) {
            submitBtn.removeAttribute("disabled");
            submitBtn.textContent = "Submit Claim to Security Office";
          }
        }
      });
    }
  </script>
</Base>
