PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # server only, never in the browser
ALLOWED_EMAIL_DOMAIN=dlsau.edu.ph    # every account is firstname.lastname@dlsau.edu.ph
DEMO_ALLOWED_EMAILS=            # dev only, ignored in production builds
GOOGLE_CLIENT_ID=               # optional; password login is the default
GOOGLE_CLIENT_SECRET=
TURNSTILE_SITE_KEY=             # required in production (bot check)
TURNSTILE_SECRET_KEY=           # required in production (server siteverify)
RESEND_API_KEY=                 # stretch only
DEV_LOGIN_BYPASS=false          # local dev only, must stay false on deploy
DEV_SESSION_SECRET=             # local dev only, openssl rand -hex 32